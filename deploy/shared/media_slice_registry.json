{
  "schemaVersion": "media-slice-registry",
  "description": "切片级媒体路由表。优先解析 objectKey 中的 /s/{sliceId}/，归档 fixture 通过显式 archived sliceId 路由到固定 slice。",
  "allocation": {
    "strategy": "sequential-capacity",
    "limits": {
      "avatar": {
        "maxObjects": 50000,
        "maxBytes": 1073741824
      },
      "image": {
        "maxObjects": 50000,
        "maxBytes": 5368709120
      },
      "video": {
        "maxObjects": 5000,
        "maxBytes": 21474836480
      }
    },
    "writableSlices": {
      "avatar": "avatar-seed-0001",
      "image": "image-seed-0001",
      "video": "video-seed-0001"
    }
  },
  "slices": [
    {
      "sliceId": "avatar-seed-0001",
      "mediaFamily": "avatar",
      "originType": "local_root",
      "localRoot": "quwoquan_service/contracts/metadata/_shared/test_fixtures/media",
      "publicBaseUrl": "",
      "healthState": "healthy",
      "priority": 100,
      "objectKeyTemplate": "{domain}/{assetKind}/s/{sliceId}/{ownerType}/{ownerId}/{assetId}_{variant}.{ext}"
    },
    {
      "sliceId": "image-seed-0001",
      "mediaFamily": "image",
      "originType": "local_root",
      "localRoot": "quwoquan_service/contracts/metadata/_shared/test_fixtures/media",
      "publicBaseUrl": "",
      "healthState": "healthy",
      "priority": 100,
      "objectKeyTemplate": "{domain}/{assetKind}/s/{sliceId}/{ownerType}/{ownerId}/{assetId}_{variant}.{ext}"
    },
    {
      "sliceId": "video-seed-0001",
      "mediaFamily": "video",
      "originType": "local_root",
      "localRoot": "quwoquan_service/contracts/metadata/_shared/test_fixtures/media",
      "publicBaseUrl": "",
      "healthState": "healthy",
      "priority": 100,
      "objectKeyTemplate": "{domain}/{assetKind}/s/{sliceId}/{ownerType}/{ownerId}/{assetId}_{variant}.{ext}"
    },
    {
      "sliceId": "archived-avatar",
      "mediaFamily": "avatar",
      "originType": "local_root",
      "localRoot": "quwoquan_service/contracts/metadata/_shared/test_fixtures/media",
      "publicBaseUrl": "",
      "healthState": "healthy",
      "priority": 10
    },
    {
      "sliceId": "archived-image",
      "mediaFamily": "image",
      "originType": "local_root",
      "localRoot": "quwoquan_service/contracts/metadata/_shared/test_fixtures/media",
      "publicBaseUrl": "",
      "healthState": "healthy",
      "priority": 10
    },
    {
      "sliceId": "archived-video",
      "mediaFamily": "video",
      "originType": "local_root",
      "localRoot": "quwoquan_service/contracts/metadata/_shared/test_fixtures/media",
      "publicBaseUrl": "",
      "healthState": "healthy",
      "priority": 10
    }
  ]
}
