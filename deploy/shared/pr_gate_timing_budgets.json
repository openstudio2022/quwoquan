{
  "version": 1,
  "totalBudgetSeconds": 900,
  "gates": {
    "02.service_pipeline": {
      "budgetSeconds": 180,
      "criticalPath": "prepare_release + max(build_go, build_seed_box, build_recommendation_service) + validate_deploy",
      "phaseBudgetsSeconds": {
        "prepare_release": 30,
        "build_go": 120,
        "build_seed_box": 120,
        "build_recommendation_service": 120,
        "validate_deploy": 30
      }
    },
    "03.delivery_gate": {
      "budgetSeconds": 360,
      "criticalPath": "topology_regression + max(quwoquan_service, quwoquan_app, ops_portal)",
      "phaseBudgetsSeconds": {
        "topology_regression": 60,
        "quwoquan_service": 180,
        "quwoquan_app": 300,
        "ops_portal": 180
      }
    },
    "04.pre_release_gate_pr": {
      "budgetSeconds": 180,
      "criticalPath": "gamma_environment_ready + max(assistant_api_protocol_smoke, chat_avatar_api_probe)",
      "phaseBudgetsSeconds": {
        "gamma_environment_ready": 30,
        "assistant_api_protocol_smoke": 60,
        "chat_avatar_api_probe": 90
      }
    },
    "04.pre_release_gate_full": {
      "budgetSeconds": 1500,
      "criticalPath": "gamma_package_bundle + gamma_deploy_ecs_pre + gamma_environment_ready + max(gamma_api_contract, assistant_runtime_smoke, chat_avatar_api_probe)",
      "phaseBudgetsSeconds": {
        "gamma_package_bundle": 240,
        "gamma_deploy_ecs_pre": 900,
        "gamma_environment_ready": 120,
        "gamma_api_contract": 180,
        "assistant_runtime_smoke": 180,
        "chat_avatar_api_probe": 120
      }
    },
    "04.gamma_restart_repeatable": {
      "budgetSeconds": 300,
      "criticalPath": "gamma_restart_roll + health_checks",
      "phaseBudgetsSeconds": {
        "gamma_restart_roll": 240,
        "health_checks": 60
      }
    },
    "04.gamma_rollout_repeatable": {
      "budgetSeconds": 600,
      "criticalPath": "gamma_rollout_deploy + health_checks",
      "phaseBudgetsSeconds": {
        "gamma_rollout_deploy": 540,
        "health_checks": 60
      }
    },
    "04.gamma_cold_build_repeatable": {
      "budgetSeconds": 2700,
      "criticalPath": "gamma_cold_build_deploy + health_checks",
      "phaseBudgetsSeconds": {
        "gamma_cold_build_deploy": 2640,
        "health_checks": 60
      }
    },
    "05.app_env_device_matrix_pr": {
      "budgetSeconds": 30,
      "criticalPath": "summary_only_when_self_hosted_disabled_by_default_on_pr",
      "phaseBudgetsSeconds": {
        "pr_default_skip": 30
      }
    },
    "09.gamma_full_validation": {
      "budgetSeconds": 2700,
      "criticalPath": "deploy + readiness + max(api_contract, assistant_ui_semantic_smoke, chat_avatar_api_probe) + ui_full_profile",
      "phaseBudgetsSeconds": {
        "deploy": 900,
        "gamma_environment_ready": 90,
        "gamma_api_contract": 240,
        "assistant_ui_semantic_smoke": 600,
        "chat_avatar_api_probe": 180,
        "ui_full_profile": 900
      }
    },
    "07.mainline_auto_prod": {
      "budgetSeconds": 900,
      "criticalPath": "delivery_gate + alpha_stage + beta_device_matrix + gamma_hosted + prod_initial_checks + prod_full",
      "phaseBudgetsSeconds": {
        "delivery_gate": 240,
        "alpha_stage": 60,
        "beta_device_matrix": 180,
        "gamma_hosted": 240,
        "prod_initial_checks": 90,
        "prod_full": 90
      }
    },
    "07.main_commit_to_prod": {
      "budgetSeconds": 900,
      "criticalPath": "service_pipeline_02 + mainline_auto_prod_07",
      "phaseBudgetsSeconds": {
        "service_pipeline_02": 180,
        "mainline_auto_prod_07": 720
      }
    }
  }
}
