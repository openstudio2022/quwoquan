# Unified in-project output root (runtime tasks / releases / evidence / cache).
# Canonical SSOT: quwoquan_data/scripts/core/paths.py::default_output_root().
# All runtime-phase output lives here (gitignored); only publish/** stays version-controlled.
.qwq_output/

# Retired generated roots and local-only assistant state.
.mainline-release-artifact/
quwoquan_app/assistant/
quwoquan_app/personal_assistant/
quwoquan_app/package.json
quwoquan_app/package-lock.json
quwoquan_app/figma.config.json
quwoquan_app/openspec-README.md

# Retired sandbox root; do not use it as a runtime fallback.
.qwq_sandbox/

quwoquan_service/.local_models/
quwoquan_service/.control-plane-state/
