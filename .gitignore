# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
tmp/
*.tmp
*.bak
*.log

# Build artifacts
.dart_tool/
build/
dist/
.test-dist/
*.o
*.a

# quwoquan_data command package named "build" is source code, not a build artifact.
!quwoquan_data/scripts/build/
!quwoquan_data/scripts/build/*.py

# Environment files
.env
.env.local
.env.*.local

# Node modules (if any)
node_modules/

# Python (if any)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Java (if any)
*.class
*.jar
*.war
*.ear
target/

# Logs
logs/
*.log

# Assistant reference implementations (synced from upstream, do not commit)
ref/

# quwoquan_data runtime roots
quwoquan_data/runtime/**
!quwoquan_data/runtime/
!quwoquan_data/runtime/.gitignore

# Deprecated quwoquan_data root-level runtime data directories.
# New sample data must live under quwoquan_data/tests/fixtures/.
quwoquan_data/crawl_specs/
quwoquan_data/trees/
quwoquan_data/runs/
quwoquan_data/publish/
quwoquan_data/out/
quwoquan_data/raw/
quwoquan_data/batch_plans/

# artifacts — runtime/build products (already-tracked declarative files stay)
artifacts/local-gamma/
artifacts/ecs-onebox/
artifacts/app-env-packages/
artifacts/service-env-packages/
artifacts/stackctl/
artifacts/stackctl-contract/

# quwoquan_data release artifacts are generated outputs, not source truth.
quwoquan_data/release/

# Local runtime state
state/
quwoquan_service/.local_models/

# Git worktrees
.worktrees/

