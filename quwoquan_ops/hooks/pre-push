#!/usr/bin/env bash
set -euo pipefail

# 本地 integration 发布校验 exact admission、远端身份与 expected-old 快进。
# lane 远端及 main 直推禁止；受管 system backsync 独立验真。
# 本地 hook 不等于服务端 Alpha 强制保障。
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
export QWQ_OUTPUT_ROOT="$ROOT/.qwq_output"
export PYTHONDONTWRITEBYTECODE=1

updates="$(cat)"
if [[ -z "$updates" ]]; then
  echo "[pre-push] nothing to push"
  exit 0
fi

if ! printf '%s\n' "$updates" | python3 -B quwoquan_ops/gate/verify_git_branch_policy.py --pre-push --remote-name "${1:-}" --remote-url "${2:-}"; then
  echo "[pre-push] GATE_BLOCK: branch policy rejected push updates" >&2
  exit 1
fi

echo "[pre-push] branch policy ok"
