#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
export QWQ_OUTPUT_ROOT="$ROOT/.qwq_output"
export PYTHONDONTWRITEBYTECODE=1

updates_root="$QWQ_OUTPUT_ROOT/env/repo/local/local-readiness/process/push-updates"
mkdir -p "$updates_root"
chmod 700 "$updates_root"
temporary="$(mktemp "$updates_root/incoming.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
chmod 600 "$temporary"
cat >"$temporary"
if [[ ! -s "$temporary" ]]; then
  echo "[pre-push] GATE_BLOCK: push updates 为空，无法精确绑定 release_ready" >&2
  exit 1
fi
updates_digest="$(python3 - "$temporary" <<'PYDIGEST'
import hashlib, sys
from pathlib import Path
print(hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest())
PYDIGEST
)"
updates_file="$updates_root/$updates_digest.txt"
if [[ ! -e "$updates_file" ]]; then
  mv "$temporary" "$updates_file"
  chmod 600 "$updates_file"
else
  cmp -s "$temporary" "$updates_file" || {
    echo "[pre-push] GATE_BLOCK: content-addressed push updates collision" >&2
    exit 1
  }
fi
trap - EXIT
rm -f "$temporary"

recovery="python3 quwoquan_ops/cli/local_readiness.py release --push-updates $updates_file"
if ! python3 quwoquan_ops/gate/verify_git_branch_policy.py --pre-push <"$updates_file"; then
  echo "[pre-push] RECOVER: $recovery" >&2
  exit 1
fi
if ! python3 -B quwoquan_ops/cli/local_readiness.py verify --level release --push-updates "$updates_file" >/dev/null; then
  echo "[pre-push] GATE_BLOCK: exact local sha/base has no fresh Review-terminal release_ready receipt" >&2
  echo "[pre-push] RECOVER: $recovery" >&2
  exit 1
fi

echo "[pre-push] fresh release_ready receipt accepted for exact push updates"
