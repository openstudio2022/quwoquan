#!/usr/bin/env bash
set -euo pipefail

# 本地 pre-push 只做 branch policy：普通 lane 仅推同名远端；active 的 dev1.0/main
# 禁止直推，可证明的受管 system fast-forward backsync 依 contract 放行。发布就绪回执
# 不在这里消费；lane→dev1.0 的合入由 PR 上的 CI Delivery Gate 承担。
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
export QWQ_OUTPUT_ROOT="$ROOT/.qwq_output"
export PYTHONDONTWRITEBYTECODE=1

updates="$(cat)"
if [[ -z "$updates" ]]; then
  echo "[pre-push] nothing to push"
  exit 0
fi

if ! printf '%s\n' "$updates" | python3 -B quwoquan_ops/gate/verify_git_branch_policy.py --pre-push; then
  echo "[pre-push] GATE_BLOCK: branch policy rejected push updates" >&2
  exit 1
fi

echo "[pre-push] branch policy ok"
