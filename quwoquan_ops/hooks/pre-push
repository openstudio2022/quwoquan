#!/usr/bin/env bash
set -euo pipefail

# 本地 pre-push 只做 branch policy：禁止直推 dev1.0/main 与非白名单分支——这就是准出
# 边界本身。发布就绪回执不在这里消费；lane→dev1.0 的合入由 PR 上的 CI Delivery
# Gate 承担，本地 lane 推送不背负回执。
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
export QWQ_OUTPUT_ROOT="$ROOT/.qwq_output"
export PYTHONDONTWRITEBYTECODE=1

updates="$(cat)"
if [[ -z "$updates" ]]; then
  echo "[pre-push] nothing to push"
  exit 0
fi

if ! printf '%s\n' "$updates" | python3 -B quwoquan_ops/gate/verify_git_branch_policy.py --pre-push; then
  echo "[pre-push] GATE_BLOCK: branch policy rejected push updates" >&2
  exit 1
fi

echo "[pre-push] branch policy ok"
