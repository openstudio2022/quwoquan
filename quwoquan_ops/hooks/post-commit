#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
export QWQ_OUTPUT_ROOT="${QWQ_OUTPUT_ROOT:-$ROOT/.qwq_output}"
export PYTHONDONTWRITEBYTECODE=1

# 提交后只原子标记“下次受支持的 sessionStart 到期检查”。这里不得加载 policy、
# inventory 或执行 git 扫描；任何失败均 fail-open，提交结果不受影响。
python3 quwoquan_ops/hooks/worktree_merge_reminder.py --harness git --mode mark-due || true
