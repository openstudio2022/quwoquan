#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
export QWQ_OUTPUT_ROOT="$ROOT/.qwq_output"
export PYTHONDONTWRITEBYTECODE=1

if ! git diff --cached --quiet; then
  recovery="python3 quwoquan_ops/cli/local_readiness.py scope --staged"
  if ! python3 -B quwoquan_ops/cli/local_readiness.py staged-boundary || \
     ! python3 -B quwoquan_ops/cli/local_readiness.py verify --level scope --staged >/dev/null 2>&1; then
    echo "[pre-commit] GATE_BLOCK: staged boundary or fresh Review-terminal scope_ready receipt failed" >&2
    echo "[pre-commit] RECOVER: $recovery" >&2
    exit 1
  fi
  echo "[pre-commit] fresh staged Review-terminal scope_ready receipt accepted"
fi
