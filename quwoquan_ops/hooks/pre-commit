#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
# Pin disposable-output root for the whole hook. A polluted shell export can
# otherwise redirect make/stackctl into pytest isolation dirs and fail later
# gates with incomplete report.json artifacts.
export QWQ_OUTPUT_ROOT="$ROOT/.qwq_output"
export PYTHONDONTWRITEBYTECODE=1

# L0 commit gate: parallel static + impacted tests. Never make gate / scope=all.
if ! git diff --cached --name-only | grep -q .; then
  exit 0
fi

echo "[pre-commit] running commit_gate (L0, target ≤10m)"
bash quwoquan_ops/gate/commit_gate.sh
