#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

python3 quwoquan_ops/gate/verify_git_branch_policy.py

has_service=false
has_app=false
has_data=false
has_ops=false

while IFS= read -r path; do
  case "$path" in
    quwoquan_service/*) has_service=true ;;
    quwoquan_app/*) has_app=true ;;
    quwoquan_data/*) has_data=true ;;
    quwoquan_ops/*|specs/*) has_ops=true ;;
  esac
done < <(git diff --cached --name-only)

# 跨 App/Service 或触及 Data/Ops/specs 时跑全量门禁，避免 echo|grep 漏检。
if [[ "$has_service" == true && "$has_app" == true ]] ||
  [[ "$has_data" == true ]] ||
  [[ "$has_ops" == true && ( "$has_service" == true || "$has_app" == true ) ]]; then
  echo "[pre-commit] running repo gate (cross-area)"
  make gate
elif [[ "$has_service" == true ]]; then
  echo "[pre-commit] running gate (service)"
  bash quwoquan_ops/gate/gate_repo.sh --scope service
elif [[ "$has_app" == true ]]; then
  echo "[pre-commit] running gate (app)"
  bash quwoquan_ops/gate/gate_repo.sh --scope app
elif [[ "$has_ops" == true || "$has_data" == true ]]; then
  echo "[pre-commit] running repo gate (ops/data)"
  make gate
fi
