{
  "title": "L2 — 契约对象 ready operation 覆盖",
  "uid": "qwq-l2-contract-object-coverage",
  "tags": [
    "quwoquan",
    "l2",
    "contract-graph",
    "generated"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "description": "Code generated from quwoquan_service/generated/contract_graph.json；regenerate with verify_object_alert_coverage.py --write。每域 ready operation 的可用性与 P95 由对象级 recording rule 派生。",
  "panels": [
    {
      "title": "assistant ready operation 5xx 错误率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(quwoquan_assistant_contract_operation_requests_total{service=\"assistant-service\",operation=~\"assistant\\\\..+\",contract_metric=~\"assistant_.+\",commercial_status=\"ready\",status=~\"5..\"}[5m])) by (operation, contract_metric) / clamp_min(sum(rate(quwoquan_assistant_contract_operation_requests_total{service=\"assistant-service\",operation=~\"assistant\\\\..+\",contract_metric=~\"assistant_.+\",commercial_status=\"ready\"}[5m])) by (operation, contract_metric), 0.001)",
          "legendFormat": "{{ operation }}"
        }
      ]
    },
    {
      "title": "assistant ready operation P95 延迟",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(quwoquan_assistant_contract_operation_duration_seconds_bucket{service=\"assistant-service\",operation=~\"assistant\\\\..+\",contract_metric=~\"assistant_.+\",commercial_status=\"ready\"}[5m])) by (le, operation, contract_metric, slo_latency_p95_ms))",
          "legendFormat": "{{ operation }}"
        }
      ]
    },
