{
  "title": "L2 — 推荐商用成熟度",
  "uid": "qwq-l2-recommendation-commercial",
  "tags": [
    "quwoquan",
    "l2",
    "recommendation",
    "commercial-maturity",
    "attribution"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "description": "Non-deep recommendation commercial maturity dashboard. It uses P0+ bounded attribution metrics only; offline replay, AB significance and deep ranking are out of scope.",
  "templating": {
    "list": [
      {
        "name": "channel",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(recommendation_feed_served_by_attribution_total, channel)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "vertical",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(recommendation_feed_served_by_attribution_total, vertical)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "supply_source",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(recommendation_feed_served_by_attribution_total, supply_source)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "recall_path",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(recommendation_feed_served_by_attribution_total, recall_path)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Served volume by channel and vertical",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Home, travel, premium and other feed surfaces should stay visible without relying on objective-only metrics.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_feed_served_by_attribution_total{channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (channel, vertical)",
          "legendFormat": "{{ channel }} / {{ vertical }}"
        }
      ]
    },
    {
      "title": "CTR by recall_path",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "Click is the explicit seven-state click signal, not an interaction alias.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{state=\"click\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (recall_path) / clamp_min(sum(rate(recommendation_behavior_by_attribution_total{state=\"impressed\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (recall_path), 0.001)",
          "legendFormat": "{{ recall_path }}"
        }
      ]
    },
    {
      "title": "Negative feedback rate by supply_source",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Compares UGC and data engineering supply without high-cardinality source ids.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{state=\"negative\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (supply_source) / clamp_min(sum(rate(recommendation_behavior_by_attribution_total{state=\"impressed\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (supply_source), 0.001)",
          "legendFormat": "{{ supply_source }}"
        }
      ]
    },
    {
      "title": "Unknown attribution rate",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "description": "Rises when app, service or persistence loses bounded attribution fields.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{channel=\"unknown\",recall_path=\"unknown\"}[5m])) / clamp_min(sum(rate(recommendation_behavior_by_attribution_total[5m])), 0.001)",
          "legendFormat": "unknown attribution"
        }
      ]
    },
    {
      "title": "Travel and premium consumption",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "description": "Focuses on the two P0 scenario routes: travel vertical and premium stream.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{state=~\"click|dwell\",channel=~\"travel|premium_stream\",vertical=~\"travel_photography|premium\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (channel, recall_path)",
          "legendFormat": "{{ channel }} / {{ recall_path }}"
        }
      ]
    },
    {
      "title": "Intersection fact vs affinity CTR",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "description": "Fact intersection should be evaluated separately from affinity explanations.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{state=\"click\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\",intersection_class=~\"fact|affinity\"}[5m])) by (intersection_class) / clamp_min(sum(rate(recommendation_behavior_by_attribution_total{state=\"impressed\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\",intersection_class=~\"fact|affinity\"}[5m])) by (intersection_class), 0.001)",
          "legendFormat": "{{ intersection_class }}"
        }
      ]
    },
    {
      "title": "Policy digest CTR",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "description": "Attributes click-through changes to the exact canonical recommendation policy digest.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{state=\"click\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\",policy_digest!=\"unknown\"}[5m])) by (policy_digest) / clamp_min(sum(rate(recommendation_behavior_by_attribution_total{state=\"impressed\",channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\",policy_digest!=\"unknown\"}[5m])) by (policy_digest), 0.001)",
          "legendFormat": "{{ policy_digest }}"
        }
      ]
    },
    {
      "title": "Served share by supply_source",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "description": "Tracks UGC versus data engineering supply share after quality and eligibility gates.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_feed_served_by_attribution_total{channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])) by (supply_source) / clamp_min(sum(rate(recommendation_feed_served_by_attribution_total{channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\"}[5m])), 0.001)",
          "legendFormat": "{{ supply_source }}"
        }
      ]
    },
    {
      "title": "Policy digest served mix",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "description": "Separates traffic by the exact canonical recommendation policy digest before AB significance is available.",
      "targets": [
        {
          "expr": "sum(rate(recommendation_feed_served_by_attribution_total{channel=~\"$channel\",vertical=~\"$vertical\",supply_source=~\"$supply_source\",recall_path=~\"$recall_path\",policy_digest!=\"unknown\"}[5m])) by (policy_digest)",
          "legendFormat": "{{ policy_digest }}"
        }
      ]
    },
    {
      "title": "Seven-state funnel (served → negative)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "N1-3 七态漏斗：served/visible/impressed/click/dwell/interaction/negative 每秒速率。漏斗断层（如 served 高但 impressed 低）指向下发浪费或可见性问题。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(recommendation_feed_served_total[10m]))",
          "legendFormat": "served"
        },
        {
          "expr": "sum(rate(recommendation_feed_visible_total[10m]))",
          "legendFormat": "visible"
        },
        {
          "expr": "sum(rate(recommendation_feed_impressed_total[10m]))",
          "legendFormat": "impressed"
        },
        {
          "expr": "sum(rate(recommendation_feed_click_total[10m]))",
          "legendFormat": "click"
        },
        {
          "expr": "sum(rate(recommendation_feed_dwell_total[10m]))",
          "legendFormat": "dwell"
        },
        {
          "expr": "sum(rate(recommendation_feed_interaction_total[10m]))",
          "legendFormat": "interaction"
        },
        {
          "expr": "sum(rate(recommendation_feed_negative_feedback_total[10m]))",
          "legendFormat": "negative"
        }
      ]
    },
    {
      "title": "AB experiment: bucket CTR and admission validity",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "N1-3 AB 闭环：experiment_bucket 维度的行为 CTR（click/impressed）与 AB 准入有效率（valid / total，来自每小时 ABAdmissionRunner）。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(rate(recommendation_behavior_by_attribution_total{state=\"click\"}[30m])) by (experiment_bucket) / clamp_min(sum(rate(recommendation_behavior_by_attribution_total{state=\"impressed\"}[30m])) by (experiment_bucket), 0.001)",
          "legendFormat": "ctr {{experiment_bucket}}"
        },
        {
          "expr": "sum(rate(recommendation_feed_ab_experiment_validity_total{result=\"valid\"}[6h])) by (experiment) / clamp_min(sum(rate(recommendation_feed_ab_experiment_validity_total[6h])) by (experiment), 0.001)",
          "legendFormat": "validity {{experiment}}"
        }
      ]
    },
    {
      "title": "Feed terminal outcome by request class, empty reason and failure stage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "Shows success, degraded, empty and failure terminal rates for initial discovery and premium requests without hiding dependency stages behind HTTP 200 empty responses.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(rate(recommendation_feed_terminal_total[5m])) by (request_class, outcome, empty_reason, failure_stage)",
          "legendFormat": "{{ request_class }} / {{ outcome }} / {{ empty_reason }} / {{ failure_stage }}"
        }
      ]
    },
    {
      "title": "Feed delivery-page failure and atomic admission",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "Stable previous-page replay is available only when immutable append/load and same-slot quota admission remain healthy.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum(rate(content_feed_delivery_page_total{result=~\"store_unavailable|atomic_unavailable|payload_rejected|conflict|error|invalid|invalid_quota_policy|shard_key_rejected|shard_byte_rejected|repair_bound_rejected\"}[5m])) / clamp_min(sum(rate(content_feed_delivery_page_total[5m])), 0.001)",
          "legendFormat": "failure rate"
        },
        {
          "expr": "sum(rate(content_feed_delivery_page_total{operation=\"append\",result=\"atomic_unavailable\"}[5m]))",
          "legendFormat": "atomic unavailable"
        }
      ]
    },
    {
      "title": "Feed delivery-page payload and scope pressure",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "P99 uncompressed payload stays below 64 KiB; quota evictions expose scopes reaching the 8 active windows x 50-page depth budget.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(content_feed_delivery_page_payload_bytes_bucket[5m])) by (le))",
          "legendFormat": "payload p99 bytes"
        },
        {
          "expr": "sum(rate(content_feed_delivery_page_quota_evictions_total[5m]))",
          "legendFormat": "scope evictions / s"
        }
      ]
    },
    {
      "title": "Immutable feed global quota admission",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "Separates owner eviction from fixed-shard key, byte and repair-bound rejection. Rejection never evicts another subject/scope.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "expr": "sum(rate(recommendation_ranked_feed_window_create_total{result=~\"shard_key_rejected|shard_byte_rejected|repair_bound_rejected\"}[5m])) by (result)",
          "legendFormat": "ranked window {{ result }}"
        },
        {
          "expr": "sum(rate(content_feed_delivery_page_total{operation=\"append\",result=~\"shard_key_rejected|shard_byte_rejected|repair_bound_rejected\"}[5m])) by (result)",
          "legendFormat": "delivery page {{ result }}"
        },
        {
          "expr": "sum(rate(recommendation_ranked_feed_window_quota_evictions_total[5m]))",
          "legendFormat": "ranked owner eviction"
        },
        {
          "expr": "sum(rate(content_feed_delivery_page_quota_evictions_total[5m]))",
          "legendFormat": "delivery owner eviction"
        }
      ]
    },
    {
      "title": "Immutable feed quota-shard utilization",
      "type": "timeseries",
      "datasource": "Prometheus",
      "description": "P99 touched-shard utilization against configured repository defaults. Environment capacity/readback remains a deployment acceptance gate.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(recommendation_ranked_feed_window_shard_live_records_bucket[5m])) by (le)) / 128",
          "legendFormat": "ranked key utilization"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(recommendation_ranked_feed_window_shard_live_bytes_bucket[5m])) by (le)) / 134217728",
          "legendFormat": "ranked byte utilization"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(content_feed_delivery_page_shard_live_records_bucket[5m])) by (le)) / 512",
          "legendFormat": "delivery key utilization"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(content_feed_delivery_page_shard_live_bytes_bucket[5m])) by (le)) / 33554432",
          "legendFormat": "delivery byte utilization"
        }
      ]
    }
  ]
}
