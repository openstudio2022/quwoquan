{
  "title": "L2 — 内容飞轮大循环",
  "uid": "qwq-l2-flywheel",
  "tags": [
    "quwoquan",
    "l2",
    "flywheel",
    "recommendation"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "description": "行为反馈 → user 域兴趣投影(rm_user_profile_view) → 引擎按 policy×segment 归因 → 曝光/点击反馈。画像重算生产端（content 侧 UserInterestRecomputed 发布与 recompute/entropy/segment 指标）尚未实现，对应面板待生产端落地后按真实 emitter 恢复；与 quwoquan_service/scripts/product-ops-service/tools/eval_content_flywheel_loop.py 的数据面闭环实证互补。",
  "panels": [
    {
      "title": "① user 域兴趣投影吞吐（result）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "user-service InterestProfileProjector 消费 UserInterestRecomputed 写 rm_user_profile_view；parse_error/write_error 速率即 CQRS 投影故障率。上游生产端未落地时本面板长期无样本属预期。",
      "targets": [
        {
          "expr": "sum(rate(quwoquan_interest_projection_total[5m])) by (result)",
          "legendFormat": "{{ result }}"
        }
      ]
    },
    {
      "title": "① 投影新鲜度滞后（P95/P99 秒）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "画像 recomputedAt 到投影落库 apply 的滞后；高位说明事件积压，对外画像 API 读到陈旧数据。",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(quwoquan_interest_projection_freshness_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(quwoquan_interest_projection_freshness_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "② 引擎按 policy × segment 归因 QPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "description": "每个被服务请求归因到其生效的 policyDigest 与人群 segment（rec.pipeline.requests_by_policy_total）；这是策略元数据化 + 人群定向真正生效到引擎的端到端证据。",
      "targets": [
        {
          "expr": "sum(rate(rec_pipeline_requests_by_policy_total[5m])) by (policy_digest, segment)",
          "legendFormat": "{{ policy_digest }} / {{ segment }}"
        }
      ]
    },
    {
      "title": "② 模型 vs 规则命中（闭环健康）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "description": "model_hits 占比走低、rule_hits 抬升说明模型路径退化，飞轮反馈未有效驱动模型。",
      "targets": [
        {
          "expr": "sum(rate(rec_pipeline_model_hits_total[5m]))",
          "legendFormat": "model"
        },
        {
          "expr": "sum(rate(rec_pipeline_rule_hits_total[5m]))",
          "legendFormat": "rule"
        }
      ]
    },
    {
      "title": "② 推荐空 Feed 率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "description": "empty_results / requests；空 feed 率上升直接拉断飞轮（无内容可消费即无反馈）。",
      "targets": [
        {
          "expr": "sum(rate(rec_pipeline_empty_results_total[5m])) / (sum(rate(rec_pipeline_requests_total[5m])) + 0.001)",
          "legendFormat": "空Feed率"
        }
      ]
    },
    {
      "title": "③ 互动: 曝光 / 点击（CTR 反馈燃料）",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "description": "推荐产出被消费的反馈源头（content-service 七态漏斗真实计数器）；曝光/点击即下一轮行为 → 特征 → 画像的燃料。CTR = engagement{action=click} / impressed。",
      "targets": [
        {
          "expr": "sum(rate(recommendation_feed_impressed_total[5m]))",
          "legendFormat": "曝光"
        },
        {
          "expr": "sum(rate(recommendation_feed_engagement_total{action=\"click\"}[5m]))",
          "legendFormat": "点击"
        },
        {
          "expr": "sum(rate(recommendation_feed_engagement_total{action=\"click\"}[5m])) / (sum(rate(recommendation_feed_impressed_total[5m])) + 0.001)",
          "legendFormat": "CTR"
        }
      ]
    }
  ]
}
