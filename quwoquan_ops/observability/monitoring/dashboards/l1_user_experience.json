{
  "dashboard": {
    "title": "L1 — 用户体验与运营指标",
    "uid": "qwq-l1-ux",
    "tags": ["quwoquan", "l1", "user-experience"],
    "timezone": "browser",
    "refresh": "1m",
    "panels": [
      {
        "title": "页面打开量 (OpsEvent page_open)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "description": "来源: OpsEvent eventName=page_open，按 pageName 聚合",
        "targets": [
          {
            "expr": "sum(rate(ops_events_total{event_name=\"page_open\"}[5m])) by (page_name)",
            "legendFormat": "{{ page_name }}"
          }
        ]
      },
      {
        "title": "页面停留时长 (OpsEvent page_return durationMs)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "description": "来源: OpsEvent eventName=page_return，按 pageName P50/P95",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(ops_event_metrics_bucket{event_name=\"page_return\",metric=\"durationMs\"}[5m])) by (le, page_name))",
            "legendFormat": "P95 {{ page_name }}"
          }
        ]
      },
      {
        "title": "端侧 API 延迟 (从 AppLog api_latency)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "description": "由 cloudHttpClientProvider ApiLatencyObserver 写入 AppLog → OpsEvent 上传",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(app_api_latency_ms_bucket[5m])) by (le, path))",
            "legendFormat": "P95 {{ path }}"
          }
        ]
      },
      {
        "title": "用户行为漏斗 (impression → click → deep_engage)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(rec_engagement_impression_total[5m]))",
            "legendFormat": "曝光"
          },
          {
            "expr": "sum(rate(rec_engagement_click_total[5m]))",
            "legendFormat": "点击"
          },
          {
            "expr": "sum(rate(rec_engagement_deep_engage_total[5m]))",
            "legendFormat": "深度互动"
          }
        ]
      },
      {
        "title": "启动 Shell 首帧 P50/P95",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "description": "startup_welcome_sequence shellFirstPaintMs；正常目标 3s",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(ops_event_metrics_bucket{event_name=\"startup_welcome_sequence\",metric=\"shellFirstPaintMs\"}[10m])) by (le, platform))",
            "legendFormat": "P50 {{ platform }}"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(ops_event_metrics_bucket{event_name=\"startup_welcome_sequence\",metric=\"shellFirstPaintMs\"}[10m])) by (le, platform))",
            "legendFormat": "P95 {{ platform }}"
          }
        ]
      },
      {
        "title": "欢迎退出/移除 P95 与 6s 硬门",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(ops_event_metrics_bucket{event_name=\"startup_welcome_sequence\",metric=\"welcomeExitMs\"}[10m])) by (le, platform))",
            "legendFormat": "退出 P95 {{ platform }}"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(ops_event_metrics_bucket{event_name=\"startup_welcome_sequence\",metric=\"overlayRemovedMs\"}[10m])) by (le, platform))",
            "legendFormat": "移除 P95 {{ platform }}"
          }
        ]
      },
      {
        "title": "启动重放与降级比例",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "sum(rate(ops_events_total{event_name=\"startup_welcome_sequence\",phase=\"finished\"}[10m])) by (replay_count, exit_reason, platform)",
            "legendFormat": "{{ platform }} replay={{ replay_count }} {{ exit_reason }}"
          }
        ]
      },
      {
        "title": "欢迎动效 Build/Raster P95",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(ops_event_metrics_bucket{event_name=\"startup_welcome_sequence\",metric=~\"buildFrameP95Ms|rasterFrameP95Ms\"}[10m])) by (le, metric, platform))",
            "legendFormat": "{{ platform }} {{ metric }}"
          }
        ]
      }
    ]
  }
}
