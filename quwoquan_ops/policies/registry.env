# 四环境共享的 registry 与基础镜像默认值。
# Dockerfiles 禁止 ARG 默认值；stackctl 从 runtime.yaml 注入 GO/ALPINE，
# 数据面 Compose 回退值与本文件保持同一 tag。
QWQ_REGISTRY_MIRROR_HOSTS=docker.m.daocloud.io,docker.nju.edu.cn,docker.mirrors.sjtug.sjtu.edu.cn
QWQ_GO_BASE_IMAGE=golang:1.24-bookworm
QWQ_ALPINE_BASE_IMAGE=alpine:3.21
QWQ_ALPINE_PROD_BASE_IMAGE=alpine:3.22
QWQ_PYTHON_BASE_IMAGE=python:3.11-slim-bookworm
QWQ_POSTGRES_IMAGE=postgres:16-alpine
QWQ_MONGO_IMAGE=mongo:7-jammy
QWQ_REDIS_IMAGE=redis:7.2-alpine
QWQ_CADDY_IMAGE=caddy:2.8.4-alpine
QWQ_MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
QWQ_MINIO_MC_IMAGE=minio/mc:RELEASE.2025-03-12T17-29-24Z
