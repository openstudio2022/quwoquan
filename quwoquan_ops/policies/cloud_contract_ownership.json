{
  "leaseRoot": ".qwq_output/env/repo/local/control-plane/process/app-cloud-handoff/leases",
  "resources": [
    {
      "id": "contract-graph-source",
      "owner": "business-object-analysis",
      "writePaths": [
        "quwoquan_service/contracts/metadata/**",
        "quwoquan_service/internal/metadata/ast/**",
        "quwoquan_service/internal/metadata/graph/**",
        "quwoquan_service/internal/metadata/validate/**"
      ],
      "consumers": [
        "contract-graph-compiler"
      ]
    },
    {
      "id": "contract-graph-bundle",
      "owner": "business-object-analysis",
      "writePaths": [
        "quwoquan_service/generated/contract_graph.json"
      ],
      "consumers": [
        "app-cloud-handoff"
      ]
    },
    {
      "id": "app-cloud-handoff",
      "owner": "app-cloud-governance",
      "writePaths": [
        "quwoquan_app/tool/cloud_codegen/contract_graph.lock.json",
        "quwoquan_app/tool/cloud_codegen/contract_graph.breaking.json"
      ],
      "consumers": [
        "app-only-emitter"
      ]
    },
    {
      "id": "app-generated-output",
      "owner": "app-only-emitter",
      "writePaths": [
        "quwoquan_app/lib/service/assistant_service/assistant/assistant_preference/domain/generated/**",
        "quwoquan_app/lib/service/assistant_service/assistant/assistant_run/domain/generated/**",
        "quwoquan_app/lib/service/assistant_service/assistant/assistant_turn_view/domain/generated/**",
        "quwoquan_app/lib/service/circle_service/circle_management/circle/presentation/generated/**",
        "quwoquan_app/lib/service/content_service/content/post/application/generated/**",
        "quwoquan_app/lib/service/content_service/content/post/domain/generated/**",
        "quwoquan_app/lib/service/content_service/content/post/presentation/generated/**",
        "quwoquan_app/lib/service/content_service/media/media_asset/application/generated/**",
        "quwoquan_app/lib/service/content_service/media/media_upload_session/application/generated/**",
        "quwoquan_app/lib/service/entity_service/entity_homepage/homepage/presentation/generated/**",
        "quwoquan_app/lib/service/recommendation_service/recommendation/recommendation_feature_profile_view/application/generated/**",
        "quwoquan_app/lib/service/recommendation_service/recommendation/recommendation_feature_profile_view/presentation/generated/**",
        "quwoquan_app/lib/runtime/errors/generated/**",
        "quwoquan_app/lib/runtime/observability/generated/app_telemetry_catalog.g.dart",
        "quwoquan_app/lib/runtime/transport/generated/**",
        "quwoquan_app/lib/service/search_service/search/search_index_view/application/generated/**",
        "quwoquan_app/lib/service/search_service/search/search_index_view/presentation/generated/**",
        "quwoquan_app/lib/service/user_service/account/user_account/application/public/generated/**",
        "quwoquan_app/lib/runtime/transport/generated/cloud_api_defaults.g.dart",
        "quwoquan_app/lib/service/content_service/content/post/adapters/generated/article_detail_wire_keys.g.dart",
        "quwoquan_app/lib/service/content_service/content/post/application/generated/content_metadata.g.dart",
        "quwoquan_app/lib/service/content_service/content/post/adapters/generated/content_post_immersive_wire_keys.g.dart",
        "quwoquan_app/lib/service/recommendation_service/recommendation/recommendation_feature_profile_view/presentation/generated/impact_help_type_metadata.g.dart",
        "quwoquan_app/lib/service/recommendation_service/recommendation/recommendation_feature_profile_view/presentation/generated/intersection_display_metadata.g.dart",
        "quwoquan_app/lib/service/search_service/search/search_index_view/application/generated/search_contract.g.dart",
        "quwoquan_app/lib/service/search_service/search/search_index_view/application/generated/search_registry.g.dart",
        "quwoquan_app/lib/service/content_service/content/post/presentation/generated/content_ui_config.g.dart",
        "quwoquan_app/packages/quwoquan_cloud_contracts/lib/src/generated/**",
        "quwoquan_app/packages/quwoquan_cloud_contracts/lib/src/*/*_operation_contracts.g.dart",
        "quwoquan_app/packages/quwoquan_cloud_contracts/lib/src/content/preview_track_manifest_contracts.g.dart",
        "quwoquan_app/packages/quwoquan_cloud_contracts/lib/src/rtc/**",
        "quwoquan_app/packages/quwoquan_cloud_contracts/lib/generated/**",
        "quwoquan_app/tool/cloud_codegen/generated_manifest.json"
      ],
      "consumers": [
        "app-production-composition"
      ]
    },
    {
      "id": "app-shell-navigation-generated-output",
      "owner": "app-shell-navigation-emitter",
      "writePaths": [
        "quwoquan_app/lib/runtime/shell/navigation/generated/**",
        "quwoquan_app/tool/shell_navigation_codegen/generated_manifest.json"
      ],
      "consumers": [
        "app-production-composition"
      ]
    },
    {
      "id": "runtime-observability-catalog-output",
      "owner": "observability-catalog-emitter",
      "writePaths": [
        "quwoquan_service/runtime/observability/catalog_generated.go",
        "quwoquan_app/lib/runtime/observability/generated/runtime_log_catalog.g.dart",
        "quwoquan_ops/cli/lib/generated/runtime_log_catalog.py",
        "quwoquan_data/scripts/core/generated/runtime_log_catalog.py",
        "quwoquan_ops/portal/src/generated/observability/runtimeLogCatalog.generated.ts"
      ],
      "consumers": [
        "runtime-observability"
      ]
    },
    {
      "id": "shared-topology",
      "owner": "environment-ops",
      "writePaths": [
        "quwoquan_ops/environments/*.yaml"
      ],
      "consumers": [
        "stackctl",
        "service-layout-governance"
      ]
    }
  ],
  "consumerImportDag": [
    [
      "contract-graph-source",
      "contract-graph-bundle"
    ],
    [
      "contract-graph-bundle",
      "app-cloud-handoff"
    ],
    [
      "app-cloud-handoff",
      "app-generated-output"
    ],
    [
      "app-generated-output",
      "app-production-composition"
    ],
    [
      "contract-graph-source",
      "app-shell-navigation-generated-output"
    ],
    [
      "app-shell-navigation-generated-output",
      "app-production-composition"
    ]
  ],
  "forbiddenEdges": [
    [
      "app-cloud-governance",
      "contract-graph-source"
    ],
    [
      "app-only-emitter",
      "contract-graph-source"
    ]
  ],
  "schema": "1"
}
