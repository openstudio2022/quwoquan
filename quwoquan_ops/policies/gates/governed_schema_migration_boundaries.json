        "release/legacy_release_cohort_v1.schema.json",
        "release/legacy_content_pool_handoff_query_v1.schema.json"
      ],
      "evidence_schema": "release/legacy_source_repository_evidence.schema.json",
      "lineage_schema": "release/legacy_release_repackage_lineage.schema.json",
      "output_schemas": [
        "release/release_cohort.schema.json",
        "release/producer_release_handoff.schema.json"
      ],
      "current_builder": "content.release.canonical.aggregate_release.build_pool_release",
      "current_writer": "content.release.canonical.producer_release_handoff.write_producer_release_handoff",
      "current_reader": "content.release.canonical.producer_release_handoff.read_producer_release_handoff"
    }
  ]
