    "expires_when": "已批准旧输入迁移终止且对应 command、handler 与旧输入闭包原子退役时删除边界声明。"
  },
  "boundaries": [
    {
      "spec_ref": "specs/feature-tree/discovery-content/object-homepage-coverage-scaling/multi-carrier-release/spec.md#req-030",
      "cli": "quwoquan_data/scripts/cli.py",
      "command": "release",
      "subcommand": "repackage-legacy",
      "registration": "quwoquan_data/scripts/content/release/canonical/handler_cli.py",
      "register_function": "register_parser",
      "handler": "quwoquan_data/scripts/content/release/canonical/handler.py",
      "handler_function": "handle_repackage_legacy",
      "governed_call": "content.coordination.runtime.governed_repackage_call",
      "authority_verifier": "content.coordination.authority.verify_authority_artifact",
      "authority_purpose": "legacy-source-repository-seal",
      "input_error_codes": ["DATA.RELEASE.REPACKAGE.LEGACY_SCHEMA_UNSUPPORTED", "DATA.RELEASE.REPACKAGE.LEGACY_SCHEMA_INVALID"],
      "implementation": "quwoquan_data/scripts/content/release/canonical/legacy_release_repackage.py",
      "freeze_function": "freeze_legacy_source",
