{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/quwoquan_ops/environments/evidence/environment_acceptance_fact.schema.json",
  "title": "EnvironmentAcceptanceFact v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "factId",
        "environment",
        "profile",
        "status",
        "candidate",
        "impactPlanDigest",
        "caseResultRefs",
        "runtimeIdentity",
        "dataLifecycle",
        "providerReadiness",
        "observabilityReadiness",
        "inspectEvidence",
        "doctorEvidence",
        "cleanupEvidence",
        "leaseClosureEvidence",
        "predecessor",
        "expiresAt",
        "nonPromotable",
        "issuedAt",
        "signer"
      ],
      "properties": {
        "schema": {
          "const": "quwoquan_ops.environment_acceptance_fact.v2"
        },
        "factId": {
          "$ref": "#/$defs/digest"
        },
        "environment": {
          "enum": [
            "alpha",
            "beta",
            "gamma"
          ]
        },
        "profile": {
          "enum": [
            "smoke",
            "integration",
            "release"
          ]
        },
        "status": {
          "const": "passed"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "impactPlanDigest": {
          "$ref": "#/$defs/digest"
        },
        "caseResultRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactRef"
          }
        },
        "runtimeIdentity": {
          "$ref": "#/$defs/exactRef"
        },
        "dataLifecycle": {
          "$ref": "#/$defs/exactRef"
        },
        "providerReadiness": {
          "$ref": "#/$defs/exactRef"
        },
        "observabilityReadiness": {
          "$ref": "#/$defs/exactRef"
        },
        "inspectEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "doctorEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "cleanupEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "leaseClosureEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "predecessor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exactRef"
            }
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "nonPromotable": {
          "type": "boolean"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signer": {
          "$ref": "#/$defs/signer"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "factId",
        "environment",
        "profile",
        "status",
        "candidate",
        "impactPlanDigest",
        "caseResultRefs",
        "runtimeIdentity",
        "dataLifecycle",
        "providerReadiness",
        "observabilityReadiness",
        "inspectEvidence",
        "doctorEvidence",
        "cleanupEvidence",
        "leaseClosureEvidence",
        "predecessor",
        "expiresAt",
        "nonPromotable",
        "issuedAt",
        "signer",
        "reasonCode"
      ],
      "properties": {
        "schema": {
          "const": "quwoquan_ops.environment_acceptance_fact.v2"
        },
        "factId": {
          "$ref": "#/$defs/digest"
        },
        "environment": {
          "const": "beta"
        },
        "profile": {
          "enum": [
            "smoke",
            "integration",
            "release"
          ]
        },
        "status": {
          "const": "not_required"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "impactPlanDigest": {
          "$ref": "#/$defs/digest"
        },
        "caseResultRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactRef"
          }
        },
        "runtimeIdentity": {
          "$ref": "#/$defs/exactRef"
        },
        "dataLifecycle": {
          "$ref": "#/$defs/exactRef"
        },
        "providerReadiness": {
          "$ref": "#/$defs/exactRef"
        },
        "observabilityReadiness": {
          "$ref": "#/$defs/exactRef"
        },
        "inspectEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "doctorEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "cleanupEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "leaseClosureEvidence": {
          "$ref": "#/$defs/exactRef"
        },
        "predecessor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exactRef"
            }
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "nonPromotable": {
          "type": "boolean"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signer": {
          "$ref": "#/$defs/signer"
        },
        "reasonCode": {
          "const": "IMPACT_PLAN.NO_LIVE_ENVIRONMENT_REQUIRED"
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*(?:^|/)latest(?:[./]|$)).+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "commit",
        "tree"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/digest"
        },
        "commit": {
          "$ref": "#/$defs/gitOid"
        },
        "tree": {
          "$ref": "#/$defs/gitOid"
        }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "payloadType",
        "payload",
        "signature"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "payloadType": {
          "const": "application/vnd.quwoquan.environment-acceptance-fact.v2+json"
        },
        "payload": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
