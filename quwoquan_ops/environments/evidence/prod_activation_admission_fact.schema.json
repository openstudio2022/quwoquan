{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/quwoquan_ops/environments/evidence/prod_activation_admission_fact.schema.json",
  "title": "ProdActivationAdmissionFact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admissionId",
    "decision",
    "stableTag",
    "tagObjectOid",
    "sourceGitSha",
    "sourceTree",
    "controlPlaneGitSha",
    "releaseTagAdmission",
    "qualification",
    "candidateMaterialManifest",
    "factoryMaterials",
    "deliveryTargets",
    "prior",
    "artifacts",
    "ociDigests",
    "createdBeforeStage",
    "admittedAt"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_ops.prod_activation_admission_fact.v1"
    },
    "admissionId": {
      "$ref": "#/$defs/digest"
    },
    "decision": {
      "const": "admitted"
    },
    "stableTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tagObjectOid": {
      "$ref": "#/$defs/git"
    },
    "sourceGitSha": {
      "$ref": "#/$defs/git"
    },
    "controlPlaneGitSha": {
      "$ref": "#/$defs/git"
    },
    "releaseTagAdmission": {
      "$ref": "#/$defs/exactRef"
    },
    "qualification": {
      "$ref": "#/$defs/exactRef"
    },
    "candidateMaterialManifest": {
      "$ref": "#/$defs/exactRef"
    },
    "prior": {
      "$ref": "#/$defs/prior"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "ociDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "createdBeforeStage": {
      "const": "canary"
    },
    "admittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceTree": {
      "$ref": "#/$defs/tree"
    },
    "deliveryTargets": {
      "enum": [
        [
          "service"
        ],
        [
          "app",
          "service"
        ]
      ]
    },
    "factoryMaterials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "web"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/factoryMaterial"
        },
        "web": {
          "$ref": "#/$defs/factoryMaterial"
        },
        "app": {
          "$ref": "#/$defs/factoryMaterial"
        }
      }
    }
  },
  "$defs": {
    "initialHumanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "environment",
        "deliveryTargets",
        "stableAdmission",
        "candidateMaterialManifest",
        "serviceMaterial",
        "webMaterial",
        "inventoryDigest",
        "absenceProof",
        "attemptId",
        "recoveryResources",
        "actions",
        "candidateDigest",
        "observationDigest",
        "executionOwner",
        "executionGeneration",
        "releaseGeneration",
        "recoveryEffects"
      ],
      "properties": {
        "target": {
          "const": "prod-hosted"
        },
        "environment": {
          "const": "prod"
        },
        "deliveryTargets": {
          "enum": [
            [
              "service"
            ],
            [
              "app",
              "service"
            ]
          ]
        },
        "stableAdmission": {
          "$ref": "#/$defs/exactRef"
        },
        "candidateMaterialManifest": {
          "$ref": "#/$defs/exactRef"
        },
        "serviceMaterial": {
          "$ref": "#/$defs/exactRef"
        },
        "webMaterial": {
          "$ref": "#/$defs/exactRef"
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "absenceProof": {
          "$ref": "#/$defs/exactRef"
        },
        "attemptId": {
          "$ref": "#/$defs/digest"
        },
        "recoveryResources": {
          "$ref": "#/$defs/exactRef"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidateDigest": {
          "$ref": "#/$defs/digest"
        },
        "observationDigest": {
          "$ref": "#/$defs/digest"
        },
        "executionOwner": {
          "type": "string",
          "minLength": 1
        },
        "executionGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "releaseGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryEffects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "target",
            "environment",
            "previousReleased",
            "rollbackReadiness",
            "expectedGeneration",
            "ociDigests"
          ],
          "properties": {
            "state": {
              "const": "present"
            },
            "target": {
              "const": "prod-hosted"
            },
            "environment": {
              "const": "prod"
            },
            "previousReleased": {
              "$ref": "#/$defs/exactRef"
            },
            "rollbackReadiness": {
              "$ref": "#/$defs/exactRef"
            },
            "expectedGeneration": {
              "type": "integer",
              "minimum": 1
            },
            "ociDigests": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "target",
            "environment",
            "expectedGeneration",
            "executionOwner",
            "executionGeneration",
            "attemptId",
            "observationDigest",
            "inventoryObservation",
            "ledgerHistoryObservation",
            "routeObservation",
            "unitObservation",
            "autoRestartObservation",
            "inflightObservation",
            "humanAuthority",
            "humanBindingDigest",
            "recoveryResources"
          ],
          "properties": {
            "state": {
              "const": "absent"
            },
            "target": {
              "const": "prod-hosted"
            },
            "environment": {
              "const": "prod"
            },
            "expectedGeneration": {
              "type": "integer",
              "minimum": 0
            },
            "executionOwner": {
              "type": "string",
              "minLength": 1
            },
            "executionGeneration": {
              "type": "integer",
              "minimum": 1
            },
            "attemptId": {
              "$ref": "#/$defs/digest"
            },
            "observationDigest": {
              "$ref": "#/$defs/digest"
            },
            "inventoryObservation": {
              "$ref": "#/$defs/exactRef"
            },
            "ledgerHistoryObservation": {
              "$ref": "#/$defs/exactRef"
            },
            "routeObservation": {
              "$ref": "#/$defs/exactRef"
            },
            "unitObservation": {
              "$ref": "#/$defs/exactRef"
            },
            "autoRestartObservation": {
              "$ref": "#/$defs/exactRef"
            },
            "inflightObservation": {
              "$ref": "#/$defs/exactRef"
            },
            "humanAuthority": {
              "$ref": "#/$defs/exactRef"
            },
            "recoveryResources": {
              "$ref": "#/$defs/exactRef"
            },
            "humanBindingDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "ociRef",
        "digest"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "ociRef": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "tree": {
      "type": "string",
      "pattern": "^(?:sha1:)?[0-9a-f]{40}$|^(?:sha256:)?[0-9a-f]{64}$"
    },
    "factoryMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ociRef",
        "ociDigest",
        "payloadDigest",
        "materialDigest"
      ],
      "properties": {
        "ociRef": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "ociDigest": {
          "$ref": "#/$defs/digest"
        },
        "payloadDigest": {
          "$ref": "#/$defs/digest"
        },
        "materialDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
