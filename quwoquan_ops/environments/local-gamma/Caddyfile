{
	admin 0.0.0.0:2019
	local_certs
}

(local_gamma_tls) {
	tls internal
}

(media_cors) {
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "*"
		Cross-Origin-Resource-Policy "cross-origin"
	}
}

# Ops owns the single immutable local-gamma route table. Compose mounts this
# file directly; runtime output contains evidence and process state only.
https://gamma-api.quwoquan-env.test:{$LOCAL_GAMMA_HTTP_PORT:19000},
https://gamma-api.localhost:{$LOCAL_GAMMA_HTTP_PORT:19000},
https://localhost:{$LOCAL_GAMMA_HTTP_PORT:19000} {
	import local_gamma_tls
	handle /healthz {
		reverse_proxy content-service:18080
	}
	handle /config/app {
		reverse_proxy content-service:18080
	}
	handle /livez {
		reverse_proxy content-service:18080
	}
	handle /startupz {
		reverse_proxy content-service:18080
	}
	@api_content path /content*
	handle @api_content {
		reverse_proxy content-service:18080
	}
	@api_chat path /chat*
	handle @api_chat {
		reverse_proxy chat-service:18081
	}
	@api_user path /auth* /owner* /user* /me /me/*
	handle @api_user {
		reverse_proxy user-service:18082
	}
	@api_assistant path /assistant*
	handle @api_assistant {
		reverse_proxy assistant-service:18087
	}
	@api_notification path /app-messages /app-messages/*
	handle @api_notification {
		reverse_proxy notification-service:18087
	}
	@api_tag path /tag*
	handle @api_tag {
		reverse_proxy tag-service:18092
	}
	@api_search path /search*
	handle @api_search {
		reverse_proxy search-service:18095
	}
	@api_entity path /homepages*
	handle @api_entity {
		reverse_proxy entity-service:18084
	}
	@api_circle path /circles*
	handle @api_circle {
		reverse_proxy circle-service:18082
	}
	@api_rtc path /rtc*
	handle @api_rtc {
		reverse_proxy rtc-service:18083
	}
	@api_realtime path /realtime* /config/realtime
	handle @api_realtime {
		reverse_proxy realtime-gateway:18090
	}
	handle /ops/* {
		reverse_proxy product-ops-service:18086
	}
	handle /legal/manifest.json {
		header {
			Cache-Control "public, max-age=300"
			X-Content-Type-Options "nosniff"
		}
		root * /srv/legal
		file_server
	}
	handle /legal/* {
		header {
			Cache-Control "public, max-age=300"
			X-Content-Type-Options "nosniff"
			Content-Type "text/html; charset=utf-8"
		}
		root * /srv/legal
		file_server
	}
	handle /media/* {
		import media_cors
		root * /srv/media
		file_server
	}
	handle {
		respond "local-gamma mirror route is not ready for this path" 404
	}
}

https://gamma-rtc.quwoquan-env.test:{$LOCAL_GAMMA_HTTP_PORT:19000},
https://gamma-rtc.localhost:{$LOCAL_GAMMA_HTTP_PORT:19000} {
	import local_gamma_tls
	reverse_proxy livekit-sfu:7880
}

https://gamma-product-ops.quwoquan-env.test:{$LOCAL_GAMMA_PRODUCT_OPS_PORT:19010},
https://gamma-product-ops.localhost:{$LOCAL_GAMMA_PRODUCT_OPS_PORT:19010},
https://localhost:{$LOCAL_GAMMA_PRODUCT_OPS_PORT:19010} {
	import local_gamma_tls
	handle /healthz {
		reverse_proxy product-ops-service:18086
	}
	handle /ops/* {
		reverse_proxy product-ops-service:18086
	}
	handle /control-plane/product/* {
		reverse_proxy product-ops-service:18086
	}
	handle /control-plane/platform/* {
		reverse_proxy platform-ops-service:18088
	}
	# 运维运营 Portal SPA（与 prod 渲染面同构：静态站点 + 同源控制面 API）。
	handle {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
		}
		root * /srv/portal
		try_files {path} /index.html
		file_server
	}
}

https://gamma-avatar.quwoquan-env.test:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100},
https://gamma-image.quwoquan-env.test:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100},
https://gamma-video.quwoquan-env.test:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100},
https://gamma-avatar.localhost:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100},
https://gamma-image.localhost:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100},
https://gamma-video.localhost:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100},
https://localhost:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100} {
	import local_gamma_tls
	import media_cors
	handle /healthz {
		respond "ok" 200
	}
	root * /srv/media
	file_server
}

