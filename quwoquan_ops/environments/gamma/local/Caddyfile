{
	admin 0.0.0.0:2019
}

(public_gamma_tls) {
	tls {$QWQ_PUBLIC_TLS_CERT_FILE} {$QWQ_PUBLIC_TLS_KEY_FILE}
}

(media_cors) {
	# ?Cache-Control keeps the default no-store only when the immutable
	# matcher below did not already set a Cache-Control. A hard-coded
	# Cache-Control here would overwrite the immutable policy at flush time.
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "*"
		Cross-Origin-Resource-Policy "cross-origin"
		?Cache-Control "no-store"
	}
	@immutable_public_media {
		path_regexp immutable_public_media ^/media/(?:avatar|image|video|background|attachment)/s/(?:[^/]+/)+v[1-9][0-9]*/(?:[^/]+/)*[^/]+$
		vars_regexp canonical_media_query {http.request.uri.query} ^$
	}
	header @immutable_public_media {
		Cache-Control "public, max-age=31536000, immutable"
		X-QWQ-Media-Cache-Key "{http.request.uri.path}"
	}
}

(business_api_edge) {
	reverse_proxy api-edge:18079 {
		# Caddy owns the network boundary and overwrites, rather than appends to,
		# the only anonymous admission subject header.
		header_up X-Edge-Client-IP {remote_host}
	}
}

# Caddy owns TLS and static delivery only. Every business HTTP path enters the
# generated-operation api-edge; service path ownership is not copied here.
https://{$QWQ_PUBLIC_API_HOST}:{$LOCAL_GAMMA_HTTP_PORT:19000},
https://{$QWQ_PUBLIC_WEB_HOST}:{$LOCAL_GAMMA_HTTP_PORT:19000} {
	import public_gamma_tls
	@web_api {
		host {$QWQ_PUBLIC_WEB_HOST}
		path /api/*
	}
	uri @web_api strip_prefix /api
	handle /legal/manifest.json {
		header {
			Cache-Control "public, max-age=300"
			X-Content-Type-Options "nosniff"
		}
		root * /srv/legal
		file_server
	}
	handle /legal/* {
		header {
			Cache-Control "public, max-age=300"
			X-Content-Type-Options "nosniff"
			Content-Type "text/html; charset=utf-8"
		}
		root * /srv/legal
		file_server
	}
	handle /media/* {
		import media_cors
		root * /srv/media
		file_server
	}
	handle {
		import business_api_edge
	}
}

https://{$QWQ_PUBLIC_RTC_HOST}:{$LOCAL_GAMMA_HTTP_PORT:19000} {
	import public_gamma_tls
	reverse_proxy livekit-sfu:7880
}

https://{$QWQ_PUBLIC_OPS_HOST}:{$LOCAL_GAMMA_PRODUCT_OPS_PORT:19010} {
	import public_gamma_tls
	handle /healthz {
		import business_api_edge
	}
	handle /ops/* {
		import business_api_edge
	}
	handle /control-plane/product/* {
		import business_api_edge
	}
	handle /control-plane/platform/* {
		import business_api_edge
	}
	# 运维运营 Portal SPA（与 prod 渲染面同构：静态站点 + 同源控制面 API）。
	handle {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
		}
		root * /srv/portal
		try_files {path} /index.html
		file_server
	}
}

https://{$QWQ_PUBLIC_CDN_HOST}:{$LOCAL_GAMMA_MEDIA_EDGE_PORT:19100} {
	import public_gamma_tls
	import media_cors
	handle /healthz {
		respond "ok" 200
	}
	root * /srv/media
	file_server
}

:80 {
	handle /legal/* {
		header {
			Cache-Control "public, max-age=300"
			X-Content-Type-Options "nosniff"
		}
		root * /srv/legal
		file_server
	}
	handle /media/* {
		import media_cors
		root * /srv/media
		file_server
	}
	handle {
		import business_api_edge
	}
}
