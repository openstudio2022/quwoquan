{
  "version": 1,
  "totalBudgetSeconds": 900,
  "modeScope": {
    "prod-hosted": {
      "supportedModes": [],
      "notes": "prod-hosted currently remains gray rollout stage driven via stackctl deploy --target prod-hosted with service/image/config/step/SLO inputs; do not infer restart|rollout|cold-build commands for prod."
    }
  },
  "gates": {
    "00.local_commit_gate": {
      "budgetSeconds": 600,
      "hardFailSeconds": 900,
      "criticalPath": "max(L0_static_parallel, L0_impacted_tests_parallel)",
      "phaseBudgetsSeconds": {
        "L0_static_parallel": 120,
        "L0_impacted_tests_parallel": 420,
        "L0_smoke": 90
      }
    },
    "01.local_env_matrix": {
      "budgetSeconds": 600,
      "hardFailSeconds": 1800,
      "criticalPath": "L0 + alpha + beta + gamma + prod(package/purity/release-verify) serial; exclusive local runtime switch",
      "cacheModeNotes": "warm soft=600s; cold may use hard=1800s or COLD_CACHE_EXEMPT then require a warm re-run. prod-hosted SSH deploy is NOT in this budget.",
      "phaseBudgetsSeconds": {
        "L0_commit_gate": 45,
        "alpha_pkg_up_verify": 60,
        "beta_pkg_up_verify": 100,
        "gamma_pkg_up_verify_warm": 150,
        "gamma_pkg_up_verify_cold": 240,
        "prod_pkg_purity_release": 30,
        "down_switch_total": 60
      }
    },
    "02.service_pipeline": {
      "budgetSeconds": 180,
      "criticalPath": "prepare_release + max(build_go, build_recommendation_service) + validate_deploy",
      "phaseBudgetsSeconds": {
        "prepare_release": 30,
        "build_go": 120,
        "build_recommendation_service": 120,
        "validate_deploy": 30
      }
    },
    "03.delivery_gate": {
      "budgetSeconds": 360,
      "criticalPath": "topology_regression + max(quwoquan_service, quwoquan_app, ops_portal)",
      "phaseBudgetsSeconds": {
        "topology_regression": 60,
        "quwoquan_service": 180,
        "quwoquan_app": 300,
        "ops_portal": 180
      }
    },
    "04.pre_release_gate_pr": {
      "budgetSeconds": 180,
      "criticalPath": "gamma_environment_ready + max(assistant_api_protocol_smoke, chat_avatar_api_probe)",
      "phaseBudgetsSeconds": {
        "gamma_environment_ready": 30,
        "assistant_api_protocol_smoke": 60,
        "chat_avatar_api_probe": 90
      }
    },
    "05.app_env_device_matrix_pr": {
      "budgetSeconds": 30,
      "criticalPath": "summary_only_when_self_hosted_disabled_by_default_on_pr",
      "phaseBudgetsSeconds": {
        "pr_default_skip": 30
      }
    },
    "07.mainline_auto_prod": {
      "budgetSeconds": 900,
      "criticalPath": "delivery_gate + alpha_stage + beta_device_matrix + prod_initial_checks + prod_full",
      "phaseBudgetsSeconds": {
        "delivery_gate": 240,
        "alpha_stage": 60,
        "beta_device_matrix": 180,
        "prod_initial_checks": 90,
        "prod_full": 90
      }
    },
    "07.main_commit_to_prod": {
      "budgetSeconds": 900,
      "criticalPath": "service_pipeline_02 + mainline_auto_prod_07",
      "phaseBudgetsSeconds": {
        "service_pipeline_02": 180,
        "mainline_auto_prod_07": 720
      }
    }
  }
}
