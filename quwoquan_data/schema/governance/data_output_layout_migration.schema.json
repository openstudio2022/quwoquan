{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.data_output_layout_migration",
  "title": "Data output layout migration plan or receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentKind",
    "planDigest",
    "dataOutputRoot",
    "entries",
    "totalFileCount",
    "totalByteCount",
    "recordedAt",
    "appliedAt",
    "status"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.data_output_layout_migration"},
    "documentKind": {"enum": ["plan", "apply_receipt"]},
    "planDigest": {"$ref": "#/$defs/digest"},
    "dataOutputRoot": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    },
    "totalFileCount": {"type": "integer", "minimum": 0},
    "totalByteCount": {"type": "integer", "minimum": 0},
    "recordedAt": {"type": "string", "minLength": 1},
    "appliedAt": {"type": ["string", "null"]},
    "status": {"enum": ["planned", "applied"]}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "destinationRef", "fileCount", "byteCount", "digest"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1},
        "destinationRef": {"type": "string", "minLength": 1},
        "fileCount": {"type": "integer", "minimum": 1},
        "byteCount": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
