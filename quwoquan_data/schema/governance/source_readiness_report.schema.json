{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/governance/source_readiness_report",
  "title": "Source-readiness qualification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "generatedAt",
    "sourceDigest",
    "inputDigest",
    "sources",
    "minimumPerProvince",
    "exhaustInput",
    "inputExhausted",
    "inputUniqueByProvince",
    "qualifiedByProvince",
    "frozenByProvince",
    "coveredCellsByProvince",
    "processed",
    "belowMinimum",
    "decision",
    "outputs"
  ],
  "properties": {
    "schema": { "const": "quwoquan_data.source_readiness_report" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["wikipedia", "baidu_baike", "toutiao_baike"]
      }
    },
    "minimumPerProvince": { "type": "integer", "minimum": 1 },
    "exhaustInput": { "type": "boolean" },
    "inputExhausted": { "type": "boolean" },
    "inputUniqueByProvince": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "qualifiedByProvince": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "frozenByProvince": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "coveredCellsByProvince": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "processed": { "type": "integer", "minimum": 0 },
    "belowMinimum": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "actual"],
        "properties": {
          "required": { "type": "integer", "minimum": 1 },
          "actual": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "decision": { "enum": ["GO", "NO_GO"] },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "inconclusive", "frozenTargets"],
      "properties": {
        "ready": { "type": "string", "minLength": 1 },
        "inconclusive": { "type": "string", "minLength": 1 },
        "frozenTargets": { "type": "string", "minLength": 1 }
      }
    }
  }
}
