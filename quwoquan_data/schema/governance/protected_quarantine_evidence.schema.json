{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.protected_quarantine_evidence",
  "title": "Protected immutable forensic quarantine evidence receipt",
  "description": "Freezes an incident quarantine using its own QUARANTINE.json marker; no migration provenance is accepted.",
  "$defs": {
    "schemaId": {
      "const": "quwoquan_data.protected_quarantine_evidence"
    },
    "status": {
      "const": "protected_read_only"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reusableSourceTruthAllowed": {
      "const": false
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeCount": {
      "type": "integer",
      "minimum": 0
    },
    "fileCount": {
      "type": "integer",
      "minimum": 1
    },
    "directories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "symlinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symlink"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byteCount",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "symlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target",
        "targetSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "targetSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "provenance",
    "quarantineRef",
    "reason",
    "reusableSourceTruthAllowed",
    "forensicMarkerPath",
    "forensicMarkerSha256",
    "forensicDecision",
    "forensicConsumption",
    "forensicRecovery",
    "directories",
    "files",
    "symlinks",
    "directoryCount",
    "fileCount",
    "symlinkCount",
    "byteCount",
    "treeDigest",
    "manifestDigest",
    "recordedAt"
  ],
  "properties": {
    "schema": {
      "$ref": "#/$defs/schemaId"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "provenance": {
      "const": "forensic"
    },
    "quarantineRef": {
      "type": "string",
      "pattern": "^quarantine/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "reason": {
      "$ref": "#/$defs/reason"
    },
    "reusableSourceTruthAllowed": {
      "$ref": "#/$defs/reusableSourceTruthAllowed"
    },
    "forensicMarkerPath": {
      "const": "QUARANTINE.json"
    },
    "forensicMarkerSha256": {
      "$ref": "#/$defs/digest"
    },
    "forensicDecision": {
      "type": "string",
      "minLength": 1
    },
    "forensicConsumption": {
      "const": "forbidden"
    },
    "forensicRecovery": {
      "const": "retain_for_forensics_only"
    },
    "directories": {
      "$ref": "#/$defs/directories"
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "symlinks": {
      "$ref": "#/$defs/symlinks"
    },
    "directoryCount": {
      "$ref": "#/$defs/nonNegativeCount"
    },
    "fileCount": {
      "$ref": "#/$defs/fileCount"
    },
    "symlinkCount": {
      "$ref": "#/$defs/nonNegativeCount"
    },
    "byteCount": {
      "$ref": "#/$defs/nonNegativeCount"
    },
    "treeDigest": {
      "$ref": "#/$defs/digest"
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "recordedAt": {
      "$ref": "#/$defs/recordedAt"
    }
  }
}
