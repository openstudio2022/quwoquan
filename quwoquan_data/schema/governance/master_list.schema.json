{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "全国地点静态覆盖身份（discovery_seed/2）— quwoquan_data/verticals/travel/coverage/中国/{省}/{市州}.yaml。目录即行政层级，消费方直接 walk 目录。文件只保存稳定地理、实体与发现身份；来源、权利、执行、发布结论必须在 execution 工作包中产生。文件内 country/province/city 与路径一致，跨省地点只在主归属省登记一次，次归属经 geoTagRefs 表达。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "quwoquan_data.discovery_seed/2" },
    "country": { "type": "string", "description": "国家名，与 coverage/ 下一级目录名一致，如 中国" },
    "province": { "type": "string", "description": "省级行政区名，与省目录名一致，如 四川省" },
    "city": { "type": "string", "description": "市州级行政区名，与文件名（去 .yaml）一致，如 成都市" },
    "districts": {
      "type": "array",
      "minItems": 1,
      "description": "按区县分组的地点清单；district 必须命中行政区树 Topic/地理/行政区/{country}/{province}/{city}/ 下的叶子目录名。直辖市口径（北京/上海/天津/重庆：行政区树把区县挂在市州槽位，{city} 本身即叶子）：文件即区县级一文件，districts 恰一组且 district == city，geoTagRef 指向市州槽位叶子本身",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "district": { "type": "string", "description": "区县名，如 都江堰市" },
          "leaves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "description": "地点常用名" },
                "canonicalName": { "type": "string", "description": "规范名（entityRef 第三段真相源，跨文件全局唯一）" },
                "entityType": {
                  "type": "string",
                  "description": "主类型单值 `地点/{Entity地点一级节点名}`（裁决 6 优先级表判定；决定 entityRef 第二段目录归属），如 地点/景区；必须落在试点 scope（景区/自然景观/打卡地/遗址/古镇/宗教场所/博物馆/公园 + 可选 温泉/主题乐园）"
                },
                "typeTagRefs": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" },
                  "description": "全量类型标签数组，精确到叶子（如 Entity/地点/景区/5A景区 + Entity/地点/博物馆）；主类型对应叶子必须在数组中；物化时全部进 _entity.json.tagRefs"
                },
                "geoTagRef": {
                  "type": "string",
                  "description": "区县级主归属行政区标签（单值，分片/推荐特征/geo_bucket 消费），如 Topic/地理/行政区/中国/四川省/成都市/都江堰市"
                },
                "geoTagRefs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "可选：跨省/跨市地点的全量地理归属数组（必须包含 geoTagRef 主归属）；非跨界地点缺省"
                },
                "aliases": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "可选：别名（去重与检索辅助）"
                },
                "selectionPriority": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "选取优先级（1 最高；select-targets 排序消费）"
                },
                "identityRefs": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
                    "wikipediaPageId": { "type": "integer", "minimum": 1 },
                    "osmType": { "type": "string", "enum": ["node", "way", "relation"] },
                    "osmId": { "type": "string", "pattern": "^[0-9]+$" }
                  },
                  "dependentRequired": {
                    "osmType": ["osmId"],
                    "osmId": ["osmType"]
                  },
                  "description": "候选身份解析：QID > Wikipedia pageid > OSM type/id"
                },
                "coordinates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lat", "lon"],
                  "properties": {
                    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                    "lon": { "type": "number", "minimum": -180, "maximum": 180 }
                  }
                },
                "discoverySources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "wiki_category",
                      "wikidata_geo",
                      "osm_poi",
                      "baidu_baike_search",
                      "sogou_baike_search",
                      "toutiao_baike_search"
                    ]
                  },
                  "uniqueItems": true,
                  "description": "仅表示候选发现 driver；不得投影为 homepage source 或 primaryEvidenceRef"
                }
              },
              "required": [
                "name",
                "canonicalName",
                "entityType",
                "typeTagRefs",
                "geoTagRef",
                "selectionPriority"
              ]
            }
          }
        },
        "required": ["district", "leaves"]
      }
    }
  },
  "required": ["schemaVersion", "country", "province", "city", "districts"]
}
