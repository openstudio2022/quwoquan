{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.content_remediation_request",
  "title": "Governed content remediation execution request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "status", "audit", "original", "targetVersion", "issueCodes", "issueSeverities", "requirements", "retireCandidate"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "severity": {"enum": ["high", "medium", "low"]}
  },
  "properties": {
    "schema": {"const": "quwoquan_data.content_remediation_request.v1"},
    "requestId": {"type": "string", "pattern": "^content-remediation-[0-9a-f]{32}$"},
    "status": {"const": "awaiting_execution"},
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestRef", "baselineDigest"],
      "properties": {"manifestRef": {"$ref": "#/$defs/nonEmpty"}, "baselineDigest": {"$ref": "#/$defs/digest"}}
    },
    "original": {
      "type": "object", "additionalProperties": false,
      "required": ["objectRef", "version", "digests"],
      "properties": {
        "objectRef": {"$ref": "#/$defs/nonEmpty"},
        "version": {"type": "integer", "minimum": 0},
        "digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}
      }
    },
    "targetVersion": {"type": "integer", "minimum": 1},
    "issueCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"}},
    "issueSeverities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/severity"}},
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRevisionReacquire", "mappingGate", "independentReviewGate", "canonicalPublishAllowed"],
      "properties": {
        "sourceRevisionReacquire": {"const": "required"},
        "mappingGate": {"const": "required"},
        "independentReviewGate": {"const": "required"},
        "canonicalPublishAllowed": {"const": false}
      }
    },
    "retireCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["suggested", "executionAllowed", "reasonIssueCodes"],
      "properties": {
        "suggested": {"type": "boolean"},
        "executionAllowed": {"const": false},
        "reasonIssueCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
