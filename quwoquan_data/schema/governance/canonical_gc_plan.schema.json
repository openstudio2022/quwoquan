{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/governance/canonical_gc_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "planId", "status", "plannedAt", "minAgeHours",
    "publishRoot", "releaseRoot", "candidates", "protectedExecutions",
    "protectedTransactions", "releaseExecutionRefs", "publishExecutionRefs",
    "releaseIdentityIncidentReleaseRefs",
    "releaseIdentityIncidentExecutionRefs",
    "reviewedClosureAdoptionSourceReleaseRefs",
    "reviewedClosureAdoptionExecutionRefs", "reclaimedExecutions",
    "referenceGraph", "candidateCount", "reclaimableBytes", "planDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.canonical_gc_plan"},
    "planId": {"type": "string", "minLength": 1},
    "status": {"const": "planned"},
    "plannedAt": {"type": "string", "format": "date-time"},
    "minAgeHours": {"type": "number", "minimum": 0},
    "publishRoot": {"type": "string", "minLength": 1},
    "releaseRoot": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "protectedExecutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/protectedExecution"}
    },
    "protectedTransactions": {
      "type": "array",
      "items": {"$ref": "#/$defs/protectedTransaction"}
    },
    "releaseExecutionRefs": {"$ref": "#/$defs/stringSet"},
    "publishExecutionRefs": {"$ref": "#/$defs/stringSet"},
    "releaseIdentityIncidentReleaseRefs": {"$ref": "#/$defs/stringSet"},
    "releaseIdentityIncidentExecutionRefs": {"$ref": "#/$defs/stringSet"},
    "reviewedClosureAdoptionSourceReleaseRefs": {"$ref": "#/$defs/stringSet"},
    "reviewedClosureAdoptionExecutionRefs": {"$ref": "#/$defs/stringSet"},
    "reclaimedExecutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/reclaimedExecution"}
    },
    "referenceGraph": {"type": "object"},
    "candidateCount": {"type": "integer", "minimum": 0},
    "reclaimableBytes": {"type": "integer", "minimum": 0},
    "planDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "ref", "reason", "pathType", "merkleRoot", "fileCount", "bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "execution", "object_transaction", "transaction_staging",
            "source_capsule", "executor_bundle", "acquisition_receipt",
            "acquisition_manifest", "acquisition_cas",
            "acquisition_evidence", "acquisition_staging"
          ]
        },
        "ref": {"type": "string", "pattern": "^data/"},
        "reason": {"type": "string", "minLength": 1},
        "pathType": {"enum": ["file", "directory"]},
        "merkleRoot": {"$ref": "#/$defs/digest"},
        "fileCount": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "protectedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "reasons"],
      "properties": {
        "executionId": {"type": "string", "minLength": 1},
        "reasons": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reclaimedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "reclaimReason", "tombstoneRef"],
      "properties": {
        "executionId": {"type": "string", "minLength": 1},
        "reclaimReason": {
          "enum": [
            "gc_quarantine_reclaim", "reclaimed_before_tombstone_protocol"
          ]
        },
        "tombstoneRef": {
          "type": "string",
          "pattern": "^data/local/workspace/gc/tombstones/"
        }
      }
    },
    "protectedTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transactionId", "reason"],
      "properties": {
        "transactionId": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
