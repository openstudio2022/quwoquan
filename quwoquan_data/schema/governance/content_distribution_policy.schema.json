{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/governance/content_distribution_policy.schema.json",
  "type": "object",
  "required": [
    "schema",
    "policyId",
    "productLifecycleState",
    "releaseClass",
    "mediaGeneration",
    "acquisition",
    "researchDiscovery",
    "researchDistribution",
    "commercialDistribution",
    "articleMedia",
    "scaleMilestones"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan.content_distribution_policy"},
    "policyId": {"type": "string", "minLength": 1},
    "productLifecycleState": {"enum": ["research", "commercial"]},
    "releaseClass": {"enum": ["research", "commercial"]},
    "mediaGeneration": {
      "type": "object",
      "required": ["imageAllowed", "videoAllowed"],
      "additionalProperties": false,
      "properties": {
        "imageAllowed": {"type": "boolean"},
        "videoAllowed": {"type": "boolean"}
      }
    },
    "acquisition": {
      "type": "object",
      "required": ["bypassLogin", "bypassPaywall", "bypassCaptcha", "bypassAccessControl"],
      "additionalProperties": false,
      "properties": {
        "bypassLogin": {"const": false},
        "bypassPaywall": {"const": false},
        "bypassCaptcha": {"const": false},
        "bypassAccessControl": {"const": false}
      }
    },
    "researchDiscovery": {
      "type": "object",
      "required": [
        "catalogRevision", "imageProviderPriority", "imageSearchAxes",
        "videoPopularity"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogRevision": {"type": "string", "minLength": 1},
        "imageProviderPriority": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "imageSearchAxes": {
          "type": "array",
          "const": ["category", "entity", "season", "style", "viewpoint", "popularity"]
        },
        "videoPopularity": {
          "type": "object",
          "description": "Observed popularity availability and comparable-bucket ranking coverage are receipt statistics only.",
          "required": ["signals", "normalization", "statistical", "nonBlocking"],
          "additionalProperties": false,
          "properties": {
            "signals": {
              "type": "array",
              "const": ["play", "like", "comment", "share", "favorite"]
            },
            "normalization": {
              "const": "same_platform_topic_time_bucket_percentile"
            },
            "statistical": {"const": true},
            "nonBlocking": {"const": true}
          }
        }
      }
    },
    "researchDistribution": {
      "type": "object",
      "required": ["allowedRightsStatuses", "requireInternalAccessIsolation"],
      "additionalProperties": false,
      "properties": {
        "allowedRightsStatuses": {
          "type": "array",
          "const": ["verified", "unverified", "unknown"]
        },
        "requireInternalAccessIsolation": {"const": true}
      }
    },
    "commercialDistribution": {
      "type": "object",
      "required": ["allowedRightsStatuses", "requireAuthorizationProof"],
      "additionalProperties": false,
      "properties": {
        "allowedRightsStatuses": {"type": "array", "const": ["verified"]},
        "requireAuthorizationProof": {"const": true}
      }
    },
    "articleMedia": {
      "type": "object",
      "description": "Article media rate targets are receipt statistics; only per-object declared media closure is an admission gate.",
      "required": ["illustratedRateTarget", "textOnlyRateTarget", "requireCoverAndBodyImage"],
      "additionalProperties": false,
      "properties": {
        "illustratedRateTarget": {
          "description": "Statistical target only; does not reject a qualified article or release.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "textOnlyRateTarget": {
          "description": "Statistical target only; does not reject a qualified article or release.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requireCoverAndBodyImage": {"const": true}
      }
    },
    "scaleMilestones": {
      "type": "object",
      "description": "Workload targets and structural M100-to-M1000 binding; target attainment and recovery rate do not gate promotion.",
      "required": ["m100Targets", "m1000Targets", "requireM100PromotionBeforeM1000", "automaticRecovery"],
      "additionalProperties": false,
      "properties": {
        "m100Targets": {"$ref": "#/$defs/m100Targets"},
        "m1000Targets": {"$ref": "#/$defs/m1000Targets"},
        "requireM100PromotionBeforeM1000": {"const": true},
        "automaticRecovery": {
          "type": "object",
          "description": "Automatic recovery rate is recorded but never participates in aggregate passed or M1000 eligibility.",
          "required": ["targetRate", "statistical", "nonBlocking"],
          "additionalProperties": false,
          "properties": {
            "targetRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "statistical": {"const": true},
            "nonBlocking": {"const": true}
          }
        }
      }
    }
  },
  "$defs": {
    "m100Targets": {
      "type": "object",
      "required": ["homepage", "article", "image", "video"],
      "additionalProperties": false,
      "properties": {
        "homepage": {"const": 100},
        "article": {"const": 100},
        "image": {"const": 100},
        "video": {"const": 10}
      }
    },
    "m1000Targets": {
      "type": "object",
      "required": ["homepage", "article", "image", "video"],
      "additionalProperties": false,
      "properties": {
        "homepage": {"const": 1000},
        "article": {"const": 1000},
        "image": {"const": 1000},
        "video": {"const": 100}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"productLifecycleState": {"const": "research"}}},
      "then": {"properties": {"releaseClass": {"const": "research"}}},
      "else": {"properties": {"releaseClass": {"const": "commercial"}}}
    }
  ]
}
