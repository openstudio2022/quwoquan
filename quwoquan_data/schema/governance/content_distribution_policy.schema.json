{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/governance/content_distribution_policy.schema.json",
  "type": "object",
  "required": [
    "schema",
    "policyId",
    "productLifecycleState",
    "releaseClass",
    "mediaGeneration",
    "acquisition",
    "researchDiscovery",
    "articleMedia",
    "scaleMilestones",
    "productionDistribution",
    "assetRecordDefaults"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan.content_distribution_policy"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "productLifecycleState": {
      "enum": [
        "production"
      ]
    },
    "releaseClass": {
      "enum": [
        "production"
      ]
    },
    "mediaGeneration": {
      "type": "object",
      "required": [
        "imageAllowed",
        "videoAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "imageAllowed": {
          "type": "boolean"
        },
        "videoAllowed": {
          "type": "boolean"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "required": [
        "bypassLogin",
        "bypassPaywall",
        "bypassCaptcha",
        "bypassAccessControl"
      ],
      "additionalProperties": false,
      "properties": {
        "bypassLogin": {
          "const": false
        },
        "bypassPaywall": {
          "const": false
        },
        "bypassCaptcha": {
          "const": false
        },
        "bypassAccessControl": {
          "const": false
        }
      }
    },
    "researchDiscovery": {
      "type": "object",
      "required": [
        "catalogRevision",
        "imageProviderPriority",
        "imageSearchAxes",
        "videoPopularity"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogRevision": {
          "type": "string",
          "minLength": 1
        },
        "imageProviderPriority": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "imageSearchAxes": {
          "type": "array",
          "const": [
            "category",
            "entity",
            "season",
            "style",
            "viewpoint",
            "popularity"
          ]
        },
        "videoPopularity": {
          "type": "object",
          "description": "Observed popularity details are optional statistics and never decide object admission or Research release eligibility.",
          "required": [
            "signals",
            "normalization",
            "statistical",
            "nonBlocking"
          ],
          "additionalProperties": false,
          "properties": {
            "signals": {
              "type": "array",
              "const": [
                "play",
                "like",
                "comment",
                "share",
                "favorite"
              ]
            },
            "normalization": {
              "const": "same_platform_topic_time_bucket_percentile"
            },
            "statistical": {
              "const": true
            },
            "nonBlocking": {
              "const": true
            }
          }
        }
      }
    },
    "assetRecordDefaults": {
      "description": "采集代码无法核实、只能按 producer 政策统一申明的资产级记录常量；这是它们唯一的声明位。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercialAuthorizationStatus",
        "modelReleaseStatus",
        "propertyReleaseStatus",
        "takedownPolicy"
      ],
      "properties": {
        "commercialAuthorizationStatus": {
          "const": "unverified"
        },
        "modelReleaseStatus": {
          "enum": ["not_required", "obtained", "editorial_only"]
        },
        "propertyReleaseStatus": {
          "type": "string",
          "minLength": 1
        },
        "takedownPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "articleMedia": {
      "type": "object",
      "description": "Article media rate targets are receipt statistics; only per-object declared media closure is an admission gate.",
      "required": [
        "illustratedRateTarget",
        "textOnlyRateTarget",
        "requireCoverAndBodyImage"
      ],
      "additionalProperties": false,
      "properties": {
        "illustratedRateTarget": {
          "description": "Statistical target only; does not reject a qualified article or release.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "textOnlyRateTarget": {
          "description": "Statistical target only; does not reject a qualified article or release.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requireCoverAndBodyImage": {
          "const": false
        }
      }
    },
    "scaleMilestones": {
      "type": "object",
      "description": "Cumulative unique admitted-object targets; predecessor identity and operational measurements are statistical and do not block Research publication.",
      "required": [
        "m1Targets",
        "m10Targets",
        "m100Targets",
        "m1000Targets",
        "m10000Targets",
        "requireM100PromotionBeforeM1000",
        "requireM1000PromotionBeforeM10000",
        "milestoneAttainmentRequired",
        "attainmentCountingMode"
      ],
      "additionalProperties": false,
      "properties": {
        "m1Targets": {
          "$ref": "#/$defs/milestoneTargets"
        },
        "m10Targets": {
          "$ref": "#/$defs/milestoneTargets"
        },
        "m100Targets": {
          "$ref": "#/$defs/milestoneTargets"
        },
        "m1000Targets": {
          "$ref": "#/$defs/milestoneTargets"
        },
        "m10000Targets": {
          "$ref": "#/$defs/milestoneTargets"
        },
        "requireM100PromotionBeforeM1000": {
          "const": false
        },
        "requireM1000PromotionBeforeM10000": {
          "const": false
        },
        "milestoneAttainmentRequired": {
          "const": true
        },
        "attainmentCountingMode": {
          "const": "cumulative_unique_finalized_objects"
        }
      }
    },
    "productionDistribution": {
      "type": "object",
      "required": [
        "recordedRightsStatuses",
        "rightsBlockPublish"
      ],
      "additionalProperties": false,
      "properties": {
        "recordedRightsStatuses": {
          "type": "array",
          "const": [
            "verified",
            "unverified",
            "restricted",
            "unknown"
          ]
        },
        "rightsBlockPublish": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "milestoneTargets": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 1
        },
        "article": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "integer",
          "minimum": 1
        },
        "video": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
