{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/governance/source_readiness_manifest",
  "title": "Source-readiness resumable run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "provinces",
    "candidateFiles",
    "includeMasterList",
    "exhaustInput",
    "sources",
    "minimumPerProvince",
    "inputDigest",
    "sourceDigest"
  ],
  "properties": {
    "schema": { "const": "quwoquan_data.source_readiness_manifest" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "provinces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidateFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "includeMasterList": { "type": "boolean" },
    "exhaustInput": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["wikipedia", "baidu_baike", "toutiao_baike"]
      }
    },
    "minimumPerProvince": { "type": "integer", "minimum": 1 },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
