{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/governance/coverage_source_ready_catalog_projection",
  "title": "Coverage source-ready to homepage/article catalog boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "coverageBindings",
    "coverageReceiptStatus",
    "counts",
    "homepageCatalogBuilderInputs",
    "articleCatalogBuilderInputs",
    "plannedCandidates",
    "blockers",
    "projectionDigest"
  ],
  "properties": {
    "schema": { "const": "quwoquan_data.coverage_source_ready_catalog_projection" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "sourceRevision": { "$ref": "#/$defs/sha256" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "entityCatalogDigest": { "$ref": "#/$defs/sha256" },
    "coverageBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "report", "sourceReady", "sourceInconclusive", "frozenTargets"],
      "properties": {
        "manifest": { "$ref": "#/$defs/jsonBinding" },
        "report": { "$ref": "#/$defs/jsonBinding" },
        "sourceReady": { "$ref": "#/$defs/fileBinding" },
        "sourceInconclusive": { "$ref": "#/$defs/fileBinding" },
        "frozenTargets": { "$ref": "#/$defs/recordBinding" }
      }
    },
    "coverageReceiptStatus": { "const": "missing" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plannedEntityCount", "homepage", "article"],
      "properties": {
        "plannedEntityCount": { "type": "integer", "minimum": 0 },
        "homepage": { "$ref": "#/$defs/carrierCounts" },
        "article": { "$ref": "#/$defs/carrierCounts" }
      }
    },
    "homepageCatalogBuilderInputs": { "type": "array", "maxItems": 0 },
    "articleCatalogBuilderInputs": { "type": "array", "maxItems": 0 },
    "plannedCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/plannedCandidate" }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "reason", "affectedEntityCount"],
        "properties": {
          "code": { "const": "DATA.SOURCE.POOL_SHORTFALL" },
          "reason": { "type": "string", "minLength": 1 },
          "affectedEntityCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "projectionDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fileSha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "jsonBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "documentDigest", "fileSha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "documentDigest": { "$ref": "#/$defs/sha256" },
        "fileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "recordBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "recordSetDigest", "fileSha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "recordSetDigest": { "$ref": "#/$defs/sha256" },
        "fileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "carrierCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plannedCount", "readyCount", "mediaMissingCount"],
      "properties": {
        "plannedCount": { "type": "integer", "minimum": 0 },
        "readyCount": { "const": 0 },
        "mediaMissingCount": { "type": "integer", "minimum": 0 }
      }
    },
    "carrierGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "blockerCode", "missingEvidence"],
      "properties": {
        "ready": { "const": false },
        "blockerCode": { "const": "DATA.SOURCE.POOL_SHORTFALL" },
        "missingEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plannedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverageEntityIdentity",
        "candidateName",
        "province",
        "city",
        "district",
        "entityType",
        "source",
        "coverageRecordDigest",
        "homepage",
        "article"
      ],
      "properties": {
        "coverageEntityIdentity": { "type": "string", "minLength": 1 },
        "candidateName": { "type": "string", "minLength": 1 },
        "province": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 },
        "entityType": { "type": "string", "pattern": "^地点/" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceKind", "extractor", "sourceUrl", "observedAt"],
          "properties": {
            "sourceKind": { "enum": ["wikipedia", "baidu_baike", "toutiao_baike"] },
            "extractor": { "enum": ["wikipedia_api", "baidu_baike_html", "toutiao_baike_html"] },
            "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        },
        "coverageRecordDigest": { "$ref": "#/$defs/sha256" },
        "homepage": { "$ref": "#/$defs/carrierGap" },
        "article": { "$ref": "#/$defs/carrierGap" }
      }
    }
  }
}
