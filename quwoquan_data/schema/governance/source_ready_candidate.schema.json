{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/governance/source_ready_candidate",
  "title": "Source-ready travel object qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identityKey",
    "candidate",
    "attemptedSources",
    "qualified",
    "qualifiedAt"
  ],
  "properties": {
    "schema": { "const": "quwoquan_data.source_ready_candidate" },
    "identityKey": { "type": "string", "pattern": "^name_location:.+\\|.+\\|.+\\|.+$" },
    "candidate": {
      "type": "object",
      "required": ["name", "province", "city", "district"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "province": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 }
      }
    },
    "attemptedSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["wikipedia", "baidu_baike", "toutiao_baike"]
      }
    },
    "qualified": { "type": "boolean" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "extractor",
        "canonicalUrl",
        "resolvedTitle",
        "matchConfidence"
      ],
      "properties": {
        "sourceKind": {
          "enum": ["wikipedia", "baidu_baike", "toutiao_baike"]
        },
        "extractor": {
          "enum": ["wikipedia_api", "baidu_baike_html", "toutiao_baike_html"]
        },
        "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "resolvedTitle": { "type": "string", "minLength": 1 },
        "matchConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provinceRank", "coverageCell"],
      "properties": {
        "provinceRank": { "type": "integer", "minimum": 1 },
        "coverageCell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "district", "entityType"],
          "properties": {
            "city": { "type": "string", "minLength": 1 },
            "district": { "type": "string", "minLength": 1 },
            "entityType": { "type": "string", "pattern": "^地点/" }
          }
        }
      }
    },
    "qualifiedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "qualified": { "const": true } },
        "required": ["qualified"]
      },
      "then": { "required": ["evidence"] },
      "else": { "not": { "required": ["evidence"] } }
    }
  ]
}
