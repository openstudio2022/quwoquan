{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/governance/canonical_gc_apply.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "planId", "planDigest", "status", "appliedAt",
    "quarantined", "quarantinedCount", "quarantinedBytes",
    "permanentDeletion", "idempotent", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.canonical_gc_apply"},
    "planId": {"type": "string", "minLength": 1},
    "planDigest": {"$ref": "#/$defs/digest"},
    "status": {"const": "applied"},
    "appliedAt": {"type": "string", "format": "date-time"},
    "quarantined": {
      "type": "array",
      "items": {"$ref": "#/$defs/quarantined"}
    },
    "quarantinedCount": {"type": "integer", "minimum": 0},
    "quarantinedBytes": {"type": "integer", "minimum": 0},
    "permanentDeletion": {"const": false},
    "idempotent": {"type": "boolean"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "quarantined": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref", "kind", "pathType", "status", "merkleRoot", "fileCount",
        "bytes", "quarantineRef", "quarantinedAt"
      ],
      "properties": {
        "ref": {"type": "string", "pattern": "^data/"},
        "kind": {"type": "string", "minLength": 1},
        "pathType": {"enum": ["file", "directory"]},
        "status": {"const": "quarantined"},
        "merkleRoot": {"$ref": "#/$defs/digest"},
        "fileCount": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "quarantineRef": {"type": "string", "pattern": "^data/local/workspace/quarantine/canonical-gc/"},
        "quarantinedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
