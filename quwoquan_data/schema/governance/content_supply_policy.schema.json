{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policyId": { "type": "string", "minLength": 1 },
    "feedMinimumPosts": { "type": "integer", "minimum": 1 },
    "contentPerEntity": {
      "type": "object",
      "properties": {
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      },
      "required": ["article", "image", "video"],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "nonEmptyRateMinimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "duplicateExposureRateMaximum": { "type": "number", "minimum": 0, "maximum": 1 },
        "homepageMaxSourceFidelity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "required": ["nonEmptyRateMinimum", "duplicateExposureRateMaximum", "homepageMaxSourceFidelity"],
      "additionalProperties": false
    },
    "mediaSubject": {
      "type": "object",
      "properties": {
        "representativeIndicators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "prohibitedIndicators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      },
      "required": ["representativeIndicators", "prohibitedIndicators"],
      "additionalProperties": false
    },
    "videoDelivery": {
      "type": "object",
      "properties": {
        "container": { "const": "mp4" },
        "codec": { "const": "h264" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspectRatio": { "const": "9:16" },
        "pixelFormat": { "const": "yuv420p" },
        "framesPerSecond": { "type": "integer", "minimum": 1 },
        "segmentDurationSeconds": { "type": "integer", "minimum": 1 },
        "minimumSourceFrames": { "type": "integer", "minimum": 1 },
        "minimumDurationSeconds": { "type": "integer", "minimum": 1 },
        "maximumDurationSeconds": { "type": "integer", "minimum": 1 },
        "posterRequired": { "const": true },
        "subtitlesRequired": { "const": true },
        "checksumRequired": { "const": true },
        "rightsProvenanceRequired": { "const": true }
      },
      "required": [
        "container", "codec", "width", "height", "aspectRatio", "pixelFormat",
        "framesPerSecond", "segmentDurationSeconds", "minimumSourceFrames", "minimumDurationSeconds",
        "maximumDurationSeconds",
        "posterRequired", "subtitlesRequired", "checksumRequired", "rightsProvenanceRequired"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "policyId", "feedMinimumPosts", "contentPerEntity", "quality", "mediaSubject",
    "videoDelivery"
  ],
  "additionalProperties": false
}
