{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/_common/data_issue.schema.json",
  "title": "Data workflow issue",
  "description": "Offline Data diagnostic issue. Consumers may inspect code, message and origin fields but must not derive recovery control flow.",
  "type": "object",
  "required": [
    "code",
    "message",
    "ref",
    "origin",
    "attrs"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "DATA.MEDIA.ENUMERATION_INCOMPLETE",
        "DATA.MEDIA.DOWNLOAD_INCOMPLETE",
        "DATA.MEDIA.CAPTION_INVALID",
        "DATA.MEDIA.COVER_CONFLICT",
        "DATA.CONTRACT.INVALID"
      ]
    },
    "ref": {
      "type": "string",
      "maxLength": 512
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "origin": {
      "type": "string",
      "maxLength": 512
    },
    "attrs": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}
