{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/environment_release_lifecycle_exit.schema.json",
  "title": "Environment immutable release rollback and replay exit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "sourceOwner",
    "exitRunId",
    "originalReleaseId",
    "originalManifestDigest",
    "originalImportRunId",
    "originalVerifyRunId",
    "originalImportResultRef",
    "originalVerifyResultRef",
    "rollbackToReleaseId",
    "rollbackToManifestDigest",
    "rollbackRunId",
    "rollbackVerifyRunId",
    "rollbackResultRef",
    "rollbackVerifyResultRef",
    "replayImportRunId",
    "replayVerifyRunId",
    "replayManifestDigest",
    "replayImportResultRef",
    "replayVerifyResultRef",
    "recordedAt",
    "verificationChecksum",
    "passed"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.environment_release_lifecycle_exit"},
    "environment": {"enum": ["alpha", "beta", "gamma", "prod"]},
    "sourceOwner": {"const": "qwq_data"},
    "exitRunId": {"type": "string", "minLength": 1},
    "originalReleaseId": {"type": "string", "minLength": 1},
    "originalManifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "originalImportRunId": {"type": "string", "minLength": 1},
    "originalVerifyRunId": {"type": "string", "minLength": 1},
    "originalImportResultRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "originalVerifyResultRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "rollbackToReleaseId": {"type": "string", "minLength": 1},
    "rollbackToManifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rollbackRunId": {"type": "string", "minLength": 1},
    "rollbackVerifyRunId": {"type": "string", "minLength": 1},
    "rollbackResultRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "rollbackVerifyResultRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "replayImportRunId": {"type": "string", "minLength": 1},
    "replayVerifyRunId": {"type": "string", "minLength": 1},
    "replayManifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "replayImportResultRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "replayVerifyResultRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "recordedAt": {"type": "string", "minLength": 1},
    "verificationChecksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "passed": {"const": true}
  }
}
