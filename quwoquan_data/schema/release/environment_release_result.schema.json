{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment release run result",
  "type": "object",
  "required": [
    "schema",
    "environment",
    "releaseId",
    "containsUnverifiedAssets",
    "manifestDigest",
    "admissionKind",
    "runId",
    "status",
    "startedAt",
    "endedAt",
    "durationMs",
    "verificationChecksum"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.environment_release_result"
    },
    "environment": {
      "enum": [
        "alpha",
        "beta",
        "gamma",
        "prod"
      ]
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "containsUnverifiedAssets": {
      "type": "boolean"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "admissionKind": {
      "enum": [
        "producer_handoff",
        "empty_baseline_attestation"
      ]
    },
    "handoffRef": {
      "type": "string",
      "pattern": "^handoff-ref-v1:sha256:[0-9a-f]{64}:sha256:[0-9a-f]{64}$"
    },
    "handoffArtifactRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+/producer_release_handoff\\.json$"
    },
    "handoffArtifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "systemAttestationRef": {
      "type": "string",
      "pattern": "^data/releases/(?!\\.{1,2}/)[^/\\\\\\u0000-\\u001f\\u007f]+/attestations/release\\.json$"
    },
    "systemAttestationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "importRunId": {
      "type": "string",
      "minLength": 1
    },
    "lifecycleExitRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/release-lifecycle-exit/.+/lifecycle-exit\\.json)$"
    },
    "status": {
      "enum": [
        "completed",
        "dry_run",
        "prepared",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "homepageVerificationCasesRef": {
      "type": "string"
    },
    "tagImportReportRef": {
      "type": "string"
    },
    "creatorImportReportRef": {
      "type": "string"
    },
    "contentImportReportRef": {
      "type": "string"
    },
    "homepageImportReportRef": {
      "type": "string"
    },
    "coverageReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/.+/coverage-receipt\\.json)$"
    },
    "postApiVerificationRef": {
      "type": "string"
    },
    "releaseReadinessRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/.+)$"
    },
    "tagConsumerVerificationRef": {
      "type": "string"
    },
    "homepageApiVerificationRef": {
      "type": "string"
    },
    "baselineApiVerificationRef": {
      "type": "string"
    },
    "failedStage": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "operationAttempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "canonicalErrorCode",
          "recoveryAction",
          "recoveryAfterSeconds",
          "retryAfterSeconds",
          "operation"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "canonicalErrorCode": {
            "type": "string",
            "pattern": "^(none|[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[a-z][a-z0-9_]*)$"
          },
          "recoveryAction": {
            "enum": [
              "none",
              "retry",
              "surface",
              "absorb",
              "fallback",
              "escalate",
              "compensate"
            ]
          },
          "recoveryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "pageId",
              "status",
              "requestId",
              "traceId",
              "startedAt",
              "endedAt",
              "durationMs"
            ],
            "properties": {
              "path": {
                "const": "/search"
              },
              "pageId": {
                "const": "search.global"
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "traceId": {
                "type": "string",
                "minLength": 1
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "endedAt": {
                "type": "string",
                "format": "date-time"
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "verificationChecksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentCandidateReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "contentPreActiveReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "contentActivationReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "contentPostActiveReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "contentCandidateReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentPreActiveReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentActivationReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentPostActiveReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tagCandidateReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "tagCandidateReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tagFencedReadbackReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "tagFencedReadbackReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "creatorCandidateReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "creatorCandidateReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "creatorFencedReadbackReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "creatorFencedReadbackReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "homepageCandidateReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "homepageCandidateReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "homepageFencedReadbackReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "homepageFencedReadbackReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentFencedReadbackReceiptRef": {
      "type": "string",
      "pattern": "^(|env/(alpha|beta|gamma|prod)/runs/data-release/(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+\\.json)$"
    },
    "contentFencedReadbackReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "admissionKind": {
            "const": "producer_handoff"
          }
        },
        "required": [
          "admissionKind"
        ]
      },
      "then": {
        "required": [
          "handoffRef",
          "handoffArtifactRef",
          "handoffArtifactDigest"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "systemAttestationRef"
              ]
            },
            {
              "required": [
                "systemAttestationDigest"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "systemAttestationRef",
          "systemAttestationDigest"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "handoffRef"
              ]
            },
            {
              "required": [
                "handoffArtifactRef"
              ]
            },
            {
              "required": [
                "handoffArtifactDigest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failedStage",
          "error"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "failedStage"
              ]
            },
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "operationAttempts"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared"
          },
          "contentImportReportRef": {
            "minLength": 1
          }
        },
        "required": [
          "status",
          "contentImportReportRef"
        ]
      },
      "then": {
        "required": [
          "tagCandidateReceiptRef",
          "tagCandidateReceiptDigest",
          "creatorCandidateReceiptRef",
          "creatorCandidateReceiptDigest",
          "homepageCandidateReceiptRef",
          "homepageCandidateReceiptDigest",
          "contentCandidateReceiptRef",
          "contentCandidateReceiptDigest"
        ],
        "properties": {
          "tagCandidateReceiptRef": {
            "minLength": 1
          },
          "creatorCandidateReceiptRef": {
            "minLength": 1
          },
          "homepageCandidateReceiptRef": {
            "minLength": 1
          },
          "contentCandidateReceiptRef": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          },
          "contentActivationReceiptRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "importRunId",
          "contentActivationReceiptRef"
        ]
      },
      "then": {
        "required": [
          "tagCandidateReceiptRef",
          "tagCandidateReceiptDigest",
          "creatorCandidateReceiptRef",
          "creatorCandidateReceiptDigest",
          "homepageCandidateReceiptRef",
          "homepageCandidateReceiptDigest",
          "contentCandidateReceiptRef",
          "contentCandidateReceiptDigest",
          "contentPreActiveReceiptRef",
          "contentPreActiveReceiptDigest",
          "contentActivationReceiptRef",
          "contentActivationReceiptDigest",
          "contentPostActiveReceiptRef",
          "contentPostActiveReceiptDigest",
          "tagFencedReadbackReceiptRef",
          "tagFencedReadbackReceiptDigest",
          "creatorFencedReadbackReceiptRef",
          "creatorFencedReadbackReceiptDigest",
          "homepageFencedReadbackReceiptRef",
          "homepageFencedReadbackReceiptDigest",
          "contentFencedReadbackReceiptRef",
          "contentFencedReadbackReceiptDigest"
        ],
        "properties": {
          "tagCandidateReceiptRef": {
            "minLength": 1
          },
          "creatorCandidateReceiptRef": {
            "minLength": 1
          },
          "homepageCandidateReceiptRef": {
            "minLength": 1
          },
          "contentCandidateReceiptRef": {
            "minLength": 1
          },
          "tagFencedReadbackReceiptRef": {
            "minLength": 1
          },
          "creatorFencedReadbackReceiptRef": {
            "minLength": 1
          },
          "homepageFencedReadbackReceiptRef": {
            "minLength": 1
          },
          "contentFencedReadbackReceiptRef": {
            "minLength": 1
          },
          "contentPreActiveReceiptRef": {
            "minLength": 1
          },
          "contentActivationReceiptRef": {
            "minLength": 1
          },
          "contentPostActiveReceiptRef": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
