{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment release run result",
  "type": "object",
  "required": [
    "schema", "environment", "releaseId", "releaseClass",
    "productLifecycleState", "containsUnverifiedAssets", "manifestDigest",
    "runId", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.environment_release_result"},
    "environment": {"enum": ["alpha", "beta", "gamma", "prod"]},
    "releaseId": {"type": "string", "minLength": 1},
    "releaseClass": {"enum": ["research", "commercial"]},
    "productLifecycleState": {"enum": ["research", "commercial"]},
    "containsUnverifiedAssets": {"type": "boolean"},
    "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runId": {"type": "string", "minLength": 1},
    "importRunId": {"type": "string", "minLength": 1},
    "verifyRunId": {"type": "string", "minLength": 1},
    "stageRunId": {"type": "string", "minLength": 1},
    "activateRunId": {"type": "string", "minLength": 1},
    "contentPhase": {
      "description": "stage：只写候选与 additive 引用对象；verify：候选读回；activate：单事务切 pointer 并执行 destructive 收尾。缺省表示 consumer 读回或历史一步式 run。",
      "enum": ["stage", "verify", "activate"]
    },
    "candidateRevision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "fullSync": {"type": "boolean"},
    "candidateVerificationRef": {"type": "string"},
    "mediaPruneRef": {"type": "string"},
    "readinessPhase": {"enum": ["research", "consumer", "commercial"]},
    "lifecycleExitRef": {
      "type": "string",
      "pattern": "^env/(alpha|beta|gamma|prod)/runs/release-lifecycle-exit/.+/lifecycle-exit\\.json$"
    },
    "status": {"enum": ["completed", "dry_run", "prepared", "failed"]},
    "homepageVerificationCasesRef": {"type": "string"},
    "tagImportReportRef": {"type": "string"},
    "creatorImportReportRef": {"type": "string"},
    "contentImportReportRef": {"type": "string"},
    "homepageImportReportRef": {"type": "string"},
    "coverageReceiptRef": {
      "type": "string",
      "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/.+/coverage-receipt\\.json$"
    },
    "postApiVerificationRef": {"type": "string"},
    "releaseReadinessRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "researchIsolationVerificationRef": {
      "type": "string",
      "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/.+/research-isolation-verification\\.json$"
    },
    "tagConsumerVerificationRef": {"type": "string"},
    "homepageApiVerificationRef": {"type": "string"},
    "baselineApiVerificationRef": {"type": "string"},
    "failedStage": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1},
    "operationAttempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt", "canonicalErrorCode", "recoveryAction",
          "recoveryAfterSeconds", "retryAfterSeconds", "operation"
        ],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
          "canonicalErrorCode": {
            "type": "string",
            "pattern": "^(none|[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[a-z][a-z0-9_]*)$"
          },
          "recoveryAction": {
            "enum": ["none", "retry", "surface", "absorb", "fallback", "escalate", "compensate"]
          },
          "recoveryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path", "pageId", "status", "requestId", "traceId",
              "startedAt", "endedAt", "durationMs"
            ],
            "properties": {
              "path": {"const": "/search"},
              "pageId": {"const": "search.global"},
              "status": {"type": "integer", "minimum": 100, "maximum": 599},
              "requestId": {"type": "string", "minLength": 1},
              "traceId": {"type": "string", "minLength": 1},
              "startedAt": {"type": "string", "format": "date-time"},
              "endedAt": {"type": "string", "format": "date-time"},
              "durationMs": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "verificationChecksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
