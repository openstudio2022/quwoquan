{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment release run result",
  "type": "object",
  "required": [
    "schema", "environment", "releaseId", "releaseClass",
    "productLifecycleState", "containsUnverifiedAssets", "manifestDigest",
    "runId", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.environment_release_result"},
    "environment": {"enum": ["alpha", "beta", "gamma", "prod"]},
    "releaseId": {"type": "string", "minLength": 1},
    "releaseClass": {"enum": ["research", "commercial"]},
    "productLifecycleState": {"enum": ["research", "commercial"]},
    "containsUnverifiedAssets": {"type": "boolean"},
    "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runId": {"type": "string", "minLength": 1},
    "importRunId": {"type": "string", "minLength": 1},
    "readinessPhase": {"enum": ["research", "consumer", "commercial"]},
    "lifecycleExitRef": {
      "type": "string",
      "pattern": "^env/(alpha|beta|gamma|prod)/runs/release-lifecycle-exit/.+/lifecycle-exit\\.json$"
    },
    "status": {"enum": ["completed", "dry_run", "prepared", "failed"]},
    "homepageVerificationCasesRef": {"type": "string"},
    "tagImportReportRef": {"type": "string"},
    "creatorImportReportRef": {"type": "string"},
    "contentImportReportRef": {"type": "string"},
    "homepageImportReportRef": {"type": "string"},
    "postApiVerificationRef": {"type": "string"},
    "releaseReadinessRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "researchIsolationVerificationRef": {
      "type": "string",
      "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/.+/research-isolation-verification\\.json$"
    },
    "tagConsumerVerificationRef": {"type": "string"},
    "homepageApiVerificationRef": {"type": "string"},
    "baselineApiVerificationRef": {"type": "string"},
    "failedStage": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1},
    "verificationChecksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
