{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/ship_report.schema.json",
  "title": "Ship report (批次 ship 闭环证据)",
  "description": "ship_report.json 唯一字段定义（写入口 ship/handler._write_batch_ship_report / write_release_only_ship_report）。release_only 闭环 envs 必须为空且 importRequested=false。",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "dataReleaseId",
    "sourceReleaseId",
    "envs",
    "importRequested",
    "dryRun",
    "summary",
    "importReports",
    "writtenAt"
  ],
  "additionalProperties": false,
  "properties": {
    "closureType": {
      "type": "string",
      "enum": [
        "release_only"
      ]
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "dataReleaseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceReleaseId": {
      "type": "string"
    },
    "envs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "importRequested": {
      "type": "boolean"
    },
    "dryRun": {
      "type": "boolean"
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "importReports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writtenAt": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "quwoquan_data.ship_report"
    }
  }
}
