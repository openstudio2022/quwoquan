{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/campaign_scale_source_pool.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "poolId", "targetScale", "sourceRevision", "sourceDigest",
    "entityCatalogDigest", "planDigest", "planFileSha256",
    "sourceCapsuleRef", "sourceCapsuleDigest", "laneSelections"
  ],
  "properties": {
    "poolId": {"type": "string", "minLength": 1},
    "targetScale": {"enum": ["M100", "M1000", "M10000"]},
    "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "planFileSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceCapsuleRef": {"type": "string", "minLength": 1},
    "sourceCapsuleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "laneSelections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["carrier", "candidateIds", "candidateCount", "selectionDigest"],
        "properties": {
          "carrier": {"enum": ["homepage", "article", "image", "video"]},
          "candidateIds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "candidateCount": {"type": "integer", "minimum": 1},
          "selectionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
