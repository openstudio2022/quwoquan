{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/gamma_homepage_api_verification.schema.json",
  "title": "Gamma homepage API verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "releaseId", "runId", "sourceUatCasesRef", "apiBaseUrl", "verifiedAt", "passed", "entities", "issues"],
  "properties": {
    "schemaVersion": {"const": "quwoquan_data.gamma_homepage_api_verification/1"},
    "environment": {"const": "gamma"},
    "releaseId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "sourceUatCasesRef": {"type": "string", "pattern": "^env/gamma/runs/data-release/"},
    "apiBaseUrl": {"type": "string", "pattern": "^https?://"},
    "apiResolveHost": {"type": "string", "minLength": 1},
    "verifiedAt": {"type": "string", "minLength": 1},
    "passed": {"const": true},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityRef", "homepageId", "title", "detailStatus", "introductionStatus", "coverUrl", "sectionCount"],
        "properties": {
          "entityRef": {"type": "string", "minLength": 3},
          "homepageId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "detailStatus": {"const": 200},
          "introductionStatus": {"const": 200},
          "coverUrl": {"type": "string", "minLength": 1},
          "sectionCount": {"type": "integer", "minimum": 1}
        }
      }
    },
    "issues": {"type": "array", "maxItems": 0}
  }
}
