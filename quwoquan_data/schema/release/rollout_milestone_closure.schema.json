{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/rollout_milestone_closure.schema.json",
  "title": "Gamma rollout milestone closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "payloadSha256",
    "rolloutId",
    "milestone",
    "environment",
    "executionIds",
    "batchExecutionIds",
    "approvedEntityRefs",
    "approvedEntityRefsByScope",
    "batchApprovedEntityRefsByScope",
    "evidenceRefs",
    "rollbackTargetReleaseId",
    "passed",
    "recordedAt"
  ],
  "properties": {
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rolloutId": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "enum": [
        "canary",
        "m1",
        "m2",
        "m3"
      ]
    },
    "environment": {
      "const": "gamma"
    },
    "executionIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "batchExecutionIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approvedEntityRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approvedEntityRefsByScope": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "batchApprovedEntityRefsByScope": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rollbackTargetReleaseId": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "const": true
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "quwoquan_data.rollout_milestone_closure"
    }
  }
}
