{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/m1000_four_environment_proof_result.schema.json",
  "title": "Read-only prove-m1000-four-env result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateVersion",
    "sourceFingerprint",
    "releaseId",
    "releaseDigest",
    "milestone",
    "exactCohortCounts",
    "predecessorCounts",
    "requiredNewCounts",
    "sampleStrategyDigest",
    "sampleDistribution",
    "environments",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.m1000_four_environment_proof_result"
    },
    "candidateVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceFingerprint": {
      "$ref": "#/$defs/digest"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "releaseDigest": {
      "$ref": "#/$defs/digest"
    },
    "milestone": {
      "const": "M1000"
    },
    "exactCohortCounts": {
      "$ref": "#/$defs/positiveCounts"
    },
    "predecessorCounts": {
      "$ref": "#/$defs/positiveCounts"
    },
    "requiredNewCounts": {
      "$ref": "#/$defs/positiveCounts"
    },
    "sampleStrategyDigest": {
      "$ref": "#/$defs/digest"
    },
    "sampleDistribution": {
      "$ref": "#/$defs/positiveCounts"
    },
    "environments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/alpha"
        },
        {
          "$ref": "#/$defs/beta"
        },
        {
          "$ref": "#/$defs/gamma"
        },
        {
          "$ref": "#/$defs/prod"
        }
      ],
      "items": false
    },
    "verdict": {
      "const": "pass"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positiveCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 1
        },
        "article": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "integer",
          "minimum": 1
        },
        "video": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "target",
        "acceptanceFactId",
        "requiredGates",
        "responsibilityRoles"
      ],
      "properties": {
        "environment": {
          "enum": [
            "alpha",
            "beta",
            "gamma",
            "prod"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceFactId": {
          "$ref": "#/$defs/digest"
        },
        "requiredGates": {
          "const": [
            "environment_acceptance",
            "capacity_timeliness",
            "fault_recovery",
            "rollback_replay",
            "responsibility_acceptance"
          ]
        },
        "responsibilityRoles": {
          "const": [
            "product_owner",
            "data_content_operations_owner",
            "quality_user_representative",
            "environment_reliability_owner",
            "release_owner"
          ]
        }
      }
    },
    "alpha": {
      "allOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "properties": {
            "environment": {
              "const": "alpha"
            }
          }
        }
      ]
    },
    "beta": {
      "allOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "properties": {
            "environment": {
              "const": "beta"
            }
          }
        }
      ]
    },
    "gamma": {
      "allOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "properties": {
            "environment": {
              "const": "gamma"
            }
          }
        }
      ]
    },
    "prod": {
      "allOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "properties": {
            "environment": {
              "const": "prod"
            }
          }
        }
      ]
    }
  }
}
