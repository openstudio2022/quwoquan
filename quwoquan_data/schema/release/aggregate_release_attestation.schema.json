{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "releaseId",
    "releaseKind",
    "executionIds",
    "rolloutMilestone",
    "entityCount",
    "postCount",
    "creatorCount",
    "tagCount",
    "canonicalMerkle",
    "sourceDigest",
    "payloadSha256",
    "recordedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "releaseKind": {
      "enum": [
        "content",
        "empty_baseline"
      ]
    },
    "executionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rolloutMilestone": {
      "enum": [
        "baseline",
        "canary",
        "m1",
        "m2",
        "m3",
        "h10k",
        "launch"
      ]
    },
    "entityCount": {
      "type": "integer",
      "minimum": 0
    },
    "postCount": {
      "type": "integer",
      "minimum": 0
    },
    "creatorCount": {
      "type": "integer",
      "minimum": 0
    },
    "tagCount": {
      "type": "integer",
      "minimum": 0
    },
    "canonicalMerkle": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceDigest": {
      "type": "object",
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "quwoquan_data.aggregate_release_attestation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseKind": {
            "const": "content"
          }
        }
      },
      "then": {
        "properties": {
          "executionIds": {
            "minItems": 1
          },
          "rolloutMilestone": {
            "enum": [
              "canary",
              "m1",
              "m2",
              "m3",
              "h10k",
              "launch"
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "entityCount": { "minimum": 1 }
            }
          },
          {
            "properties": {
              "postCount": { "minimum": 1 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "releaseKind": {
            "const": "empty_baseline"
          }
        }
      },
      "then": {
        "properties": {
          "executionIds": {
            "maxItems": 0
          },
          "rolloutMilestone": {
            "const": "baseline"
          },
          "entityCount": {
            "const": 0
          },
          "postCount": {
            "const": 0
          },
          "creatorCount": {
            "const": 0
          },
          "tagCount": {
            "const": 0
          }
        }
      }
    }
  ]
}
