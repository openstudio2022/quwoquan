{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/import_report.schema.json",
  "title": "Environment import report (content importer 回执)",
  "description": "content-service cmd/import 产出的 import-<env>.json 契约（Go 侧写、数据侧消费）。ship 转写批次证据前必须通过本 Schema，防止导入证据链断裂。",
  "type": "object",
  "required": [
    "schema",
    "status",
    "environment",
    "releaseId",
    "sourceOwner",
    "manifestDigest",
    "mode",
    "deletePolicy",
    "counts",
    "postBindings",
    "auditEvents"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "dry-run",
        "imported"
      ]
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceOwner": {
      "const": "qwq_data"
    },
    "manifestDigest": {
      "description": "完整 immutable release payload 摘要；必须等于 release attestation.payloadSha256。",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": ["upsert", "sync"]
    },
    "deletePolicy": {
      "enum": ["none", "tombstone"]
    },
    "counts": {
      "type": "object",
      "required": [
        "postsLoaded",
        "entitiesLoaded"
      ],
      "additionalProperties": false,
      "properties": {
        "postsLoaded": {
          "type": "integer",
          "minimum": 0
        },
        "entitiesLoaded": {
          "type": "integer",
          "minimum": 0
        },
        "articleLoaded": {"type": "integer", "minimum": 0},
        "imageLoaded": {"type": "integer", "minimum": 0},
        "videoLoaded": {"type": "integer", "minimum": 0},
        "researchLoaded": {"type": "integer", "minimum": 0},
        "commercialLoaded": {"type": "integer", "minimum": 0},
        "postsUpserted": {
          "type": "integer",
          "minimum": 0
        },
        "entitiesUpserted": {
          "type": "integer",
          "minimum": 0
        },
        "feedUpserted": {
          "type": "integer",
          "minimum": 0
        },
        "outboxEventsReady": {
          "description": "本次 imported candidate 对应的 durable Post lifecycle 事件总数；Search 与 Recommendation 从同一 outbox 派生，但该计数不得推进 active pointer。",
          "type": "integer",
          "minimum": 0
        },
        "outboxEventsAppended": {
          "description": "本次调用新追加的事件数；同一 releaseId + digest 幂等重放时允许为 0。",
          "type": "integer",
          "minimum": 0
        },
        "postsRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "entitiesRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "feedRemoved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "postBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "postRef",
          "postId",
          "contentId",
          "contentVersion",
          "usageScope",
          "contentType",
          "authorId"
        ],
        "additionalProperties": false,
        "properties": {
          "postRef": {"type": "string", "pattern": "^(article|image|video)/[^/].*$"},
          "postId": {"type": "string", "minLength": 1},
          "contentId": {"type": "string", "minLength": 1},
          "contentVersion": {"type": "integer", "minimum": 1},
          "usageScope": {"enum": ["research", "commercial"]},
          "contentType": {"enum": ["article", "image", "video"]},
          "authorId": {"type": "string", "minLength": 1}
        }
      }
    },
    "auditEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceReportPath": {
      "type": "string"
    },
    "schema": {
      "const": "quwoquan.content_import_report"
    }
  }
}
