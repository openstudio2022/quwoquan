{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/import_report.schema.json",
  "title": "Environment import report (content importer 回执)",
  "description": "content-service cmd/import 产出的 import-<env>.json 契约（Go 侧写、数据侧消费）。ship 转写批次证据前必须通过本 Schema，防止导入证据链断裂。",
  "type": "object",
  "required": [
    "schema",
    "status",
    "environment",
    "releaseId",
    "sourceOwner",
    "manifestDigest",
    "counts",
    "postBindings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "description": "dry-run 只加载不写；staged/verified/active 是三阶段回执；imported 是历史一步式激活回执。",
      "type": "string",
      "enum": [
        "dry-run",
        "staged",
        "verified",
        "active",
        "imported"
      ]
    },
    "phase": {
      "description": "content importer 三阶段：stage 只写 posts_candidate 与 additive 媒体归属；verify 读回候选闭包；activate 才在单事务内提交 Post/outbox/pointer。",
      "enum": ["stage", "verify", "activate"]
    },
    "candidateRevision": {
      "description": "stage 分配、verify/activate 必须精确回显的候选身份。",
      "type": "integer",
      "minimum": 1
    },
    "previousReleaseId": {"type": "string"},
    "previousManifestDigest": {"type": "string"},
    "previousRevision": {"type": "integer", "minimum": 0},
    "candidatePostIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "candidateSourceHashes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceOwner": {
      "const": "qwq_data"
    },
    "manifestDigest": {
      "description": "完整 immutable release payload 摘要；必须等于 release attestation.payloadSha256。",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": ["upsert", "sync"]
    },
    "deletePolicy": {
      "enum": ["none", "tombstone"]
    },
    "counts": {
      "type": "object",
      "required": [
        "postsLoaded",
        "entitiesLoaded"
      ],
      "additionalProperties": false,
      "properties": {
        "postsLoaded": {
          "type": "integer",
          "minimum": 0
        },
        "entitiesLoaded": {
          "type": "integer",
          "minimum": 0
        },
        "articleLoaded": {"type": "integer", "minimum": 0},
        "imageLoaded": {"type": "integer", "minimum": 0},
        "videoLoaded": {"type": "integer", "minimum": 0},
        "researchLoaded": {"type": "integer", "minimum": 0},
        "commercialLoaded": {"type": "integer", "minimum": 0},
        "postsUpserted": {
          "type": "integer",
          "minimum": 0
        },
        "postsStaged": {
          "description": "stage 写入 posts_candidate 的候选 Post 数。",
          "type": "integer",
          "minimum": 0
        },
        "candidatePosts": {
          "description": "verify 按 candidateRevision 读回的候选 Post 数，必须等于 postsLoaded。",
          "type": "integer",
          "minimum": 0
        },
        "mediaAssetsProjected": {
          "description": "本次导入投影进 media_assets 的 release 媒体资产数；原图短签授权（DEC-031 research 消费面）依赖该投影存在。",
          "type": "integer",
          "minimum": 0
        },
        "entitiesUpserted": {
          "type": "integer",
          "minimum": 0
        },
        "feedUpserted": {
          "type": "integer",
          "minimum": 0
        },
        "outboxEventsReady": {
          "description": "本次 imported candidate 对应的 durable Post lifecycle 事件总数；Search 与 Recommendation 从同一 outbox 派生，但该计数不得推进 active pointer。",
          "type": "integer",
          "minimum": 0
        },
        "outboxEventsAppended": {
          "description": "本次调用新追加的事件数；同一 releaseId + digest 幂等重放时允许为 0。",
          "type": "integer",
          "minimum": 0
        },
        "postsRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "entitiesRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "feedRemoved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "postBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "postRef",
          "postId",
          "contentId",
          "contentVersion",
          "usageScope",
          "contentType",
          "authorId"
        ],
        "additionalProperties": false,
        "properties": {
          "postRef": {"type": "string", "pattern": "^(article|image|video)/[^/].*$"},
          "postId": {"type": "string", "minLength": 1},
          "contentId": {"type": "string", "minLength": 1},
          "contentVersion": {"type": "integer", "minimum": 1},
          "usageScope": {"enum": ["research", "commercial"]},
          "contentType": {"enum": ["article", "image", "video"]},
          "authorId": {"type": "string", "minLength": 1}
        }
      }
    },
    "auditEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "description": "成功 activation 后 data_release_state 的 authoritative revision。dry-run/staged/verified 不产生 revision。",
      "type": "integer",
      "minimum": 1
    },
    "sourceVersion": {
      "description": "成功 activation 后写入 Post/outbox/active pointer 的 immutable source version。",
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceReportPath": {
      "type": "string"
    },
    "schema": {
      "const": "quwoquan.content_import_report"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["imported", "active"]}}, "required": ["status"]},
      "then": {"required": ["revision", "sourceVersion", "mode", "deletePolicy", "auditEvents"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["revision"]},
            {"required": ["sourceVersion"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["staged", "verified", "active"]}}, "required": ["status"]},
      "then": {"required": ["phase", "candidateRevision"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["phase"]},
            {"required": ["candidateRevision"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "staged"}}, "required": ["status"]},
      "then": {
        "required": ["mode", "deletePolicy", "auditEvents", "previousReleaseId", "previousManifestDigest", "previousRevision"],
        "properties": {"phase": {"const": "stage"}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
      "then": {
        "required": ["candidatePostIds", "candidateSourceHashes", "auditEvents"],
        "properties": {"phase": {"const": "verify"}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {"properties": {"phase": {"const": "activate"}}}
    },
    {
      "if": {"properties": {"status": {"const": "dry-run"}}, "required": ["status"]},
      "then": {"required": ["mode", "deletePolicy", "auditEvents"]}
    }
  ]
}
