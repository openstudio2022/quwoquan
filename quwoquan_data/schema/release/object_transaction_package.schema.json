{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/object_transaction_package.schema.json",
  "title": "永久 publish freeze 下的单对象发布事务输入包",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transactionId",
    "executionId",
    "publishMediaMode",
    "sourcePolicyRevision",
    "target",
    "closure",
    "review",
    "objectClosureDigest"
  ],
  "properties": {
    "transactionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "inputPayloadDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publishMediaMode": {
      "enum": [
        "not_applicable",
        "text_only",
        "embedded_media"
      ]
    },
    "sourcePolicyRevision": {
      "enum": [
        "encyclopedia-primary",
        "rights-cleared-content",
        "governance-projection"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layoutSchema",
        "objectKind",
        "objectRef",
        "objectSchema",
        "packageObjectRef"
      ],
      "properties": {
        "layoutSchema": {
          "const": "quwoquan_data.canonical_publish"
        },
        "objectKind": {
          "enum": [
            "creators",
            "entities",
            "posts"
          ]
        },
        "objectRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "objectSchema": {
          "enum": [
            "quwoquan_data.creator_object",
            "quwoquan_data.entity_object",
            "quwoquan_data.post_object"
          ]
        },
        "packageObjectRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creatorRefs",
        "tagRefs",
        "sourceCatalogRef",
        "rightsRef",
        "casRefs"
      ],
      "properties": {
        "creatorRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tagRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceCatalogRef": {
          "type": "string",
          "minLength": 1
        },
        "rightsRef": {
          "type": "string",
          "minLength": 1
        },
        "casRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceRef",
              "objectKey",
              "sha256",
              "bytes"
            ],
            "properties": {
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "objectKey": {
                "type": "string",
                "pattern": "^media/objects/sha256/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}\\.[A-Za-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "creatorObjects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "creatorRef",
              "packageRef",
              "treeDigest"
            ],
            "properties": {
              "creatorRef": {
                "type": "string",
                "minLength": 1
              },
              "packageRef": {
                "type": "string",
                "minLength": 1
              },
              "treeDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestationRef"
      ],
      "properties": {
        "attestationRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objectClosureDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema": {
      "const": "quwoquan_data.object_transaction_package"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publishMediaMode": {
            "const": "text_only"
          }
        },
        "required": [
          "publishMediaMode"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "objectKind": {
                "const": "posts"
              }
            },
            "required": [
              "objectKind"
            ]
          },
          "closure": {
            "properties": {
              "casRefs": {
                "maxItems": 0
              }
            },
            "required": [
              "casRefs"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "closure": {
            "properties": {
              "casRefs": {
                "minItems": 1
              }
            },
            "required": [
              "casRefs"
            ]
          }
        }
      }
    }
  ]
}
