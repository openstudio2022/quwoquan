{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/homepage_import_report.schema.json",
  "title": "Homepage import report (entity-service homepage-import 回执)",
  "description": "Non-authoritative stage-only homepage importer report; candidate query receipt is admission authority.",
  "type": "object",
  "required": [
    "schema",
    "releaseId",
    "env",
    "dryRun",
    "sourceOwner",
    "manifestDigest",
    "projectionVersion",
    "closureDigest",
    "expected",
    "projected",
    "entityRefToHomepageId",
    "entityRefMappingDigest",
    "replayed",
    "verifiedAt",
    "issues",
    "finishedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_service.homepage_import_report"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "dryRun": {
      "type": "boolean"
    },
    "sourceOwner": {
      "const": "qwq_data"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projectionVersion": {
      "type": "integer",
      "minimum": 0
    },
    "closureDigest": {
      "type": "string"
    },
    "expected": {
      "type": "integer",
      "minimum": 0
    },
    "projected": {
      "type": "integer",
      "minimum": 0
    },
    "entityRefToHomepageId": {
      "type": "object"
    },
    "entityRefMappingDigest": {
      "type": "string"
    },
    "replayed": {
      "type": "boolean"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "issues": {
      "type": "array"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
