{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/pool_object_retirement_receipt.schema.json",
  "title": "Create-once retirement receipt for one canonical pool object",
  "description": "退役回执只声明「此对象退出可选集」这一件事。它是对象目录下的独立文档，不改写 manifest、generator 或任何审核回执；payloadDigest 冻结退役当时的原始证据字节，供事后复核字节未被改写。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "objectType", "objectRef", "objectId", "reason",
    "retiredAt", "payloadDigest", "inadmissibility"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.pool_object_retirement_receipt"},
    "objectType": {"enum": ["homepage", "content"]},
    "objectRef": {"type": "string", "minLength": 1},
    "objectId": {"type": "string", "minLength": 1},
    "reason": {
      "description": "退役原因闭集。成员与 core.control_types.PoolObjectRetirementReason 同源，每个成员绑定一条 discovery 层的 typed 不可准入判据，闭集外取值不得写入。",
      "enum": ["historical_generator_not_agent"]
    },
    "retiredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "payloadDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inadmissibility": {
      "description": "退役前该对象的不可准入判据事实，由 discovery 层逐对象判定产出，不由本回执自算。",
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "code"],
      "properties": {
        "gate": {"enum": ["quality", "eligibility", "delivery"]},
        "code": {"type": "string", "pattern": "^DATA\\.[A-Z0-9_.]+$"}
      }
    }
  }
}
