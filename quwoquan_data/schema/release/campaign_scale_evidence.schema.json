{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/campaign_scale_evidence.schema.json",
  "title": "Canonical four-lane campaign scale evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceId",
    "rootExecutionId",
    "status",
    "targetScale",
    "releaseId",
    "manifestDigest",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "campaignPlanRef",
    "campaignPlanDigest",
    "calibrationPreflightReceipt",
    "releaseAssetAdmissionRef",
    "releaseAssetAdmissionSha256",
    "predecessorCarriedExecutionIds",
    "releaseExecutionIds",
    "sourcePool",
    "sourcePoolDigest",
    "predecessorSourcePoolDigests",
    "lanes",
    "duplicateAssetCount",
    "crossLaneWriteCount",
    "articleIllustratedRate",
    "recordedAt",
    "evidenceDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.campaign_scale_evidence"},
    "evidenceId": {"type": "string", "minLength": 1},
    "rootExecutionId": {"type": "string", "minLength": 1},
    "runtimeSessionId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,127}$"},
    "runtimeSessionRef": {"$ref": "#/$defs/safeRef"},
    "runtimeSessionDigest": {"$ref": "#/$defs/digest"},
    "runId": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "fencingToken": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["passed", "failed"]},
    "targetScale": {"enum": ["M100", "M1000", "M10000"]},
    "releaseId": {"type": "string", "minLength": 1},
    "manifestDigest": {"$ref": "#/$defs/digest"},
    "sourceRevision": {"$ref": "#/$defs/digest"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "entityCatalogDigest": {"$ref": "#/$defs/digest"},
    "campaignPlanRef": {"$ref": "#/$defs/safeRef"},
    "campaignPlanDigest": {"$ref": "#/$defs/digest"},
    "calibrationPreflightReceipt": {
      "$ref": "../execution/semantic_provider_preflight_receipt_ref.schema.json"
    },
    "releaseAssetAdmissionRef": {"$ref": "#/$defs/safeRef"},
    "releaseAssetAdmissionSha256": {"$ref": "#/$defs/digest"},
    "predecessorPromotion": {
      "$ref": "#/$defs/predecessorPromotion"
    },
    "predecessorCarriedExecutionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "releaseExecutionIds": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourcePool": {"$ref": "campaign_scale_source_pool.schema.json"},
    "sourcePoolDigest": {"$ref": "#/$defs/digest"},
    "predecessorSourcePoolDigests": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/homepageLane"},
        {"$ref": "#/$defs/articleLane"},
        {"$ref": "#/$defs/imageLane"},
        {"$ref": "#/$defs/videoLane"}
      ],
      "items": false
    },
    "duplicateAssetCount": {"type": "integer", "minimum": 0},
    "crossLaneWriteCount": {"type": "integer", "minimum": 0},
    "articleIllustratedRate": {"type": "number", "minimum": 0, "maximum": 1},
    "fourLaneOverlapDurationSeconds": {"type": "integer", "minimum": 0},
    "fourLaneLongestContinuousOverlapSeconds": {"type": "integer", "minimum": 0},
    "allSemanticJobsTerminalAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "terminalResidualSampleAt": {"type": "string", "format": "date-time"},
    "scaleStartedAt": {"type": "string", "format": "date-time"},
    "scaleCompletedAt": {"type": "string", "format": "date-time"},
    "wallClockBudgetSeconds": {"type": ["integer", "null"], "minimum": 1},
    "wallClockSeconds": {"type": "integer", "minimum": 0},
    "resourceSoakEvidenceRef": {"$ref": "#/$defs/safeRef"},
    "resourceSoakEvidenceDigest": {"$ref": "#/$defs/digest"},
    "faultInjectionEvidenceRef": {"$ref": "#/$defs/safeRef"},
    "faultInjectionEvidenceDigest": {"$ref": "#/$defs/digest"},
    "diagnosticIssues": {
      "description": "Non-blocking runtime, resource, fault, timing or capacity observations that were unavailable or invalid.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "recordedAt": {"type": "string", "format": "date-time"},
    "evidenceDigest": {"$ref": "#/$defs/digest"}
  },
  "dependentRequired": {
    "runtimeSessionId": ["runtimeSessionRef", "runtimeSessionDigest", "runId", "generation", "fencingToken"],
    "runtimeSessionRef": ["runtimeSessionId", "runtimeSessionDigest", "runId", "generation", "fencingToken"],
    "runtimeSessionDigest": ["runtimeSessionId", "runtimeSessionRef", "runId", "generation", "fencingToken"],
    "runId": ["runtimeSessionId", "runtimeSessionRef", "runtimeSessionDigest", "generation", "fencingToken"],
    "generation": ["runtimeSessionId", "runtimeSessionRef", "runtimeSessionDigest", "runId", "fencingToken"],
    "fencingToken": ["runtimeSessionId", "runtimeSessionRef", "runtimeSessionDigest", "runId", "generation"],
    "scaleStartedAt": ["scaleCompletedAt", "wallClockBudgetSeconds", "wallClockSeconds"],
    "scaleCompletedAt": ["scaleStartedAt", "wallClockBudgetSeconds", "wallClockSeconds"],
    "wallClockBudgetSeconds": ["scaleStartedAt", "scaleCompletedAt", "wallClockSeconds"],
    "wallClockSeconds": ["scaleStartedAt", "scaleCompletedAt", "wallClockBudgetSeconds"],
    "resourceSoakEvidenceRef": [
      "resourceSoakEvidenceDigest", "runtimeSessionId", "runtimeSessionRef",
      "runtimeSessionDigest", "runId", "generation", "fencingToken",
      "fourLaneOverlapDurationSeconds", "fourLaneLongestContinuousOverlapSeconds",
      "allSemanticJobsTerminalAt", "terminalResidualSampleAt"
    ],
    "resourceSoakEvidenceDigest": ["resourceSoakEvidenceRef"],
    "faultInjectionEvidenceRef": [
      "faultInjectionEvidenceDigest", "runtimeSessionId", "runtimeSessionRef",
      "runtimeSessionDigest", "runId", "generation", "fencingToken"
    ],
    "faultInjectionEvidenceDigest": ["faultInjectionEvidenceRef"]
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "duplicateAssetCount": {"const": 0},
          "crossLaneWriteCount": {"const": 0},
          "fourLaneOverlapDurationSeconds": {"minimum": 0},
          "fourLaneLongestContinuousOverlapSeconds": {"minimum": 0}
        }
      }
    },
    {
      "if": {"properties": {"targetScale": {"const": "M100"}}, "required": ["targetScale"]},
      "then": {
        "not": {"required": ["predecessorPromotion"]},
        "properties": {
          "predecessorCarriedExecutionIds": {"maxItems": 0},
          "predecessorSourcePoolDigests": {"maxItems": 0},
          "wallClockBudgetSeconds": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"targetScale": {"const": "M1000"}}, "required": ["targetScale"]},
      "then": {
        "required": ["predecessorPromotion"],
        "properties": {
          "predecessorPromotion": {"properties": {"targetScale": {"const": "M100"}}},
          "predecessorCarriedExecutionIds": {"minItems": 4},
          "predecessorSourcePoolDigests": {"minItems": 1},
          "wallClockBudgetSeconds": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"targetScale": {"const": "M10000"}}, "required": ["targetScale"]},
      "then": {
        "required": ["predecessorPromotion"],
        "properties": {
          "predecessorPromotion": {"properties": {"targetScale": {"const": "M1000"}}},
          "predecessorCarriedExecutionIds": {"minItems": 4},
          "predecessorSourcePoolDigests": {"minItems": 2}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "predecessorPromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionId", "releaseId", "manifestDigest", "targetScale", "receiptRef",
        "receiptDigest"
      ],
      "properties": {
        "promotionId": {"type": "string", "minLength": 1},
        "releaseId": {"type": "string", "minLength": 1},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "sourceRevision": {"$ref": "#/$defs/digest"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "entityCatalogDigest": {"$ref": "#/$defs/digest"},
        "sourceIdentities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceIdentity"}
        },
        "sourceIdentitySetDigest": {"$ref": "#/$defs/digest"},
        "targetScale": {"enum": ["M100", "M1000"]},
        "receiptRef": {"$ref": "#/$defs/safeRef"},
        "receiptDigest": {"$ref": "#/$defs/digest"}
      },
      "oneOf": [
        {
          "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest"],
          "not": {"anyOf": [{"required": ["sourceIdentities"]}, {"required": ["sourceIdentitySetDigest"]}]}
        },
        {
          "required": ["sourceIdentities", "sourceIdentitySetDigest"],
          "not": {"anyOf": [{"required": ["sourceRevision"]}, {"required": ["sourceDigest"]}, {"required": ["entityCatalogDigest"]}]}
        }
      ]
    },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest", "executionIds"],
      "properties": {
        "sourceRevision": {"$ref": "#/$defs/digest"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "entityCatalogDigest": {"$ref": "#/$defs/digest"},
        "executionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "executionId",
        "retryChain",
        "publishReceiptRef",
        "publishReceiptSha256",
        "executionPublishRef",
        "executionPublishSha256",
        "finalizedCount",
        "researchAcceptedCount",
        "predecessorCarriedCount",
        "newFinalizedCount",
        "totalUniqueFinalizedCount",
        "semanticCalibration"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "executionId": {"type": "string", "minLength": 1},
        "retryChain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "publishReceiptRef": {"$ref": "#/$defs/safeRef"},
        "publishReceiptSha256": {"$ref": "#/$defs/digest"},
        "executionPublishRef": {"$ref": "#/$defs/safeRef"},
        "executionPublishSha256": {"$ref": "#/$defs/digest"},
        "finalizedCount": {"type": "integer", "minimum": 1},
        "researchAcceptedCount": {"type": "integer", "minimum": 0},
        "predecessorCarriedCount": {"type": "integer", "minimum": 0},
        "newFinalizedCount": {"type": "integer", "minimum": 1},
        "totalUniqueFinalizedCount": {"type": "integer", "minimum": 1},
        "semanticCalibration": {"$ref": "#/$defs/semanticCalibration"}
      }
    },
    "semanticCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "provider",
        "authorModel",
        "authorModelFamily",
        "reviewerModel",
        "reviewerModelFamily",
        "calibrationProvider",
        "calibrationModel",
        "calibrationModelFamily",
        "executionManifestRef",
        "executionManifestSha256",
        "authorRun",
        "reviewerRun",
        "selectionPolicy",
        "calibrationRuns"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "provider": {"enum": ["cursor_sdk", "codex_sdk"]},
        "authorModel": {"type": "string", "minLength": 1},
        "authorModelFamily": {"type": "string", "minLength": 1},
        "reviewerModel": {"type": "string", "minLength": 1},
        "reviewerModelFamily": {"type": "string", "minLength": 1},
        "calibrationProvider": {"const": "codex_sdk"},
        "calibrationModel": {"const": "gpt-5.6-sol"},
        "calibrationModelFamily": {"const": "gpt"},
        "executionManifestRef": {"$ref": "#/$defs/safeRef"},
        "executionManifestSha256": {"$ref": "#/$defs/digest"},
        "authorRun": {"$ref": "#/$defs/semanticRunEvidence"},
        "reviewerRun": {"$ref": "#/$defs/semanticRunEvidence"},
        "selectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampleRate",
            "minimumSampleCount",
            "smallBatchPolicy",
            "acceptedObjectCount",
            "requiredSampleCount",
            "selectedObjectRefs",
            "selectionDigest"
          ],
          "properties": {
            "sampleRate": {"const": 0.1},
            "minimumSampleCount": {"const": 10},
            "smallBatchPolicy": {"const": "all"},
            "acceptedObjectCount": {"type": "integer", "minimum": 1},
            "requiredSampleCount": {"type": "integer", "minimum": 1},
            "selectedObjectRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "selectionDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "calibrationRuns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticRunEvidence"}
        }
      }
    },
    "semanticRunEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectRef",
        "runId",
        "evidenceRef",
        "evidenceSha256"
      ],
      "properties": {
        "objectRef": {"type": "string", "minLength": 1},
        "runId": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "^contract-output:"}
        },
        "evidenceRef": {"$ref": "#/$defs/safeRef"},
        "evidenceSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "homepageLane": {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"carrier": {"const": "homepage"}}}]},
    "articleLane": {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"carrier": {"const": "article"}}}]},
    "imageLane": {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"carrier": {"const": "image"}}}]},
    "videoLane": {"allOf": [{"$ref": "#/$defs/lane"}, {"properties": {"carrier": {"const": "video"}}}]}
  }
}
