{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/creator_import_report.schema.json",
  "title": "Creator import report",
  "type": "object",
  "required": ["schema", "status", "environment", "releaseId", "sourceOwner", "mode", "projectionDatabase", "counts", "authorIds", "verifiedCreatorIds", "generatedAt"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan.user_creator_import_report"},
    "status": {"enum": ["dry-run", "active"]},
    "environment": {"type": "string", "minLength": 1},
    "releaseId": {"type": "string", "minLength": 1},
    "sourceOwner": {"const": "qwq_data"},
    "mode": {"enum": ["upsert", "sync"]},
    "projectionDatabase": {"const": "quwoquan_user"},
    "counts": {
      "type": "object",
      "required": ["creatorsLoaded", "usersUpserted", "creatorsUpserted", "usersRemoved", "creatorsRemoved"],
      "additionalProperties": false,
      "properties": {
        "creatorsLoaded": {"type": "integer", "minimum": 0},
        "usersUpserted": {"type": "integer", "minimum": 0},
        "creatorsUpserted": {"type": "integer", "minimum": 0},
        "usersRemoved": {"type": "integer", "minimum": 0},
        "creatorsRemoved": {"type": "integer", "minimum": 0}
      }
    },
    "authorIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verifiedCreatorIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "generatedAt": {"type": "string", "minLength": 1}
  }
}
