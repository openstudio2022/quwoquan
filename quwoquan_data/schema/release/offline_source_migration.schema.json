{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "显式冻结 canonical 源的离线工程转换审计；不签发发布或审核资格",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "purpose", "sourceRevision", "selectionDigest", "originalFiles", "convertedFiles", "objects"],
  "properties": {
    "schema": {"const": "quwoquan.offline_source_migration"},
    "version": {"const": 1},
    "purpose": {"const": "alpha_offline_engineering"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selectionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "originalFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "convertedFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "objects": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["originalRef", "convertedRef", "originalManifestDigest", "convertedManifestDigest", "originalVersion", "convertedVersion"],
      "properties": {
        "originalRef": {"type": "string", "minLength": 1},
        "convertedRef": {"type": "string", "minLength": 1},
        "originalManifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "convertedManifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "originalVersion": {"type": "integer", "minimum": 1},
        "convertedVersion": {"type": "integer", "minimum": 2}
      }
    }}
  },
  "$defs": {"file": {
    "type": "object", "additionalProperties": false,
    "required": ["ref", "sha256", "byteLength"],
    "properties": {
      "ref": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "byteLength": {"type": "integer", "minimum": 0}
    }
  }}
}
