{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/fault_injection_event.schema.json",
  "title": "One immutable typed fault-injection event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "caseId",
    "faultType",
    "carrier",
    "executionId",
    "jobId",
    "triggeredAt"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.fault_injection_event"},
    "caseId": {"type": "string", "minLength": 1},
    "faultType": {"$ref": "#/$defs/faultType"},
    "carrier": {"enum": ["homepage", "article", "image", "video"]},
    "executionId": {"type": "string", "minLength": 1},
    "jobId": {"type": "string", "minLength": 8},
    "triggeredAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "faultType": {
      "enum": [
        "worker_termination",
        "lease_expiry",
        "redis_restart",
        "mongo_reconnect",
        "provider_timeout",
        "provider_rate_limit"
      ]
    }
  }
}
