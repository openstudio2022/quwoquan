{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseClass",
    "producerBaselineRevision",
    "objectRefs",
    "expectedCarrierCounts"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.release_cohort"
    },
    "releaseClass": {
      "enum": [
        "research",
        "commercial"
      ]
    },
    "milestone": {
      "enum": [
        "M1",
        "M10",
        "M100",
        "M1000",
        "M10000"
      ]
    },
    "objectRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(entities|posts)/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      }
    },
    "expectedCarrierCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 0
        },
        "article": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "producerBaselineRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
