{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/pool_append_batch.schema.json",
  "title": "Object-level pool append batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "appendSetId", "items"],
  "properties": {
    "schema": {"const": "quwoquan_data.pool_append_batch"},
    "appendSetId": {"type": "string", "minLength": 1},
    "batchDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "sourceRef", "record"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "sourceRef": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema", "objectType", "objectId", "objectRef", "recordSequence", "contentVersion",
              "status", "processResult", "qualityResult", "eligibilityResult",
              "usageScope", "evidenceRef", "evidenceDigest", "payloadDigest"
            ],
            "properties": {
              "schema": {"const": "quwoquan_data.pool_object_record"},
              "objectType": {"enum": ["author", "homepage", "content"]},
              "objectId": {"type": "string", "minLength": 1},
              "objectRef": {"type": "string", "minLength": 1},
              "recordSequence": {"type": "integer", "minimum": 1},
              "contentVersion": {"type": "integer", "minimum": 1},
              "status": {"enum": ["active", "retired", "deleted"]},
              "processResult": {"enum": ["completed", "failed"]},
              "qualityResult": {"enum": ["passed", "failed"]},
              "eligibilityResult": {"enum": ["passed", "pending", "failed"]},
              "usageScope": {"type": ["string", "null"], "enum": ["research", "commercial", null]},
              "evidenceRef": {"type": "string", "minLength": 1},
              "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "payloadDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "canonicalObjectDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "sourceIdentity": {
                "type": "object", "additionalProperties": false,
                "required": ["executionId", "sourceRevision", "sourceDigest", "entityCatalogDigest", "identityDigest"],
                "properties": {
                  "executionId": {"type": "string", "minLength": 1},
                  "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "identityDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                }
              },
              "sourceAttribution": {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"}
            },
            "allOf": [
              {
                "if": {"properties": {"objectType": {"enum": ["homepage", "content"]}}, "required": ["objectType"]},
                "then": {"required": ["canonicalObjectDigest", "sourceIdentity", "sourceAttribution"]}
              }
            ]
          }
        }
      }
    }
  }
}
