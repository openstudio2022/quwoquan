{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/release_identity_incident_legacy_migration.schema.json",
  "type": "object",
  "required": [
    "schema",
    "migrationId",
    "releaseId",
    "incidentId",
    "status",
    "storageClass",
    "sourceIncident",
    "contractBoundary",
    "classification",
    "evidenceSnapshots",
    "projection",
    "recordedAt",
    "receiptDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.release_identity_incident_legacy_migration"
    },
    "migrationId": { "const": "legacy-original-file-v1" },
    "releaseId": { "type": "string", "minLength": 1 },
    "incidentId": { "type": "string", "minLength": 1 },
    "status": { "const": "migrated" },
    "storageClass": { "const": "append_only_create_once" },
    "sourceIncident": {
      "type": "object",
      "required": [
        "ref",
        "fileSha256",
        "receiptDigest",
        "recordedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "receiptDigest": { "$ref": "#/$defs/sha256" },
        "recordedAt": { "type": "string", "minLength": 1 }
      }
    },
    "contractBoundary": {
      "type": "object",
      "required": [
        "commit",
        "committedAt",
        "schemaRef",
        "schemaFileSha256",
        "predecessorSchemaAbsent"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "committedAt": { "type": "string", "minLength": 1 },
        "schemaRef": { "type": "string", "minLength": 1 },
        "schemaFileSha256": { "$ref": "#/$defs/sha256" },
        "predecessorSchemaAbsent": { "const": true }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "acquisitionMode",
        "basis",
        "recoveryFieldsAbsent"
      ],
      "additionalProperties": false,
      "properties": {
        "acquisitionMode": { "const": "original_file" },
        "basis": { "const": "pre_contract_original_snapshot_closed_world" },
        "recoveryFieldsAbsent": { "const": true }
      }
    },
    "evidenceSnapshots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "sourceRef",
          "normalizedRef",
          "fileSha256",
          "releaseId",
          "payloadSha256",
          "canonicalMerkle",
          "executionIds"
        ],
        "additionalProperties": false,
        "properties": {
          "sourceRef": { "type": "string", "minLength": 1 },
          "normalizedRef": { "type": "string", "minLength": 1 },
          "fileSha256": { "$ref": "#/$defs/sha256" },
          "releaseId": { "type": "string", "minLength": 1 },
          "payloadSha256": { "$ref": "#/$defs/sha256" },
          "canonicalMerkle": { "$ref": "#/$defs/sha256" },
          "executionIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "required": ["ref", "fileSha256", "receiptDigest"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "receiptDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "recordedAt": { "type": "string", "minLength": 1 },
    "receiptDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
