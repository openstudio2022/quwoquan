{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/schema/release/asset_rights_closure.schema.json",
  "title": "Asset Rights Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assetRights"
      }
    },
    "schema": {
      "const": "quwoquan_data.asset_rights_closure"
    }
  },
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "bytes"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mimeType": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "assetRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "sourceKind",
        "sourceUseMode",
        "canonicalFilePage",
        "snapshotUrl",
        "pageRevision",
        "originalAssetUrl",
        "author",
        "source",
        "licenseName",
        "licenseShortName",
        "licenseUrl",
        "usageScope",
        "attribution",
        "caption",
        "captionSource",
        "modifications",
        "fetchedAt",
        "snapshot",
        "asset",
        "authorizationProof",
        "modelReleaseStatus",
        "rightsAuditStatus",
        "rightsAuditIssues"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceUseMode": {
          "enum": [
            "licensed_adaptation",
            "factual_reference_only",
            "self_generated_original",
            "rights_audit_only"
          ]
        },
        "canonicalFilePage": {
          "type": "string",
          "pattern": "^https://"
        },
        "snapshotUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "pageRevision": {
          "type": "string",
          "minLength": 1
        },
        "originalAssetUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "licenseName": {
          "type": "string",
          "minLength": 1
        },
        "licenseShortName": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "usageScope": {
          "enum": [
            "app_publish",
            "editorial"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "captionSource": {
          "type": "string",
          "minLength": 1
        },
        "modifications": {
          "type": "string",
          "minLength": 1
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "$ref": "#/$defs/blob"
        },
        "asset": {
          "allOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "object",
              "required": [
                "mimeType",
                "width",
                "height"
              ],
              "properties": {
                "mimeType": {
                  "type": "string",
                  "pattern": "^(image|video)/"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "authorizationProof": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "modelReleaseStatus": {
          "enum": [
            "not_required",
            "obtained",
            "editorial_only"
          ]
        },
        "rightsAuditStatus": {
          "enum": ["verified", "unverified"]
        },
        "rightsAuditIssues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rightsAuditStatus": { "const": "verified" }
            },
            "required": ["rightsAuditStatus"]
          },
          "then": {
            "properties": {
              "sourceUseMode": {
                "enum": [
                  "licensed_adaptation",
                  "factual_reference_only",
                  "self_generated_original"
                ]
              },
              "author": { "minLength": 1 },
              "licenseName": { "minLength": 1 },
              "licenseShortName": { "minLength": 1 },
              "authorizationProof": { "pattern": "^https://" },
              "rightsAuditIssues": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "sourceUseMode": { "const": "rights_audit_only" },
              "rightsAuditIssues": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
