{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/schema/release/asset_rights_closure.schema.json",
  "title": "Asset Rights Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRights"
      }
    },
    "publishMediaMode": {
      "enum": ["not_applicable", "text_only", "embedded_media"]
    },
    "schema": {
      "const": "quwoquan_data.asset_rights_closure"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"publishMediaMode": {"const": "text_only"}},
        "required": ["publishMediaMode"]
      },
      "then": {
        "properties": {"assets": {"maxItems": 0}},
        "required": ["assets"]
      },
      "else": {
        "properties": {"assets": {"minItems": 1}},
        "required": ["assets"]
      }
    }
  ],
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "bytes"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mimeType": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "independentAssetReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId", "assetKind", "objectRef", "receiptRef",
        "receiptDigest", "receiptFileSha256", "sourceRevision",
        "sourceDigest", "entityCatalogDigest", "acquisitionReceiptRef",
        "acquisitionReceiptDigest", "acquisitionReceiptSha256",
        "acquisitionAssetId", "contentSha256", "casRef",
        "reviewDecision", "reviewer"
      ],
      "properties": {
        "reviewId": {
          "type": "string",
          "pattern": "^asset-review-[0-9a-f]{64}$"
        },
        "assetKind": {"enum": ["image", "video"]},
        "objectRef": {"type": "string", "minLength": 1},
        "receiptRef": {
          "type": "string",
          "pattern": "^data/tasks/[^/]+/evidence/asset_reviews/receipts/asset-review-[0-9a-f]{64}\\.json$"
        },
        "receiptDigest": {"$ref": "#/$defs/sha256"},
        "receiptFileSha256": {"$ref": "#/$defs/sha256"},
        "sourceRevision": {"$ref": "#/$defs/sha256"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
        "acquisitionReceiptRef": {
          "type": "string",
          "pattern": "^data/local/workspace/source-acquisition/((video/)?receipts|professional-image-supported-api-preparations/professional-image-supported-api-[0-9a-f]{16}/receipts)/[0-9a-f]{64}(-attempt-[0-9]{3,})?\\.json$"
        },
        "acquisitionReceiptDigest": {"$ref": "#/$defs/sha256"},
        "acquisitionReceiptSha256": {"$ref": "#/$defs/sha256"},
        "acquisitionAssetId": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "casRef": {"type": "string", "minLength": 1},
        "reviewDecision": {"const": "accepted"},
        "mediaProbeDigest": {"$ref": "#/$defs/sha256"},
        "popularitySignalsDigest": {"$ref": "#/$defs/sha256"},
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "runId"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "runId": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"assetKind": {"const": "video"}},
            "required": ["assetKind"]
          },
          "then": {
            "required": ["mediaProbeDigest", "popularitySignalsDigest"]
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "sourceKind",
        "sourceUseMode",
        "canonicalFilePage",
        "snapshotUrl",
        "pageRevision",
        "originalAssetUrl",
        "author",
        "source",
        "licenseName",
        "licenseShortName",
        "licenseUrl",
        "usageScope",
        "attribution",
        "caption",
        "captionSource",
        "modifications",
        "fetchedAt",
        "snapshot",
        "asset",
        "authorizationProof",
        "distributionDecision",
        "modelReleaseStatus",
        "rightsAuditStatus",
        "rightsAuditIssues"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "acquisitionReceiptRef": {
          "type": "string",
          "pattern": "^data/local/workspace/source-acquisition/((video/)?receipts|professional-image-supported-api-preparations/professional-image-supported-api-[0-9a-f]{16}/receipts)/[0-9a-f]{64}(-attempt-[0-9]{3,})?\\.json$"
        },
        "independentAssetReview": {
          "$ref": "#/$defs/independentAssetReview"
        },
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceUseMode": {
          "enum": [
            "licensed_adaptation",
            "factual_reference_only",
            "self_generated_original",
            "rights_audit_only"
          ]
        },
        "canonicalFilePage": {
          "type": "string",
          "pattern": "^https://"
        },
        "snapshotUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "pageRevision": {
          "type": "string",
          "minLength": 1
        },
        "originalAssetUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "licenseName": {
          "type": "string",
          "minLength": 1
        },
        "licenseShortName": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "usageScope": {
          "enum": [
            "app_publish",
            "editorial"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "captionSource": {
          "type": "string",
          "minLength": 1
        },
        "modifications": {
          "type": "string",
          "minLength": 1
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "$ref": "#/$defs/blob"
        },
        "asset": {
          "allOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "object",
              "required": [
                "mimeType",
                "width",
                "height"
              ],
              "properties": {
                "mimeType": {
                  "type": "string",
                  "pattern": "^(image|video)/"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "authorizationProof": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "distributionDecision": {
          "enum": [
            "research_allowed",
            "commercial_allowed"
          ]
        },
        "modelReleaseStatus": {
          "enum": [
            "not_required",
            "obtained",
            "editorial_only"
          ]
        },
        "rightsAuditStatus": {
          "enum": ["verified", "unverified", "restricted", "unknown"]
        },
        "rightsAuditIssues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "dependentRequired": {
        "acquisitionReceiptRef": ["independentAssetReview"],
        "independentAssetReview": ["acquisitionReceiptRef"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rightsAuditStatus": { "const": "verified" }
            },
            "required": ["rightsAuditStatus"]
          },
          "then": {
            "properties": {
              "sourceUseMode": {
                "enum": [
                  "licensed_adaptation",
                  "factual_reference_only",
                  "self_generated_original"
                ]
              },
              "author": { "minLength": 1 },
              "licenseName": { "minLength": 1 },
              "licenseShortName": { "minLength": 1 },
              "authorizationProof": { "pattern": "^https://" },
              "rightsAuditIssues": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "sourceUseMode": { "const": "rights_audit_only" },
              "rightsAuditIssues": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
