{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/schema/release/asset_rights_closure.schema.json",
  "title": "Asset Rights Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assetRights"
      }
    },
    "publishMediaMode": {
      "enum": [
        "not_applicable",
        "text_only",
        "embedded_media"
      ]
    },
    "schema": {
      "const": "quwoquan_data.asset_rights_closure"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publishMediaMode": {
            "const": "text_only"
          }
        },
        "required": [
          "publishMediaMode"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "maxItems": 0
          }
        },
        "required": [
          "assets"
        ]
      },
      "else": {
        "properties": {
          "assets": {
            "minItems": 1
          }
        },
        "required": [
          "assets"
        ]
      }
    }
  ],
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "bytes"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mimeType": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "sourceKind",
        "sourceUseMode",
        "canonicalFilePage",
        "snapshotUrl",
        "pageRevision",
        "originalAssetUrl",
        "author",
        "source",
        "licenseName",
        "licenseShortName",
        "licenseUrl",
        "usageScope",
        "attribution",
        "caption",
        "captionSource",
        "modifications",
        "fetchedAt",
        "snapshot",
        "asset",
        "authorizationProof",
        "distributionDecision",
        "modelReleaseStatus",
        "rightsAuditStatus",
        "rightsAuditIssues"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceUseMode": {
          "enum": [
            "licensed_adaptation",
            "factual_reference_only",
            "self_generated_original",
            "rights_audit_only"
          ]
        },
        "canonicalFilePage": {
          "type": "string",
          "pattern": "^https://"
        },
        "snapshotUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "pageRevision": {
          "type": "string",
          "minLength": 1
        },
        "originalAssetUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "licenseName": {
          "type": "string",
          "minLength": 1
        },
        "licenseShortName": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "usageScope": {
          "enum": [
            "app_publish",
            "editorial"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "captionSource": {
          "type": "string",
          "minLength": 1
        },
        "modifications": {
          "type": "string",
          "minLength": 1
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "$ref": "#/$defs/blob"
        },
        "asset": {
          "allOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "object",
              "required": [
                "mimeType",
                "width",
                "height"
              ],
              "properties": {
                "mimeType": {
                  "type": "string",
                  "pattern": "^(image|video)/"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "authorizationProof": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "distributionDecision": {
          "enum": [
            "research_allowed",
            "commercial_allowed",
            "blocked"
          ]
        },
        "modelReleaseStatus": {
          "enum": [
            "not_required",
            "obtained",
            "editorial_only",
            "verified",
            "unverified"
          ]
        },
        "commercialAuthorizationStatus": {"enum": ["verified", "unverified"]},
        "propertyReleaseStatus": {"type": "string", "minLength": 1},
        "audioRightsStatus": {"enum": ["licensed", "original_authorized", "replaced_with_licensed_track", "no_audio", "unverified"]},
        "derivedModifications": {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution/properties/derivedModifications"},
        "watermarkNote": {"type": "string"},
        "watermarkStatus": {
          "description": "由看过像素的 AI 申报并经 ingest 转录；缺席只能记 unknown，不得假定 absent。",
          "enum": ["absent", "present", "unknown"]
        },
        "watermarkKind": {
          "enum": ["none", "author_signature", "platform_logo", "stock_agency", "other", "unknown"]
        },
        "accessPolicy": {
          "description": "来源站点 robots/ToS 对自动访问的态度，由 ingest 资产行原样转录；只记录不阻断，缺席即缺席。",
          "enum": ["open", "robots_disallowed", "tos_restricted"]
        },
        "rightsAuditStatus": {
          "enum": [
            "verified",
            "unverified",
            "restricted",
            "unknown"
          ]
        },
        "rightsAuditIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rightsAuditStatus": {
                "const": "verified"
              }
            },
            "required": [
              "rightsAuditStatus"
            ]
          },
          "then": {
            "properties": {
              "sourceUseMode": {
                "enum": [
                  "licensed_adaptation",
                  "factual_reference_only",
                  "self_generated_original"
                ]
              },
              "author": {
                "minLength": 1
              },
              "licenseName": {
                "minLength": 1
              },
              "licenseShortName": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "rightsAuditIssues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
