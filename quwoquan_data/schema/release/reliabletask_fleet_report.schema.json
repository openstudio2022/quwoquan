{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/reliabletask_fleet_report.schema.json",
  "type": "object",
  "required": [
    "schema",
    "passed",
    "backend",
    "total",
    "succeeded",
    "stageCompletedCount",
    "publishTaskCount",
    "objectTransactionResultCount",
    "commercialAcceptedCount",
    "fleetControlPlaneThroughputPerHour",
    "fleetAcceptedThroughputPerHour",
    "endToEndAcceptedThroughputPerHour",
    "acceptedContentThroughputStatus",
    "recoveryEligibleCount",
    "automaticRecoveredCount",
    "manualRecoveredCount",
    "automaticRecoveryStatus",
    "automaticRecoveryRate",
    "firstAttemptSuccessRate",
    "finalizedWithinStageBudgetRate",
    "duplicatePublishCount",
    "missingObjectCount",
    "requiredQuota",
    "finalizedObjectCount",
    "idempotencyKey",
    "taskOutcomes",
    "executionCreatedAt",
    "fleetStartedAt",
    "canonicalFinalizedAt",
    "fleetWallClockMilliseconds",
    "endToEndWallClockMilliseconds",
    "completedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "backend": {
      "const": "mongodb+redis"
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "succeeded": {
      "type": "integer",
      "minimum": 0
    },
    "stageCompletedCount": {
      "type": "integer",
      "minimum": 0
    },
    "publishTaskCount": {
      "type": "integer",
      "minimum": 0
    },
    "objectTransactionResultCount": {
      "type": "integer",
      "minimum": 0
    },
    "commercialAcceptedCount": {
      "type": "integer",
      "minimum": 0
    },
    "fleetControlPlaneThroughputPerHour": {
      "type": "number",
      "minimum": 0
    },
    "fleetAcceptedThroughputPerHour": {
      "type": "number",
      "minimum": 0
    },
    "endToEndAcceptedThroughputPerHour": {
      "type": "number",
      "minimum": 0
    },
    "acceptedContentThroughputStatus": {
      "enum": [
        "MEASURED",
        "GATE_BLOCK_NO_COMMERCIAL_BATCH",
        "GATE_BLOCK_INCOMPLETE_COMMERCIAL_BATCH"
      ]
    },
    "automaticRecoveryRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recoveryEligibleCount": {"type": "integer", "minimum": 0},
    "automaticRecoveredCount": {"type": "integer", "minimum": 0},
    "manualRecoveredCount": {"type": "integer", "minimum": 0},
    "automaticRecoveryStatus": {"enum": ["MEASURED", "NOT_EXERCISED"]},
    "firstAttemptSuccessRate": {"type": "number", "minimum": 0, "maximum": 1},
    "finalizedWithinStageBudgetRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stageLatencyP99Ms": {
      "type": "integer",
      "minimum": 0
    },
    "workerUtilization": {
      "type": "number",
      "minimum": 0
    },
    "repairCount": {
      "type": "integer",
      "minimum": 0
    },
    "reasonedAbandonCount": {
      "type": "integer",
      "minimum": 0
    },
    "storageErrorCount": {
      "type": "integer",
      "minimum": 0
    },
    "queueLag": {
      "type": "integer",
      "minimum": 0
    },
    "duplicatePublishCount": {
      "type": "integer",
      "minimum": 0
    },
    "missingObjectCount": {
      "type": "integer",
      "minimum": 0
    },
    "requiredQuota": {
      "type": "integer",
      "minimum": 1
    },
    "finalizedObjectCount": {
      "type": "integer",
      "minimum": 0
    },
    "idempotencyKey": {
      "const": "executionId+entity+carrier+sourceRevision+stage"
    },
    "taskOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["jobId", "status", "attempts"],
        "additionalProperties": false,
        "properties": {
          "jobId": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["ready", "processing", "retry_wait", "succeeded", "dead"]
          },
          "attempts": {"type": "integer", "minimum": 0},
          "failureCode": {"type": "string", "minLength": 1}
        }
      }
    },
    "executionCreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fleetStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalFinalizedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "fleetWallClockMilliseconds": {
      "type": "integer",
      "minimum": 0
    },
    "endToEndWallClockMilliseconds": {
      "type": "integer",
      "minimum": 0
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "schema": {
      "const": "quwoquan.reliabletask_fleet_report"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"recoveryEligibleCount": {"const": 0}},
        "required": ["recoveryEligibleCount"]
      },
      "then": {
        "properties": {
          "automaticRecoveredCount": {"const": 0},
          "manualRecoveredCount": {"const": 0},
          "automaticRecoveryStatus": {"const": "NOT_EXERCISED"},
          "automaticRecoveryRate": {"const": 0}
        }
      },
      "else": {
        "properties": {
          "automaticRecoveryStatus": {"const": "MEASURED"}
        }
      }
    }
  ]
}
