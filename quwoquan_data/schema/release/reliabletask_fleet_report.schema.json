{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/reliabletask_fleet_report.schema.json",
  "type": "object",
  "required": [
    "schema",
    "passed",
    "backend",
    "total",
    "succeeded",
    "stageCompletedCount",
    "publishTaskCount",
    "objectTransactionResultCount",
    "commercialAcceptedCount",
    "controlPlaneTaskThroughputPerHour",
    "acceptedContentThroughputPerHour",
    "acceptedContentThroughputStatus",
    "automaticRecoveryRate",
    "finalizedWithinStageBudgetRate",
    "duplicatePublishCount",
    "missingObjectCount",
    "idempotencyKey",
    "completedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "backend": {
      "const": "mongodb+redis"
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "succeeded": {
      "type": "integer",
      "minimum": 0
    },
    "stageCompletedCount": {
      "type": "integer",
      "minimum": 0
    },
    "publishTaskCount": {
      "type": "integer",
      "minimum": 0
    },
    "objectTransactionResultCount": {
      "type": "integer",
      "minimum": 0
    },
    "commercialAcceptedCount": {
      "type": "integer",
      "minimum": 0
    },
    "controlPlaneTaskThroughputPerHour": {
      "type": "number",
      "minimum": 0
    },
    "acceptedContentThroughputPerHour": {
      "type": "number",
      "minimum": 0
    },
    "acceptedContentThroughputStatus": {
      "enum": [
        "MEASURED",
        "GATE_BLOCK_NO_COMMERCIAL_BATCH",
        "GATE_BLOCK_INCOMPLETE_COMMERCIAL_BATCH"
      ]
    },
    "automaticRecoveryRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "finalizedWithinStageBudgetRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stageLatencyP99Ms": {
      "type": "integer",
      "minimum": 0
    },
    "workerUtilization": {
      "type": "number",
      "minimum": 0
    },
    "repairCount": {
      "type": "integer",
      "minimum": 0
    },
    "reasonedAbandonCount": {
      "type": "integer",
      "minimum": 0
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "storageErrorCount": {
      "type": "integer",
      "minimum": 0
    },
    "queueLag": {
      "type": "integer",
      "minimum": 0
    },
    "duplicatePublishCount": {
      "type": "integer",
      "minimum": 0
    },
    "missingObjectCount": {
      "type": "integer",
      "minimum": 0
    },
    "idempotencyKey": {
      "const": "entity+carrier+sourceRevision+stage"
    },
    "completedAt": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "quwoquan.reliabletask_fleet_report"
    }
  }
}
