{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/environment_release_readiness.schema.json",
  "title": "Release-bound environment content readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "releaseId",
    "releaseKind",
    "releaseClass",
    "productLifecycleState",
    "containsUnverifiedAssets",
    "rightsStatusCounts",
    "authorizationRequiredAssetIds",
    "researchAcceptedCount",
    "commercialAcceptedCount",
    "sourceOwner",
    "readinessPhase",
    "manifestDigest",
    "mediaManifestDigest",
    "importRunId",
    "verifyRunId",
    "guestActorHash",
    "guestLogin",
    "counts",
    "entityRefs",
    "postIds",
    "creatorIds",
    "tagRefs",
    "mediaAssetIds",
    "feedQueries",
    "contentImportReportRef",
    "creatorAttributionRef",
    "tagAttributionRef",
    "homepageApiVerificationRef",
    "postApiVerificationRef",
    "mediaManifestRef",
    "verifiedAt",
    "verificationChecksum",
    "passed"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.environment_release_readiness"},
    "environment": {"enum": ["alpha", "beta", "gamma", "prod"]},
    "releaseId": {"type": "string", "minLength": 1},
    "releaseKind": {"const": "content"},
    "sourceOwner": {"const": "qwq_data"},
    "releaseClass": {"enum": ["research", "commercial"]},
    "productLifecycleState": {"enum": ["research", "commercial"]},
    "containsUnverifiedAssets": {"type": "boolean"},
    "rightsStatusCounts": {"type": "object", "required": ["verified", "unverified", "restricted", "unknown"], "additionalProperties": false, "properties": {"verified": {"type": "integer", "minimum": 0}, "unverified": {"type": "integer", "minimum": 0}, "restricted": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}}},
    "authorizationRequiredAssetIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "researchAcceptedCount": {"type": "integer", "minimum": 0},
    "commercialAcceptedCount": {"type": "integer", "minimum": 0},
    "readinessPhase": {"enum": ["research", "consumer", "commercial"]},
    "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mediaManifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "importRunId": {"type": "string", "minLength": 1},
    "verifyRunId": {"type": "string", "minLength": 1},
    "guestActorHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "guestLogin": {
      "allOf": [
        {"$ref": "#/$defs/operationEvidence"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "/auth/login/anonymous"},
            "pageId": {"const": "user.login.anonymous"},
            "status": {"const": 200}
          }
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "posts", "creators", "avatarAssets", "imageAssets", "tags", "mediaAssets", "discoveryPosts", "premiumPlayableVideos"],
      "properties": {
        "entities": {"type": "integer", "minimum": 1},
        "posts": {"type": "integer", "minimum": 1},
        "creators": {"type": "integer", "minimum": 1},
        "avatarAssets": {
          "type": "integer",
          "minimum": 1,
          "description": "Release-bound creator avatars whose exact canonical URL returned HTTP 200/206 with image MIME and non-empty bytes."
        },
        "imageAssets": {
          "type": "integer",
          "minimum": 1,
          "description": "Release-bound post image assets whose canonical public URL returned exact MIME, byte length and SHA-256."
        },
        "tags": {"type": "integer", "minimum": 1},
        "mediaAssets": {"type": "integer", "minimum": 1},
        "discoveryPosts": {"type": "integer", "minimum": 1},
        "premiumPlayableVideos": {
          "type": "integer",
          "minimum": 0,
          "description": "Release-bound premium video rows that passed Data's public byte-range, video MIME and MP4/WebM playable-header probe; CDN length/ETag/hash/duration/decoded-first-frame remain environment evidence."
        }
      }
    },
    "entityRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "postIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "creatorIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tagRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mediaAssetIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "appUatEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "releaseClass",
        "productLifecycleState",
        "homepageId",
        "homepageTitle",
        "articleWorkId",
        "articleTitle",
        "imageWorkId",
        "imageTitle",
        "videoWorkId",
        "creatorName",
        "tagLabel",
        "videoAttribution"
      ],
      "properties": {
        "releaseId": {"type": "string", "minLength": 1},
        "releaseClass": {"enum": ["research", "commercial"]},
        "productLifecycleState": {"enum": ["research", "commercial"]},
        "homepageId": {"type": "string", "minLength": 1},
        "homepageTitle": {"type": "string", "minLength": 1},
        "articleWorkId": {"type": "string", "minLength": 1},
        "articleTitle": {"type": "string", "minLength": 1},
        "imageWorkId": {"type": "string", "minLength": 1},
        "imageTitle": {"type": "string", "minLength": 1},
        "videoWorkId": {"type": "string", "minLength": 1},
        "creatorName": {"type": "string", "minLength": 1},
        "tagLabel": {"type": "string", "minLength": 1},
        "videoAttribution": {"type": "string", "minLength": 1}
      }
    },
    "feedQueries": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "query", "status", "releaseBound", "matchedPostIds", "requests"],
        "properties": {
          "name": {"enum": ["discovery_work", "typed_article", "typed_image", "typed_video", "homepage_recommend", "premium_stream"]},
          "path": {"const": "/content/feed"},
          "query": {"type": "string", "minLength": 1},
          "status": {"const": 200},
          "releaseBound": {"const": true},
          "matchedPostIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "requests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/operationEvidence"},
                {
                  "type": "object",
                  "properties": {
                    "path": {"const": "/content/feed"},
                    "pageId": {"const": "content.feed.list"},
                    "status": {"const": 200}
                  }
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {"contains": {"type": "object", "properties": {"name": {"const": "typed_video"}, "query": {"pattern": "^identity=work&type=video&limit=[1-9][0-9]*$"}}, "required": ["name", "query"]}},
        {"contains": {"type": "object", "properties": {"name": {"const": "homepage_recommend"}, "query": {"pattern": "^sort=recommend&channelId=recommend&limit=[1-9][0-9]*$"}}, "required": ["name", "query"]}}
      ]
    },
    "contentImportReportRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "creatorAttributionRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "tagAttributionRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "homepageApiVerificationRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "postApiVerificationRef": {"type": "string", "pattern": "^env/(alpha|beta|gamma|prod)/runs/data-release/"},
    "mediaManifestRef": {"type": "string", "pattern": "^data/releases/.+/payload/media_manifest\\.json$"},
    "verifiedAt": {"type": "string", "minLength": 1},
    "verificationChecksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "passed": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"readinessPhase": {"enum": ["research", "commercial"]}},
        "required": ["readinessPhase"]
      },
      "then": {
        "required": ["appUatEnvelope"],
        "properties": {
          "counts": {
            "properties": {
              "premiumPlayableVideos": {"minimum": 1}
            }
          },
          "feedQueries": {
            "minItems": 6,
            "contains": {
              "type": "object",
              "properties": {
                "name": {"const": "premium_stream"},
                "query": {"pattern": "^sort=recommend&channelId=premium_stream&limit=[1-9][0-9]*$"}
              },
              "required": ["name", "query"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "counts": {
            "properties": {
              "premiumPlayableVideos": {"const": 0}
            }
          },
          "feedQueries": {
            "maxItems": 5,
            "not": {
              "contains": {
                "type": "object",
                "properties": {"name": {"const": "premium_stream"}},
                "required": ["name"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "operationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "pageId",
        "status",
        "requestId",
        "traceId",
        "startedAt",
        "endedAt",
        "durationMs"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "pageId": {"type": "string", "minLength": 1},
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "requestId": {"type": "string", "minLength": 1},
        "traceId": {"type": "string", "minLength": 1},
        "startedAt": {"type": "string", "minLength": 1},
        "endedAt": {"type": "string", "minLength": 1},
        "durationMs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
