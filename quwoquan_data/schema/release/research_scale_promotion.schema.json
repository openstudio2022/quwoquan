{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/research_scale_promotion.schema.json",
  "title": "Research cumulative scale promotion receipt",
  "description": "Create-once cumulative milestone receipt. Counts, immutable closure, uniqueness and source identity are gates; quality-rate, mix, popularity, recovery, concurrency, timing and resource fields are truthful non-blocking statistics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotionId",
    "releaseId",
    "releaseClass",
    "productLifecycleState",
    "manifestDigest",
    "targetScale",
    "sourcePoolDigest",
    "predecessorSourcePoolDigests",
    "scaleStartedAt",
    "scaleCompletedAt",
    "wallClockBudgetSeconds",
    "wallClockSeconds",
    "capacityThroughputByCarrier",
    "carrierCounts",
    "campaignWaveStatistics",
    "statistics",
    "professionalImageSourceMix",
    "duplicateAssetCount",
    "crossLaneWriteCount",
    "resourceIsolationPassed",
    "soakDurationSeconds",
    "semanticJobsByLane",
    "semanticCalibrationByLane",
    "fourLaneOverlapSampleCount",
    "fourLaneOverlapDurationSeconds",
    "fourLaneLongestContinuousOverlapSeconds",
    "allSemanticJobsTerminalAt",
    "terminalResidualSampleAt",
    "campaignEvidenceRef",
    "campaignEvidenceDigest",
    "resourceSoakEvidenceRef",
    "resourceSoakEvidenceDigest",
    "faultInjectionEvidenceRef",
    "faultInjectionEvidenceDigest",
    "nextScaleEligible",
    "recordedAt"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.research_scale_promotion"},
    "promotionId": {"type": "string", "minLength": 1},
    "releaseId": {"type": "string", "minLength": 1},
    "releaseClass": {"const": "research"},
    "productLifecycleState": {"const": "research"},
    "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceIdentities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceIdentity"}
    },
    "sourceIdentitySetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targetScale": {"enum": ["M100", "M1000", "M10000"]},
    "sourcePoolDigest": {
      "description": "Current campaign-wave source-pool observation; milestone identity is sourceIdentitySetDigest.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessorSourcePoolDigests": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "scaleStartedAt": {"type": "string", "format": "date-time"},
    "scaleCompletedAt": {"type": "string", "format": "date-time"},
    "wallClockBudgetSeconds": {"type": ["integer", "null"], "minimum": 1},
    "wallClockSeconds": {"type": "integer", "minimum": 0},
    "capacityThroughputByCarrier": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/capacityThroughput"}, {"properties": {"carrier": {"const": "homepage"}}}]},
        {"allOf": [{"$ref": "#/$defs/capacityThroughput"}, {"properties": {"carrier": {"const": "article"}}}]},
        {"allOf": [{"$ref": "#/$defs/capacityThroughput"}, {"properties": {"carrier": {"const": "image"}}}]},
        {"allOf": [{"$ref": "#/$defs/capacityThroughput"}, {"properties": {"carrier": {"const": "video"}}}]}
      ],
      "items": false
    },
    "predecessorPromotion": {"$ref": "#/$defs/predecessorPromotion"},
    "carrierCounts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/homepageCount"},
        {"$ref": "#/$defs/articleCount"},
        {"$ref": "#/$defs/imageCount"},
        {"$ref": "#/$defs/videoCount"}
      ],
      "items": false
    },
    "campaignWaveStatistics": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/campaignWaveCount"}, {"properties": {"carrier": {"const": "homepage"}}}]},
        {"allOf": [{"$ref": "#/$defs/campaignWaveCount"}, {"properties": {"carrier": {"const": "article"}}}]},
        {"allOf": [{"$ref": "#/$defs/campaignWaveCount"}, {"properties": {"carrier": {"const": "image"}}}]},
        {"allOf": [{"$ref": "#/$defs/campaignWaveCount"}, {"properties": {"carrier": {"const": "video"}}}]}
      ],
      "items": false
    },
    "statistics": {"$ref": "#/$defs/statistics"},
    "professionalImageSourceMix": {"$ref": "#/$defs/professionalImageSourceMix"},
    "duplicateAssetCount": {"const": 0},
    "crossLaneWriteCount": {"const": 0},
    "resourceIsolationPassed": {"type": "boolean"},
    "soakDurationSeconds": {"type": "integer", "minimum": 0},
    "semanticJobsByLane": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/homepageSemanticJobs"},
        {"$ref": "#/$defs/articleSemanticJobs"},
        {"$ref": "#/$defs/imageSemanticJobs"},
        {"$ref": "#/$defs/videoSemanticJobs"}
      ],
      "items": false
    },
    "semanticCalibrationByLane": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "campaign_scale_evidence.schema.json#/$defs/semanticCalibration"},
            {"properties": {"carrier": {"const": "homepage"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "campaign_scale_evidence.schema.json#/$defs/semanticCalibration"},
            {"properties": {"carrier": {"const": "article"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "campaign_scale_evidence.schema.json#/$defs/semanticCalibration"},
            {"properties": {"carrier": {"const": "image"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "campaign_scale_evidence.schema.json#/$defs/semanticCalibration"},
            {"properties": {"carrier": {"const": "video"}}}
          ]
        }
      ],
      "items": false
    },
    "fourLaneOverlapSampleCount": {"type": "integer", "minimum": 0},
    "fourLaneOverlapDurationSeconds": {"type": "integer", "minimum": 0},
    "fourLaneLongestContinuousOverlapSeconds": {"type": "integer", "minimum": 0},
    "allSemanticJobsTerminalAt": {"type": ["string", "null"], "format": "date-time"},
    "terminalResidualSampleAt": {"type": "string", "format": "date-time"},
    "campaignEvidenceRef": {"type": "string", "minLength": 1},
    "campaignEvidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resourceSoakEvidenceRef": {"type": "string", "minLength": 1},
    "resourceSoakEvidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "faultInjectionEvidenceRef": {"type": "string", "minLength": 1},
    "faultInjectionEvidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nextScaleEligible": {"enum": ["M1000", "M10000", "COMPLETE"]},
    "recordedAt": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest"],
          "not": {"anyOf": [{"required": ["sourceIdentities"]}, {"required": ["sourceIdentitySetDigest"]}]}
        },
        {
          "required": ["sourceIdentities", "sourceIdentitySetDigest"],
          "not": {"anyOf": [{"required": ["sourceRevision"]}, {"required": ["sourceDigest"]}, {"required": ["entityCatalogDigest"]}]}
        }
      ]
    },
    {
      "if": {"properties": {"targetScale": {"const": "M100"}}, "required": ["targetScale"]},
      "then": {
        "properties": {
          "nextScaleEligible": {"const": "M1000"},
          "predecessorSourcePoolDigests": {"maxItems": 0},
          "wallClockBudgetSeconds": {"type": "null"},
          "carrierCounts": {
            "prefixItems": [
              {"properties": {"targetCount": {"const": 100}, "totalUniqueFinalizedCount": {"const": 100}, "researchAcceptedCount": {"const": 100}}},
              {"properties": {"targetCount": {"const": 100}, "totalUniqueFinalizedCount": {"const": 100}, "researchAcceptedCount": {"const": 100}}},
              {"properties": {"targetCount": {"const": 100}, "totalUniqueFinalizedCount": {"const": 100}, "researchAcceptedCount": {"const": 100}}},
              {"properties": {"targetCount": {"const": 10}, "totalUniqueFinalizedCount": {"const": 10}, "researchAcceptedCount": {"const": 10}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"targetScale": {"const": "M1000"}}, "required": ["targetScale"]},
      "then": {
        "required": ["predecessorPromotion"],
        "properties": {
          "nextScaleEligible": {"const": "M10000"},
          "predecessorSourcePoolDigests": {"minItems": 1},
          "predecessorPromotion": {"properties": {"targetScale": {"const": "M100"}}},
          "wallClockBudgetSeconds": {"type": "null"},
          "carrierCounts": {
            "prefixItems": [
              {"properties": {"targetCount": {"const": 1000}, "totalUniqueFinalizedCount": {"const": 1000}, "researchAcceptedCount": {"const": 1000}}},
              {"properties": {"targetCount": {"const": 1000}, "totalUniqueFinalizedCount": {"const": 1000}, "researchAcceptedCount": {"const": 1000}}},
              {"properties": {"targetCount": {"const": 1000}, "totalUniqueFinalizedCount": {"const": 1000}, "researchAcceptedCount": {"const": 1000}}},
              {"properties": {"targetCount": {"const": 100}, "totalUniqueFinalizedCount": {"const": 100}, "researchAcceptedCount": {"const": 100}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"targetScale": {"const": "M10000"}}, "required": ["targetScale"]},
      "then": {
        "required": ["predecessorPromotion"],
        "properties": {
          "nextScaleEligible": {"const": "COMPLETE"},
          "predecessorSourcePoolDigests": {"minItems": 2},
          "predecessorPromotion": {"properties": {"targetScale": {"const": "M1000"}}},
          "wallClockBudgetSeconds": {"const": 604800},
          "wallClockSeconds": {"maximum": 604800},
          "carrierCounts": {
            "prefixItems": [
              {"properties": {"targetCount": {"const": 10000}, "totalUniqueFinalizedCount": {"minimum": 10000}, "researchAcceptedCount": {"minimum": 10000}}},
              {"properties": {"targetCount": {"const": 10000}, "totalUniqueFinalizedCount": {"minimum": 10000}, "researchAcceptedCount": {"minimum": 10000}}},
              {"properties": {"targetCount": {"const": 10000}, "totalUniqueFinalizedCount": {"minimum": 10000}, "researchAcceptedCount": {"minimum": 10000}}},
              {"properties": {"targetCount": {"const": 1000}, "totalUniqueFinalizedCount": {"minimum": 1000}, "researchAcceptedCount": {"minimum": 1000}}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "predecessorPromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionId", "releaseId", "manifestDigest", "targetScale", "receiptRef",
        "receiptDigest"
      ],
      "properties": {
        "promotionId": {"type": "string", "minLength": 1},
        "releaseId": {"type": "string", "minLength": 1},
        "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceIdentities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceIdentity"}
        },
        "sourceIdentitySetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "targetScale": {"enum": ["M100", "M1000"]},
        "receiptRef": {"type": "string", "minLength": 1},
        "receiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "oneOf": [
        {
          "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest"],
          "not": {"anyOf": [{"required": ["sourceIdentities"]}, {"required": ["sourceIdentitySetDigest"]}]}
        },
        {
          "required": ["sourceIdentities", "sourceIdentitySetDigest"],
          "not": {"anyOf": [{"required": ["sourceRevision"]}, {"required": ["sourceDigest"]}, {"required": ["entityCatalogDigest"]}]}
        }
      ]
    },
    "sourceIdentity": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest", "executionIds"],
          "properties": {
            "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "executionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["identityKind", "sourceDigest", "canonicalObjectDigest", "migrationEvidenceDigest", "executionIds"],
          "properties": {
            "identityKind": {"const": "legacy_canonical_migration"},
            "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "canonicalObjectDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "migrationEvidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "executionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "carrierCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "targetCount",
        "qualifiedCount",
        "finalizedCount",
        "predecessorCarriedCount",
        "newFinalizedCount",
        "totalUniqueFinalizedCount",
        "selectedCount",
        "discardedCount",
        "shortfallCount",
        "researchAcceptedCount"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "targetCount": {"type": "integer", "minimum": 1},
        "qualifiedCount": {"type": "integer", "minimum": 1},
        "finalizedCount": {"type": "integer", "minimum": 1},
        "selectedCount": {"type": "integer", "minimum": 1},
        "discardedCount": {"type": "integer", "minimum": 0},
        "predecessorCarriedCount": {"type": "integer", "minimum": 0},
        "newFinalizedCount": {"type": "integer", "minimum": 1},
        "totalUniqueFinalizedCount": {"type": "integer", "minimum": 1},
        "shortfallCount": {"const": 0},
        "researchAcceptedCount": {"type": "integer", "minimum": 1}
      }
    },
    "campaignWaveCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier", "approvedQuota", "selectedCount", "qualifiedCount",
        "finalizedCount", "discardedCount", "shortfallCount"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "approvedQuota": {"type": "integer", "minimum": 1},
        "selectedCount": {"type": "integer", "minimum": 1},
        "qualifiedCount": {"type": "integer", "minimum": 1},
        "finalizedCount": {"type": "integer", "minimum": 1},
        "discardedCount": {"type": "integer", "minimum": 0},
        "shortfallCount": {"type": "integer", "minimum": 0}
      }
    },
    "homepageCount": {
      "allOf": [
        {"$ref": "#/$defs/carrierCount"},
        {"properties": {"carrier": {"const": "homepage"}}}
      ]
    },
    "articleCount": {
      "allOf": [
        {"$ref": "#/$defs/carrierCount"},
        {"properties": {"carrier": {"const": "article"}}}
      ]
    },
    "imageCount": {
      "allOf": [
        {"$ref": "#/$defs/carrierCount"},
        {"properties": {"carrier": {"const": "image"}}}
      ]
    },
    "videoCount": {
      "allOf": [
        {"$ref": "#/$defs/carrierCount"},
        {"properties": {"carrier": {"const": "video"}}}
      ]
    },
    "rateStatistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "rate"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "nonBlockingRateStatistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistical", "nonBlocking", "numerator", "denominator", "rate"],
      "properties": {
        "statistical": {"const": true},
        "nonBlocking": {"const": true},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "signalAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "numerator", "denominator", "rate"],
      "properties": {
        "signal": {"enum": ["play", "like", "comment", "share", "favorite"]},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "playAvailability": {
      "allOf": [
        {"$ref": "#/$defs/signalAvailability"},
        {"properties": {"signal": {"const": "play"}}}
      ]
    },
    "likeAvailability": {
      "allOf": [
        {"$ref": "#/$defs/signalAvailability"},
        {"properties": {"signal": {"const": "like"}}}
      ]
    },
    "commentAvailability": {
      "allOf": [
        {"$ref": "#/$defs/signalAvailability"},
        {"properties": {"signal": {"const": "comment"}}}
      ]
    },
    "shareAvailability": {
      "allOf": [
        {"$ref": "#/$defs/signalAvailability"},
        {"properties": {"signal": {"const": "share"}}}
      ]
    },
    "favoriteAvailability": {
      "allOf": [
        {"$ref": "#/$defs/signalAvailability"},
        {"properties": {"signal": {"const": "favorite"}}}
      ]
    },
    "nullableCount": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "popularityComparisonBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "topic", "timeBucket", "candidateCount"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "timeBucket": {"type": "string", "minLength": 1},
        "candidateCount": {"type": "integer", "minimum": 0}
      }
    },
    "videoPopularityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectRef", "assetId", "playCount", "likeCount", "commentCount",
        "shareCount", "favoriteCount", "observedAt", "comparisonBucket",
        "popularityScore", "popularityPercentile", "rankingEligible",
        "ineligibleReason"
      ],
      "properties": {
        "objectRef": {"type": "string", "pattern": "^posts/video/"},
        "assetId": {"type": "string", "minLength": 1},
        "playCount": {"$ref": "#/$defs/nullableCount"},
        "likeCount": {"$ref": "#/$defs/nullableCount"},
        "commentCount": {"$ref": "#/$defs/nullableCount"},
        "shareCount": {"$ref": "#/$defs/nullableCount"},
        "favoriteCount": {"$ref": "#/$defs/nullableCount"},
        "observedAt": {"type": "string", "minLength": 1},
        "comparisonBucket": {"$ref": "#/$defs/popularityComparisonBucket"},
        "popularityScore": {"$ref": "#/$defs/nullableNumber"},
        "popularityPercentile": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "rankingEligible": {"type": "boolean"},
        "ineligibleReason": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"rankingEligible": {"const": true}},
            "required": ["rankingEligible"]
          },
          "then": {
            "properties": {
              "ineligibleReason": {"const": ""},
              "popularityPercentile": {"type": "number"}
            }
          },
          "else": {
            "properties": {
              "ineligibleReason": {"minLength": 1},
              "popularityPercentile": {"type": "null"}
            }
          }
        }
      ]
    },
    "videoPopularityStatistic": {
      "type": "object",
      "description": "Truthful non-blocking five-signal availability and ranking coverage statistics.",
      "additionalProperties": false,
      "required": [
        "statistical", "nonBlocking", "signalAvailability",
        "rankingCoverage", "observations", "observationIssues"
      ],
      "properties": {
        "statistical": {"const": true},
        "nonBlocking": {"const": true},
        "signalAvailability": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/playAvailability"},
            {"$ref": "#/$defs/likeAvailability"},
            {"$ref": "#/$defs/commentAvailability"},
            {"$ref": "#/$defs/shareAvailability"},
            {"$ref": "#/$defs/favoriteAvailability"}
          ],
          "items": false
        },
        "rankingCoverage": {"$ref": "#/$defs/rateStatistic"},
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/videoPopularityObservation"}
        },
        "observationIssues": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "automaticRecoveryStatistic": {
      "type": "object",
      "description": "Observed automatic recovery statistics; never an object or milestone admission gate.",
      "additionalProperties": false,
      "required": [
        "statistical", "nonBlocking", "status", "eligibleCount",
        "automaticCount", "targetRate", "rate"
      ],
      "properties": {
        "statistical": {"const": true},
        "nonBlocking": {"const": true},
        "status": {"enum": ["NOT_EXERCISED", "MEASURED"]},
        "eligibleCount": {"type": "integer", "minimum": 0},
        "automaticCount": {"type": "integer", "minimum": 0},
        "targetRate": {"const": 0.95},
        "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "providerAssetCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "acceptedAssetCount", "acceptedAssetRatio"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "acceptedAssetCount": {"type": "integer", "minimum": 1},
        "acceptedAssetRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "professionalImageSourceMix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistical", "nonBlocking",
        "acceptedImageAssetCount", "originalAssetClosureCount",
        "pinterestAcceptedAssetCount", "tuchongAcceptedAssetCount",
        "pinterestTuchongAcceptedAssetCount", "pinterestTuchongAcceptedAssetRatio",
        "largestProvider", "maxProviderAcceptedAssetRatio", "providerAssetCounts",
        "policyObservations", "observationIssues"
      ],
      "properties": {
        "statistical": {"const": true},
        "nonBlocking": {"const": true},
        "acceptedImageAssetCount": {"type": "integer", "minimum": 0},
        "originalAssetClosureCount": {"type": "integer", "minimum": 0},
        "pinterestAcceptedAssetCount": {"type": "integer", "minimum": 0},
        "tuchongAcceptedAssetCount": {"type": "integer", "minimum": 0},
        "pinterestTuchongAcceptedAssetCount": {"type": "integer", "minimum": 0},
        "pinterestTuchongAcceptedAssetRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "largestProvider": {"type": "string"},
        "maxProviderAcceptedAssetRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "providerAssetCounts": {
          "type": "array",
          "items": {"$ref": "#/$defs/providerAssetCount"}
        },
        "policyObservations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pinterestUniqueLargest", "tuchongPresent",
            "pinterestTuchongAtLeastHalf", "providerAboveSeventyPercent"
          ],
          "properties": {
            "pinterestUniqueLargest": {"type": "boolean"},
            "tuchongPresent": {"type": "boolean"},
            "pinterestTuchongAtLeastHalf": {"type": "boolean"},
            "providerAboveSeventyPercent": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "observationIssues": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "quotaAttainment": {
      "type": "object",
      "description": "Per-carrier cumulative unique finalized / targetCount; rate must be at least one.",
      "additionalProperties": false,
      "required": ["carrier", "numerator", "denominator", "rate"],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 1}
      }
    },
    "homepageQuotaAttainment": {
      "allOf": [
        {"$ref": "#/$defs/quotaAttainment"},
        {"properties": {"carrier": {"const": "homepage"}}}
      ]
    },
    "articleQuotaAttainment": {
      "allOf": [
        {"$ref": "#/$defs/quotaAttainment"},
        {"properties": {"carrier": {"const": "article"}}}
      ]
    },
    "imageQuotaAttainment": {
      "allOf": [
        {"$ref": "#/$defs/quotaAttainment"},
        {"properties": {"carrier": {"const": "image"}}}
      ]
    },
    "videoQuotaAttainment": {
      "allOf": [
        {"$ref": "#/$defs/quotaAttainment"},
        {"properties": {"carrier": {"const": "video"}}}
      ]
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectPassRate",
        "illustratedRate",
        "textOnlyRate",
        "videoPopularity",
        "automaticRecoveryRate",
        "capacityPlanning",
        "resourceSoak",
        "firstPassRate",
        "discardRate",
        "quotaAttainmentByCarrier"
      ],
      "properties": {
        "objectPassRate": {
          "description": "Sum of qualifiedCount / sum of selectedCount across the four lanes.",
          "$ref": "#/$defs/rateStatistic"
        },
        "illustratedRate": {
          "description": "Non-blocking illustrated article count / article count statistic.",
          "$ref": "#/$defs/nonBlockingRateStatistic"
        },
        "textOnlyRate": {
          "description": "Non-blocking text-only article count / article count statistic.",
          "$ref": "#/$defs/nonBlockingRateStatistic"
        },
        "videoPopularity": {
          "$ref": "#/$defs/videoPopularityStatistic"
        },
        "automaticRecoveryRate": {
          "$ref": "#/$defs/automaticRecoveryStatistic"
        },
        "capacityPlanning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statistical", "nonBlocking", "status", "evidenceCount",
            "observationIssues"
          ],
          "properties": {
            "statistical": {"const": true},
            "nonBlocking": {"const": true},
            "status": {"enum": ["MEASURED", "UNAVAILABLE"]},
            "evidenceCount": {
              "type": "integer", "minimum": 0, "maximum": 4
            },
            "observationIssues": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "resourceSoak": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statistical", "nonBlocking", "status", "durationSeconds",
            "fourLaneOverlapDurationSeconds"
          ],
          "properties": {
            "statistical": {"const": true},
            "nonBlocking": {"const": true},
            "status": {"enum": ["passed", "failed"]},
            "durationSeconds": {"type": "integer", "minimum": 0},
            "fourLaneOverlapDurationSeconds": {
              "type": "integer", "minimum": 0
            }
          }
        },
        "firstPassRate": {
          "description": "Lanes whose retryChain contains only the current execution / four promoted lanes.",
          "$ref": "#/$defs/rateStatistic"
        },
        "discardRate": {
          "description": "Sum of discardedCount / sum of selectedCount across the four lanes.",
          "$ref": "#/$defs/rateStatistic"
        },
        "quotaAttainmentByCarrier": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/homepageQuotaAttainment"},
            {"$ref": "#/$defs/articleQuotaAttainment"},
            {"$ref": "#/$defs/imageQuotaAttainment"},
            {"$ref": "#/$defs/videoQuotaAttainment"}
          ],
          "items": false
        }
      }
    },
    "capacityThroughput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier", "measuredScale", "sourceRevision", "sourceDigest", "entityCatalogDigest", "throughputUnit", "perSlotThroughputSamples", "evidenceRef", "evidenceDigest", "throughputBasisDigest"],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "measuredScale": {"enum": ["M100", "M1000", "M10000"]},
        "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "throughputUnit": {"const": "objects_per_second_per_slot"},
        "perSlotThroughputSamples": {
          "type": "array",
          "minItems": 10,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "evidenceRef": {"type": "string", "minLength": 1},
        "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "throughputBasisDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "semanticJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "executionId",
        "semanticJobCount",
        "semanticJobSucceededCount",
        "semanticJobTerminalCount",
        "semanticJobIds",
        "semanticJobSucceededIds",
        "semanticJobTerminalIds",
        "perSlotThroughputSamples",
        "activeDurationSeconds",
        "activeIntervals"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "executionId": {"type": "string", "minLength": 1},
        "semanticJobCount": {"type": "integer", "minimum": 0},
        "semanticJobSucceededCount": {"type": "integer", "minimum": 0},
        "semanticJobTerminalCount": {"type": "integer", "minimum": 0},
        "semanticJobIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "semanticJobSucceededIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "semanticJobTerminalIds": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "perSlotThroughputSamples": {
          "type": "array",
          "minItems": 0,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "activeDurationSeconds": {"type": "integer", "minimum": 0},
        "activeIntervals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/activeInterval"}
        }
      }
    },
    "activeInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "endedAt", "durationSeconds"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "endedAt": {"type": "string", "format": "date-time"},
        "durationSeconds": {"type": "integer", "minimum": 0}
      }
    }
    ,"homepageSemanticJobs": {"allOf": [{"$ref": "#/$defs/semanticJobs"}, {"properties": {"carrier": {"const": "homepage"}}}]}
    ,"articleSemanticJobs": {"allOf": [{"$ref": "#/$defs/semanticJobs"}, {"properties": {"carrier": {"const": "article"}}}]}
    ,"imageSemanticJobs": {"allOf": [{"$ref": "#/$defs/semanticJobs"}, {"properties": {"carrier": {"const": "image"}}}]}
    ,"videoSemanticJobs": {"allOf": [{"$ref": "#/$defs/semanticJobs"}, {"properties": {"carrier": {"const": "video"}}}]}
  }
}
