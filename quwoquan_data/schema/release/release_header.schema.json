{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical immutable release header",
  "type": "object",
  "required": [
    "schema",
    "releaseId",
    "sourceOwner",
    "releaseKind",
    "releaseClass",
    "productLifecycleState",
    "containsUnverifiedAssets",
    "rightsStatusCounts",
    "authorizationRequiredAssetIds",
    "researchAcceptedCount",
    "commercialAcceptedCount",
    "canonicalMerkle",
    "executionIds",
    "sourceDigests"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.release"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceOwner": {
      "const": "qwq_data"
    },
    "releaseKind": {
      "enum": [
        "content",
        "empty_baseline"
      ]
    },
    "releaseClass": {
      "enum": [
        "research",
        "commercial"
      ]
    },
    "productLifecycleState": {
      "enum": [
        "research",
        "commercial"
      ]
    },
    "containsUnverifiedAssets": {
      "type": "boolean"
    },
    "rightsStatusCounts": {
      "type": "object",
      "required": [
        "verified",
        "unverified",
        "restricted",
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "restricted": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authorizationRequiredAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "researchAcceptedCount": {
      "type": "integer",
      "minimum": 0
    },
    "commercialAcceptedCount": {
      "type": "integer",
      "minimum": 0
    },
    "canonicalMerkle": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceIdentities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceIdentity"
      }
    },
    "sourceIdentitySetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceDigests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "algorithm",
          "digest",
          "inputs"
        ],
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "const": "sha256"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "inputs": {
            "const": [
              "quwoquan_data/schema",
              "quwoquan_data/control_plane",
              "quwoquan_data/prompts",
              "quwoquan_data/templates",
              "quwoquan_data/verticals/travel",
              "quwoquan_data/reference",
              "quwoquan_data/requirements.txt",
              "quwoquan_data/requirements-cursor.txt",
              "quwoquan_service/services/content-service/contracts/media/media_asset",
              "quwoquan_service/services/content-service/contracts/content/post/ui_config.yaml",
              "quwoquan_service/services/recommendation-service/contracts/recommendation/recommendation_feature_profile_view/projections/intersection_reason.yaml"
            ]
          }
        }
      }
    },
    "selectionScope": {
      "enum": [
        "target_environment",
        "all_publishable",
        "milestone"
      ]
    },
    "targetEnvironment": {
      "enum": [
        "alpha",
        "beta",
        "gamma",
        "prod"
      ]
    },
    "milestone": {
      "enum": [
        "M100",
        "M1000",
        "M10000"
      ]
    },
    "milestoneTargets": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 1
        },
        "article": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "integer",
          "minimum": 1
        },
        "video": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "releaseMode": {
      "enum": [
        "research",
        "commercial"
      ]
    },
    "poolDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "article",
        "image",
        "video",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "article": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/handoffContent"},
          {"$ref": "#/$defs/legacyAuditContent"}
        ]
      }
    },
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "authorId",
          "version",
          "creatorRef"
        ],
        "additionalProperties": false,
        "properties": {
          "authorId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "creatorRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "buildResult": {
      "const": "completed"
    },
    "contractMigration": {
      "type": "object",
      "required": [
        "sourceReleaseId",
        "sourcePayloadSha256",
        "sourceCanonicalMerkle",
        "sourceSamplePlanRef",
        "sourceSamplePlanDigest",
        "reasonCode"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceReleaseId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePayloadSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceCanonicalMerkle": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceSamplePlanRef": {
          "const": "uat/sample_plan.json"
        },
        "sourceSamplePlanDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reasonCode": {
          "const": "RELEASE_UAT_SAMPLE_PLAN_CONTRACT_CUTOVER"
        }
      }
    },
    "reviewedClosureAdoption": {
      "$ref": "../execution/reviewed_closure_adoption_campaign_binding.schema.json"
    },
    "samplePlanRef": {
      "const": "uat/sample_plan.json"
    },
    "samplePlanDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "handoffContent": {
      "type": "object",
      "required": [
        "contentId", "version", "postRef", "selectionIdentityDigest",
        "canonicalObjectDigest", "contentLibraryBindingDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "contentId": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "postRef": {"type": "string", "minLength": 1},
        "selectionIdentityDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "canonicalObjectDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contentLibraryBindingDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "legacyAuditContent": {
      "type": "object",
      "required": [
        "contentId", "version", "postRef", "executionId", "sourceIdentityDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "contentId": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "postRef": {"type": "string", "minLength": 1},
        "executionId": {"type": "string", "minLength": 1},
        "sourceIdentityDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "required": [
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "executionIds"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entityCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "executionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseKind": {
            "const": "empty_baseline"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceRevision"
              ]
            },
            {
              "required": [
                "sourceDigest"
              ]
            },
            {
              "required": [
                "entityCatalogDigest"
              ]
            },
            {
              "required": [
                "sourceIdentities"
              ]
            },
            {
              "required": [
                "sourceIdentitySetDigest"
              ]
            },
            {
              "required": [
                "samplePlanRef"
              ]
            },
            {
              "required": [
                "samplePlanDigest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "releaseClass": {
            "const": "commercial"
          }
        }
      },
      "then": {
        "properties": {
          "productLifecycleState": {
            "const": "commercial"
          },
          "containsUnverifiedAssets": {
            "const": false
          },
          "authorizationRequiredAssetIds": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "productLifecycleState": {
            "const": "research"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "targetEnvironment"
        ]
      },
      "then": {
        "required": [
          "selectionScope",
          "releaseMode",
          "poolDigest",
          "counts",
          "contents",
          "authors",
          "buildResult"
        ],
        "not": {
          "required": [
            "milestone"
          ]
        },
        "properties": {
          "selectionScope": {
            "const": "target_environment"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "milestone"
        ]
      },
      "then": {
        "required": [
          "selectionScope",
          "milestoneTargets",
          "releaseMode",
          "poolDigest",
          "counts",
          "contents",
          "authors",
          "buildResult",
          "sourceIdentities",
          "sourceIdentitySetDigest",
          "samplePlanRef",
          "samplePlanDigest"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "targetEnvironment"
              ]
            },
            {
              "required": [
                "sourceRevision"
              ]
            },
            {
              "required": [
                "sourceDigest"
              ]
            },
            {
              "required": [
                "entityCatalogDigest"
              ]
            }
          ]
        },
        "properties": {
          "selectionScope": {
            "const": "milestone"
          },
          "releaseClass": {
            "const": "research"
          },
          "productLifecycleState": {
            "const": "research"
          },
          "releaseMode": {
            "const": "research"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "releaseKind": {
            "const": "content"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "sourceRevision",
              "sourceDigest",
              "entityCatalogDigest"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceIdentities"
                  ]
                },
                {
                  "required": [
                    "sourceIdentitySetDigest"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "sourceIdentities",
              "sourceIdentitySetDigest"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceRevision"
                  ]
                },
                {
                  "required": [
                    "sourceDigest"
                  ]
                },
                {
                  "required": [
                    "entityCatalogDigest"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "milestone": {
            "const": "M100"
          }
        },
        "required": [
          "milestone"
        ]
      },
      "then": {
        "properties": {
          "milestoneTargets": {
            "properties": {
              "homepage": {
                "const": 100
              },
              "article": {
                "const": 100
              },
              "image": {
                "const": 100
              },
              "video": {
                "const": 10
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "milestone": {
            "const": "M1000"
          }
        },
        "required": [
          "milestone"
        ]
      },
      "then": {
        "properties": {
          "milestoneTargets": {
            "properties": {
              "homepage": {
                "const": 1000
              },
              "article": {
                "const": 1000
              },
              "image": {
                "const": 1000
              },
              "video": {
                "const": 100
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "milestone": {
            "const": "M10000"
          }
        },
        "required": [
          "milestone"
        ]
      },
      "then": {
        "properties": {
          "milestoneTargets": {
            "properties": {
              "homepage": {
                "const": 10000
              },
              "article": {
                "const": 10000
              },
              "image": {
                "const": 10000
              },
              "video": {
                "const": 1000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "selectionScope"
          ]
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "releaseMode"
              ]
            },
            {
              "required": [
                "poolDigest"
              ]
            },
            {
              "required": [
                "counts"
              ]
            },
            {
              "required": [
                "contents"
              ]
            },
            {
              "required": [
                "authors"
              ]
            },
            {
              "required": [
                "buildResult"
              ]
            },
            {
              "required": [
                "milestoneTargets"
              ]
            },
            {
              "required": [
                "samplePlanRef"
              ]
            },
            {
              "required": [
                "samplePlanDigest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "selectionScope": {
            "const": "all_publishable"
          }
        },
        "required": [
          "selectionScope"
        ]
      },
      "then": {
        "required": [
          "releaseMode",
          "poolDigest",
          "counts",
          "contents",
          "authors",
          "buildResult"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "targetEnvironment"
              ]
            },
            {
              "required": [
                "milestone"
              ]
            }
          ]
        }
      }
    }
  ]
}
