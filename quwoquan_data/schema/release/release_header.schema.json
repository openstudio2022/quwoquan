{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical immutable release header",
  "type": "object",
  "required": [
    "schema",
    "releaseId",
    "sourceOwner",
    "releaseKind",
    "releaseClass",
    "productLifecycleState",
    "containsUnverifiedAssets",
    "rightsStatusCounts",
    "authorizationRequiredAssetIds",
    "researchAcceptedCount",
    "commercialAcceptedCount",
    "canonicalMerkle",
    "executionIds",
    "sourceDigests"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.release"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceOwner": {
      "const": "qwq_data"
    },
    "releaseKind": {
      "enum": [
        "content",
        "empty_baseline"
      ]
    },
    "releaseClass": {
      "enum": [
        "research",
        "commercial"
      ]
    },
    "productLifecycleState": {
      "enum": [
        "research",
        "commercial"
      ]
    },
    "containsUnverifiedAssets": {
      "type": "boolean"
    },
    "rightsStatusCounts": {
      "type": "object",
      "required": [
        "verified",
        "unverified",
        "restricted",
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "restricted": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authorizationRequiredAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "researchAcceptedCount": {
      "type": "integer",
      "minimum": 0
    },
    "commercialAcceptedCount": {
      "type": "integer",
      "minimum": 0
    },
    "canonicalMerkle": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceIdentities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceIdentity"
      }
    },
    "sourceIdentitySetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceDigests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "algorithm",
          "digest",
          "inputs"
        ],
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "const": "sha256"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "inputs": {
            "const": [
              "quwoquan_data/schema/_common",
              "quwoquan_data/schema/content",
              "quwoquan_data/schema/execution",
              "quwoquan_data/schema/source",
              "quwoquan_data/schema/publish/entity.schema.json",
              "quwoquan_data/schema/release/asset_rights_closure.schema.json",
              "quwoquan_data/schema/release/content_pool_handoff_query.schema.json",
              "quwoquan_data/schema/release/media_manifest.schema.json",
              "quwoquan_data/schema/release/object_transaction_package.schema.json",
              "quwoquan_data/schema/release/pool_object_record.schema.json",
              "quwoquan_data/schema/release/producer_release_handoff.schema.json",
              "quwoquan_data/schema/release/release_asset_admission.schema.json",
              "quwoquan_data/schema/release/release_attestation.schema.json",
              "quwoquan_data/schema/release/release_cohort.schema.json",
              "quwoquan_data/schema/release/release_desired_state.schema.json",
              "quwoquan_data/schema/release/release_header.schema.json",
              "quwoquan_data/schema/governance/_definition.schema.json",
              "quwoquan_data/schema/governance/content_distribution_policy.schema.json",
              "quwoquan_data/control_plane",
              "quwoquan_data/prompts",
              "quwoquan_data/templates",
              "quwoquan_data/verticals/travel",
              "quwoquan_data/reference",
              "quwoquan_data/requirements.txt",
              "quwoquan_service/services/content-service/contracts/media/media_asset/image_variant_policy.yaml"
            ]
          }
        }
      }
    },
    "poolDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 0
        },
        "article": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/handoffContent"
      }
    },
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "authorId",
          "version",
          "creatorRef"
        ],
        "additionalProperties": false,
        "properties": {
          "authorId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "creatorRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "buildResult": {
      "const": "completed"
    },
    "milestone": {
      "enum": [
        "M1",
        "M10",
        "M100",
        "M1000",
        "M10000"
      ]
    },
    "milestoneTargets": {
      "$ref": "#/$defs/carrierCountsWithoutTotal"
    }
  },
  "$defs": {
    "carrierCountsWithoutTotal": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 0
        },
        "article": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "handoffContent": {
      "type": "object",
      "required": [
        "contentId",
        "version",
        "postRef",
        "selectionIdentityDigest",
        "canonicalObjectDigest",
        "contentLibraryBindingDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "postRef": {
          "type": "string",
          "minLength": 1
        },
        "selectionIdentityDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canonicalObjectDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contentLibraryBindingDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "required": [
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "executionIds"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entityCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "executionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseKind": {
            "const": "empty_baseline"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceRevision"
              ]
            },
            {
              "required": [
                "sourceDigest"
              ]
            },
            {
              "required": [
                "entityCatalogDigest"
              ]
            },
            {
              "required": [
                "sourceIdentities"
              ]
            },
            {
              "required": [
                "sourceIdentitySetDigest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "releaseClass": {
            "const": "commercial"
          }
        }
      },
      "then": {
        "properties": {
          "productLifecycleState": {
            "const": "commercial"
          },
          "containsUnverifiedAssets": {
            "const": false
          },
          "authorizationRequiredAssetIds": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "productLifecycleState": {
            "const": "research"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "releaseKind": {
            "const": "content"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "sourceRevision",
              "sourceDigest",
              "entityCatalogDigest"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceIdentities"
                  ]
                },
                {
                  "required": [
                    "sourceIdentitySetDigest"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "sourceIdentities",
              "sourceIdentitySetDigest"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceRevision"
                  ]
                },
                {
                  "required": [
                    "sourceDigest"
                  ]
                },
                {
                  "required": [
                    "entityCatalogDigest"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
