{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/release/legacy_producer_release_handoff_v1.schema.json",
  "title": "Supported legacy producer handoff v1 (closed input schema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoffId",
    "releaseId",
    "milestone",
    "carrierCounts",
    "release",
    "explicitCohort",
    "contentPoolObjects",
    "producerBaselineRevision",
    "producerContractDigest"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.producer_release_handoff"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "milestone": {
      "enum": [
        "M1",
        "M10",
        "M100",
        "M1000",
        "M10000"
      ]
    },
    "producerBaselineRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "producerContractDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "carrierCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "article",
        "image",
        "video",
        "total"
      ],
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 0
        },
        "article": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "payloadDigest",
        "headerRef",
        "headerDigest"
      ],
      "properties": {
        "scope": {
          "const": "output"
        },
        "ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "headerRef": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "headerDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "explicitCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest",
        "document"
      ],
      "properties": {
        "scope": {
          "enum": [
            "output",
            "repo"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "document": {
          "$ref": "legacy_release_cohort_v1.schema.json"
        }
      }
    },
    "contentPoolObjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectRef",
          "carrier",
          "queryDocument",
          "queryDigest"
        ],
        "properties": {
          "objectRef": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          },
          "carrier": {
            "enum": [
              "homepage",
              "article",
              "image",
              "video"
            ]
          },
          "queryDocument": {
            "$ref": "legacy_content_pool_handoff_query_v1.schema.json"
          },
          "queryDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
