{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data-owned immutable release UAT sample plan",
  "type": "object",
  "required": [
    "schema",
    "releaseId",
    "releaseDigest",
    "milestone",
    "selectionEvidence",
    "eligiblePopulationCounts",
    "exactCohortCounts",
    "entryCarrierCells",
    "sampleStrategy",
    "sampleCount",
    "samples"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.release_uat_sample_plan"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "releaseDigest": {
      "$ref": "#/$defs/digest"
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "M1",
        "M10",
        "M100",
        "M1000",
        "M10000",
        null
      ]
    },
    "selectionEvidence": {
      "type": "object",
      "required": [
        "poolDigest",
        "sourceIdentitySetDigest",
        "canonicalMerkle",
        "releaseContentsDigest",
        "releaseEntityCohortDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "poolDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceIdentitySetDigest": {
          "$ref": "#/$defs/digest"
        },
        "canonicalMerkle": {
          "$ref": "#/$defs/digest"
        },
        "releaseContentsDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseEntityCohortDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "eligiblePopulationCounts": {
      "$ref": "#/$defs/carrierCounts"
    },
    "exactCohortCounts": {
      "$ref": "#/$defs/carrierCounts"
    },
    "entryCarrierCells": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/matrixCell"
      }
    },
    "sampleStrategy": {
      "type": "object",
      "required": [
        "authority",
        "name",
        "version",
        "seedDigest",
        "carrierOrder",
        "sortKey",
        "direction",
        "objectDigestAlgorithm",
        "sampleDistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "stratified_exact",
            "baseline_per_required_carrier"
          ]
        },
        "version": {
          "const": 1
        },
        "seedDigest": {
          "$ref": "#/$defs/digest"
        },
        "carrierOrder": {
          "const": [
            "homepage",
            "article",
            "image",
            "video"
          ]
        },
        "sortKey": {
          "const": "identity"
        },
        "direction": {
          "const": "ascending"
        },
        "sampleDistribution": {
          "$ref": "#/$defs/carrierCounts"
        },
        "objectDigestAlgorithm": {
          "const": "sha256-path-blob-merkle"
        },
        "authority": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "release_uat_sampling_authority.schema.json"
            }
          ]
        }
      }
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "sampleId",
          "carrier",
          "objectId",
          "objectRef",
          "objectDigest"
        ],
        "additionalProperties": false,
        "properties": {
          "sampleId": {
            "type": "string",
            "pattern": "^(m(1|10|100|1000|10000)|baseline)-(homepage|article|image|video)-[0-9]{3}$"
          },
          "carrier": {
            "$ref": "#/$defs/carrier"
          },
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "objectRef": {
            "type": "string",
            "pattern": "^objects/(entities|posts/(article|image|video))/[^/].+$"
          },
          "objectDigest": {
            "$ref": "#/$defs/digest"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "carrier": {
                  "const": "homepage"
                }
              },
              "required": [
                "carrier"
              ]
            },
            "then": {
              "properties": {
                "objectId": {
                  "pattern": "^/entity/[^/].+$"
                },
                "objectRef": {
                  "pattern": "^objects/entities/[^/].+$"
                }
              }
            },
            "else": {
              "properties": {
                "objectRef": {
                  "pattern": "^objects/posts/(article|image|video)/[^/].+$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "carrier": {
      "enum": [
        "homepage",
        "article",
        "image",
        "video"
      ]
    },
    "entry": {
      "enum": [
        "feed",
        "search",
        "recommendation",
        "direct_or_object_route"
      ]
    },
    "carrierCounts": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 0
        },
        "article": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "video": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "matrixCell": {
      "type": "object",
      "required": [
        "entry",
        "carrier",
        "applicability"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "#/$defs/entry"
        },
        "carrier": {
          "$ref": "#/$defs/carrier"
        },
        "applicability": {
          "enum": [
            "required",
            "not_applicable"
          ]
        },
        "specRef": {
          "type": "string",
          "pattern": "^specs/feature-tree/.+\\.md#[a-z0-9][a-z0-9._-]*$"
        },
        "runnerClass": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "required"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "required": [
              "specRef",
              "runnerClass"
            ],
            "not": {
              "required": [
                "reasonCode"
              ]
            }
          },
          "else": {
            "required": [
              "reasonCode"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "specRef"
                  ]
                },
                {
                  "required": [
                    "runnerClass"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "milestone": {
            "const": "M1000"
          }
        },
        "required": [
          "milestone"
        ]
      },
      "then": {
        "properties": {
          "sampleStrategy": {
            "properties": {
              "authority": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "sampleStrategy": {
            "properties": {
              "authority": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
