{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "平台级内容供给任务：垂类 × 场景 × 作者人设 × 载体。",
  "type": "object",
  "required": [
    "schemaVersion",
    "supplyTaskId",
    "goal",
    "vertical",
    "scenarios",
    "dailyContentTarget",
    "authorPool",
    "contentMix",
    "contentTargets",
    "subject",
    "sopRefs",
    "planningContract",
    "creatorGovernance",
    "queuePolicy",
    "tokenBudget",
    "releasePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "quwoquan.content_supply.task" },
    "supplyTaskId": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "vertical": { "enum": ["travel", "campus", "photography", "tech", "car"] },
    "verticalLabel": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["cold_start", "long_tail_fill", "hotspot_tracking", "optimize_existing", "refresh_stale", "reported_revision"]
      }
    },
    "dailyContentTarget": { "type": "integer", "minimum": 1 },
    "authorPool": {
      "type": "object",
      "required": ["multiplier", "size", "activation", "dailyActiveAuthorTarget", "publishIntervalDays", "identityPolicy"],
      "properties": {
        "domain": { "const": "CreatorProfile/SystemAuthor" },
        "multiplier": { "type": "integer", "minimum": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "activation": { "const": "daily_quota" },
        "dailyActiveAuthorTarget": { "type": "integer", "minimum": 1 },
        "publishIntervalDays": {
          "type": "object",
          "required": ["min", "max", "mean"],
          "properties": {
            "min": { "const": 1 },
            "max": { "const": 5 },
            "mean": { "const": 3 }
          }
        },
        "identityPolicy": {
          "type": "object",
          "required": ["transparentSystemCreator", "forbidFakeRealExperience", "forbidUnprovenOfficialOrProfessionalClaims", "doNotMaterializeEachAuthorAsTagOrEntity"],
          "properties": {
            "transparentSystemCreator": { "const": true },
            "forbidFakeRealExperience": { "const": true },
            "forbidUnprovenOfficialOrProfessionalClaims": { "const": true },
            "doNotMaterializeEachAuthorAsTagOrEntity": { "const": true }
          }
        },
        "defaultStatus": { "const": "active" },
        "lifecycle": {
          "type": "array",
          "items": { "enum": ["draft", "ai_reviewed", "active", "throttled", "suspended", "retired"] },
          "contains": { "const": "active" }
        },
        "claimPolicy": {
          "type": "object",
          "required": ["defaultExperienceClaimMode", "firstPersonRequiresHumanOrLicensedEvidence", "forbidOfficialOrProfessionalClaimWithoutEvidence"],
          "properties": {
            "defaultExperienceClaimMode": { "const": "editorial_synthesis" },
            "allowedExperienceClaimModes": {
              "type": "array",
              "items": { "enum": ["editorial_synthesis", "authorized_first_person", "public_data_analysis", "visual_discovery"] }
            },
            "firstPersonRequiresHumanOrLicensedEvidence": { "const": true },
            "forbidOfficialOrProfessionalClaimWithoutEvidence": { "const": true }
          }
        },
        "disclosure": {
          "type": "object",
          "required": ["required", "type", "displayText", "mustBeUserVisible"],
          "properties": {
            "required": { "const": true },
            "type": { "const": "platform_virtual_creator" },
            "displayText": { "type": "string", "minLength": 1 },
            "mustBeUserVisible": { "const": true }
          }
        },
        "creatorArchetypes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contentMix": {
      "type": "object",
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "contentTargets": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "subject": {
      "type": "object",
      "required": ["kind", "type", "refs"],
      "properties": {
        "kind": { "type": "string" },
        "type": { "type": "string" },
        "refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "sopRefs": {
      "type": "object",
      "required": ["verticalSopRef", "scenarioSopRefs", "contentSpecRefs"],
      "properties": {
        "verticalSopRef": { "type": "string" },
        "scenarioSopRefs": { "type": "object", "additionalProperties": { "type": "string" } },
        "contentSpecRefs": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "runModes": {
      "type": "array",
      "items": { "enum": ["new", "fill_missing", "optimize_existing", "refresh_stale", "repair_failed"] }
    },
    "planningContract": {
      "type": "object",
      "required": ["requiredBindings", "layers", "dedupBeforeGeneration", "aiReviewDefault", "humanReviewMode"],
      "properties": {
        "requiredBindings": {
          "type": "array",
          "contains": { "const": "creatorProfileId" }
        },
        "layers": {
          "type": "array",
          "contains": { "const": "vertical" }
        },
        "dedupBeforeGeneration": { "const": true },
        "aiReviewDefault": { "const": true },
        "humanReviewMode": { "const": "spot_check_or_high_risk" },
        "forbidBareTopicGeneration": { "const": true },
        "creatorRequiredFields": {
          "type": "array",
          "contains": { "const": "creatorProfileId" }
        },
        "activeRefsProjection": { "const": "semanticMentions.published_only" }
      }
    },
    "creatorGovernance": {
      "type": "object",
      "required": ["domain", "stateMachine", "tagEntityPolicy"],
      "properties": {
        "domain": { "const": "CreatorProfile/SystemAuthor" },
        "tagEntityPolicy": {
          "type": "object",
          "required": ["authorClassificationTagsOnly", "doNotCreateTagPerAuthor", "doNotCreateEntityPerVirtualAuthor"],
          "properties": {
            "authorClassificationTagsOnly": { "const": true },
            "doNotCreateTagPerAuthor": { "const": true },
            "doNotCreateEntityPerVirtualAuthor": { "const": true }
          }
        }
      }
    },
    "queuePolicy": {
      "type": "object",
      "required": ["backend", "productionBackends", "leaseSeconds", "heartbeatSeconds", "deadLetterAfterAttempts"],
      "properties": {
        "backend": { "enum": ["local_file", "reliabletask"] },
        "productionBackends": {
          "type": "array",
          "items": { "enum": ["reliabletask"] }
        },
        "defaultProductionBackend": { "const": "reliabletask" },
        "reliableTask": {
          "type": "object",
          "required": ["taskType", "queue", "store", "readyIndex"],
          "properties": {
            "taskType": { "const": "data.content_object.execute" },
            "queue": { "const": "reliabletask.data.content_supply" },
            "store": { "const": "MongoStore" },
            "readyIndex": { "const": "RedisReadyIndex" }
          }
        },
        "leaseSeconds": { "type": "integer", "minimum": 60 },
        "heartbeatSeconds": { "type": "integer", "minimum": 10 },
        "deadLetterAfterAttempts": { "type": "integer", "minimum": 1 }
      }
    },
    "tokenBudget": {
      "type": "object",
      "required": ["sopSummaryMaxTokens", "creatorProfileSummaryMaxTokens", "evidenceSummaryMaxTokens", "draftMaxTokens", "reviewMaxTokens"],
      "properties": {
        "sopSummaryMaxTokens": { "type": "integer", "maximum": 500 },
        "creatorProfileSummaryMaxTokens": { "type": "integer", "maximum": 300 },
        "evidenceSummaryMaxTokens": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "draftMaxTokens": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "reviewMaxTokens": { "type": "integer", "minimum": 1 },
        "overflowAction": { "const": "summarize_or_reject" }
      }
    },
    "releasePolicy": {
      "type": "object",
      "required": ["mode", "publishRequiresReleaseVerify", "importRequiresProjectionVerify", "activeRefsProjection"],
      "properties": {
        "mode": { "const": "isolated_release_first" },
        "publishRequiresReleaseVerify": { "const": true },
        "importRequiresProjectionVerify": { "const": true },
        "allowPendingReviewMentions": { "type": "boolean" },
        "activeRefsProjection": { "const": "semanticMentions.published_only" }
      }
    }
  }
}
