{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "单次运行账本 — quwoquan_data/tasks/<taskId>/runs/run_<ts>.json。沉淀会话总结与增量，供复盘与重启参考。",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "quwoquan.task.run" },
    "runId": { "type": "string", "description": "运行 id，如 run_20260601_0156" },
    "taskId": { "type": "string" },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": ["string", "null"] },
    "owner": { "type": "string", "description": "执行者（会话/subagent 标识）" },
    "batches": { "type": "array", "items": { "type": "string" }, "description": "本次涉及的 batch id" },
    "delta": {
      "type": "object",
      "description": "本次增量",
      "properties": {
        "entitiesAdded": { "type": "integer" },
        "postsAdded": { "type": "integer" },
        "entitiesUpdated": { "type": "integer" },
        "postsUpdated": { "type": "integer" }
      }
    },
    "sessionSummary": { "type": "string", "description": "本次会话做了什么（人读）" },
    "decisions": { "type": "array", "items": { "type": "string" }, "description": "关键决策/取舍" },
    "nextSuggested": { "type": "array", "items": { "type": "string" }, "description": "下一步建议（重启入口）" }
  },
  "required": ["schemaVersion", "runId", "taskId", "startedAt"]
}
