{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "任务进度断点 — quwoquan_data/tasks/<taskId>/progress.json。重启续跑唯一依据：广度(coverage.entities) + 深度(anglesByEntity / conditionCells)。",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "quwoquan.task.progress" },
    "taskId": { "type": "string" },
    "updatedAt": { "type": "string" },
    "coverage": {
      "type": "object",
      "description": "广度：目标实体的完成/待补",
      "properties": {
        "entities": {
          "type": "object",
          "properties": {
            "done": { "type": "array", "items": { "type": "string" }, "description": "已完成实体（entityType/name）" },
            "remaining": { "type": "array", "items": { "type": "string" }, "description": "待补实体" }
          },
          "required": ["done", "remaining"]
        },
        "categoriesDone": { "type": "array", "items": { "type": "string" }, "description": "父任务用：各实体类别广度完成情况" }
      }
    },
    "anglesByEntity": {
      "type": "object",
      "description": "深度：每实体已完成角度集合（entityRef -> [angle...]）",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "conditionCells": {
      "type": "array",
      "description": "深度：已覆盖的 地域×季节 条件格",
      "items": {
        "type": "object",
        "properties": {
          "region": { "type": "string" },
          "season": { "type": "string" }
        }
      }
    },
    "openGaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "已知缺口（人读），resume 优先消费"
    },
    "counts": {
      "type": "object",
      "properties": {
        "entities": { "type": "integer" },
        "posts": { "type": "integer" }
      }
    },
    "lastRunId": { "type": ["string", "null"] }
  },
  "required": ["schemaVersion", "taskId", "coverage"]
}
