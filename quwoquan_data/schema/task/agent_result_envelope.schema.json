{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structured Agent result envelope accepted by the production controller.",
  "type": "object",
  "required": ["schemaVersion", "jobId", "taskId", "batchId", "ref", "stage", "files", "gates"],
  "properties": {
    "schemaVersion": { "const": "quwoquan.agent_result_envelope" },
    "envelopeId": { "type": "string" },
    "jobId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "properties": {
        "agentId": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "role": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "gate_verdict.schema.json" }
    }
  }
}
