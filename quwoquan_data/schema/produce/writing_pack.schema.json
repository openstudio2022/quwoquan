{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "写作契约 writing_pack — 内容对象 3.compose/writing_pack.json（CLI prepare 产出，供会话模型创作正文）",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "ref": { "type": "string" },
    "kind": { "type": "string" },
    "title": { "type": "string" },
    "byline": { "type": "string" },
    "carrier": { "type": "string" },
    "publishLayout": { "type": "string" },
    "templateId": { "type": ["string", "null"] },
    "wordCount": { "type": "object" },
    "forbiddenPhrases": { "type": "array", "items": { "type": "string" } },
    "mustIncludeFacts": { "type": "array", "items": { "type": "string" } },
    "sectionIntents": { "type": "array", "items": { "type": "string" } },
    "narrativeContract": { "type": "object" },
    "styleFamily": { "type": "string" },
    "evidencePoints": { "type": "array" },
    "assets": { "type": "array" },
    "writingIntent": {
      "type": "string",
      "enum": ["planning_consultation", "decision_experience", "post_trip_journal"],
      "description": "写作主线：单篇唯一；prompt.md 据此给会话模型主线导向"
    },
    "baseSourceRef": { "type": ["string", "null"], "description": "主底稿来源 ref（风格与事实锚点）" },
    "bannedRegisterTerms": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本主体类型禁用语域词（由垂类 SOP 注入，如户外景区禁'看展/展厅'）"
    }
  },
  "required": ["schemaVersion", "ref", "kind", "title", "carrier"]
}
