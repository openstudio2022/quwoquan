{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "证据驱动篇目规划包 — batches/{batch}/_shared/content_plan_packet.json（见 content_pipeline_spec.md §1.2.1）",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ref": { "type": "string" },
          "kind": { "type": "string", "enum": ["entity", "route"] },
          "title": { "type": "string" },
          "entityRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "rationale": { "type": "string" },
          "writingIntent": {
            "type": "string",
            "enum": ["planning_consultation", "decision_experience", "post_trip_journal"],
            "description": "写作主线：单篇唯一。攻略/咨询=planning_consultation，决策体验=decision_experience，游后记录=post_trip_journal"
          },
          "baseSourceRef": {
            "type": "string",
            "description": "主底稿来源 ref（相对内容对象 1.download/sources/）；作为风格与事实锚点，其它来源只能补事实"
          }
        },
        "required": ["ref", "kind", "title", "entityRefs", "evidenceRefs", "rationale", "writingIntent"]
      }
    }
  },
  "required": ["items"]
}
