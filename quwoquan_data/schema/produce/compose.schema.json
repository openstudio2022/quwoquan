{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "sourceFact": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "imageSource": {
      "type": "object",
      "required": [
        "sourceCollectionId",
        "creator",
        "collectionPageUrl",
        "license"
      ],
      "properties": {
        "sourceCollectionId": { "type": "string", "minLength": 1 },
        "creator": { "$ref": "#/$defs/sourceFact" },
        "collectionPageUrl": { "$ref": "#/$defs/sourceFact" },
        "license": { "$ref": "#/$defs/sourceFact" },
        "termsUrl": { "$ref": "#/$defs/sourceFact" },
        "authorizationProof": { "$ref": "#/$defs/sourceFact" }
      },
      "anyOf": [
        {
          "required": ["termsUrl"],
          "properties": { "termsUrl": { "$ref": "#/$defs/sourceFact" } }
        },
        {
          "required": ["authorizationProof"],
          "properties": { "authorizationProof": { "$ref": "#/$defs/sourceFact" } }
        }
      ]
    },
    "semanticMention": {
      "type": "object",
      "required": ["mentionId", "kind", "surface", "location", "rangeStart", "rangeEnd", "status"],
      "properties": {
        "mentionId": { "type": "string" },
        "kind": { "type": "string", "enum": ["entity", "tag"] },
        "surface": { "type": "string" },
        "location": { "type": "string" },
        "rangeStart": { "type": "integer", "minimum": 0 },
        "rangeEnd": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["published", "pending_review", "rejected", "offline"] },
        "candidateId": { "type": ["string", "null"] },
        "targetRef": { "type": ["string", "null"] }
      }
    }
  },
  "properties": {
    "topicId": { "type": "string" },
    "contentType": { "type": "string", "enum": ["article", "image", "video"] },
    "articleMarkdown": { "type": "string" },
    "title": { "type": "string" },
    "caption": { "type": "string" },
    "summary": { "type": "string" },
    "coverAssetRef": { "type": "string" },
    "entityRefs": { "type": "array", "items": { "type": "string" } },
    "tagRefs": { "type": "array", "items": { "type": "string" } },
    "semanticMentions": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticMention" }
    },
    "sourceUrls": { "type": "array", "items": { "type": "string" } },
    "sourcePaths": { "type": "array", "items": { "type": "string" } },
    "authorId": { "type": "string" },
    "creatorProfileId": { "type": "string" },
    "creatorArchetype": { "type": "string" },
    "creatorProfileVersion": { "type": "string" },
    "creatorDisclosure": {
      "type": "object",
      "required": ["type", "displayText", "visible"],
      "properties": {
        "type": { "const": "platform_virtual_creator" },
        "displayText": { "type": "string" },
        "visible": { "const": true }
      }
    },
    "experienceClaimMode": {
      "enum": ["editorial_synthesis", "authorized_first_person", "public_data_analysis", "visual_discovery"]
    },
    "authorQualitySignals": { "type": "object" },
    "template": { "type": "string" },
    "galleryMarkdown": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": { "type": "string" },
          "fileName": { "type": "string" },
          "caption": { "type": "string" },
          "sourceCollectionId": { "type": "string" },
          "creator": { "$ref": "#/$defs/sourceFact" },
          "collectionPageUrl": { "$ref": "#/$defs/sourceFact" },
          "license": { "$ref": "#/$defs/sourceFact" },
          "termsUrl": { "$ref": "#/$defs/sourceFact" },
          "authorizationProof": { "$ref": "#/$defs/sourceFact" },
          "page": { "$ref": "#/$defs/sourceFact" },
          "licenseProof": { "$ref": "#/$defs/sourceFact" },
          "kind": { "type": "string" },
          "scope": { "type": "string" },
          "objectKey": { "type": "string" },
          "sourcePath": { "type": "string" },
          "imageLayout": { "type": "string" }
        },
        "required": ["assetId", "fileName"]
      }
    },
    "carrier": { "type": "string", "enum": ["article", "image", "gallery", "review"] },
    "sourceCollectionId": { "type": "string" },
    "creator": { "$ref": "#/$defs/sourceFact" },
    "collectionPageUrl": { "$ref": "#/$defs/sourceFact" },
    "license": { "$ref": "#/$defs/sourceFact" },
    "termsUrl": { "$ref": "#/$defs/sourceFact" },
    "authorizationProof": { "$ref": "#/$defs/sourceFact" },
    "page": { "$ref": "#/$defs/sourceFact" },
    "licenseProof": { "$ref": "#/$defs/sourceFact" },
    "publishLayout": { "type": "string", "enum": ["travel", "campus", "image", "gallery"] },
    "publishAngle": { "type": "string" },
    "publishTitle": { "type": "string" },
    "publishSeq": { "type": "integer" },
    "articleRenderProfile": { "type": "object" },
    "conditionContext": { "type": "object" },
    "recommendation": { "type": "object" },
    "composeBriefRef": { "type": "string" },
    "sourceQuality": { "type": "array" },
    "storySpine": { "type": "object" },
    "relatedSearchPlan": { "type": "object" },
    "evidenceBundle": { "type": "object" },
    "writingIntent": {
      "type": "string",
      "enum": ["planning_consultation", "decision_experience", "post_trip_journal"],
      "description": "写作主线：单篇唯一；门禁校验正文结构与之匹配"
    },
    "baseSourceRef": { "type": ["string", "null"], "description": "主底稿来源 ref（风格与事实锚点）" },
    "imageBindings": { "type": "array", "items": { "type": "object" } },
    "videoBindings": { "type": "array", "items": { "type": "object" } }
  },
  "required": ["topicId", "entityRefs", "tagRefs"],
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": { "contentType": { "const": "image" } },
            "required": ["contentType"]
          },
          {
            "properties": { "carrier": { "enum": ["image", "gallery"] } },
            "required": ["carrier"]
          }
        ]
      },
      "then": {
        "required": ["assets"],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "caption": { "type": "string", "maxLength": 300 },
          "assets": { "type": "array", "minItems": 1, "maxItems": 20 }
        },
        "anyOf": [
          { "$ref": "#/$defs/imageSource" },
          {
            "properties": {
              "assets": {
                "type": "array",
                "items": { "$ref": "#/$defs/imageSource" }
              }
            },
            "required": ["assets"]
          }
        ]
      },
      "else": {
        "required": ["articleMarkdown", "title"],
        "properties": {
          "articleMarkdown": { "type": "string", "minLength": 300 },
          "title": { "type": "string" },
          "entityRefs": { "type": "array", "minItems": 1 },
          "tagRefs": { "type": "array", "minItems": 2 }
        }
      }
    }
  ]
}
