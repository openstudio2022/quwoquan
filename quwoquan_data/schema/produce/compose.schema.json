{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topicId": { "type": "string" },
    "articleMarkdown": { "type": "string", "minLength": 300 },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "coverAssetRef": { "type": "string" },
    "entityRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tagRefs": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "sourceUrls": { "type": "array", "items": { "type": "string" } },
    "sourcePaths": { "type": "array", "items": { "type": "string" } },
    "template": { "type": "string" },
    "galleryMarkdown": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": { "type": "string" },
          "fileName": { "type": "string" },
          "caption": { "type": "string" },
          "kind": { "type": "string" },
          "scope": { "type": "string" },
          "objectKey": { "type": "string" },
          "sourcePath": { "type": "string" },
          "imageLayout": { "type": "string" }
        },
        "required": ["assetId", "fileName"]
      }
    },
    "publishLayout": { "type": "string", "enum": ["travel", "campus"] },
    "publishAngle": { "type": "string" },
    "publishTitle": { "type": "string" },
    "publishSeq": { "type": "integer" },
    "articleRenderProfile": { "type": "object" },
    "conditionContext": { "type": "object" },
    "recommendation": { "type": "object" },
    "composeBriefRef": { "type": "string" },
    "sourceQuality": { "type": "array" },
    "storySpine": { "type": "object" },
    "relatedSearchPlan": { "type": "object" },
    "evidenceBundle": { "type": "object" },
    "writingIntent": {
      "type": "string",
      "enum": ["planning_consultation", "decision_experience", "post_trip_journal"],
      "description": "写作主线：单篇唯一；门禁校验正文结构与之匹配"
    },
    "baseSourceRef": { "type": ["string", "null"], "description": "主底稿来源 ref（风格与事实锚点）" },
    "imageBindings": { "type": "array", "items": { "type": "object" } },
    "videoBindings": { "type": "array", "items": { "type": "object" } }
  },
  "required": ["topicId", "articleMarkdown", "title", "entityRefs", "tagRefs"]
}
