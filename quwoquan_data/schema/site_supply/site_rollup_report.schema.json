{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quwoquan_data/schema/site_supply/site_rollup_report.schema.json",
  "title": "Site Rollup Report",
  "type": "object",
  "required": ["schemaVersion", "vertical", "siteId", "batchId", "passed", "decision", "siteFunnel", "executionReadiness", "blockers", "warnings"],
  "properties": {
    "schemaVersion": {"const": "quwoquan.site_supply.site_rollup_report/1"},
    "vertical": {"type": "string"},
    "siteId": {"type": "string"},
    "batchId": {"type": "string"},
    "passed": {"type": "boolean"},
    "decision": {"enum": ["go", "no_go"]},
    "frontier": {"type": "object"},
    "siteFunnel": {
      "type": "object",
      "required": ["candidateCount", "scoreCount", "productionEligibleCount", "contentPlanHandoffCount", "deadLetterCount", "stageFailures"],
      "properties": {
        "candidateCount": {"type": "integer", "minimum": 0},
        "laneCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "scoreCount": {"type": "integer", "minimum": 0},
        "productionEligibleCount": {"type": "integer", "minimum": 0},
        "productionEligibleLaneCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "contentPlanHandoffCount": {"type": "integer", "minimum": 0},
        "contentPlanHandoffLaneCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "deadLetterCount": {"type": "integer", "minimum": 0},
        "stageFailures": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": true
    },
    "executionReadiness": {
      "type": "object",
      "required": ["queueBackend", "measuredThroughput", "tokenLedgerCount", "releaseVerified", "importVerified", "searchVisible", "recommendationFeedbackReady"],
      "properties": {
        "queueBackend": {"enum": ["local_file", "reliabletask", ""]},
        "measuredThroughput": {"type": "object"},
        "firstPassRate": {"type": ["number", "null"]},
        "tokenLedgerCount": {"type": "integer"},
        "releaseVerified": {"type": "boolean"},
        "importVerified": {"type": "boolean"},
        "searchVisible": {"type": "boolean"},
        "recommendationFeedbackReady": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
