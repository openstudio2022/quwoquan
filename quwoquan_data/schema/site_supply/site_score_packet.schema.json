{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quwoquan_data/schema/site_supply/site_score_packet.schema.json",
  "title": "Site Score Packet",
  "type": "object",
  "required": ["schemaVersion", "vertical", "siteId", "batchId", "candidateRef", "scores", "productionEligible", "publishRecommendation", "gate"],
  "properties": {
    "schemaVersion": {"const": "quwoquan.site_supply.site_score_packet/1"},
    "vertical": {"type": "string"},
    "siteId": {"type": "string"},
    "batchId": {"type": "string"},
    "candidateRef": {"type": "string"},
    "canonicalUrl": {"type": "string"},
    "lane": {"type": "string"},
    "scores": {
      "type": "object",
      "required": ["overall", "contentQuality", "visualQuality", "freshness", "rightsSafety", "dedupeValue"],
      "additionalProperties": {"type": "number"}
    },
    "productionEligible": {"type": "boolean"},
    "publishRecommendation": {"enum": ["publish_candidate", "blocked"]},
    "issues": {"type": "array", "items": {"type": "string"}},
    "gate": {"type": "object"}
  },
  "additionalProperties": true
}
