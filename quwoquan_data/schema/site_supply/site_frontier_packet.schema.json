{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quwoquan_data/schema/site_supply/site_frontier_packet.schema.json",
  "title": "Site Frontier Packet",
  "type": "object",
  "required": ["schemaVersion", "vertical", "siteId", "batchId", "profile", "timeWindow", "queuePolicy", "frontier", "gate"],
  "properties": {
    "schemaVersion": {"const": "quwoquan.site_supply.site_frontier_packet/1"},
    "vertical": {"type": "string", "minLength": 1},
    "siteId": {"type": "string", "minLength": 1},
    "batchId": {"type": "string", "minLength": 1},
    "workspaceRoot": {"type": "string"},
    "sourceRegistryRef": {"type": "string"},
    "admissionMode": {"enum": ["batch_crawl", "controlled_trial"]},
    "profile": {
      "type": "object",
      "required": [
        "siteId",
        "domains",
        "allowedPaths",
        "contentLanes",
        "fetchMode",
        "extractor",
        "rightsPolicy",
        "robotsPolicy",
        "loginPolicy",
        "watermarkPolicy",
        "crawlAllowed",
        "fetchable"
      ],
      "properties": {
        "siteId": {"type": "string"},
        "domains": {"type": "array", "items": {"type": "string"}},
        "allowedPaths": {"type": "array", "items": {"type": "string"}},
        "contentLanes": {"type": "array", "items": {"enum": ["homepage", "article", "image", "video", "knowledgeCard"]}},
        "fetchMode": {"type": "string"},
        "extractor": {"type": "string"},
        "rightsPolicy": {"type": "string"},
        "robotsPolicy": {"type": "string"},
        "loginPolicy": {"type": "string"},
        "watermarkPolicy": {"type": "string"},
        "termsUrl": {"type": "string"},
        "controlledTrial": {"type": "object"},
        "crawlAllowed": {"type": "boolean"},
        "fetchable": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "timeWindow": {
      "type": "object",
      "required": ["from", "to", "days"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "days": {"type": "integer", "maximum": 731}
      },
      "additionalProperties": false
    },
    "queuePolicy": {
      "type": "object",
      "required": ["backend", "partitionKeyPattern"],
      "properties": {
        "backend": {"enum": ["local_file", "reliabletask"]},
        "requiredForScale": {"type": "string"},
        "partitionKeyPattern": {"type": "string"}
      },
      "additionalProperties": true
    },
    "frontier": {"type": "object"},
    "handoff": {"type": "object"},
    "gate": {"type": "object"}
  },
  "additionalProperties": true
}
