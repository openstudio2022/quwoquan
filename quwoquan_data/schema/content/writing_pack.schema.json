{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "写作契约 writing_pack — 内容对象 3.compose/writing_pack.json（宿主 AI 逐对象产出，供作者会话创作正文）",
  "type": "object",
  "properties": {
    "stage": {
      "const": "3.compose"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "executionBinding": {
      "enum": [
        "frozen",
        "standalone"
      ]
    },
    "sourcePolicyRevision": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "promptBundleRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "qualityRef": {
      "const": "2.quality/quality_analysis.json"
    },
    "qualityDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selectedSourceUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "ref": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "byline": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "vertical": {
      "type": [
        "string",
        "null"
      ]
    },
    "publishLayout": {
      "type": "string"
    },
    "templateId": {
      "type": [
        "string",
        "null"
      ]
    },
    "wordCount": {
      "type": "object"
    },
    "forbiddenPhrases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mustIncludeFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sectionIntents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narrativeContract": {
      "type": "object"
    },
    "styleFamily": {
      "type": "string"
    },
    "evidencePoints": {
      "type": "array"
    },
    "assets": {
      "type": "array"
    },
    "writingIntent": {
      "type": "string",
      "enum": [
        "planning_consultation",
        "decision_experience",
        "post_trip_journal"
      ],
      "description": "写作主线：单篇唯一；prompt.md 据此给会话模型主线导向"
    },
    "articleCategory": {
      "const": "photography"
    },
    "baseSourceRef": {
      "type": [
        "string",
        "null"
      ],
      "description": "主底稿来源 ref（风格与事实锚点）"
    },
    "creatorProfileRef": {
      "type": "string",
      "pattern": "^qwq_creator_[a-z0-9_]+$",
      "description": "canonical publish/creators/ 下的 creator 目录名；物化器据此派生 manifest creator 绑定字段"
    },
    "tagRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]+/.+"
      },
      "description": "canonical tags 引用（publish-closure 校验无悬空）；由 3.compose 从既有 canonical tag 集选择"
    },
    "allowedContactNumbers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "description": "仅从主底稿中带官方场馆语境的联系方式派生，用于 review 放行"
    },
    "bannedRegisterTerms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "本主体类型禁用语域词（由垂类模板规则注入，如户外景区禁'看展/展厅'）"
    },
    "schema": {
      "const": "quwoquan_data.writing_pack"
    },
    "selectedSourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sources/[^/]+/source\\.md$"
      }
    }
  },
  "required": [
    "schema",
    "stage",
    "executionId",
    "qualityRef",
    "qualityDigest",
    "selectedSourceUrls",
    "selectedSourceRefs",
    "ref",
    "kind",
    "title",
    "carrier"
  ],
  "additionalProperties": false
}
