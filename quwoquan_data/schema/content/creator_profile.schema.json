{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "creatorProfileId",
    "subAccountId",
    "authorId",
    "isSystemBuiltin",
    "displayName",
    "userHandle",
    "headline",
    "bio",
    "creatorArchetype",
    "status",
    "verticalRefs",
    "scenarioRefs",
    "claimPolicy",
    "disclosure",
    "publishCadence",
    "qualityScore",
    "fatigueScore",
    "riskTier",
    "profileVersion",
    "publicProfileTagRefs",
    "recommendationTagRefs",
    "preferredBlueprintIds",
    "voiceStyle",
    "expertiseClaims",
    "mustNotClaim",
    "coverageScope",
    "carrierAffinity"
  ],
  "properties": {
    "creatorProfileId": { "type": "string" },
    "subAccountId": { "type": "string" },
    "authorId": { "type": "string" },
    "isSystemBuiltin": { "type": "boolean" },
    "displayName": { "type": "string" },
    "userHandle": { "type": "string" },
    "avatarObjectKey": { "type": "string" },
    "headline": { "type": "string" },
    "bio": { "type": "string" },
    "creatorArchetype": { "type": "string" },
    "status": { "enum": ["draft", "ai_reviewed", "active", "throttled", "suspended", "retired"] },
    "verticalRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scenarioRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "claimPolicy": {
      "type": "object",
      "required": ["experienceClaimMode", "mayUseFirstPerson", "mustCiteEvidenceForClaims", "forbiddenClaims"],
      "properties": {
        "experienceClaimMode": {
          "enum": ["editorial_synthesis", "authorized_first_person", "public_data_analysis", "visual_discovery"]
        },
        "mayUseFirstPerson": { "type": "boolean" },
        "mustCiteEvidenceForClaims": { "const": true },
        "forbiddenClaims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disclosure": {
      "type": "object",
      "required": ["type", "displayText", "visible"],
      "properties": {
        "type": { "const": "platform_virtual_creator" },
        "displayText": { "type": "string" },
        "visible": { "const": true }
      }
    },
    "publishCadence": {
      "type": "object",
      "required": ["intervalDays", "randomizedRangeDays", "maxDailyPosts"],
      "properties": {
        "intervalDays": { "type": "integer", "minimum": 1, "maximum": 5 },
        "randomizedRangeDays": {
          "type": "array",
          "prefixItems": [{ "const": 1 }, { "const": 5 }],
          "items": false
        },
        "maxDailyPosts": { "type": "integer", "maximum": 1 }
      }
    },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "fatigueScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskTier": { "enum": ["low", "medium", "high"] },
    "profileVersion": { "type": "string" },
    "publicProfileTagRefs": { "type": "array", "items": { "type": "string" } },
    "recommendationTagRefs": { "type": "array", "items": { "type": "string" } },
    "preferredBlueprintIds": { "type": "array", "items": { "type": "string" } },
    "voiceStyle": { "type": "object" },
    "expertiseClaims": { "type": "array", "items": { "type": "string" } },
    "mustNotClaim": { "type": "array", "items": { "type": "string" } },
    "coverageScope": {
      "type": "object",
      "description": "作者题材与地理范围（用于内容→作者最适配匹配的范围维度）。",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["nationwide", "regional", "thematic"] },
        "label": { "type": "string" },
        "regionRefs": { "type": "array", "items": { "type": "string" } },
        "topicRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "carrierAffinity": {
      "type": "object",
      "description": "作者载体偏向权重（article/image/video，0..1）；为 0 表示不产出该载体。",
      "required": ["article", "image", "video"],
      "properties": {
        "article": { "type": "number", "minimum": 0, "maximum": 1 },
        "image": { "type": "number", "minimum": 0, "maximum": 1 },
        "video": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
