{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3.compose entity homepage packet",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "executionBinding",
    "sourcePolicyRevision",
    "sourceRevision",
    "promptBundleRevision",
    "executionId",
    "step",
    "ref",
    "selectedSourceUrls",
    "payload"
  ],
  "properties": {
    "stage": {
      "const": "3.compose"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "executionBinding": {
      "enum": [
        "frozen",
        "standalone"
      ]
    },
    "sourcePolicyRevision": {
      "const": "encyclopedia-primary"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "promptBundleRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "step": {
      "const": "entity_page"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "selectedSourceUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "name",
        "entityRef",
        "baseDraft",
        "draftPage",
        "minChars",
        "minSectionChars"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "minChars": {
          "type": "integer",
          "minimum": 1
        },
        "minSectionChars": {
          "type": "integer",
          "minimum": 1
        },
        "entityRef": {
          "type": "string",
          "minLength": 1
        },
        "baseDraft": {
          "type": "object",
          "oneOf": [
            {
              "maxProperties": 0
            },
            {
              "additionalProperties": false,
              "required": [
                "sourceRef",
                "primaryEvidenceRef",
                "entityName",
                "sourceKind",
                "extractor",
                "canonicalUrl",
                "sourceTitle",
                "policyRevision",
                "text"
              ],
              "properties": {
                "sourceRef": {
                  "type": "string",
                  "minLength": 1
                },
                "primaryEvidenceRef": {
                  "type": "string",
                  "minLength": 1
                },
                "entityName": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceKind": {
                  "enum": [
                    "wikipedia",
                    "baidu_baike",
                    "toutiao_baike"
                  ]
                },
                "extractor": {
                  "enum": [
                    "wikipedia_api",
                    "baidu_baike_html",
                    "toutiao_baike_html"
                  ]
                },
                "canonicalUrl": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sourceTitle": {
                  "type": "string",
                  "minLength": 1
                },
                "policyRevision": {
                  "const": "encyclopedia-primary"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "draftPage": {
          "const": "4.draft/page.md"
        }
      }
    },
    "schema": {
      "const": "quwoquan_data.stage_envelope"
    }
  }
}
