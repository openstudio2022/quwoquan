{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/schema/content/pool_admission.schema.json",
  "title": "Author and content pool admission",
  "$defs": {
    "processResult": {"enum": ["completed", "failed"]},
    "qualityResult": {"enum": ["passed", "failed"]},
    "evidenceRef": {"type": "string", "minLength": 1},
    "evidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usageScope": {"enum": ["research", "commercial"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processResult",
        "qualityResult",
        "evidenceRef",
        "evidenceDigest"
      ],
      "properties": {
        "processResult": {"$ref": "#/$defs/processResult"},
        "qualityResult": {"$ref": "#/$defs/qualityResult"},
        "evidenceRef": {"$ref": "#/$defs/evidenceRef"},
        "evidenceDigest": {"$ref": "#/$defs/evidenceDigest"}
      }
    },
    "authorAdmission": {
      "$ref": "#/$defs/evidence"
    },
    "contentAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processResult",
        "qualityResult",
        "usageScope",
        "rightsResult",
        "rightsAuthorityRef",
        "rightsAuthorityDigest",
        "evidenceRef",
        "evidenceDigest"
      ],
      "properties": {
        "processResult": {"$ref": "#/$defs/processResult"},
        "qualityResult": {"$ref": "#/$defs/qualityResult"},
        "usageScope": {"$ref": "#/$defs/usageScope"},
        "rightsResult": {"const": "passed"},
        "rightsAuthorityRef": {"type": "string", "minLength": 1},
        "rightsAuthorityDigest": {"$ref": "#/$defs/evidenceDigest"},
        "evidenceRef": {"$ref": "#/$defs/evidenceRef"},
        "evidenceDigest": {"$ref": "#/$defs/evidenceDigest"}
      }
    }
  }
}
