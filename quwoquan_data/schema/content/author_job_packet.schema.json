{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "4.draft author job packet",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "executionBinding",
    "objectRef",
    "composePacketRef",
    "promptRef",
    "promptSnapshotRef",
    "hostRuntime",
    "hostActor",
    "runId",
    "outputRefs"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "const": "4.draft"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "executionBinding": {
      "enum": [
        "frozen",
        "standalone"
      ]
    },
    "objectRef": {
      "type": "string",
      "minLength": 1
    },
    "composePacketRef": {
      "type": "string",
      "minLength": 1
    },
    "promptRef": {
      "type": "string",
      "minLength": 1
    },
    "promptSnapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "outputRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "writingIntent": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseSourceRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "caption": {
      "type": "string"
    },
    "carrier": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentObjectDir": {
      "type": [
        "string",
        "null"
      ]
    },
    "writingPackRef": {
      "type": "string"
    },
    "sourcePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceUrls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mustIncludeFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bannedRegisterTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creativeBrief": {
      "type": "object"
    },
    "creatorAssignment": {
      "type": "object"
    },
    "captionPolicy": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "articleSourceUnitFreeze": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "receiptRef",
            "freezeDigest",
            "sourceUnitId",
            "sourceUnitRef",
            "executionSourceDigest"
          ],
          "additionalProperties": false,
          "properties": {
            "receiptRef": {
              "type": "string",
              "pattern": "^0\\.plan/article_source_unit_freezes/[^/]+\\.json$"
            },
            "freezeDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sourceUnitId": {
              "type": "string",
              "minLength": 1
            },
            "sourceUnitRef": {
              "type": "string",
              "pattern": "^sources/[^/]+$"
            },
            "executionSourceDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "exitGates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executionContract": {
      "type": "object"
    },
    "isolation": {
      "type": "string"
    },
    "schema": {
      "const": "quwoquan_data.author_job_packet"
    },
    "hostRuntime": {
      "const": "external_host_agent"
    },
    "hostActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "role"
      ],
      "properties": {
        "host": {
          "const": "external_host_agent"
        },
        "role": {
          "const": "author"
        }
      }
    }
  }
}
