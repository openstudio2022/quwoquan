{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "sourceVideoPath",
    "originalCreatorName",
    "platform",
    "sourcePostUrl",
    "originalAssetUrl",
    "attributionText",
    "rightsBasis",
    "commercialAuthorizationStatus",
    "publicationAdmission",
    "audioRightsStatus",
    "modelReleaseStatus",
    "propertyReleaseStatus",
    "takedownPolicy"
  ],
  "properties": {
    "sourceVideoPath": { "type": "string", "minLength": 1 },
    "originalCreatorName": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "sourcePostUrl": { "type": "string", "format": "uri" },
    "originalAssetUrl": { "type": "string", "format": "uri" },
    "attributionText": { "type": "string", "minLength": 1 },
    "rightsBasis": { "type": "string", "minLength": 1 },
    "commercialAuthorizationStatus": { "enum": ["verified", "unverified"] },
    "publicationAdmission": {
      "enum": ["research_release", "commercial_release", "risk_accepted_attribution_only"]
    },
    "authorizationProofUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "termsUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "riskAcceptanceId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "audioRightsStatus": {
      "enum": [
        "licensed",
        "original_authorized",
        "replaced_with_licensed_track",
        "no_audio",
        "unverified"
      ]
    },
    "audioAuthorizationProofUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "modelReleaseStatus": { "type": "string", "minLength": 1 },
    "propertyReleaseStatus": { "type": "string", "minLength": 1 },
    "takedownPolicy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"audioRightsStatus": {"const": "unverified"}}},
      "then": {"properties": {"publicationAdmission": {"const": "research_release"}}}
    },
    {
      "if": {
        "required": ["publicationAdmission"],
        "properties": {"publicationAdmission": {"const": "commercial_release"}}
      },
      "then": {
        "required": ["authorizationProofUrl", "termsUrl"],
        "properties": {
          "commercialAuthorizationStatus": {"const": "verified"},
          "authorizationProofUrl": {"type": "string", "pattern": "^https://"},
          "termsUrl": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  ]
}
