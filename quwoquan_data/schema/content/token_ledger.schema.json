{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Token and cost ledger entry scoped by one execution, job, creator and content type.",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "jobId",
    "runId",
    "provider",
    "model",
    "scope",
    "contentType",
    "budgetTokens",
    "usedTokens",
    "inputTokens",
    "outputTokens",
    "cacheReadTokens",
    "cacheWriteTokens",
    "costBudgetUsd",
    "costUsd",
    "costKnown",
    "costSource",
    "costIssue",
    "pricingRevision",
    "retryCostUsd",
    "passed",
    "cacheHits",
    "budgetExceeded"
  ],
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "P4 补强：用量必须关联到具体 agent run（无真实 run 的估算条目用 artifact:<ref> 合成关联）"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": ["execution_stage", "content_object"]
    },
    "executionStage": {
      "type": ["string", "null"]
    },
    "contentObjectRef": {
      "type": ["string", "null"]
    },
    "creatorProfileId": {
      "type": ["string", "null"]
    },
    "contentType": {
      "type": "string",
      "minLength": 1
    },
    "budgetTokens": {
      "type": "integer",
      "minimum": 0
    },
    "usedTokens": {
      "type": "integer",
      "minimum": 0
    },
    "inputTokens": {"type": "integer", "minimum": 0},
    "outputTokens": {"type": "integer", "minimum": 0},
    "cacheReadTokens": {"type": "integer", "minimum": 0},
    "cacheWriteTokens": {"type": "integer", "minimum": 0},
    "costBudgetUsd": {"type": "number", "minimum": 0},
    "costUsd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "costKnown": {"type": "boolean"},
    "costSource": {"type": ["string", "null"]},
    "costIssue": {"type": ["string", "null"]},
    "pricingRevision": {"type": ["string", "null"]},
    "retryCostUsd": {"type": "number", "minimum": 0},
    "passed": {"type": "boolean"},
    "cacheHits": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "budgetExceeded": {
      "type": "boolean"
    },
    "unitPassedCostUsd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "schema": {
      "const": "quwoquan.token_ledger"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"scope": {"const": "content_object"}}
      },
      "then": {
        "properties": {
          "creatorProfileId": {"type": "string", "minLength": 1},
          "contentObjectRef": {"type": "string", "minLength": 1}
        },
        "required": ["creatorProfileId", "contentObjectRef"]
      }
    }
  ]
}
