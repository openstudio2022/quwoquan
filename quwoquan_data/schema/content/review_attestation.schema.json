{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "5.review four-file closure attestation",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "executionBinding",
    "objectRef",
    "decision",
    "deterministicGate",
    "independentReviewer",
    "mediaRefReview",
    "repair"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "const": "5.review"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "executionBinding": {
      "enum": [
        "frozen",
        "standalone"
      ]
    },
    "objectRef": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approved",
        "revision_needed",
        "rejected"
      ]
    },
    "deterministicGate": {
      "$ref": "#/$defs/check"
    },
    "independentReviewer": {
      "type": "object",
      "description": "独立宿主 reviewer 结论；actor 与 reviewer_result.actor 必须一致，modelFamily 只作真实审计记录，不作异族准出硬门。",
      "required": [
        "status",
        "actor"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "actor": {
          "$ref": "reviewer_result.schema.json#/properties/actor",
          "description": "与 reviewer_result.actor 相同的独立宿主 reviewer 身份与真实调用。"
        },
        "resultHash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "mediaRefReview": {
      "$ref": "#/$defs/check"
    },
    "repair": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_required",
            "pending",
            "completed",
            "failed"
          ]
        }
      }
    },
    "schema": {
      "const": "quwoquan_data.review_attestation"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "status",
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
