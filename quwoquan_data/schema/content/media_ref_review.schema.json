{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "objectRef",
    "passed",
    "mediaIssues",
    "referenceIssues",
    "rightsReviews"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {"const": "5.review"},
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "objectRef": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "mediaIssues": {"type": "array", "items": {"type": "string"}},
    "referenceIssues": {"type": "array", "items": {"type": "string"}},
    "rightsReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetRef", "sourceUrl", "license", "termsUrl", "authorizationProof", "usageScope", "passed", "issues"],
        "properties": {
          "assetRef": {"type": "string", "minLength": 1},
          "sourceUrl": {"type": "string", "pattern": "^https://"},
          "license": {"type": "string", "minLength": 1},
          "termsUrl": {"type": "string", "pattern": "^https://"},
          "authorizationProof": {"type": ["string", "null"], "pattern": "^https://"},
          "usageScope": {"enum": ["research", "commercial"]},
          "passed": {"type": "boolean"},
          "issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "schema": {"const": "quwoquan_data.media_ref_review"}
  }
}
