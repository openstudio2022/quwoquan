{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "objectRef",
    "passed",
    "mediaIssues",
    "referenceIssues"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "const": "5.review"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "objectRef": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "mediaIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenceIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema": {
      "const": "quwoquan_data.media_ref_review"
    }
  }
}
