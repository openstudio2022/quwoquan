{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/content/content_review.schema.json",
  "description": "review 每对象唯一内容裁决。顶层 objectRef 唯一绑定冻结的 producer execution target identity，不承载发布后 canonical repository locator 或内容版本；独立 reviewer 提交语义保真报告与判断，seal 只补齐机械字段、核对摘要/覆盖/顺序闭包，不生成语义事实。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "executionId",
    "objectRef",
    "decision",
    "author",
    "reviewer",
    "candidateBindings",
    "dimensions",
    "blockingIssues",
    "assetRights",
    "protocol",
    "objectRevision",
    "dispositions"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.content_review"
    },
    "stage": {
      "const": "5.review"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "decision",
          "issues"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "blockingIssues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety": {
      "enum": [
        "ok",
        "concern"
      ]
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assetRights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRef",
          "sourceUrl",
          "license",
          "termsUrl",
          "authorizationProof",
          "decision",
          "issues"
        ],
        "properties": {
          "assetRef": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "termsUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "authorizationProof": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "qualityScores": {
      "description": "reviewer 申报的多维质量评分（只记录不门禁）：键为载体评分维度闭集成员（各载体六维，见 content-production Skill quality.md），值为 1–5 整数；缺席合法，脚本不补零。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "angle_and_title": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "audio_fit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "caption_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "composition_aesthetics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "editing_rhythm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "fact_traceability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "image_match": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "image_relevance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "information_completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "originality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "practical_density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "practical_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "readability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "rights_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "source_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "structure_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "subject_relevance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "technical_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "unique_perspective": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "uniqueness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "visual_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "qualityNotes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "semanticReport": {
      "description": "独立 reviewer 提交的语义保真报告；seal 仅核对来源/草稿摘要、覆盖计数闭包、顺序摘要守恒和状态闭包，不自行作语义判断。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedCarrier",
        "carrierCompatible",
        "sources",
        "issues"
      ],
      "properties": {
        "reviewedCarrier": {
          "enum": [
            "homepage",
            "article",
            "image",
            "video"
          ]
        },
        "carrierCompatible": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceRef",
              "sourceDigest",
              "parseStatus",
              "dialect",
              "dialectVersion",
              "capabilities",
              "sourceCounts",
              "draftCounts",
              "sourceSequenceDigest",
              "draftSequenceDigest"
            ],
            "properties": {
              "sourceRef": {
                "type": "string",
                "pattern": "^sources/.+/source\\.md$"
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "parseStatus": {
                "enum": [
                  "complete",
                  "degraded",
                  "unsupported_opaque"
                ]
              },
              "dialect": {
                "type": "string",
                "minLength": 1
              },
              "dialectVersion": {
                "type": "string",
                "minLength": 1
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "title",
                    "heading",
                    "paragraph",
                    "list",
                    "table_logical_grid",
                    "footnote",
                    "media_order"
                  ]
                }
              },
              "sourceCounts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "heading",
                  "paragraph",
                  "list",
                  "tableLogicalCell",
                  "footnote",
                  "media"
                ],
                "properties": {
                  "title": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "heading": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "paragraph": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "list": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tableLogicalCell": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "footnote": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "media": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "draftCounts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "heading",
                  "paragraph",
                  "list",
                  "tableLogicalCell",
                  "footnote",
                  "media"
                ],
                "properties": {
                  "title": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "heading": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "paragraph": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "list": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tableLogicalCell": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "footnote": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "media": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "sourceSequenceDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "draftSequenceDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "homepageFidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "headingTree",
            "paragraphOrder",
            "links",
            "nestedLists",
            "tableLogicalGrid",
            "footnotes",
            "mediaCaptionOrder"
          ],
          "properties": {
            "title": {
              "type": "boolean"
            },
            "tableLogicalGrid": {
              "type": "boolean"
            },
            "footnotes": {
              "type": "boolean"
            },
            "headingTree": {
              "type": "boolean"
            },
            "paragraphOrder": {
              "type": "boolean"
            },
            "links": {
              "type": "boolean"
            },
            "nestedLists": {
              "type": "boolean"
            },
            "mediaCaptionOrder": {
              "type": "boolean"
            }
          }
        },
        "articleIntent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "independent",
            "intent",
            "rationale"
          ],
          "properties": {
            "independent": {
              "type": "boolean"
            },
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "enum": [
                  "SEMANTIC_PARSE_INCOMPLETE",
                  "SEMANTIC_COVERAGE_GAP",
                  "STRUCTURE_ORDER_DRIFT",
                  "HOMEPAGE_FIDELITY_LOSS",
                  "CARRIER_MISMATCH",
                  "ARTICLE_INTENT_NOT_INDEPENDENT"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "protocol": {
      "$ref": "semantic_disposition.schema.json#/$defs/protocolTriplet"
    },
    "objectRevision": {
      "$ref": "semantic_disposition.schema.json#/$defs/objectTuple"
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "semantic_disposition.schema.json#/$defs/disposition"
      }
    },
    "objectIdentity": {
      "description": "Optional business identity carried by the manifest; never substituted for objectRef.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "entityRef"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "entityRef": {
          "type": "string",
          "pattern": "^/entity/(?!\\.{1,2}(?:/|$))[^/]+(?:/(?!\\.{1,2}(?:/|$))[^/]+)*$"
        }
      }
    },
    "author": {
      "$ref": "../execution/seal_input.schema.json#/$defs/actor"
    },
    "reviewer": {
      "$ref": "../execution/seal_input.schema.json#/$defs/actor"
    },
    "candidateBindings": {
      "description": "Single-track exact candidate closure. execution_draft binds its 4.draft artifact; immutable_remediation_artifact additionally requires manifest and semantic document.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "page",
        "manifest",
        "semanticDocument"
      ],
      "properties": {
        "origin": {
          "enum": [
            "execution_draft",
            "immutable_remediation_artifact"
          ]
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "manifest": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "digest"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "semanticDocument": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "digest"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "execution_draft"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "page": {
                "properties": {
                  "ref": {
                    "pattern": "^4\\.draft/(?:page\\.md|draft\\.article\\.md|image_work\\.json|video_script\\.json)$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "immutable_remediation_artifact"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "manifest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "digest"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "semanticDocument": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "digest"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "objectRef": {
      "description": "Opaque canonical logical identity; locator depth is not identity semantics.",
      "type": "string",
      "pattern": "^(?:entities/(?!\\.{1,2}(?:/|$))[^/]+(?:/(?!\\.{1,2}(?:/|$))[^/]+)*/[1-9][0-9]*|posts/(?:article|image|video)/(?!\\.{1,2}(?:/|$))[^/]+(?:/(?!\\.{1,2}(?:/|$))[^/]+)*/[1-9][0-9]*)$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approved"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "blockingIssues": {
            "maxItems": 0
          },
          "dimensions": {
            "items": {
              "properties": {
                "decision": {
                  "const": "approved"
                },
                "issues": {
                  "maxItems": 0
                }
              }
            }
          },
          "semanticReport": {
            "properties": {
              "carrierCompatible": {
                "const": true
              },
              "issues": {
                "maxItems": 0
              },
              "sources": {
                "items": {
                  "properties": {
                    "parseStatus": {
                      "const": "complete"
                    }
                  }
                }
              }
            }
          },
          "dispositions": {
            "items": {
              "allOf": [
                {
                  "$ref": "semantic_disposition.schema.json#/$defs/disposition"
                },
                {
                  "properties": {
                    "outcome": {
                      "const": "auto_continue"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approved"
          },
          "objectRef": {
            "pattern": "^entities/"
          }
        },
        "required": [
          "decision",
          "objectRef"
        ]
      },
      "then": {
        "properties": {
          "semanticReport": {
            "required": [
              "homepageFidelity"
            ],
            "properties": {
              "reviewedCarrier": {
                "const": "homepage"
              },
              "homepageFidelity": {
                "properties": {
                  "title": {
                    "const": true
                  },
                  "headingTree": {
                    "const": true
                  },
                  "paragraphOrder": {
                    "const": true
                  },
                  "links": {
                    "const": true
                  },
                  "nestedLists": {
                    "const": true
                  },
                  "tableLogicalGrid": {
                    "const": true
                  },
                  "footnotes": {
                    "const": true
                  },
                  "mediaCaptionOrder": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approved"
          },
          "objectRef": {
            "pattern": "^posts/article/"
          }
        },
        "required": [
          "decision",
          "objectRef"
        ]
      },
      "then": {
        "properties": {
          "semanticReport": {
            "required": [
              "articleIntent"
            ],
            "properties": {
              "reviewedCarrier": {
                "const": "article"
              },
              "articleIntent": {
                "properties": {
                  "independent": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
