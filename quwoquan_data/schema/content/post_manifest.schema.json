{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "作品 manifest — posts/{type}/{angle}/{title}/{seq}/manifest.json",
  "type": "object",
  "$defs": {
    "sourceFact": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "semanticMention": {
      "type": "object",
      "required": ["mentionId", "kind", "surface", "location", "rangeStart", "rangeEnd", "status"],
      "properties": {
        "mentionId": { "type": "string" },
        "kind": { "type": "string", "enum": ["entity", "tag"] },
        "surface": { "type": "string" },
        "location": { "type": "string" },
        "rangeStart": { "type": "integer", "minimum": 0 },
        "rangeEnd": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["published", "pending_review", "rejected", "offline"] },
        "candidateId": { "type": ["string", "null"] },
        "targetRef": { "type": ["string", "null"] }
      }
    },
    "sourceAttribution": {
      "type": "object",
      "required": [
        "isOriginal",
        "originalCreatorName",
        "platform",
        "sourcePostUrl",
        "originalAssetUrl",
        "attributionText",
        "rightsBasis",
        "commercialAuthorizationStatus",
        "publicationAdmission",
        "watermarkStatus",
        "audioRightsStatus",
        "modelReleaseStatus",
        "propertyReleaseStatus",
        "collectedAt",
        "takedownPolicy"
      ],
      "properties": {
        "isOriginal": { "type": "boolean" },
        "originalCreatorId": { "type": ["string", "null"] },
        "originalCreatorName": { "type": "string", "minLength": 1 },
        "originalCreatorProfileUrl": { "type": ["string", "null"] },
        "platform": { "type": "string", "minLength": 1 },
        "sourcePostUrl": { "type": "string", "minLength": 1 },
        "originalAssetUrl": { "type": "string", "minLength": 1 },
        "attributionText": { "type": "string", "minLength": 1 },
        "rightsBasis": { "type": "string", "minLength": 1 },
        "commercialAuthorizationStatus": { "type": "string", "minLength": 1 },
        "publicationAdmission": {
          "enum": ["commercial_release", "risk_accepted_attribution_only"]
        },
        "authorizationProofUrl": { "type": ["string", "null"] },
        "termsUrl": { "type": ["string", "null"] },
        "riskAcceptanceId": { "type": ["string", "null"] },
        "watermarkStatus": { "const": "absent" },
        "audioRightsStatus": {
          "enum": [
            "licensed",
            "original_authorized",
            "replaced_with_licensed_track",
            "no_audio"
          ]
        },
        "modelReleaseStatus": { "type": "string", "minLength": 1 },
        "propertyReleaseStatus": { "type": "string", "minLength": 1 },
        "collectedAt": { "type": "string", "minLength": 1 },
        "takedownPolicy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "vertical": { "type": "string", "minLength": 1 },
    "topicId": { "type": "string", "description": "如'峨眉山_金顶日出攻略'" },
    "contentType": { "type": "string", "enum": ["article", "image", "video"] },
    "title": { "type": "string" },
    "caption": { "type": "string" },
    "entityRefs": { "type": "array", "items": { "type": "string" }, "description": "中文实体名数组" },
    "tagRefs": { "type": "array", "items": { "type": "string" }, "description": "路径格式标签ID数组" },
    "semanticMentions": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticMention" }
    },
    "authorId": { "type": "string" },
    "creatorProfileId": { "type": "string" },
    "creatorArchetype": { "type": "string" },
    "creatorProfileVersion": { "type": "string" },
    "creatorDisclosure": {
      "type": "object",
      "required": ["type", "displayText", "visible"],
      "properties": {
        "type": { "const": "platform_virtual_creator" },
        "displayText": { "type": "string" },
        "visible": { "const": true }
      }
    },
    "experienceClaimMode": {
      "enum": ["editorial_synthesis", "authorized_first_person", "public_data_analysis", "visual_discovery"]
    },
    "authorQualitySignals": { "type": "object" },
    "sourceUrls": { "type": "array", "items": { "type": "string" } },
    "allowedContactNumbers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]+$" },
      "uniqueItems": true,
      "description": "来源已核实的公共联系电话，仅供内容安全复核"
    },
    "sourceAttribution": { "$ref": "#/$defs/sourceAttribution" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": { "type": "string" },
          "fileName": { "type": "string" },
          "caption": { "type": "string" },
          "kind": { "type": "string", "enum": ["image", "video"] },
          "role": { "type": "string", "enum": ["cover", "detail", "embedded"] },
          "sourceCollectionId": { "type": "string" },
          "objectKey": { "type": "string" },
          "cdnUrl": { "type": "string" },
          "sha256": { "type": "string" },
          "mimeType": { "type": "string" },
          "thumbnailUrl": { "type": "string" },
          "coverUrl": { "type": "string" },
          "coverStrategy": { "type": "string", "enum": ["first_frame", "manual", "auto"] },
          "coverFrameTimeMs": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "container": { "type": "string" },
          "codec": { "type": "string" },
          "pixelFormat": { "type": "string" },
          "posterFileName": { "type": "string" },
          "posterAssetId": { "type": "string" },
          "subtitlesFileName": { "type": "string" },
          "posterSha256": { "type": "string" },
          "subtitlesSha256": { "type": "string" },
          "provenanceRef": { "type": "string" },
          "sourceAssetRefs": { "type": "array", "items": { "type": "string" } },
          "rightsRefs": { "type": "array", "items": { "type": "string" } },
          "creator": { "$ref": "#/$defs/sourceFact" },
          "collectionPageUrl": { "$ref": "#/$defs/sourceFact" },
          "license": { "$ref": "#/$defs/sourceFact" },
          "termsUrl": { "$ref": "#/$defs/sourceFact" },
          "authorizationProof": { "$ref": "#/$defs/sourceFact" },
          "rightsAuditStatus": { "enum": ["verified", "unverified"] },
          "rightsAuditIssues": { "type": "array", "items": { "type": "string" } },
          "imageLayout": { "type": "string", "enum": ["fullWidth", "wrapLeft", "wrapRight", "gallery"] }
        },
        "required": ["assetId", "fileName"]
      }
    },
    "sourceCollectionId": { "type": "string" },
    "creator": { "$ref": "#/$defs/sourceFact" },
    "collectionPageUrl": { "$ref": "#/$defs/sourceFact" },
    "license": { "$ref": "#/$defs/sourceFact" },
    "termsUrl": { "$ref": "#/$defs/sourceFact" },
    "authorizationProof": { "$ref": "#/$defs/sourceFact" },
    "rightsAuditStatus": { "enum": ["verified", "unverified"] },
    "rightsAuditIssues": { "type": "array", "items": { "type": "string" } },
    "template": { "type": "string", "description": "使用的模板名称" },
    "carrier": { "type": "string", "enum": ["article", "image", "video", "review"] },
    "generator": { "type": "string", "enum": ["agent"], "description": "正文创作来源；交付面仅允许 agent（会话模型创作），脚本拼接/占位被门禁拒绝" },
    "generatorModel": { "type": ["string", "null"], "description": "创作所用模型标识（draft_meta.model）" },
    "citedSourceRefs": { "type": "array", "items": { "type": "string" }, "description": "正文创作时引用的 source 证据路径" },
    "reviewDecision": { "type": "string", "enum": ["approved", "revision_needed", "rejected"] },
    "markdownDialect": { "const": "qwq-rich-md" },
    "articleRenderProfile": { "type": "object" },
    "publishLayout": { "type": "string" },
    "publishAngle": { "type": "string" },
    "publishTitle": { "type": "string" },
    "publishSeq": { "type": "integer" },
    "createdAt": { "type": "string", "format": "date-time", "description": "内容首次创建时间（来自 draft_meta 事实）" },
    "updatedAt": { "type": "string", "format": "date-time", "description": "内容最后编辑时间（来自 draft_meta 事实）" },
    "publishedAt": { "type": "string", "format": "date-time", "description": "首次公开可见时间（由 promote 注入并保留）" },
    "executionId": { "type": ["string", "null"], "description": "生成此内容的 execution id" },
    "writingIntent": {
      "type": "string",
      "enum": ["planning_consultation", "decision_experience", "post_trip_journal"],
      "description": "写作主线：计划前咨询/攻略 | 决策体验 | 游后过程记录。单篇唯一，门禁校验正文结构与之匹配"
    },
    "baseSourceRef": { "type": ["string", "null"], "description": "主底稿来源 ref（风格与事实锚点）；其它来源只能补事实" },
    "imageBindings": {
      "type": "array",
      "description": "图文绑定：每条把一张 asset 绑定到正文锚点/节点，确保图片服务段落而非仅做封面",
      "items": {
        "type": "object",
        "properties": {
          "assetId": { "type": "string" },
          "figureId": { "type": "string" },
          "sectionAnchor": { "type": "string", "description": "绑定到的章节标题或路线节点实体名" },
          "layout": { "type": "string", "enum": ["fullWidth", "wrapLeft", "wrapRight", "gallery"] }
        },
        "required": ["assetId"]
      }
    },
    "videoBindings": {
      "type": "array",
      "description": "视频绑定：把视频资产绑定到正文锚点/路线节点，声明适合载体",
      "items": {
        "type": "object",
        "properties": {
          "assetId": { "type": "string" },
          "sectionAnchor": { "type": "string" },
          "role": { "type": "string", "enum": ["cover", "embedded", "node", "shortVideo"] }
        },
        "required": ["assetId"]
      }
    }
  },
  "required": ["vertical", "topicId", "contentType", "entityRefs", "tagRefs", "sourceUrls", "generator", "createdAt", "updatedAt"],
  "allOf": [
    {
      "if": {
        "properties": { "contentType": { "const": "image" } },
        "required": ["contentType"]
      },
      "then": {
        "required": [
          "assets",
          "sourceCollectionId",
          "creator",
          "collectionPageUrl",
          "rightsAuditStatus"
        ],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "caption": { "type": "string", "maxLength": 300 },
          "assets": { "type": "array", "minItems": 1, "maxItems": 20 },
          "sourceCollectionId": { "type": "string", "minLength": 1 },
          "creator": { "$ref": "#/$defs/sourceFact" },
          "collectionPageUrl": { "$ref": "#/$defs/sourceFact" },
          "license": { "$ref": "#/$defs/sourceFact" },
          "rightsAuditStatus": { "enum": ["verified", "unverified"] }
        }
      }
    },
    {
      "if": {
        "properties": { "contentType": { "const": "video" } },
        "required": ["contentType"]
      },
      "then": {
        "required": ["title", "caption", "assets", "videoBindings"],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "caption": { "type": "string", "maxLength": 300 },
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "contains": {
              "type": "object",
              "required": [
                "assetId", "fileName", "kind", "sha256", "mimeType",
                "durationMs", "width", "height", "container", "codec",
                "pixelFormat", "posterFileName", "subtitlesFileName",
                "posterAssetId", "posterSha256", "subtitlesSha256", "provenanceRef",
                "sourceAssetRefs", "rightsRefs"
              ],
              "properties": {
                "kind": { "const": "video" },
                "mimeType": { "const": "video/mp4" },
                "posterAssetId": { "type": "string", "minLength": 1 },
                "sourceAssetRefs": { "type": "array", "minItems": 1 },
                "rightsRefs": { "type": "array", "minItems": 1 }
              },
              "allOf": [
                {
                  "anyOf": [
                    { "required": ["cdnUrl"] },
                    { "required": ["objectKey"] }
                  ]
                },
                {
                  "anyOf": [
                    { "required": ["posterFileName"] },
                    { "required": ["thumbnailUrl"] },
                    { "required": ["coverUrl"] }
                  ]
                }
              ]
            }
          },
          "videoBindings": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
