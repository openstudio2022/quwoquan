{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "templateId",
    "subject",
    "vertical",
    "intent",
    "carrier",
    "styleFamily",
    "styleProfile",
    "audiences",
    "editorialIntent",
    "render",
    "structure",
    "wordCount",
    "imagePlan",
    "crossRefs",
    "recommendation"
  ],
  "properties": {
    "templateId": {
      "type": "string"
    },
    "subject": {
      "type": "object"
    },
    "vertical": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "styleFamily": {
      "type": "string"
    },
    "styleProfile": {
      "type": "object"
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creatorPersona": {
      "type": "object"
    },
    "editorialIntent": {
      "type": "string"
    },
    "render": {
      "type": "object"
    },
    "structure": {
      "type": "object"
    },
    "mustIncludeFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbiddenPhrases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wordCount": {
      "type": "object"
    },
    "imagePlan": {
      "type": "array"
    },
    "crossRefs": {
      "type": "object"
    },
    "recommendation": {
      "type": "object"
    },
    "narrativeMode": {
      "type": "object"
    },
    "evidenceRequirements": {
      "type": "object"
    },
    "continuityExpectations": {
      "type": "object"
    },
    "routeCoverageExpectations": {
      "type": "object"
    },
    "openingTension": {
      "type": "object",
      "description": "出发动机/犹豫期待，强制开头交代为什么走这条线。",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "focus": {
          "type": "string"
        }
      }
    },
    "explicitFeelings": {
      "type": "object",
      "description": "强制正文出现显式的喜欢与不喜欢。",
      "properties": {
        "requireLike": {
          "type": "boolean"
        },
        "requireDislike": {
          "type": "boolean"
        }
      }
    },
    "decisionPoints": {
      "type": "object",
      "description": "强制正文给出可执行的取舍判断。",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "minPoints": {
          "type": "integer"
        }
      }
    },
    "tipsEmbeddingPolicy": {
      "type": "object",
      "description": "注意事项就地融入正文，禁止独立实用信息清单块。",
      "properties": {
        "mode": {
          "type": "string"
        },
        "forbidStandaloneBlock": {
          "type": "boolean"
        }
      }
    },
    "imagePolicy": {
      "type": "object",
      "description": "画报载体策略：图为主、配小字。minImages 最少入选图片数，captionMaxChars 小字上限。",
      "properties": {
        "minImages": {
          "type": "integer"
        },
        "captionMaxChars": {
          "type": "integer"
        },
        "galleryLayout": {
          "type": "string"
        }
      }
    }
  }
}
