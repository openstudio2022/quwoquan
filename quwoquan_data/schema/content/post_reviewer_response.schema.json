{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Read-only independent post reviewer response before controller evidence binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "objectRef",
    "decision",
    "issues",
    "findings"
  ],
  "properties": {
    "schema": { "const": "quwoquan_data.post_reviewer_response" },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "objectRef": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": ["approved", "revision_needed", "rejected"]
    },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
