{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Production object-stage job contract. Stable, idempotent, backend-routable.",
  "type": "object",
  "required": [
    "schema",
    "jobId",
    "executionId",
    "ref",
    "stage",
    "queueBackend",
    "partitionKey",
    "contentObjectDir",
    "state",
    "attempt",
    "maxAttempts",
    "maxStartupFailures",
    "maxWallClockSeconds",
    "stuckThreshold",
    "permissions",
    "failureFingerprints",
    "mutexKey",
    "lease",
    "leaseExpiresEpoch",
    "deadlineEpoch",
    "notBeforeEpoch",
    "sameRunRetryable",
    "startupFailureCount",
    "stuckDetected",
    "lastIssue",
    "resultEnvelopeRequired",
    "resultEnvelopeRef",
    "gateVerdicts",
    "timings",
    "meta",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 8
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "download",
        "author",
        "publish"
      ]
    },
    "queueBackend": {
      "enum": [
        "local_file",
        "reliabletask"
      ]
    },
    "partitionKey": {
      "type": "string",
      "minLength": 1
    },
    "contentObjectDir": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reliableTaskRef": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "taskType": {
          "const": "data.content_object.execute"
        },
        "queue": {
          "const": "reliabletask.data.content_supply"
        },
        "dedupeKey": {
          "type": "string",
          "minLength": 5
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 5
        },
        "partitionKey": {
          "type": "string"
        },
        "payloadAllowlist": {
          "const": "object_job"
        },
        "payload": {
          "type": "object",
          "required": [
            "schema",
            "jobId",
            "executionId",
            "ref",
            "stage",
            "partitionKey",
            "entityRef",
            "carrier",
            "sourceRevision",
            "idempotencyKey"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {"const": "quwoquan.object_job"},
            "jobId": {"type": "string", "minLength": 1},
            "executionId": {
              "type": "string",
              "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
            },
            "ref": {"type": "string", "minLength": 1},
            "stage": {"enum": ["download", "author", "publish"]},
            "partitionKey": {"type": "string", "minLength": 1},
            "entityRef": {"type": "string", "minLength": 1},
            "carrier": {"enum": ["homepage", "article", "image", "video"]},
            "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "idempotencyKey": {"type": "string", "minLength": 5}
          }
        }
      }
    },
    "authorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "creatorProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "creatorArchetype": {
      "type": [
        "string",
        "null"
      ]
    },
    "creatorProfileVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentType": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "queued",
        "leased",
        "succeeded",
        "failed",
        "blocked",
        "dead",
        "spilled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1
    },
    "maxStartupFailures": {
      "type": "integer",
      "minimum": 1
    },
    "maxWallClockSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "stuckThreshold": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "failureFingerprints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "mutexKey": {
      "type": "string",
      "minLength": 1
    },
    "lease": {
      "type": ["string", "null"]
    },
    "leaseExpiresEpoch": {
      "type": "number",
      "minimum": 0
    },
    "deadlineEpoch": {
      "type": "number",
      "minimum": 0
    },
    "notBeforeEpoch": {
      "type": "number",
      "minimum": 0
    },
    "sameRunRetryable": {
      "type": "boolean"
    },
    "startupFailureCount": {
      "type": "integer",
      "minimum": 0
    },
    "stuckDetected": {
      "type": "boolean"
    },
    "resultEnvelopeRequired": {
      "type": "boolean"
    },
    "resultEnvelopeRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastIssue": {
      "type": [
        "object",
        "null"
      ]
    },
    "gateVerdicts": {
      "type": "array"
    },
    "timings": {
      "type": "array"
    },
    "meta": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "quwoquan.object_job"
    }
  }
}
