{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "objectRef",
    "actor",
    "verdict",
    "issues",
    "resultHash"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "const": "5.review"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "executionBinding": {
      "enum": [
        "frozen",
        "standalone"
      ]
    },
    "objectRef": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "description": "独立宿主 reviewer 的真实身份与调用记录；modelFamily 只作审计，不要求与作者异族。",
      "required": [
        "host",
        "sessionId",
        "modelFamily",
        "invocation"
      ],
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "auto"
          }
        },
        "invocation": {
          "type": "object",
          "required": [
            "provider",
            "model",
            "runId"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "auto"
              }
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "auto"
              }
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "^contract-output:"
              }
            }
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resultHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema": {
      "const": "quwoquan_data.reviewer_result"
    }
  }
}
