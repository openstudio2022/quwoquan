{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Read-only independent homepage reviewer response before the controller binds provider/model/run evidence.",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "objectRef",
    "decision",
    "issues",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "objectRef": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approved",
        "revision_needed",
        "rejected"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema": {
      "const": "quwoquan_data.homepage_reviewer_response"
    }
  }
}
