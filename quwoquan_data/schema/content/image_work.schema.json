{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "image 载体 author 产物。AI 写 title/caption/assetRefs/creatorProfileId；schema/executionId/objectRef 由 task seal 补齐。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executionId", "objectRef", "assetRefs", "caption"],
  "properties": {
    "schema": {"const": "quwoquan_data.image_work"},
    "executionId": {"type": "string", "minLength": 1},
    "objectRef": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "assetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "caption": {"type": "string", "minLength": 1},
    "assetCaptions": {
      "description": "可选逐图说明：键按 assetRefs 的同一引用规则解析，必须指向已选资产，未知引用或别名重复在 author seal 拒绝；缺席沿用总 caption，assetRefs 顺序不变。",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "creatorProfileId": {"type": "string", "minLength": 1},
    "tagRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
