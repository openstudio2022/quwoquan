{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/content/article_source_unit_freeze.schema.json",
  "type": "object",
  "required": [
    "schema", "executionId", "executionManifestRef", "executionManifestSha256",
    "executionSourceDigest", "sourceUnitId", "sourceUnitRef", "sourceManifestRef",
    "sourceManifestSha256", "sourceRef", "sourceSha256", "assetIndexRef",
    "assetIndexSha256", "assets", "freezeDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.article_source_unit_freeze"},
    "executionId": {"type": "string", "minLength": 1},
    "executionManifestRef": {"const": "execution_manifest.json"},
    "executionManifestSha256": {"$ref": "#/$defs/sha256"},
    "executionSourceDigest": {"$ref": "#/$defs/sha256"},
    "sourceUnitId": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
    "sourceUnitRef": {"type": "string", "pattern": "^sources/[^/]+$"},
    "sourceManifestRef": {"type": "string", "pattern": "^sources/[^/]+/meta\\.json$"},
    "sourceManifestSha256": {"$ref": "#/$defs/sha256"},
    "sourceRef": {"type": "string", "pattern": "^sources/[^/]+/source\\.md$"},
    "sourceSha256": {"$ref": "#/$defs/sha256"},
    "assetIndexRef": {"type": "string", "pattern": "^sources/[^/]+/assets/index\\.json$"},
    "assetIndexSha256": {"$ref": "#/$defs/sha256"},
    "assets": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/asset"}
    },
    "freezeDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "asset": {
      "type": "object",
      "required": [
        "role", "assetRef", "contentSha256", "sourceUrl", "platform", "creator",
        "capturedAt", "license", "termsUrl", "authorizationProof",
        "authorizationRequired", "rightsStatus", "rightsIssues", "acquisitionStatus",
        "distributionDecision", "admission"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["cover", "body"]},
        "assetRef": {"type": "string", "pattern": "^sources/[^/]+/assets/.+$"},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "platform": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "termsUrl": {"type": "string"},
        "authorizationProof": {"type": "string"},
        "authorizationRequired": {"type": "boolean"},
        "rightsStatus": {"enum": ["verified", "unverified", "unknown"]},
        "rightsIssues": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "acquisitionStatus": {"const": "acquired"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed"]},
        "admission": {
          "type": "object",
          "required": ["qualityStatus", "safetyStatus", "sameSourceUnit"],
          "additionalProperties": false,
          "properties": {
            "qualityStatus": {"const": "passed"},
            "safetyStatus": {"const": "passed"},
            "sameSourceUnit": {"const": true}
          }
        }
      }
    }
  }
}
