{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/reviewed_closure_adoption_campaign_binding.schema.json",
  "type": "object",
  "required": [
    "adoptionId",
    "sourceReleaseIdentity",
    "adoptionRef",
    "adoptionReceipt"
  ],
  "additionalProperties": false,
  "properties": {
    "adoptionId": {
      "type": "string",
      "minLength": 1
    },
    "sourceReleaseIdentity": {
      "type": "object",
      "required": [
        "releaseId",
        "payloadSha256",
        "canonicalMerkle",
        "attestationFileSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "releaseId": {"type": "string", "minLength": 1},
        "payloadSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canonicalMerkle": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "attestationFileSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "adoptionRef": {
      "type": "object",
      "required": ["ref", "fileSha256", "adoptionRefDigest"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "fileSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adoptionRefDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "adoptionReceipt": {
      "type": "object",
      "required": ["ref", "fileSha256", "receiptDigest"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "fileSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "receiptDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
