{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/work_request.schema.json",
  "type": "object",
  "required": [
    "schema", "workRequestId", "requestDigest", "workRequestDigest", "status",
    "intent", "lifecycle", "executionMode", "scale", "workloadMode", "activeCarriers", "workloads",
    "carrierPolicyRef", "carrierPolicyDigest", "rootExecutionId",
    "sourceRevision", "sourceDigest", "entityCatalogDigest", "sourcePool",
    "dependencies", "dependencySetDigest", "carrierEnvelopes", "retention", "compiledAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.work_request"},
    "workRequestId": {"type": "string", "pattern": "^wr-[0-9a-f]{24}$"},
    "requestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workRequestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"const": "compiled"},
    "intent": {
      "type": "object",
      "required": ["vertical", "regionRef", "topic"],
      "additionalProperties": false,
      "properties": {
        "vertical": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "regionRef": {"type": "string", "minLength": 1},
        "topic": {"type": ["string", "null"]}
      }
    },
    "lifecycle": {"enum": ["research", "commercial"]},
    "executionMode": {"enum": ["fresh", "retry"]},
    "scale": {"type": "string", "pattern": "^M[1-9][0-9]{0,5}$"},
    "workloadMode": {"enum": ["explicit", "milestone_preset"]},
    "activeCarriers": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["homepage", "article", "image", "video"]}
    },
    "workloads": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "homepage": {"type": "integer", "minimum": 1},
        "article": {"type": "integer", "minimum": 1},
        "image": {"type": "integer", "minimum": 1},
        "video": {"type": "integer", "minimum": 1}
      }
    },
    "carrierPolicyRef": {"type": "string", "minLength": 1},
    "carrierPolicyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rootExecutionId": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dependencies": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/dependencyRef"}
    },
    "dependencySetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourcePool": {
      "type": "object",
      "required": ["poolId", "targetScale", "planRef", "planDigest", "evidenceRootRef"],
      "additionalProperties": false,
      "properties": {
        "poolId": {"type": "string", "minLength": 1},
        "targetScale": {"enum": ["WORKLOAD", "M100", "M1000", "M10000"]},
        "planRef": {"type": "string", "minLength": 1},
        "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidenceRootRef": {"type": "string", "minLength": 1}
      }
    },
    "carrierEnvelopes": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"$ref": "#/$defs/envelopeRef"}
    },
    "retention": {
      "type": "object",
      "required": ["archiveAfterDays", "deleteAfterDays", "tombstoneRequired"],
      "additionalProperties": false,
      "properties": {
        "archiveAfterDays": {"type": "integer", "minimum": 1},
        "deleteAfterDays": {"type": "integer", "minimum": 1},
        "tombstoneRequired": {"const": true}
      }
    },
    "compiledAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "dependencyRef": {
      "type": "object",
      "required": ["ref", "digest"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "envelopeRef": {
      "type": "object",
      "required": ["carrier", "executionId", "envelopeRef", "requestDigest"],
      "additionalProperties": false,
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "executionId": {"type": "string", "minLength": 1},
        "envelopeRef": {"type": "string", "minLength": 1},
        "requestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
