{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/runtime_resource_sample_receipt.schema.json",
  "title": "Create-once resource observation from registered runtime targets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sampleId", "sessionRef", "sessionDigest", "rootExecutionId",
    "runId", "generation", "fencingToken", "capturedAt",
    "processMeasurements", "queueMeasurements", "workspaceMeasurements",
    "rawSample", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.runtime_resource_sample_receipt"},
    "sampleId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,127}$"},
    "sessionRef": {"$ref": "#/$defs/safeRef"},
    "sessionDigest": {"$ref": "#/$defs/digest"},
    "rootExecutionId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "fencingToken": {"$ref": "#/$defs/digest"},
    "capturedAt": {"type": "string", "minLength": 1},
    "processMeasurements": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "carrier", "executionId", "registrationPid", "isRegisteredProcess", "pid", "pgid", "processIdentityDigest", "rssBytes", "cpuPercent", "isCursorSdkBridge", "openFdCount"],
        "properties": {
          "role": {"enum": ["controller", "worker"]},
          "carrier": {"type": ["string", "null"]},
          "executionId": {"type": "string", "minLength": 1},
          "registrationPid": {"type": "integer", "minimum": 2},
          "isRegisteredProcess": {"type": "boolean"},
          "pid": {"type": "integer", "minimum": 2},
          "pgid": {"type": "integer", "minimum": 2},
          "processIdentityDigest": {"$ref": "#/$defs/digest"},
          "rssBytes": {"type": "integer", "minimum": 0},
          "cpuPercent": {"type": "number", "minimum": 0},
          "isCursorSdkBridge": {"type": "boolean"},
          "openFdCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "queueMeasurements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["carrier", "executionId", "queueDepth", "readyDepth", "oldestReadyAt", "successfulJobCount", "terminalJobCount", "observationWindowSeconds", "throughputPerHour", "latencyP95Milliseconds", "providerThrottleCount", "stuckJobCount", "providerEvidenceDigest"],
        "properties": {
          "carrier": {"enum": ["homepage", "article", "image", "video"]},
          "executionId": {"type": "string", "minLength": 1},
          "queueDepth": {"type": "integer", "minimum": 0},
          "readyDepth": {"type": "integer", "minimum": 0},
          "oldestReadyAt": {"type": ["string", "null"]},
          "successfulJobCount": {"type": "integer", "minimum": 0},
          "terminalJobCount": {"type": "integer", "minimum": 0},
          "observationWindowSeconds": {"type": "integer", "minimum": 0},
          "throughputPerHour": {"type": "number", "minimum": 0},
          "latencyP95Milliseconds": {"type": "integer", "minimum": 0},
          "providerThrottleCount": {"type": "integer", "minimum": 0},
          "stuckJobCount": {"type": "integer", "minimum": 0},
          "providerEvidenceDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "workspaceMeasurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceRef", "kind", "bytes"],
        "properties": {
          "workspaceRef": {"$ref": "#/$defs/safeRef"},
          "kind": {"enum": ["execution", "capsule", "transaction_staging"]},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "rawSample": {"$ref": "#/$defs/rawSample"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "rawSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt", "controllerRssBytes", "nonVideoWorkerMaxRssBytes",
        "videoWorkerMaxRssBytes", "totalRssBytes", "temporaryWorkspaceBytes",
        "terminalResidualBytes", "hostCpuPercent", "cursorBridgeProcessCount",
        "openFdCount", "queueDepth", "oldestReadyAgeSeconds",
        "progressAgeSeconds", "heartbeatAgeSeconds"
      ],
      "properties": {
        "capturedAt": {"type": "string", "minLength": 1},
        "controllerRssBytes": {"type": "integer", "minimum": 0},
        "nonVideoWorkerMaxRssBytes": {"type": "integer", "minimum": 0},
        "videoWorkerMaxRssBytes": {"type": "integer", "minimum": 0},
        "totalRssBytes": {"type": "integer", "minimum": 0},
        "temporaryWorkspaceBytes": {"type": "integer", "minimum": 0},
        "terminalResidualBytes": {"type": "integer", "minimum": 0},
        "hostCpuPercent": {"type": "number", "minimum": 0},
        "cursorBridgeProcessCount": {"type": "integer", "minimum": 0},
        "openFdCount": {"type": "integer", "minimum": 0},
        "queueDepth": {"type": "integer", "minimum": 0},
        "oldestReadyAgeSeconds": {"type": "integer", "minimum": 0},
        "progressAgeSeconds": {"type": "integer", "minimum": 0},
        "heartbeatAgeSeconds": {"type": "integer", "minimum": 0}
      }
    }
  }
}
