{
  "$schema": "https://json-schema.org/draft/2020-12/schema.json",
  "$id": "quwoquan_data/schema/execution/execution_state.schema.json",
  "title": "Receipt-derived execution-state projection",
  "description": "只读便利投影；恢复事实唯一来自 _shared/receipts。唯一 writer 是 receipt_state_reducer。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "completed",
    "status",
    "latestStage",
    "next",
    "latestReceiptRef",
    "latestReceiptDigest",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan.content.execution_state_projection"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "running",
        "manual_required",
        "succeeded"
      ]
    },
    "latestStage": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "string",
      "minLength": 1
    },
    "latestReceiptRef": {
      "type": "string",
      "pattern": "^_shared/receipts/[0-9]{3}-.+\\.json$"
    },
    "latestReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  }
}
