{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/campaign_failed_execution_reconciliation_receipt.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "activeCarriers",
    "workloads",
    "decision",
    "reason",
    "errorCode",
    "originalSourceIdentity",
    "observedSourceIdentity",
    "submissions",
    "campaignEvidence",
    "executionEvidence",
    "blockerEvidence",
    "retryPolicy",
    "recordedAt",
    "receiptDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.campaign_failed_execution_reconciliation_receipt"
    },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "activeCarriers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["homepage", "article", "image", "video"] }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "integer", "minimum": 1 },
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      }
    },
    "decision": { "const": "superseded" },
    "reason": {
      "enum": [
        "source_drift",
        "controller_interrupted_before_claim",
        "claimed_execution_source_drift",
        "post_publish_partial_terminal",
        "mixed_finalized_partial_terminal",
        "terminal_unpublished_source_drift",
        "terminal_unpublished_retryable_shortfall"
      ]
    },
    "errorCode": {
      "enum": [
        "DATA.CAMPAIGN.FAILED_EXECUTION_SOURCE_DRIFT",
        "DATA.CAMPAIGN.CONTROLLER_INTERRUPTED_BEFORE_CLAIM",
        "DATA.CAMPAIGN.CLAIMED_EXECUTION_SOURCE_DRIFT",
        "DATA.CAMPAIGN.POST_PUBLISH_PARTIAL_TERMINAL",
        "DATA.CAMPAIGN.MIXED_FINALIZED_PARTIAL_TERMINAL",
        "DATA.CAMPAIGN.TERMINAL_UNPUBLISHED_SOURCE_DRIFT",
        "DATA.CAMPAIGN.TERMINAL_UNPUBLISHED_RETRYABLE_SHORTFALL"
      ]
    },
    "originalSourceIdentity": {
      "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/sourceIdentity"
    },
    "observedSourceIdentity": {
      "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/sourceIdentity"
    },
    "submissions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/submissionEvidence"
        },
        "article": {
          "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/submissionEvidence"
        },
        "image": {
          "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/submissionEvidence"
        },
        "video": {
          "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/submissionEvidence"
        }
      }
    },
    "campaignEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/sourceDriftCampaignEvidence" },
        { "$ref": "#/$defs/controllerInterruptedBeforeClaimEvidence" }
      ]
    },
    "executionEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/executionAbsence" },
        { "$ref": "#/$defs/claimedExecutionSupersessions" },
        { "$ref": "#/$defs/postPublishPartialTerminal" },
        { "$ref": "#/$defs/mixedFinalizedPartialTerminal" },
        { "$ref": "#/$defs/terminalUnpublishedPartial" }
      ]
    },
    "blockerEvidence": { "$ref": "#/$defs/fileEvidence" },
    "retryPolicy": { "const": "active_workload_execution_with_retryOf" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "receiptDigest": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reason": { "const": "source_drift" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.FAILED_EXECUTION_SOURCE_DRIFT"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/sourceDriftCampaignEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/executionAbsence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "controller_interrupted_before_claim" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.CONTROLLER_INTERRUPTED_BEFORE_CLAIM"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/controllerInterruptedBeforeClaimEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/executionAbsence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "claimed_execution_source_drift" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.CLAIMED_EXECUTION_SOURCE_DRIFT"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/sourceDriftCampaignEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/claimedExecutionSupersessions"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "post_publish_partial_terminal" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.POST_PUBLISH_PARTIAL_TERMINAL"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/sourceDriftCampaignEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/postPublishPartialTerminal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "mixed_finalized_partial_terminal" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.MIXED_FINALIZED_PARTIAL_TERMINAL"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/sourceDriftCampaignEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/mixedFinalizedPartialTerminal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "terminal_unpublished_source_drift" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.TERMINAL_UNPUBLISHED_SOURCE_DRIFT"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/sourceDriftCampaignEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/terminalUnpublishedPartial"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "terminal_unpublished_retryable_shortfall" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "errorCode": {
            "const": "DATA.CAMPAIGN.TERMINAL_UNPUBLISHED_RETRYABLE_SHORTFALL"
          },
          "campaignEvidence": {
            "$ref": "#/$defs/sourceDriftCampaignEvidence"
          },
          "executionEvidence": {
            "$ref": "#/$defs/terminalUnpublishedPartial"
          }
        }
      }
    }
  ],
  "$defs": {
    "executionAbsence": {
      "type": "object",
      "required": ["lanes"],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "campaign_submission_reconciliation_receipt.schema.json#/$defs/laneExecutionAbsence"
          }
        }
      }
    },
    "claimedExecutionSupersessions": {
      "type": "object",
      "required": ["lanes"],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/claimedExecutionSupersession" }
        }
      }
    },
    "claimedExecutionSupersession": {
      "type": "object",
      "required": [
        "carrier",
        "executionId",
        "executionRootRef",
        "executionRootExists",
        "supersessionReceipt",
        "supersessionReceiptDigest",
        "previousStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": { "enum": ["homepage", "article", "image", "video"] },
        "executionId": { "type": "string", "minLength": 1 },
        "executionRootRef": { "type": "string", "minLength": 1 },
        "executionRootExists": { "const": true },
        "supersessionReceipt": { "$ref": "#/$defs/fileEvidence" },
        "supersessionReceiptDigest": { "$ref": "#/$defs/sha256" },
        "previousStatus": { "type": "string", "minLength": 1 }
      }
    },
    "postPublishPartialTerminal": {
      "type": "object",
      "required": [
        "lanes",
        "partialPublish",
        "allLanesFinalizedCount",
        "immutableReleaseEvidencePresent",
        "reviewedClosureAdoptionPresent",
        "evidenceDisposition",
        "excludedFromFinalized",
        "eligibleForRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/terminalExecution" }
        },
        "partialPublish": { "$ref": "#/$defs/preservedArticlePublish" },
        "allLanesFinalizedCount": { "const": 0 },
        "immutableReleaseEvidencePresent": { "const": false },
        "reviewedClosureAdoptionPresent": { "const": false },
        "evidenceDisposition": { "const": "preserved_unadopted" },
        "excludedFromFinalized": { "const": true },
        "eligibleForRelease": { "const": false }
      }
    },
    "mixedFinalizedPartialTerminal": {
      "type": "object",
      "required": [
        "lanes",
        "observedFinalizedCount",
        "immutableReleaseEvidencePresent",
        "reviewedClosureAdoptionPresent",
        "evidenceDisposition",
        "excludedFromRetryRelease",
        "eligibleForRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/mixedFinalizedExecution" },
              { "$ref": "#/$defs/mixedFailedExecution" }
            ]
          }
        },
        "observedFinalizedCount": { "type": "integer", "minimum": 1, "maximum": 3 },
        "immutableReleaseEvidencePresent": { "const": false },
        "reviewedClosureAdoptionPresent": { "const": false },
        "evidenceDisposition": { "const": "preserved_unadopted" },
        "excludedFromRetryRelease": { "const": true },
        "eligibleForRelease": { "const": false }
      }
    },
    "mixedFinalizedExecution": {
      "type": "object",
      "required": [
        "carrier",
        "executionId",
        "executionRootRef",
        "executionRootExists",
        "terminalStatus",
        "claim",
        "reportStatus",
        "observedFinalizedCount",
        "publishReceipt",
        "publishRef",
        "canonicalManifests",
        "publishSelectionFinalizedCount",
        "evidenceDisposition",
        "excludedFromRetryRelease",
        "eligibleForRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": { "enum": ["homepage", "article", "image", "video"] },
        "executionId": { "type": "string", "minLength": 1 },
        "executionRootRef": { "type": "string", "minLength": 1 },
        "executionRootExists": { "const": true },
        "terminalStatus": { "const": "finalized" },
        "claim": { "$ref": "#/$defs/fileEvidence" },
        "reportStatus": { "const": "finalized" },
        "observedFinalizedCount": { "const": 1 },
        "publishReceipt": { "$ref": "#/$defs/fileEvidence" },
        "publishRef": { "$ref": "#/$defs/fileEvidence" },
        "canonicalManifests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/canonicalManifestEvidence" }
        },
        "publishSelectionFinalizedCount": { "const": 1 },
        "evidenceDisposition": { "const": "preserved_unadopted" },
        "excludedFromRetryRelease": { "const": true },
        "eligibleForRelease": { "const": false }
      }
    },
    "terminalUnpublishedPartial": {
      "type": "object",
      "required": [
        "lanes",
        "observedFinalizedCount",
        "reviewQualifiedLaneCount",
        "campaignPublishReceiptsPresent",
        "campaignPublishRefsPresent",
        "preparedObjectTransactionCount",
        "objectTransactionAppliedEvidencePresent",
        "immutableReleaseEvidencePresent",
        "reviewedClosureAdoptionPresent",
        "evidenceDisposition",
        "excludedFromRetryRelease",
        "eligibleForRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/terminalUnpublishedExecution" }
        },
        "observedFinalizedCount": { "const": 0 },
        "reviewQualifiedLaneCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "campaignPublishReceiptsPresent": { "const": false },
        "campaignPublishRefsPresent": { "const": false },
        "preparedObjectTransactionCount": {
          "type": "integer",
          "minimum": 0
        },
        "objectTransactionAppliedEvidencePresent": { "const": false },
        "immutableReleaseEvidencePresent": { "const": false },
        "reviewedClosureAdoptionPresent": { "const": false },
        "evidenceDisposition": { "const": "failed_unpublished" },
        "excludedFromRetryRelease": { "const": true },
        "eligibleForRelease": { "const": false }
      }
    },
    "terminalUnpublishedExecution": {
      "type": "object",
      "required": [
        "carrier",
        "executionId",
        "executionRootRef",
        "executionRootExists",
        "terminalStatus",
        "claim",
        "reportStatus",
        "reviewReceiptPresent",
        "reviewReceipt",
        "reviewStatus",
        "reviewQualifiedCount",
        "observedFinalizedCount",
        "publishReceiptPresent",
        "publishRefPresent",
        "preparedObjectTransactions",
        "objectTransactionAppliedEvidencePresent",
        "evidenceDisposition",
        "excludedFromRetryRelease",
        "eligibleForRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": { "enum": ["homepage", "article", "image", "video"] },
        "executionId": { "type": "string", "minLength": 1 },
        "executionRootRef": { "type": "string", "minLength": 1 },
        "executionRootExists": { "const": true },
        "terminalStatus": { "const": "failed" },
        "claim": { "$ref": "#/$defs/fileEvidence" },
        "reportStatus": { "const": "blocked" },
        "reviewReceiptPresent": { "type": "boolean" },
        "reviewReceipt": {
          "oneOf": [
            { "$ref": "#/$defs/fileEvidence" },
            { "type": "null" }
          ]
        },
        "reviewStatus": {
          "type": ["string", "null"],
          "enum": ["qualified", "partial", "blocked", null]
        },
        "reviewQualifiedCount": { "type": "integer", "minimum": 0 },
        "observedFinalizedCount": { "const": 0 },
        "publishReceiptPresent": { "const": false },
        "publishRefPresent": { "const": false },
        "preparedObjectTransactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/preparedObjectTransactionEvidence" }
        },
        "objectTransactionAppliedEvidencePresent": { "const": false },
        "evidenceDisposition": { "const": "failed_unpublished" },
        "excludedFromRetryRelease": { "const": true },
        "eligibleForRelease": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reviewReceiptPresent": { "const": true } },
            "required": ["reviewReceiptPresent"]
          },
          "then": {
            "properties": {
              "reviewReceipt": { "$ref": "#/$defs/fileEvidence" },
              "reviewStatus": { "enum": ["qualified", "partial", "blocked"] }
            }
          },
          "else": {
            "properties": {
              "reviewReceipt": { "type": "null" },
              "reviewStatus": { "type": "null" },
              "reviewQualifiedCount": { "const": 0 }
            }
          }
        }
      ]
    },
    "mixedFailedExecution": {
      "type": "object",
      "required": [
        "carrier",
        "executionId",
        "executionRootRef",
        "executionRootExists",
        "terminalStatus",
        "claim",
        "reportStatus",
        "observedFinalizedCount",
        "publishReceiptPresent",
        "publishRefPresent",
        "objectTransactionEvidencePresent",
        "evidenceDisposition",
        "excludedFromRetryRelease",
        "eligibleForRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": { "enum": ["homepage", "article", "image", "video"] },
        "executionId": { "type": "string", "minLength": 1 },
        "executionRootRef": { "type": "string", "minLength": 1 },
        "executionRootExists": { "const": true },
        "terminalStatus": { "const": "failed" },
        "claim": { "$ref": "#/$defs/fileEvidence" },
        "reportStatus": { "const": "blocked" },
        "observedFinalizedCount": { "const": 0 },
        "publishReceiptPresent": { "const": false },
        "publishRefPresent": { "const": false },
        "objectTransactionEvidencePresent": { "const": false },
        "evidenceDisposition": { "const": "failed_unpublished" },
        "excludedFromRetryRelease": { "const": true },
        "eligibleForRelease": { "const": false }
      }
    },
    "canonicalManifestEvidence": {
      "type": "object",
      "required": [
        "objectKind",
        "objectRef",
        "canonicalManifestRef",
        "canonicalManifestSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "objectKind": { "enum": ["entities", "posts"] },
        "objectRef": { "type": "string", "minLength": 1 },
        "canonicalManifestRef": { "type": "string", "minLength": 1 },
        "canonicalManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "terminalExecution": {
      "type": "object",
      "required": [
        "carrier",
        "executionId",
        "executionRootRef",
        "executionRootExists"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": { "enum": ["homepage", "article", "image", "video"] },
        "executionId": { "type": "string", "minLength": 1 },
        "executionRootRef": { "type": "string", "minLength": 1 },
        "executionRootExists": { "const": true }
      }
    },
    "preservedArticlePublish": {
      "type": "object",
      "required": [
        "carrier",
        "executionId",
        "executionState",
        "publishReport",
        "publishRef",
        "transactionId",
        "objectRef",
        "objectTransactionPackage",
        "auditReport",
        "applyReport",
        "applyCompletion",
        "pointer",
        "canonicalManifestRef",
        "canonicalManifestSha256",
        "afterMerkle",
        "researchAcceptedCount",
        "finalizedObjectCount"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": { "const": "article" },
        "executionId": { "type": "string", "minLength": 1 },
        "executionState": { "$ref": "#/$defs/fileEvidence" },
        "publishReport": { "$ref": "#/$defs/fileEvidence" },
        "publishRef": { "$ref": "#/$defs/fileEvidence" },
        "transactionId": { "type": "string", "minLength": 1 },
        "objectRef": { "type": "string", "minLength": 1 },
        "objectTransactionPackage": { "$ref": "#/$defs/fileEvidence" },
        "auditReport": { "$ref": "#/$defs/fileEvidence" },
        "applyReport": { "$ref": "#/$defs/fileEvidence" },
        "applyCompletion": { "$ref": "#/$defs/fileEvidence" },
        "pointer": { "$ref": "#/$defs/fileEvidence" },
        "canonicalManifestRef": { "type": "string", "minLength": 1 },
        "canonicalManifestSha256": { "$ref": "#/$defs/sha256" },
        "afterMerkle": { "$ref": "#/$defs/sha256" },
        "researchAcceptedCount": { "const": 1 },
        "finalizedObjectCount": { "const": 0 }
      }
    },
    "sourceDriftCampaignEvidence": {
      "type": "object",
      "required": ["plan", "report", "runtimeSnapshot", "claims"],
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/fileEvidence" },
        "report": { "$ref": "#/$defs/fileEvidence" },
        "runtimeSnapshot": { "$ref": "#/$defs/fileEvidence" },
        "claims": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4,
          "additionalProperties": false,
          "properties": {
            "homepage": { "$ref": "#/$defs/fileEvidence" },
            "article": { "$ref": "#/$defs/fileEvidence" },
            "image": { "$ref": "#/$defs/fileEvidence" },
            "video": { "$ref": "#/$defs/fileEvidence" }
          }
        }
      }
    },
    "controllerInterruptedBeforeClaimEvidence": {
      "type": "object",
      "required": [
        "plan",
        "runtimeSnapshot",
        "campaignReportExists",
        "claimsPresent",
        "runtimeLaneCheckpointsPresent"
      ],
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/fileEvidence" },
        "runtimeSnapshot": { "$ref": "#/$defs/fileEvidence" },
        "campaignReportExists": { "const": false },
        "claimsPresent": { "const": false },
        "runtimeLaneCheckpointsPresent": { "const": false }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "preparedObjectTransactionEvidence": {
      "type": "object",
      "required": [
        "transactionId",
        "package",
        "objectManifest",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "transactionId": { "type": "string", "minLength": 1 },
        "package": { "$ref": "#/$defs/fileEvidence" },
        "objectManifest": { "$ref": "#/$defs/fileEvidence" },
        "state": { "const": "prepared_unapplied" }
      }
    },
    "fileEvidence": {
      "type": "object",
      "required": ["ref", "sha256"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
