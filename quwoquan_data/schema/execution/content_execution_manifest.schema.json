{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One immutable content execution work package.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "familyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "modelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "authorModel", "authorModelFamily", "authorModelParameters", "reviewerModel", "reviewerModelFamily", "reviewerModelParameters"],
      "properties": {
        "provider": {"enum": ["cursor_sdk", "codex_sdk"]},
        "authorModel": {"type": "string", "minLength": 1},
        "authorModelFamily": {"type": "string", "minLength": 1},
        "authorModelParameters": {"$ref": "#/$defs/modelParameters"},
        "reviewerModel": {"type": "string", "minLength": 1},
        "reviewerModelFamily": {"type": "string", "minLength": 1},
        "reviewerModelParameters": {"$ref": "#/$defs/modelParameters"}
      }
    },
    "runtimeProfileId": {"type": "string", "minLength": 1},
    "runtimeProfileDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semanticSelectionId": {"enum": ["default", "cursor_auto"]},
    "semanticPreflightReceipt": {
      "$ref": "semantic_preflight_receipt_ref.schema.json"
    },
    "semanticRuntime": {"enum": ["local", "cloud"]},
    "requestRef": {"const": "0.plan/request.json"},
    "targetSetRef": {"const": "0.plan/target_set.json"},
    "targetSetDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retryOf": {"type": ["string", "null"]}
  },
  "required": ["executionId", "familyRef", "sourceDigest", "modelBinding", "runtimeProfileId", "runtimeProfileDigest", "semanticSelectionId", "semanticRuntime", "requestRef", "targetSetRef", "targetSetDigest", "retryOf"],
  "allOf": [
    {
      "if": {
        "properties": {"semanticSelectionId": {"const": "cursor_auto"}},
        "required": ["semanticSelectionId"]
      },
      "then": {
        "required": ["semanticPreflightReceipt"],
        "properties": {
          "modelBinding": {
            "properties": {
              "provider": {"const": "cursor_sdk"},
              "authorModel": {"const": "auto"},
              "authorModelFamily": {"const": "auto"},
              "reviewerModel": {"const": "auto"},
              "reviewerModelFamily": {"const": "auto"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "modelBinding": {
            "properties": {
              "provider": {"const": "codex_sdk"},
              "authorModel": {"const": "gpt-5.6-terra"},
              "authorModelFamily": {"const": "gpt"},
              "reviewerModel": {"const": "gpt-5.6-terra"},
              "reviewerModelFamily": {"const": "gpt"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "modelParameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
