{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "唯一内容执行工作包。每个 executionId 只允许一个可恢复的中间过程根。",
  "type": "object",
  "properties": {
    "contractVersion": { "const": "content-execution-v2" },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(canary|m1|m2|m3)-[0-9]{3,}$"
    },
    "vertical": { "type": "string" },
    "contentType": { "enum": ["homepage", "article", "image", "video"] },
    "intent": { "type": "string" },
    "scope": { "type": "string" },
    "milestone": { "enum": ["canary", "m1", "m2", "m3"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "recipe": {
      "type": "object",
      "properties": {
        "ref": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["ref", "sha256"],
      "additionalProperties": false
    },
    "resolvedParams": { "type": "object" },
    "selectionPolicy": { "const": "frozen" },
    "targetSetRef": { "const": "0.plan/target_set.json" },
    "targetSetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retryOf": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "repoRoot": { "type": "string" }
  },
  "required": [
    "contractVersion", "executionId", "vertical", "contentType", "intent",
    "scope", "milestone", "sequence", "recipe", "resolvedParams", "selectionPolicy",
    "targetSetRef", "targetSetSha256", "retryOf",
    "createdAt", "repoRoot"
  ],
  "additionalProperties": false
}
