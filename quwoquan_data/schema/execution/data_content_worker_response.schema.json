{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "result"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan.data_content_worker_response"
    },
    "result": {
      "type": "object",
      "required": [
        "executionId",
        "jobId",
        "resultEnvelopeRef",
        "acceptanceClass",
        "completedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "executionId": {
          "type": "string",
          "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
        },
        "jobId": {"type": "string", "minLength": 1},
        "canonicalObjectRef": {"type": "string", "minLength": 1},
        "canonicalObjectSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "objectTransactionId": {"type": "string", "minLength": 1},
        "resultEnvelopeRef": {"type": "string", "minLength": 1},
        "acceptanceClass": {
          "enum": [
            "stage_completed",
            "research_canonical",
            "commercial_canonical",
            "contract_fixture"
          ]
        },
        "completedAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "acceptanceClass": {
                "enum": ["research_canonical", "commercial_canonical"]
              }
            }
          },
          "then": {
            "required": [
              "canonicalObjectRef",
              "canonicalObjectSha256",
              "objectTransactionId"
            ]
          }
        }
      ]
    }
  }
}
