{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/verify_all_receipt.schema.json",
  "title": "Canonical verify-all receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceFingerprint",
    "command",
    "exitCode",
    "verdict",
    "capturedOutput",
    "closedModules"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.verify_all_receipt"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "entrypoint",
        "arguments"
      ],
      "properties": {
        "commandId": {
          "const": "data.verify.all"
        },
        "entrypoint": {
          "const": "quwoquan_data/scripts/cli.py"
        },
        "arguments": {
          "const": [
            "verify",
            "all"
          ]
        }
      }
    },
    "exitCode": {
      "const": 0
    },
    "verdict": {
      "const": "pass"
    },
    "capturedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdoutDigest",
        "stderrDigest"
      ],
      "properties": {
        "stdoutDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stderrDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "closedModules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
