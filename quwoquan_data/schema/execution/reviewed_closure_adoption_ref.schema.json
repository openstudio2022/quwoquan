{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/reviewed_closure_adoption_ref.schema.json",
  "type": "object",
  "required": [
    "schema",
    "adoptionId",
    "sourceReleaseRootRef",
    "sourceReleaseIdentity",
    "identityIncident",
    "sourceEvidence",
    "desiredRefs",
    "mediaAssets",
    "reviewEvidence",
    "rightsEvidence",
    "upstreamProvenance",
    "closureDigests",
    "recordedAt",
    "adoptionRefDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.reviewed_closure_adoption_ref" },
    "adoptionId": { "type": "string", "minLength": 1 },
    "sourceReleaseRootRef": { "type": "string", "minLength": 1 },
    "sourceReleaseIdentity": { "$ref": "#/$defs/releaseIdentity" },
    "identityIncident": {
      "type": "object",
      "required": ["ref", "fileSha256", "receiptDigest"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "receiptDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "releaseAttestation",
        "releaseHeader",
        "desiredState",
        "objectIndex",
        "mediaManifest"
      ],
      "additionalProperties": false,
      "properties": {
        "releaseAttestation": { "$ref": "#/$defs/fileEvidence" },
        "releaseHeader": { "$ref": "#/$defs/fileEvidence" },
        "desiredState": { "$ref": "#/$defs/fileEvidence" },
        "objectIndex": { "$ref": "#/$defs/fileEvidence" },
        "mediaManifest": { "$ref": "#/$defs/fileEvidence" }
      }
    },
    "desiredRefs": { "$ref": "#/$defs/desiredRefs" },
    "mediaAssets": {
      "type": "array",
      "items": { "$ref": "#/$defs/mediaAsset" }
    },
    "reviewEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEvidence" }
    },
    "rightsEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectEvidence" }
    },
    "upstreamProvenance": {
      "type": "object",
      "required": ["executionIds", "sourceDigests"],
      "additionalProperties": false,
      "properties": {
        "executionIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceDigests": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceDigest" }
        }
      }
    },
    "closureDigests": {
      "type": "object",
      "required": ["objects", "media", "review", "rights", "upstream"],
      "additionalProperties": false,
      "properties": {
        "objects": { "$ref": "#/$defs/sha256" },
        "media": { "$ref": "#/$defs/sha256" },
        "review": { "$ref": "#/$defs/sha256" },
        "rights": { "$ref": "#/$defs/sha256" },
        "upstream": { "$ref": "#/$defs/sha256" }
      }
    },
    "recordedAt": { "type": "string", "minLength": 1 },
    "adoptionRefDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseIdentity": {
      "type": "object",
      "required": [
        "releaseId",
        "payloadSha256",
        "canonicalMerkle",
        "attestationFileSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "canonicalMerkle": { "$ref": "#/$defs/sha256" },
        "attestationFileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileEvidence": {
      "type": "object",
      "required": ["ref", "sha256"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "objectEvidence": {
      "type": "object",
      "required": ["objectRef", "ref", "sha256"],
      "additionalProperties": false,
      "properties": {
        "objectRef": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "desiredRefs": {
      "type": "object",
      "required": ["creators", "entities", "posts", "tags"],
      "additionalProperties": false,
      "properties": {
        "creators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "entities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "posts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceDigest": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" },
        "inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "required": [
        "assetId",
        "kind",
        "contentType",
        "bytes",
        "sha256",
        "publicSliceKey",
        "version",
        "ownerRefs",
        "rightsSnapshotRefs"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "contentType": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "publicSliceKey": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "ownerRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rightsSnapshotRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
