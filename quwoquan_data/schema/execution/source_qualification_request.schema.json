{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Execution-owned homepage source qualification input. Static coverage supplies identity only; source facts are runtime evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "executionId", "policyRevision", "createdAt", "targets"],
  "properties": {
    "contractVersion": {"const": "execution-source-qualification-v1"},
    "executionId": {"type": "string", "minLength": 1},
    "policyRevision": {"const": "encyclopedia-primary-v2"},
    "createdAt": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entityType", "geoTagRef", "aliases"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "entityType": {"type": "string", "minLength": 1},
          "geoTagRef": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
