{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/reviewed_closure_adoption_task_binding.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "executionId",
    "carrier",
    "operation",
    "planDigest",
    "reviewedClosureAdoption",
    "adoptedObjectRefs",
    "targetSourceIdentity",
    "status",
    "recordedAt",
    "bindingDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.reviewed_closure_adoption_task_binding"
    },
    "rootExecutionId": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "carrier": {
      "enum": ["homepage", "article", "image", "video"]
    },
    "operation": {
      "enum": [
        "homepage.adoptReviewedClosure",
        "article.adoptReviewedClosure",
        "image.adoptReviewedClosure",
        "video.adoptReviewedClosure"
      ]
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewedClosureAdoption": {
      "$ref": "reviewed_closure_adoption_campaign_binding.schema.json"
    },
    "adoptedObjectRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "targetSourceIdentity": {
      "type": "object",
      "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest"],
      "additionalProperties": false,
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceDigest": {
          "type": "object",
          "required": ["algorithm", "digest", "inputs"],
          "additionalProperties": false,
          "properties": {
            "algorithm": {"const": "sha256"},
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "entityCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "status": {"const": "adopted_reviewed_closure"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "bindingDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
