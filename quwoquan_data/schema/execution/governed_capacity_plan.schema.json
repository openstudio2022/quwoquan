{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/governed_capacity_plan.schema.json",
  "title": "Governed M1000 and M10000 capacity plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "targetScale",
    "predecessorPromotion",
    "predecessorPromotionDigest",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "budgetSeconds",
    "capacityUtilizationFactor",
    "preflight",
    "carrierPlans",
    "requiredSlots",
    "availableSlots",
    "capacityHeadroomSlots",
    "planDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.governed_capacity_plan"},
    "targetScale": {"enum": ["M1000", "M10000"]},
    "predecessorPromotion": {"$ref": "#/$defs/predecessorPromotion"},
    "predecessorPromotionDigest": {"$ref": "#/$defs/digest"},
    "sourceRevision": {"$ref": "#/$defs/digest"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "entityCatalogDigest": {"$ref": "#/$defs/digest"},
    "budgetSeconds": {"enum": [259200, 604800]},
    "capacityUtilizationFactor": {"const": 0.8},
    "preflight": {"$ref": "#/$defs/preflight"},
    "carrierPlans": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/carrierPlan"}, {"properties": {"carrier": {"const": "homepage"}}}]},
        {"allOf": [{"$ref": "#/$defs/carrierPlan"}, {"properties": {"carrier": {"const": "article"}}}]},
        {"allOf": [{"$ref": "#/$defs/carrierPlan"}, {"properties": {"carrier": {"const": "image"}}}]},
        {"allOf": [{"$ref": "#/$defs/carrierPlan"}, {"properties": {"carrier": {"const": "video"}}}]}
      ],
      "items": false
    },
    "requiredSlots": {"type": "integer", "minimum": 4},
    "availableSlots": {"type": "integer", "minimum": 1},
    "capacityHeadroomSlots": {"type": "integer", "minimum": 0},
    "planDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"targetScale": {"const": "M1000"}}, "required": ["targetScale"]},
      "then": {
        "properties": {
          "budgetSeconds": {"const": 259200},
          "predecessorPromotion": {"properties": {"targetScale": {"const": "M100"}}}
        }
      }
    },
    {
      "if": {"properties": {"targetScale": {"const": "M10000"}}, "required": ["targetScale"]},
      "then": {
        "properties": {
          "budgetSeconds": {"const": 604800},
          "predecessorPromotion": {"properties": {"targetScale": {"const": "M1000"}}}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "predecessorPromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionId",
        "releaseId",
        "manifestDigest",
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "resourceSoakEvidenceRef",
        "resourceSoakEvidenceDigest",
        "targetScale"
      ],
      "properties": {
        "promotionId": {"type": "string", "minLength": 1},
        "releaseId": {"type": "string", "minLength": 1},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "sourceRevision": {"$ref": "#/$defs/digest"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "entityCatalogDigest": {"$ref": "#/$defs/digest"},
        "resourceSoakEvidenceRef": {"$ref": "#/$defs/safeRef"},
        "resourceSoakEvidenceDigest": {"$ref": "#/$defs/digest"},
        "targetScale": {"enum": ["M100", "M1000"]}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "selectionDigest",
        "provider",
        "model",
        "runtimeProfileDigest",
        "validUntil",
        "effectiveConcurrency"
      ],
      "properties": {
        "receiptId": {"$ref": "#/$defs/digest"},
        "selectionDigest": {"$ref": "#/$defs/digest"},
        "provider": {"enum": ["cursor_sdk", "codex_sdk"]},
        "model": {"type": "string", "minLength": 1},
        "runtimeProfileDigest": {"$ref": "#/$defs/digest"},
        "validUntil": {"type": "string", "format": "date-time"},
        "effectiveConcurrency": {"type": "integer", "minimum": 1}
      }
    },
    "carrierPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier",
        "delta",
        "requiredWorkers",
        "partitionCount",
        "p10PerSlotThroughput",
        "throughputUnit",
        "perSlotThroughputSamples",
        "throughputSampleCount",
        "throughputEvidenceRef",
        "throughputEvidenceDigest",
        "throughputBasisDigest"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "delta": {"type": "integer", "minimum": 1},
        "requiredWorkers": {"type": "integer", "minimum": 1},
        "partitionCount": {"enum": [16, 32, 64, 128, 256]},
        "p10PerSlotThroughput": {"type": "number", "exclusiveMinimum": 0},
        "throughputUnit": {"const": "objects_per_second_per_slot"},
        "perSlotThroughputSamples": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "throughputSampleCount": {"type": "integer", "minimum": 1},
        "throughputEvidenceRef": {"$ref": "#/$defs/safeRef"},
        "throughputEvidenceDigest": {"$ref": "#/$defs/digest"},
        "throughputBasisDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
