{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/cursor_model_pricing.schema.json",
  "type": "object",
  "required": ["schema", "revision", "currency", "models"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan.cursor_model_pricing"},
    "revision": {"type": "string", "minLength": 1},
    "currency": {"const": "USD"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "modelId",
          "inputUsdPerMillion",
          "outputUsdPerMillion",
          "cacheReadUsdPerMillion",
          "cacheWriteUsdPerMillion"
        ],
        "additionalProperties": false,
        "properties": {
          "modelId": {"type": "string", "minLength": 1},
          "inputUsdPerMillion": {"type": ["number", "null"], "minimum": 0},
          "outputUsdPerMillion": {"type": ["number", "null"], "minimum": 0},
          "cacheReadUsdPerMillion": {"type": ["number", "null"], "minimum": 0},
          "cacheWriteUsdPerMillion": {"type": ["number", "null"], "minimum": 0}
        }
      }
    }
  }
}
