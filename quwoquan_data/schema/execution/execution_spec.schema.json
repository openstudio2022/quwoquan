{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "一个 content execution 的不可变计划。运行身份只允许 executionId。",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "quwoquan.content.execution_spec" },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(canary|m1|m2|m3)-[0-9]{3,}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "intentLabel": { "type": "string", "minLength": 1 },
    "executionArchetype": { "type": "string", "minLength": 1 },
    "vertical": { "type": "string", "minLength": 1 },
    "organizeBy": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "minLength": 1 },
    "entityCategory": { "type": ["string", "null"] },
    "status": { "enum": ["draft", "active"] },
    "scope": { "type": "object" },
    "provenance": { "type": "object" },
    "presetRef": { "type": "string", "minLength": 1 },
    "content": { "type": "object" },
    "acceptance": { "type": "object" },
    "workflowPolicy": { "type": "object" },
    "queuePolicy": { "type": "object" }
  },
  "required": [
    "schemaVersion", "executionId", "title", "intentLabel", "executionArchetype",
    "vertical", "organizeBy", "key", "status", "scope", "provenance", "presetRef",
    "content", "acceptance", "workflowPolicy", "queuePolicy"
  ],
  "additionalProperties": false
}
