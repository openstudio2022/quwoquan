{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "一个 content execution 的不可变计划。运行身份只允许 executionId。",
  "type": "object",
  "properties": {
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intentLabel": {
      "type": "string",
      "minLength": 1
    },
    "executionArchetype": {
      "type": "string",
      "minLength": 1
    },
    "vertical": {
      "type": "string",
      "minLength": 1
    },
    "organizeBy": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "entityCategory": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ]
    },
    "scope": {
      "type": "object",
      "required": ["region", "entityTypes", "coverageTargets"],
      "additionalProperties": false,
      "properties": {
        "region": {"type": "string", "minLength": 1},
        "entityTypes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "coverageTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "entityType"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "entityType": {"type": "string", "minLength": 1},
              "geoTagRef": {"type": "string", "minLength": 1},
              "geoTagRefs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "typeTagRefs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "aliases": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "coordinates": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lat", "lon"],
                "properties": {
                  "lat": {"type": "number", "minimum": -90, "maximum": 90},
                  "lon": {"type": "number", "minimum": -180, "maximum": 180}
                }
              },
              "qualifiedHomepageSource": {
                "type": "object",
                "required": ["provider", "title", "url"],
                "additionalProperties": false,
                "properties": {
                  "provider": {"enum": ["wikipedia", "baidu_baike", "toutiao_baike"]},
                  "title": {"type": "string", "minLength": 1},
                  "url": {"type": "string", "pattern": "^https://"}
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["createdAt", "createdBy"],
      "additionalProperties": false,
      "properties": {
        "createdAt": {"type": "string", "minLength": 1},
        "createdBy": {"type": "string", "minLength": 1}
      }
    },
    "presetRef": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "required": ["modalityContract", "research", "carriers", "quotas"],
      "additionalProperties": false,
      "properties": {
        "modalityContract": {"const": "separated_research"},
        "angles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "audiences": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "carriers": {
          "type": "array",
          "items": {"enum": ["homepage", "article", "image", "video"]},
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "research": {
          "type": "object",
          "required": ["lanes"],
          "additionalProperties": false,
          "properties": {
            "lanes": {
              "type": "array",
              "items": {"enum": ["homepage", "article", "image", "video"]},
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true
            },
            "imageAssetStrategy": {
              "enum": [
                "open_license_publish",
                "licensed_provider_publish",
                "ai_generated_original",
                "attribution_audited_publish",
                "reference_only_no_image_release"
              ]
            },
            "imageCountPolicy": {"enum": ["score_bonus", "hard_quota"]},
            "minimumPublishableImagesPerTarget": {
              "type": "integer",
              "minimum": 0
            },
            "allowAiImages": {"type": "boolean"}
          }
        },
        "quotas": {
          "type": "object",
          "required": [
            "entityHomepagesPerTarget",
            "entityArticlesPerTarget",
            "imageWorksPerTarget",
            "videoWorksPerTarget",
            "routeArticles"
          ],
          "additionalProperties": false,
          "properties": {
            "entityHomepagesPerTarget": {"type": "integer", "minimum": 0},
            "entityArticlesPerTarget": {"type": "integer", "minimum": 0},
            "imageWorksPerTarget": {"type": "integer", "minimum": 0},
            "videoWorksPerTarget": {"type": "integer", "minimum": 0},
            "routeArticles": {"type": "integer", "minimum": 0}
          }
        },
        "workUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "media_work_unit.schema.json#/$defs/workUnit"}
        },
        "workUnitExclusions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "media_work_unit.schema.json#/$defs/exclusion"}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["minEntities", "minPostsPerEntity", "requiredAngles"],
      "additionalProperties": false,
      "properties": {
        "minEntities": {"type": "integer", "minimum": 0},
        "minPostsPerEntity": {"type": "integer", "minimum": 0},
        "requiredAngles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "scoredAngles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "required": [
        "selectionPolicy",
        "targetEntityCount",
        "targetObjectCount",
        "approvedQuota",
        "oversampleFactor",
        "requiredWorkers",
        "partitionCount",
        "capacityPlanDigest",
        "workerHostSetBinding",
        "executionBranch",
        "gitCommitSha"
      ],
      "additionalProperties": false,
      "properties": {
        "selectionPolicy": {"const": "frozen"},
        "targetEntityCount": {"type": "integer", "minimum": 0},
        "targetObjectCount": {"type": "integer", "minimum": 0},
        "approvedQuota": {"type": "integer", "minimum": 1},
        "oversampleFactor": {"type": "number", "minimum": 1},
        "requiredWorkers": {"type": "integer", "minimum": 1},
        "partitionCount": {"enum": [16, 32, 64, 128, 256]},
        "capacityPlanDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "workerHostSetBinding": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "governed_worker_host_binding.schema.json"}
          ]
        },
        "capacityCalibration": {
          "$ref": "governed_capacity_calibration_receipt.schema.json#/$defs/executionPolicyBinding",
          "description": "两个并行上限、单对象 wall-clock、完成宽限与批次绝对截止的冻结来源。取值只能来自一份 create-once calibration receipt；携带即按 DEC-006 校验摘要与适用范围。OPEN-003 冻结出首份 receipt 后本字段与 fleet 回执的 fleetWaveCount / fleetBatchDeadlineEpochSeconds 同批提为必填，并同批退役把工作单元数当作 worker 数的 requiredWorkers。"
        },
        "scaleSourcePool": {"$ref": "scale_source_pool_binding.schema.json"},
        "sourcePoolEvidenceRootRef": {"type": "string", "minLength": 1},
        "sourcePoolSelection": {"$ref": "scale_source_pool_selection.schema.json"},
        "executionBranch": {"type": "string", "minLength": 1},
        "gitCommitSha": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["scaleSourcePool"]},
          "then": {
            "required": ["sourcePoolEvidenceRootRef", "sourcePoolSelection"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["sourcePoolEvidenceRootRef"]},
                {"required": ["sourcePoolSelection"]}
              ]
            }
          }
        }
      ]
    },
    "queuePolicy": {
      "type": "object",
      "required": [
        "backend",
        "reliableTask",
        "leaseSeconds",
        "heartbeatSeconds",
        "deadLetterAfterAttempts"
      ],
      "additionalProperties": false,
      "properties": {
        "backend": {"enum": ["local_file", "reliabletask"]},
        "reliableTask": {
          "type": "object",
          "required": ["taskType", "queue", "store", "readyIndex"],
          "additionalProperties": false,
          "properties": {
            "taskType": {"const": "data.content_object.execute"},
            "queue": {"const": "reliabletask.data.content_supply"},
            "store": {"const": "MongoStore"},
            "readyIndex": {"const": "RedisReadyIndex"}
          }
        },
        "leaseSeconds": {"type": "integer", "minimum": 1},
        "heartbeatSeconds": {"type": "integer", "minimum": 1},
        "deadLetterAfterAttempts": {"type": "integer", "minimum": 1}
      }
    },
    "schema": {
      "const": "quwoquan.content.execution_spec"
    }
  },
  "required": [
    "schema",
    "executionId",
    "title",
    "intentLabel",
    "executionArchetype",
    "vertical",
    "organizeBy",
    "key",
    "status",
    "scope",
    "provenance",
    "presetRef",
    "content",
    "acceptance",
    "executionPolicy",
    "queuePolicy"
  ],
  "additionalProperties": false
}
