{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/m100_alpha_acceptance_binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotionId",
    "promotionReceiptRef",
    "promotionReceiptDigest",
    "releaseId",
    "manifestDigest",
    "releaseUatSamplePlanRef",
    "releaseUatSamplePlanDigest",
    "dataReadinessRef",
    "dataReadinessExactByteDigest",
    "alphaEnvironmentAcceptanceRef",
    "alphaEnvironmentAcceptanceExactByteDigest",
    "requiredRawResultRefs",
    "requiredRawResultDigests",
    "executedSampleCount"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.m100_alpha_acceptance_binding"
    },
    "promotionId": {
      "type": "string",
      "minLength": 1
    },
    "promotionReceiptRef": {
      "$ref": "#/$defs/ref"
    },
    "promotionReceiptDigest": {
      "$ref": "#/$defs/digest"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "releaseUatSamplePlanRef": {
      "$ref": "#/$defs/ref"
    },
    "releaseUatSamplePlanDigest": {
      "$ref": "#/$defs/digest"
    },
    "dataReadinessRef": {
      "$ref": "#/$defs/ref"
    },
    "dataReadinessExactByteDigest": {
      "$ref": "#/$defs/digest"
    },
    "alphaEnvironmentAcceptanceRef": {
      "$ref": "#/$defs/ref"
    },
    "alphaEnvironmentAcceptanceExactByteDigest": {
      "$ref": "#/$defs/digest"
    },
    "requiredRawResultRefs": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "requiredRawResultDigests": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "appUatCompletenessProjectionRef": {
      "$ref": "#/$defs/ref"
    },
    "appUatCompletenessProjectionDigest": {
      "$ref": "#/$defs/digest"
    },
    "executedSampleCount": {
      "const": 100
    }
  },
  "dependentRequired": {
    "appUatCompletenessProjectionRef": [
      "appUatCompletenessProjectionDigest"
    ],
    "appUatCompletenessProjectionDigest": [
      "appUatCompletenessProjectionRef"
    ]
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
