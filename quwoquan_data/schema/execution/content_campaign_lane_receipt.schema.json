{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_lane_receipt.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "executionId",
    "carrier",
    "phase",
    "status",
    "approvedQuota",
    "qualifiedCount",
    "finalizedCount"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.content_campaign_lane_receipt"
    },
    "rootExecutionId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "carrier": {
      "enum": ["homepage", "article", "image", "video"]
    },
    "phase": {
      "enum": ["review", "publish"]
    },
    "status": {
      "enum": ["qualified", "finalized"]
    },
    "approvedQuota": {
      "type": "integer",
      "minimum": 1
    },
    "qualifiedCount": {
      "type": "integer",
      "minimum": 0
    },
    "finalizedCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
