{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_lane_receipt.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "executionId",
    "carrier",
    "phase",
    "status",
    "approvedQuota",
    "qualifiedCount",
    "finalizedCount",
    "selectedCount",
    "discardedCount",
    "discards",
    "shortfallCount"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.content_campaign_lane_receipt"
    },
    "rootExecutionId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "carrier": {
      "enum": ["homepage", "article", "image", "video"]
    },
    "phase": {
      "enum": ["review", "publish"]
    },
    "status": {
      "enum": ["qualified", "partial", "blocked", "finalized"]
    },
    "approvedQuota": {
      "type": "integer",
      "minimum": 1
    },
    "qualifiedCount": {
      "type": "integer",
      "minimum": 0
    },
    "finalizedCount": {
      "type": "integer",
      "minimum": 0
    },
    "selectedCount": {
      "type": "integer",
      "minimum": 0
    },
    "discardedCount": {
      "type": "integer",
      "minimum": 0
    },
    "shortfallCount": {
      "type": "integer",
      "minimum": 0
    },
    "executionPublishRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "executionPublishSha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "campaignRunId": {
      "type": "string",
      "minLength": 1
    },
    "campaignGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "campaignFencingToken": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reviewedClosureAdoption": {
      "$ref": "reviewed_closure_adoption_campaign_binding.schema.json"
    },
    "adoptedObjectRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "discards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objectRef", "issues"],
        "additionalProperties": false,
        "properties": {
          "objectRef": { "type": "string", "minLength": 1 },
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reviewQualifiedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "publish 阶段回执携带的评审合格对象数，必须等于同回执的 qualifiedCount；finalizedCount 与 publishDiscards 之和必须等于它，否则判为对象结局漂移。"
    },
    "publishDiscards": {
      "type": "array",
      "description": "评审已合格但在发布阶段被 typed 排除的对象。与 discards 不同：discards 是评审阶段的排除口径。",
      "items": {
        "type": "object",
        "required": ["objectRef", "issues"],
        "additionalProperties": false,
        "properties": {
          "objectRef": { "type": "string", "minLength": 1 },
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "review" } },
        "required": ["phase"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "executionPublishRef"
              ]
            },
            {
              "required": [
                "executionPublishSha256"
              ]
            },
            {
              "required": [
                "campaignRunId"
              ]
            },
            {
              "required": [
                "campaignGeneration"
              ]
            },
            {
              "required": [
                "campaignFencingToken"
              ]
            },
            {
              "required": [
                "reviewQualifiedCount"
              ]
            },
            {
              "required": [
                "publishDiscards"
              ]
            }
          ]
        },
        "properties": {
          "status": { "enum": ["qualified", "partial", "blocked"] },
          "finalizedCount": { "const": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "publish" } },
        "required": ["phase"]
      },
      "then": {
        "required": [
          "campaignRunId",
          "campaignGeneration",
          "campaignFencingToken",
          "reviewQualifiedCount",
          "publishDiscards"
        ],
        "oneOf": [
          {
            "required": ["executionPublishRef", "executionPublishSha256"]
          },
          {
            "required": ["reviewedClosureAdoption", "adoptedObjectRefs"]
          }
        ],
        "properties": {
          "status": { "enum": ["finalized", "partial", "blocked"] }
        }
      }
    }
  ]
}
