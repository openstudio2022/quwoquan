{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_lane_receipt.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "executionId",
    "carrier",
    "phase",
    "status",
    "approvedQuota",
    "qualifiedCount",
    "finalizedCount",
    "selectedCount",
    "discardedCount",
    "discards",
    "shortfallCount"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.content_campaign_lane_receipt"
    },
    "rootExecutionId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "carrier": {
      "enum": ["homepage", "article", "image", "video"]
    },
    "phase": {
      "enum": ["review", "publish"]
    },
    "status": {
      "enum": ["qualified", "partial", "blocked", "finalized"]
    },
    "approvedQuota": {
      "type": "integer",
      "minimum": 1
    },
    "qualifiedCount": {
      "type": "integer",
      "minimum": 0
    },
    "finalizedCount": {
      "type": "integer",
      "minimum": 0
    },
    "selectedCount": {
      "type": "integer",
      "minimum": 0
    },
    "discardedCount": {
      "type": "integer",
      "minimum": 0
    },
    "shortfallCount": {
      "type": "integer",
      "minimum": 0
    },
    "discards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objectRef", "issues"],
        "additionalProperties": false,
        "properties": {
          "objectRef": { "type": "string", "minLength": 1 },
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "review" } },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "status": { "enum": ["qualified", "partial", "blocked"] },
          "finalizedCount": { "const": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "publish" } },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "status": { "enum": ["finalized", "partial", "blocked"] }
        }
      }
    }
  ]
}
