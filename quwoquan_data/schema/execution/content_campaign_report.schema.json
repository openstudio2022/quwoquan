{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_report.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "activeCarriers",
    "workloads",
    "campaignRunId",
    "campaignGeneration",
    "campaignFencingToken",
    "status",
    "phase",
    "planDigest",
    "gitBranch",
    "gitCommitSha",
    "sourceDigest",
    "entityCatalogDigest",
    "lanes",
    "failure",
    "startedAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.content_campaign_report" },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "activeCarriers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["homepage", "article", "image", "video"] }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "integer", "minimum": 1 },
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      }
    },
    "campaignRunId": { "type": ["string", "null"], "minLength": 1 },
    "campaignGeneration": { "type": ["integer", "null"], "minimum": 1 },
    "campaignFencingToken": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "awaiting_submissions",
        "running",
        "succeeded",
        "succeeded_partial",
        "blocked"
      ]
    },
    "phase": {
      "enum": [
        "submission",
        "freeze",
        "capsule",
        "review",
        "publish",
        "cleanup",
        "completed"
      ]
    },
    "planDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitBranch": { "type": ["string", "null"], "minLength": 1 },
    "gitCommitSha": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "sourceDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "entityCatalogDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lanes": {
      "type": "object",
      "required": ["homepage", "article", "image", "video"],
      "additionalProperties": false,
      "properties": {
        "homepage": { "$ref": "#/$defs/lane" },
        "article": { "$ref": "#/$defs/lane" },
        "image": { "$ref": "#/$defs/lane" },
        "video": { "$ref": "#/$defs/lane" }
      }
    },
    "failure": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "required": [
        "executionId",
        "status",
        "phase",
        "reviewReturnCode",
        "publishReturnCode",
        "sourceCapsuleRef",
        "sourceCapsuleDigest",
        "sourceCapsuleCommitSha",
        "sourceCapsuleSourceDigest",
        "sourceCapsuleReadOnly",
        "executionRootRef",
        "cleanupStatus",
        "approvedQuota",
        "qualifiedCount",
        "finalizedCount",
        "selectedCount",
        "discardedCount",
        "shortfallCount",
        "deliveryPendingCount",
        "deliveryIntentRefs",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "executionId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "pending",
            "capsule_ready",
            "reviewed",
            "review_qualified",
            "partial",
            "delivery_pending",
            "published",
            "finalized",
            "blocked"
          ]
        },
        "phase": {
          "enum": ["submission", "capsule", "review", "publish"]
        },
        "reviewReturnCode": { "type": ["integer", "null"] },
        "publishReturnCode": { "type": ["integer", "null"] },
        "sourceCapsuleRef": { "type": ["string", "null"], "minLength": 1 },
        "sourceCapsuleDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceCapsuleCommitSha": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "sourceCapsuleSourceDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceCapsuleReadOnly": { "type": ["boolean", "null"] },
        "executionRootRef": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^data/tasks/[^/]+$"
        },
        "cleanupStatus": {
          "enum": ["not_created", "pending", "cleaned", "failed"]
        },
        "approvedQuota": { "type": ["integer", "null"], "minimum": 1 },
        "qualifiedCount": { "type": ["integer", "null"], "minimum": 0 },
        "finalizedCount": { "type": ["integer", "null"], "minimum": 0 },
        "selectedCount": { "type": ["integer", "null"], "minimum": 0 },
        "discardedCount": { "type": ["integer", "null"], "minimum": 0 },
        "shortfallCount": { "type": ["integer", "null"], "minimum": 0 },
        "deliveryPendingCount": { "type": "integer", "minimum": 0 },
        "deliveryIntentRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
