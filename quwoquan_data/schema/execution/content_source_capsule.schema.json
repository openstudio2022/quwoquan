{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_source_capsule.schema.json",
  "type": "object",
  "required": [
    "schema", "format", "gitBranch", "gitCommitSha", "sourceRevision", "sourceDigest", "executionBundle",
    "entityCatalogDigest", "roots", "laneExternalInputs", "externalInputsDigest",
    "capsuleDigest", "treeDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.content_campaign_source_capsule"},
    "format": {"const": "source-capsule-v2"},
    "gitBranch": {"type": "string", "minLength": 1},
    "gitCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executionBundle": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "laneExternalInputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": {"$ref": "#/$defs/lane"},
        "article": {"$ref": "#/$defs/lane"},
        "image": {"$ref": "#/$defs/lane"},
        "video": {"$ref": "#/$defs/lane"}
      }
    },
    "externalInputsDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scaleSourcePool": {"$ref": "scale_source_pool_binding.schema.json"},
    "sourcePoolSnapshotRootRef": {"const": "scale-source-pool"},
    "sourcePoolSnapshotDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "laneSourcePoolSelections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": {"$ref": "scale_source_pool_selection.schema.json"},
        "article": {"$ref": "scale_source_pool_selection.schema.json"},
        "image": {"$ref": "scale_source_pool_selection.schema.json"},
        "video": {"$ref": "scale_source_pool_selection.schema.json"}
      }
    },
    "capsuleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "treeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"required": ["scaleSourcePool"]},
      "then": {
        "required": [
          "sourcePoolSnapshotRootRef",
          "sourcePoolSnapshotDigest",
          "laneSourcePoolSelections"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["sourcePoolSnapshotRootRef"]},
            {"required": ["sourcePoolSnapshotDigest"]},
            {"required": ["laneSourcePoolSelections"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["rootRef", "externalInputRefs", "externalInputsDigest"],
      "additionalProperties": false,
      "properties": {
        "rootRef": {"type": "string", "minLength": 1},
        "externalInputRefs": {
          "type": "array",
          "items": {"$ref": "campaign_external_input_ref.schema.json"}
        },
        "externalInputsDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
