{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stage_semantic_request.schema.json",
  "title": "Canonical host semantic stage request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "stage",
    "sequence",
    "workflowContract",
    "openRequest",
    "inputBindings",
    "requestDigest",
    "preparedAt"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stage_semantic_request"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "sources",
        "2.quality",
        "3.compose",
        "4.draft",
        "5.review"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "workflowContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "const": "repo"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "openRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "const": "execution"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "inputBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "ref",
          "digest"
        ],
        "properties": {
          "scope": {
            "const": "execution"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "preparedAt": {
      "type": "string",
      "minLength": 1
    }
  }
}
