{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stage_receipt.schema.json",
  "description": "由 deterministic stage-open/stage-gate/stage-close 生成的当前阶段交接回执。",
  "$comment": "当前 writer 只接受 authority kernel；历史 managed state 使用独立 retired schema。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "stage",
    "sequence",
    "verdict",
    "actor",
    "typedIssues",
    "next",
    "authority",
    "recordedAt"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stage_receipt"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "0.plan",
        "sources",
        "1.download",
        "2.quality",
        "3.compose",
        "4.draft",
        "5.review",
        "publish",
        "release",
        "ship"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "modelFamily",
        "sessionId",
        "invocation"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "model",
                "runId"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "typedIssues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "recoveryStage"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "recoveryStage": {
            "enum": [
              "0.plan",
              "sources",
              "1.download",
              "2.quality",
              "3.compose",
              "4.draft",
              "5.review",
              "publish",
              "release",
              "ship"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next": {
      "enum": [
        "0.plan",
        "sources",
        "1.download",
        "2.quality",
        "3.compose",
        "4.draft",
        "5.review",
        "publish",
        "release",
        "ship",
        "END"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openRequest",
        "machineGate",
        "workflowContract",
        "semanticResult",
        "artifacts",
        "releaseBinding",
        "acceptanceBinding"
      ],
      "properties": {
        "openRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "ref",
            "digest"
          ],
          "properties": {
            "scope": {
              "enum": [
                "execution",
                "output",
                "repo"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "machineGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "ref",
            "digest"
          ],
          "properties": {
            "scope": {
              "enum": [
                "execution",
                "output",
                "repo"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "workflowContract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "ref",
            "digest"
          ],
          "properties": {
            "scope": {
              "const": "repo"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "semanticResult": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "ref",
                "digest"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "execution",
                    "output",
                    "repo"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "ref",
              "digest"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "execution",
                  "output",
                  "repo"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "releaseBinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "releaseId",
                "releaseDigest"
              ],
              "properties": {
                "releaseId": {
                  "type": "string",
                  "minLength": 1
                },
                "releaseDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "acceptanceBinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "ref",
                "digest",
                "environment"
              ],
              "properties": {
                "scope": {
                  "const": "output"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "environment": {
                  "enum": [
                    "alpha",
                    "beta",
                    "gamma"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
