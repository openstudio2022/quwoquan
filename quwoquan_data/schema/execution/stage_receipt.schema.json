{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stage_receipt.schema.json",
  "description": "内容生产阶段交接回执（DEC-005）：每阶段收尾由 `task stage-record` create-once 原子写入 `_shared/receipts/`，receipt 链是跨会话/跨宿主交接与恢复的唯一状态源。",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "stage",
    "sequence",
    "verdict",
    "actor",
    "artifacts",
    "openItems",
    "next",
    "evidence",
    "recordedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.stage_receipt"},
    "executionId": {"type": "string", "minLength": 1},
    "stage": {
      "enum": [
        "0.plan",
        "sources",
        "1.download",
        "2.quality",
        "3.compose",
        "4.draft",
        "5.review",
        "publish",
        "release",
        "ship"
      ]
    },
    "sequence": {"type": "integer", "minimum": 1},
    "verdict": {"enum": ["pass", "blocked"]},
    "actor": {
      "type": "object",
      "required": ["host", "modelFamily", "sessionId"],
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "modelFamily": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "openItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "disposition"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["return_to_stage", "gate_block", "out_of_scope"]},
          "returnStage": {
            "enum": [
              "0.plan",
              "sources",
              "1.download",
              "2.quality",
              "3.compose",
              "4.draft",
              "5.review",
              "publish",
              "release",
              "ship"
            ]
          }
        }
      }
    },
    "next": {
      "enum": [
        "0.plan",
        "sources",
        "1.download",
        "2.quality",
        "3.compose",
        "4.draft",
        "5.review",
        "publish",
        "release",
        "ship",
        "END"
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["commands", "issueCount", "repairRounds"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "exitCode"],
            "additionalProperties": false,
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "exitCode": {"type": "integer"}
            }
          }
        },
        "issueCount": {"type": "integer", "minimum": 0},
        "repairRounds": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "recordedAt": {"type": "string", "format": "date-time"}
  }
}
