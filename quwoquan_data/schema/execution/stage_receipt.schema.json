{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stage_receipt.schema.json",
  "description": "create-once seal receipt。resultRefs 是 seal 实际校验并冻结的产物 exact bytes；没有 OPEN，也没有宿主 attestation。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "stage",
    "sequence",
    "predecessor",
    "sealInput",
    "actor",
    "verdict",
    "typedIssues",
    "resultRefs"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stage_receipt"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "stage": {
      "enum": [
        "1.download",
        "4.draft",
        "5.review"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/refFrozen"
        }
      ]
    },
    "sealInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "actor": {
      "$ref": "seal_input.schema.json#/$defs/actor"
    },
    "verdict": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "typedIssues": {
      "type": "array",
      "items": {
        "$ref": "seal_input.schema.json#/$defs/typedIssue"
      }
    },
    "resultRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/refFrozen"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "1.download"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 1
          },
          "predecessor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "4.draft"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 2
          },
          "predecessor": {
            "$ref": "#/$defs/refFrozen"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "5.review"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 3
          },
          "predecessor": {
            "$ref": "#/$defs/refFrozen"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "resultRefs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "typedIssues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "refFrozen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "const": "execution"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
