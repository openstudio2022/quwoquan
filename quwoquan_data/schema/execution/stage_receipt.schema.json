{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stage_receipt.schema.json",
  "description": "create-once stage receipt。verifierFacts 是宿主 attestation，而不是内核执行证明。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "stage",
    "sequence",
    "predecessor",
    "openRequest",
    "closeInput",
    "submittedClose",
    "actor",
    "verdict",
    "typedIssues",
    "inputRefs",
    "resultRefs",
    "verifierFacts"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stage_receipt"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "stage": {
      "enum": [
        "0.plan",
        "sources",
        "1.download",
        "2.quality",
        "3.compose",
        "4.draft",
        "5.review",
        "publish",
        "release"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "predecessor": {
      "$ref": "#/$defs/predecessor"
    },
    "openRequest": {
      "$ref": "#/$defs/executionBinding"
    },
    "closeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "submittedClose": {
      "$ref": "stage_close_input.schema.json"
    },
    "actor": {
      "$ref": "stage_close_input.schema.json#/$defs/actor"
    },
    "verdict": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "typedIssues": {
      "type": "array",
      "items": {
        "$ref": "stage_close_input.schema.json#/$defs/typedIssue"
      }
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/refFrozen"
      }
    },
    "resultRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/refFrozen"
      }
    },
    "verifierFacts": {
      "type": "array",
      "items": {
        "$ref": "stage_close_input.schema.json#/$defs/verifierFact"
      },
      "description": "宿主 attestation；内核只冻结字段和 evidence bytes，不能证明 command 执行。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "0.plan"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "sources"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "1.download"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "2.quality"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "3.compose"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "4.draft"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "5.review"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 7
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "publish"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 8
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "release"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "const": 9
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "0.plan"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "predecessor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "stage": {
              "const": "0.plan"
            }
          },
          "required": [
            "stage"
          ]
        }
      },
      "then": {
        "properties": {
          "predecessor": {
            "$ref": "#/$defs/executionBinding"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "typedIssues": {
            "type": "array",
            "maxItems": 0
          },
          "resultRefs": {
            "type": "array",
            "minItems": 1
          },
          "verifierFacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "status",
                "exitCode",
                "evidenceRef",
                "evidenceDigest"
              ],
              "properties": {
                "status": {
                  "const": "passed"
                },
                "exitCode": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "typedIssues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "refFrozen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "enum": [
            "execution",
            "output",
            "repo"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "const": "execution"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/executionBinding"
        }
      ]
    }
  }
}
