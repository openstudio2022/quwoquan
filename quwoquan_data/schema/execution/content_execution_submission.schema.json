{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_execution_submission.schema.json",
  "type": "object",
  "required": [
    "schema",
    "scale",
    "workloadMode",
    "activeCarriers",
    "workloads",
    "rootExecutionId",
    "executionId",
    "operation",
    "carrier",
    "familyRef",
    "regionRef",
    "selector",
    "quota",
    "count",
    "workerHostSetBinding",
    "targetNames",
    "sourceProviders",
    "semanticSelectionId",
    "retryOf",
    "retryUnfinishedRefs",
    "gitBranch",
    "gitCommitSha",
    "sourceRevision",
    "sourceDigest",
    "executionBundle",
    "entityCatalogDigest",
    "externalInputRefs",
    "externalInputsDigest",
    "requestDigest",
    "submittedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.content_execution_submission" },
    "scale": {
      "type": "string",
      "pattern": "^M[1-9][0-9]{0,5}$"
    },
    "workloadMode": { "enum": ["milestone_preset", "explicit"] },
    "activeCarriers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["homepage", "article", "image", "video"] }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "integer", "minimum": 1 },
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      }
    },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": [
        "homepage.generate",
        "article.generate",
        "image.generate",
        "video.generate",
        "homepage.adoptReviewedClosure",
        "article.adoptReviewedClosure",
        "image.adoptReviewedClosure",
        "video.adoptReviewedClosure"
      ]
    },
    "carrier": { "enum": ["homepage", "article", "image", "video"] },
    "familyRef": { "type": "string", "minLength": 1 },
    "regionRef": { "type": "string", "minLength": 1 },
    "selector": { "type": "string", "minLength": 1 },
    "quota": { "type": "integer", "minimum": 1 },
    "count": { "type": "integer", "minimum": 1 },
    "executionAuthority": {
      "$ref": "execution_authority.schema.json"
    },
    "workerHostSetBinding": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "governed_worker_host_binding.schema.json"}
      ]
    },
    "scaleSourcePool": {"$ref": "scale_source_pool_binding.schema.json"},
    "sourcePoolEvidenceRootRef": {"type": "string", "minLength": 1},
    "sourcePoolSelection": {"$ref": "scale_source_pool_selection.schema.json"},
    "topic": { "type": ["string", "null"] },
    "targetNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticSelectionId": {
      "enum": ["default", "cursor_grok", "cursor_auto", "not_applicable"]
    },
    "semanticPreflightReceipt": {
      "$ref": "semantic_provider_preflight_receipt_ref.schema.json"
    },
    "retryOf": { "type": ["string", "null"] },
    "retryUnfinishedRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gitBranch": { "type": "string", "minLength": 1 },
    "gitCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "sourceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "executionBundle": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "externalInputRefs": {
      "type": "array",
      "items": { "$ref": "campaign_external_input_ref.schema.json" }
    },
    "externalInputsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "predecessorReconciliation": {
      "$ref": "campaign_submission_reconciliation_ref.schema.json"
    },
    "reviewedClosureAdoption": {
      "$ref": "reviewed_closure_adoption_campaign_binding.schema.json"
    },
    "requestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "submittedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "homepage.generate",
              "article.generate",
              "image.generate",
              "video.generate"
            ]
          }
        },
        "required": ["operation"]
      },
      "then": {
        "required": [
          "executionAuthority"
        ],
        "properties": {
          "semanticSelectionId": { "enum": ["default", "cursor_grok", "cursor_auto"] }
        }
      },
      "else": {
        "properties": {
          "semanticSelectionId": { "const": "not_applicable" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "semanticSelectionId": { "enum": ["default", "cursor_grok", "cursor_auto"] }
        },
        "required": ["semanticSelectionId"]
      },
      "then": {
        "required": ["semanticPreflightReceipt"]
      }
    },
    {
      "if": {"required": ["scaleSourcePool"]},
      "then": {
        "required": ["sourcePoolEvidenceRootRef", "sourcePoolSelection"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["sourcePoolEvidenceRootRef"]},
            {"required": ["sourcePoolSelection"]}
          ]
        }
      }
    },
    {
      "$comment": "只有作者派发操作才有来源池可绑；其余操作（如已审闭合重发）不得携带来源池面。",
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "homepage.generate", "article.generate", "image.generate", "video.generate"
            ]
          }
        },
        "required": ["operation"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["scaleSourcePool"]},
            {"required": ["sourcePoolEvidenceRootRef"]},
            {"required": ["sourcePoolSelection"]}
          ]
        }
      }
    },
    {
      "$comment": "来源池要求由冻结的 workload 政策决定：只有 milestone_preset 的 M10000 必须携带完整来源池，其余 workload 可以携带但不被强制。执行 id 的字面形状不是该政策的来源。",
      "if": {
        "properties": {
          "workloadMode": {"const": "milestone_preset"},
          "scale": {"const": "M10000"}
        },
        "required": ["workloadMode", "scale"]
      },
      "then": {
        "required": [
          "scaleSourcePool", "sourcePoolEvidenceRootRef", "sourcePoolSelection"
        ]
      }
    }
  ]
}
