{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_pre_acquisition_handoff.schema.json",
  "type": "object",
  "required": [
    "schema",
    "handoffId",
    "handoffRevision",
    "supersedes",
    "scale",
    "vertical",
    "scope",
    "regionRef",
    "topic",
    "runDate",
    "campaignSequence",
    "campaignRetryOf",
    "sourceRevision",
    "sourceDigest",
    "executionBundle",
    "entityCatalogDigest",
    "workloadTargets",
    "sourceMutationPolicy",
    "carrierRequirements",
    "handoffDigest",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan_data.content_pre_acquisition_handoff"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "handoffRevision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/supersedes"
        }
      ]
    },
    "scale": {
      "type": "string",
      "pattern": "^M[1-9][0-9]{0,5}$"
    },
    "vertical": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "regionRef": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "runDate": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "campaignSequence": {
      "type": "integer",
      "minimum": 1
    },
    "campaignRetryOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRevision": {
      "$ref": "#/$defs/sha256"
    },
    "sourceDigest": {
      "type": "object",
      "required": [
        "algorithm",
        "digest",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executionBundle": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "entityCatalogDigest": {
      "$ref": "#/$defs/sha256"
    },
    "workloadTargets": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "integer",
          "minimum": 1
        },
        "article": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "integer",
          "minimum": 1
        },
        "video": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceMutationPolicy": {
      "type": "object",
      "required": [
        "mode",
        "driftAction",
        "nextRevisionAction"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "immutable_after_handoff"
        },
        "driftAction": {
          "const": "GATE_BLOCK"
        },
        "nextRevisionAction": {
          "const": "create_superseding_handoff"
        }
      }
    },
    "carrierRequirements": {
      "type": "object",
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "$ref": "#/$defs/imageAcquisitionRequirement"
        },
        "article": {
          "$ref": "#/$defs/articleRequirement"
        },
        "image": {
          "$ref": "#/$defs/imageAcquisitionRequirement"
        },
        "video": {
          "$ref": "#/$defs/videoAcquisitionRequirement"
        }
      }
    },
    "handoffDigest": {
      "$ref": "#/$defs/sha256"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "supersedes": {
      "type": "object",
      "required": [
        "handoffId",
        "handoffRevision",
        "handoffRef",
        "handoffFileDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "handoffId": {
          "type": "string",
          "minLength": 1
        },
        "handoffRevision": {
          "type": "integer",
          "minimum": 1
        },
        "handoffRef": {
          "type": "string",
          "minLength": 1
        },
        "handoffFileDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "imageAcquisitionRequirement": {
      "type": "object",
      "required": [
        "phase1Mode",
        "requiredExternalInputKinds",
        "operatorPrompt"
      ],
      "additionalProperties": false,
      "properties": {
        "phase1Mode": {
          "const": "external_acquisition"
        },
        "requiredExternalInputKinds": {
          "const": [
            "professional_image_acquisition"
          ]
        },
        "operatorPrompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "videoAcquisitionRequirement": {
      "type": "object",
      "required": [
        "phase1Mode",
        "requiredExternalInputKinds",
        "operatorPrompt"
      ],
      "additionalProperties": false,
      "properties": {
        "phase1Mode": {
          "const": "external_acquisition"
        },
        "requiredExternalInputKinds": {
          "const": [
            "professional_video_acquisition"
          ]
        },
        "operatorPrompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "articleRequirement": {
      "type": "object",
      "required": [
        "phase1Mode",
        "requiredExternalInputKinds",
        "operatorPrompt"
      ],
      "additionalProperties": false,
      "properties": {
        "phase1Mode": {
          "const": "execution_source_unit_freeze"
        },
        "requiredExternalInputKinds": {
          "const": []
        },
        "operatorPrompt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "handoffRevision": {
            "const": 1
          }
        },
        "required": [
          "handoffRevision"
        ]
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes": {
            "$ref": "#/$defs/supersedes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaignSequence": {
            "const": 1
          }
        },
        "required": [
          "campaignSequence"
        ]
      },
      "then": {
        "properties": {
          "campaignRetryOf": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "campaignRetryOf": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
