{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/semantic_checkpoint_exclusion.schema.json",
  "title": "Create-once semantic checkpoint object exclusion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "stage",
    "objectRef",
    "disposition",
    "taskStarted",
    "shortfallCount",
    "terminalOutcome",
    "terminalOutcomeDigest",
    "issueRecords",
    "repairAction",
    "retryOfRequired",
    "recordedAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.semantic_checkpoint_exclusion"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": ["build_homepage", "post_author"]
    },
    "objectRef": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": ["excluded", "not_started_shortfall"]
    },
    "taskStarted": {
      "type": "boolean"
    },
    "shortfallCount": {
      "const": 1
    },
    "terminalOutcome": {
      "$ref": "execution_state.schema.json#/$defs/managedAgentOutcome"
    },
    "terminalOutcomeDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issueRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "repairAction": {
      "enum": ["new_execution_retry_of", "human_decision"]
    },
    "retryOfRequired": {
      "type": "boolean"
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "taskStarted": {"const": true}
        },
        "required": ["taskStarted"]
      },
      "then": {
        "properties": {
          "disposition": {"const": "excluded"}
        }
      },
      "else": {
        "properties": {
          "disposition": {"const": "not_started_shortfall"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "retryOfRequired": {"const": true}
        },
        "required": ["retryOfRequired"]
      },
      "then": {
        "properties": {
          "repairAction": {"const": "new_execution_retry_of"}
        }
      },
      "else": {
        "properties": {
          "repairAction": {"const": "human_decision"}
        }
      }
    }
  ]
}
