{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_request_envelope.schema.json",
  "type": "object",
  "required": [
    "schema",
    "scale",
    "workloadMode",
    "activeCarriers",
    "workloads",
    "carrier",
    "operation",
    "vertical",
    "familyRef",
    "regionRef",
    "selector",
    "quota",
    "count",
    "executionAuthority",
    "workerHostSetBinding",
    "targetNames",
    "sourceProviders",
    "semanticSelectionId",
    "retryOf",
    "rootExecutionId",
    "executionId",
    "gitBranch",
    "gitCommitSha",
    "sourceRevision",
    "sourceDigest",
    "executionBundle",
    "entityCatalogDigest",
    "preAcquisitionHandoff",
    "externalInputRefs",
    "externalInputsDigest",
    "allowedStage",
    "operatorPrompt",
    "requestDigest",
    "frozenAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.content_campaign_request_envelope" },
    "scale": {
      "type": "string",
      "pattern": "^M[1-9][0-9]{0,5}$"
    },
    "workloadMode": { "enum": ["milestone_preset", "explicit"] },
    "activeCarriers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["homepage", "article", "image", "video"] }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "integer", "minimum": 1 },
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      }
    },
    "carrier": { "enum": ["homepage", "article", "image", "video"] },
    "operation": {
      "enum": [
        "homepage.generate",
        "article.generate",
        "image.generate",
        "video.generate"
      ]
    },
    "vertical": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "familyRef": { "type": "string", "minLength": 1 },
    "regionRef": { "type": "string", "minLength": 1 },
    "selector": { "type": "string", "minLength": 1 },
    "quota": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "count": { "type": "integer", "minimum": 1 },
    "executionAuthority": {
      "$ref": "execution_authority.schema.json"
    },
    "workerHostSetBinding": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "governed_worker_host_binding.schema.json"}
      ]
    },
    "scaleSourcePool": {"$ref": "scale_source_pool_binding.schema.json"},
    "acquisitionRootRef": {"type": "string", "minLength": 1},
    "sourcePoolEvidenceRootRef": {"type": "string", "minLength": 1},
    "sourcePoolSelection": {"$ref": "scale_source_pool_selection.schema.json"},
    "topic": { "type": ["string", "null"] },
    "targetNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticSelectionId": { "enum": ["default", "cursor_grok", "cursor_auto"] },
    "semanticPreflightReceipt": {
      "$ref": "semantic_provider_preflight_receipt_ref.schema.json"
    },
    "retryOf": { "type": ["string", "null"] },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "gitBranch": { "type": "string", "minLength": 1 },
    "gitCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "sourceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "executionBundle": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "preAcquisitionHandoff": {
      "type": "object",
      "required": [
        "handoffId",
        "handoffRevision",
        "handoffRef",
        "handoffDigest",
        "handoffFileDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "handoffId": { "type": "string", "minLength": 1 },
        "handoffRevision": { "type": "integer", "minimum": 1 },
        "handoffRef": { "type": "string", "minLength": 1 },
        "handoffDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "handoffFileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "externalInputRefs": {
      "type": "array",
      "items": { "$ref": "campaign_external_input_ref.schema.json" }
    },
    "externalInputsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "predecessorReconciliation": {
      "$ref": "campaign_submission_reconciliation_ref.schema.json"
    },
    "researchScalePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionId",
        "releaseId",
        "manifestDigest",
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "targetScale",
        "carrierCounts",
        "receiptRef",
        "receiptDigest"
      ],
      "properties": {
        "promotionId": { "type": "string", "minLength": 1 },
        "releaseId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "entityCatalogDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "targetScale": {"enum": ["M100", "M1000"]},
        "carrierCounts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["carrier", "totalUniqueFinalizedCount"],
            "properties": {
              "carrier": {"enum": ["homepage", "article", "image", "video"]},
              "totalUniqueFinalizedCount": {"type": "integer", "minimum": 1}
            }
          }
        },
        "receiptRef": { "type": "string", "minLength": 1 },
        "receiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "allowedStage": { "const": "submit-only" },
    "operatorPrompt": { "type": "string", "minLength": 1 },
    "requestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "frozenAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "semanticSelectionId": { "enum": ["cursor_grok", "cursor_auto"] } },
        "required": ["semanticSelectionId"]
      },
      "then": {
        "required": ["semanticPreflightReceipt"]
      }
    },
    {
      "if": {
        "properties": {"scale": {"const": "M10000"}},
        "required": ["scale"]
      },
      "then": {
        "required": [
          "scaleSourcePool", "sourcePoolEvidenceRootRef", "sourcePoolSelection"
        ],
        "properties": {
          "workerHostSetBinding": {"$ref": "governed_worker_host_binding.schema.json"}
        }
      }
    },
    {
      "if": {
        "properties": {"scale": {"enum": ["M100", "M1000"]}},
        "required": ["scale"]
      },
      "then": {
        "properties": {"targetNames": {"minItems": 1}}
      }
    },
    {
      "if": {"required": ["scaleSourcePool"]},
      "then": {
        "required": ["sourcePoolEvidenceRootRef", "sourcePoolSelection"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["sourcePoolEvidenceRootRef"]},
            {"required": ["sourcePoolSelection"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"externalInputRefs": {"minItems": 1}},
        "required": ["externalInputRefs"]
      },
      "then": {"required": ["acquisitionRootRef"]},
      "else": {"not": {"required": ["acquisitionRootRef"]}}
    }
  ]
}
