{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_request_envelope.schema.json",
  "type": "object",
  "required": [
    "schema",
    "scale",
    "carrier",
    "operation",
    "vertical",
    "familyRef",
    "regionRef",
    "selector",
    "quota",
    "count",
    "targetNames",
    "sourceProviders",
    "semanticSelectionId",
    "retryOf",
    "rootExecutionId",
    "executionId",
    "gitBranch",
    "gitCommitSha",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "externalInputRefs",
    "externalInputsDigest",
    "allowedStage",
    "operatorPrompt",
    "requestDigest",
    "frozenAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.content_campaign_request_envelope" },
    "scale": {
      "type": "string",
      "pattern": "^M[1-9][0-9]{0,5}$"
    },
    "carrier": { "enum": ["homepage", "article", "image", "video"] },
    "operation": {
      "enum": [
        "homepage.generate",
        "article.generate",
        "image.generate",
        "video.generate"
      ]
    },
    "vertical": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "familyRef": { "type": "string", "minLength": 1 },
    "regionRef": { "type": "string", "minLength": 1 },
    "selector": { "type": "string", "minLength": 1 },
    "quota": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "count": { "type": "integer", "minimum": 1 },
    "topic": { "type": ["string", "null"] },
    "targetNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticSelectionId": { "enum": ["default", "cursor_auto"] },
    "semanticPreflightReceipt": {
      "$ref": "semantic_preflight_receipt_ref.schema.json"
    },
    "retryOf": { "type": ["string", "null"] },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "gitBranch": { "type": "string", "minLength": 1 },
    "gitCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "sourceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "externalInputRefs": {
      "type": "array",
      "items": { "$ref": "campaign_external_input_ref.schema.json" }
    },
    "externalInputsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "predecessorReconciliation": {
      "$ref": "campaign_submission_reconciliation_ref.schema.json"
    },
    "researchScalePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionId",
        "releaseId",
        "manifestDigest",
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "receiptRef",
        "receiptDigest"
      ],
      "properties": {
        "promotionId": { "type": "string", "minLength": 1 },
        "releaseId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "entityCatalogDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "receiptRef": { "type": "string", "minLength": 1 },
        "receiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "allowedStage": { "const": "submit-only" },
    "operatorPrompt": { "type": "string", "minLength": 1 },
    "requestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "frozenAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "semanticSelectionId": { "const": "cursor_auto" } },
        "required": ["semanticSelectionId"]
      },
      "then": {
        "required": ["semanticPreflightReceipt"],
        "properties": { "retryOf": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "scale": { "const": "M1000" },
          "vertical": { "const": "travel" }
        },
        "required": ["scale", "vertical"]
      },
      "then": {
        "required": ["researchScalePromotion"]
      }
    }
  ]
}
