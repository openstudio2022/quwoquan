{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One quota-qualified publish closure for an article/image/video execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "carrier",
    "approvedQuota",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.post_review_closure"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "carrier": {
      "enum": ["article", "image", "video"]
    },
    "approvedQuota": {
      "type": "integer",
      "minimum": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectRef",
          "publishRef",
          "disposition",
          "issues"
        ],
        "properties": {
          "objectRef": {
            "type": "string",
            "minLength": 1
          },
          "publishRef": {
            "type": "string",
            "pattern": "^posts/(article|image|video)/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "disposition": {
            "enum": ["qualified", "discarded"]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
