{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/media_work_unit.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "coverageTarget": {
      "type": "object",
      "required": ["name", "entityType"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "entityType": {"type": "string", "minLength": 1}
      }
    },
    "workUnit": {
      "type": "object",
      "required": [
        "workUnitId", "carrier", "manifestRef", "manifestDigest",
        "receiptRef", "receiptDigest", "assetId", "contentSha256",
        "sourceEntityId", "coverageTarget"
      ],
      "additionalProperties": false,
      "properties": {
        "workUnitId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "carrier": {"enum": ["image", "video"]},
        "manifestRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receiptRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "receiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "assetId": {"type": "string", "minLength": 1},
        "contentSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceEntityId": {"type": "string", "minLength": 1},
        "coverageTarget": {
          "type": "object",
          "required": ["name", "entityType"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "entityType": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "required": [
        "workUnitCandidateId", "carrier", "manifestRef", "manifestDigest",
        "receiptRef", "receiptDigest", "assetId", "contentSha256",
        "sourceEntityId", "candidateNames", "code"
      ],
      "additionalProperties": false,
      "properties": {
        "workUnitCandidateId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "carrier": {"enum": ["image", "video"]},
        "manifestRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receiptRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "receiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "assetId": {"type": "string", "minLength": 1},
        "contentSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceEntityId": {"type": "string", "minLength": 1},
        "candidateNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "code": {
          "enum": [
            "DATA.SOURCE.ENTITY_CATALOG_UNMAPPED",
            "DATA.SOURCE.ENTITY_CATALOG_AMBIGUOUS"
          ]
        }
      }
    }
  }
}
