{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/governed_capacity_probe_resource_samples.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "calibrationId", "requestedConcurrency", "startedAt",
    "finishedAt", "samples", "samplesDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.governed_capacity_probe_resource_samples"},
    "calibrationId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "requestedConcurrency": {"type": "integer", "minimum": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capturedAt", "rssBytes", "cpuPercent", "cursorBridgeProcessCount"],
        "properties": {
          "capturedAt": {"type": "string", "format": "date-time"},
          "rssBytes": {"type": "integer", "minimum": 1},
          "cpuPercent": {"type": "number", "minimum": 0},
          "cursorBridgeProcessCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "samplesDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
