{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stage_semantic_result_input.schema.json",
  "title": "Host-recorded semantic stage result input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestRef",
    "requestDigest",
    "actor",
    "resultRefs"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stage_semantic_result_input"
    },
    "requestRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "modelFamily",
        "sessionId",
        "invocation"
      ],
      "properties": {
        "host": {
          "const": "cursor"
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "auto",
              "unknown"
            ]
          }
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "runId"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resultRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
      }
    }
  }
}
