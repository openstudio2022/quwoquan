{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/semantic_capacity_receipt.schema.json",
  "type": "object",
  "required": [
    "schema",
    "receiptId",
    "executionId",
    "provider",
    "model",
    "role",
    "lane",
    "requestId",
    "capacityLimit",
    "laneCapacityLimit",
    "requestsPerMinute",
    "burstLimit",
    "accountScopeId",
    "hostScopeId",
    "acquiredAt",
    "waitDurationMs",
    "runtimeProfileId",
    "runtimeProfileDigest",
    "sdkVersion",
    "promptSha256",
    "outputSchemaDigest",
    "status",
    "failureKind",
    "errorCode",
    "retryable",
    "retryAfterSeconds",
    "runId",
    "resultSha256",
    "recordedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.semantic_capacity_receipt" },
    "receiptId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "executionId": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["cursor_sdk", "codex_sdk"] },
    "model": { "type": "string", "minLength": 1 },
    "role": { "enum": ["author", "reviewer", "calibration"] },
    "lane": { "enum": ["homepage", "article", "image", "video", "unknown"] },
    "requestId": { "type": "string", "minLength": 1 },
    "capacityLimit": { "type": "integer", "minimum": 1 },
    "laneCapacityLimit": { "type": "integer", "minimum": 1 },
    "requestsPerMinute": { "type": "integer", "minimum": 1 },
    "burstLimit": { "type": "integer", "minimum": 1 },
    "accountScopeId": { "type": "string", "minLength": 1 },
    "hostScopeId": { "type": "string", "minLength": 1 },
    "acquiredAt": { "type": "string", "format": "date-time" },
    "waitDurationMs": { "type": "integer", "minimum": 0 },
    "runtimeProfileId": { "type": "string", "minLength": 1 },
    "runtimeProfileDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sdkVersion": { "type": "string", "minLength": 1 },
    "promptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outputSchemaDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["finished", "error"] },
    "failureKind": { "type": ["string", "null"] },
    "errorCode": { "type": ["string", "null"] },
    "retryable": { "type": "boolean" },
    "retryAfterSeconds": { "type": "integer", "minimum": 0 },
    "runId": { "type": ["string", "null"] },
    "resultSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
