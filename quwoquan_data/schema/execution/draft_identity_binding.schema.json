{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/draft_identity_binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contentId", "contentVersion", "publishTitle", "forbidMint", "requiredAssets"],
  "properties": {
    "schema": {"const": "quwoquan_data.draft_identity_binding"},
    "contentId": {"type": "string", "minLength": 1},
    "contentVersion": {"type": "integer", "minimum": 1},
    "publishTitle": {"type": "string", "minLength": 1},
    "forbidMint": {"const": true},
    "requiredAssets": {"type": "array", "minItems": 1, "items": {"$ref": "round_spec.schema.json#/$defs/requiredAsset"}}
  }
}
