{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/governed_host_source_capsule.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "capsuleId", "sourceRevision", "sourceDigest", "entityCatalogDigest", "executorBundle", "capsuleDigest"],
  "properties": {
    "schema": {"const": "quwoquan_data.governed_host_source_capsule"},
    "capsuleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "sourceRevision": {"$ref": "#/$defs/digest"},
    "sourceDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/digest"},
        "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "entityCatalogDigest": {"$ref": "#/$defs/digest"},
    "executorBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "digest", "fileSha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "digest": {"$ref": "#/$defs/digest"},
        "fileSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "capsuleDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
