{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/seal_input.schema.json",
  "description": "AI 提交给 task seal 的最小输入：真实 actor 与业务 verdict；机械校验由 seal 自己执行。5.review 另带一份 execution 级 reviews（targetRef → 判断字段），由 seal 扇出为逐对象 content_review.json。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "verdict"
  ],
  "properties": {
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "verdict": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "typedIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typedIssue"
      }
    },
    "reviews": {
      "description": "仅 5.review 使用：键为 targetRef，值为 reviewer 的判断字段；机械字段由 seal 补齐。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/reviewJudgement"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "typedIssues"
        ],
        "properties": {
          "typedIssues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "modelFamily",
        "sessionId",
        "invocation"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "runId"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reviewJudgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blockingIssues",
        "advisories",
        "protocol",
        "objectRevision",
        "dispositions"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "blockingIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safety": {
          "enum": [
            "ok",
            "concern"
          ]
        },
        "assetRights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetRef"
            ],
            "properties": {
              "assetRef": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "qualityScores": {
          "description": "reviewer 申报的多维质量评分（只记录不门禁）：键为载体评分维度闭集成员（各载体六维，见 content-production Skill quality.md），值为 1–5 整数；缺席合法，脚本不补零。",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "angle_and_title": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "audio_fit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "caption_value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "composition_aesthetics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "editing_rhythm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "fact_traceability": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "image_match": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "image_relevance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "information_completeness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "originality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "practical_density": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "practical_value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "readability": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "rights_clarity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "source_quality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "structure_clarity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "subject_relevance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "technical_quality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "unique_perspective": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "uniqueness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "visual_quality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "qualityNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "semanticReport": {
          "description": "独立 reviewer 提交的语义保真报告；seal 仅核对来源/草稿摘要、覆盖计数闭包、顺序摘要守恒和状态闭包，不自行作语义判断。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewedCarrier",
            "carrierCompatible",
            "sources",
            "issues"
          ],
          "properties": {
            "reviewedCarrier": {
              "enum": [
                "homepage",
                "article",
                "image",
                "video"
              ]
            },
            "carrierCompatible": {
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceRef",
                  "sourceDigest",
                  "parseStatus",
                  "dialect",
                  "dialectVersion",
                  "capabilities",
                  "sourceCounts",
                  "draftCounts",
                  "sourceSequenceDigest",
                  "draftSequenceDigest"
                ],
                "properties": {
                  "sourceRef": {
                    "type": "string",
                    "pattern": "^sources/.+/source\\.md$"
                  },
                  "sourceDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "parseStatus": {
                    "enum": [
                      "complete",
                      "degraded",
                      "unsupported_opaque"
                    ]
                  },
                  "dialect": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dialectVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "capabilities": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "title",
                        "heading",
                        "paragraph",
                        "list",
                        "table_logical_grid",
                        "footnote",
                        "media_order"
                      ]
                    }
                  },
                  "sourceCounts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title",
                      "heading",
                      "paragraph",
                      "list",
                      "tableLogicalCell",
                      "footnote",
                      "media"
                    ],
                    "properties": {
                      "title": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "heading": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "paragraph": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "list": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "tableLogicalCell": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "footnote": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "media": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "draftCounts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title",
                      "heading",
                      "paragraph",
                      "list",
                      "tableLogicalCell",
                      "footnote",
                      "media"
                    ],
                    "properties": {
                      "title": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "heading": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "paragraph": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "list": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "tableLogicalCell": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "footnote": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "media": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "sourceSequenceDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "draftSequenceDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            },
            "homepageFidelity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "headingTree",
                "paragraphOrder",
                "links",
                "nestedLists",
                "tableLogicalGrid",
                "footnotes",
                "mediaCaptionOrder"
              ],
              "properties": {
                "title": {
                  "type": "boolean"
                },
                "tableLogicalGrid": {
                  "type": "boolean"
                },
                "footnotes": {
                  "type": "boolean"
                },
                "headingTree": {
                  "type": "boolean"
                },
                "paragraphOrder": {
                  "type": "boolean"
                },
                "links": {
                  "type": "boolean"
                },
                "nestedLists": {
                  "type": "boolean"
                },
                "mediaCaptionOrder": {
                  "type": "boolean"
                }
              }
            },
            "articleIntent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "independent",
                "intent",
                "rationale"
              ],
              "properties": {
                "independent": {
                  "type": "boolean"
                },
                "intent": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "enum": [
                      "SEMANTIC_PARSE_INCOMPLETE",
                      "SEMANTIC_COVERAGE_GAP",
                      "STRUCTURE_ORDER_DRIFT",
                      "HOMEPAGE_FIDELITY_LOSS",
                      "CARRIER_MISMATCH",
                      "ARTICLE_INTENT_NOT_INDEPENDENT"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "protocol": {
          "$ref": "../content/semantic_disposition.schema.json#/$defs/protocolTriplet"
        },
        "objectRevision": {
          "$ref": "../content/semantic_disposition.schema.json#/$defs/objectTuple"
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../content/semantic_disposition.schema.json#/$defs/disposition"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "semanticReport"
            ]
          }
        }
      ]
    },
    "typedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
