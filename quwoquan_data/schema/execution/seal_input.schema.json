{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/seal_input.schema.json",
  "description": "AI 提交给 task seal 的最小输入：真实 actor 与业务 verdict；机械校验由 seal 自己执行。5.review 另带一份 execution 级 reviews（targetRef → 判断字段），由 seal 扇出为逐对象 content_review.json。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "verdict"
  ],
  "properties": {
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "verdict": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "typedIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typedIssue"
      }
    },
    "reviews": {
      "description": "仅 5.review 使用：键为 targetRef，值为 reviewer 的判断字段；机械字段由 seal 补齐。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/reviewJudgement"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "typedIssues"
        ],
        "properties": {
          "typedIssues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "modelFamily",
        "sessionId",
        "invocation"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "runId"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reviewJudgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blockingIssues",
        "advisories"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "blockingIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safety": {
          "enum": [
            "ok",
            "concern"
          ]
        },
        "assetRights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetRef"
            ],
            "properties": {
              "assetRef": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "typedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
