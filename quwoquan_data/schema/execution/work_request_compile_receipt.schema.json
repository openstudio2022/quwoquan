{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/work_request_compile_receipt.schema.json",
  "type": "object",
  "required": [
    "schema", "workRequestId", "workRequestRef", "workRequestDigest",
    "requestDigest", "correlationId", "outcome", "carrierPolicyRef", "carrierPolicyDigest",
    "rootExecutionId", "sourceRevision", "sourceDigest", "entityCatalogDigest",
    "dependencySetDigest", "sourcePoolPlanRef", "sourcePoolPlanDigest", "carrierEnvelopes",
    "activeCarrierCount", "artifactCount", "totalBytes", "durationMs", "compiledAt", "receiptDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.work_request_compile_receipt"},
    "workRequestId": {"type": "string", "pattern": "^wr-[0-9a-f]{24}$"},
    "workRequestRef": {"type": "string", "minLength": 1},
    "workRequestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "correlationId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outcome": {"const": "confirmed"},
    "carrierPolicyRef": {"type": "string", "minLength": 1},
    "carrierPolicyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rootExecutionId": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dependencySetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourcePoolPlanRef": {"type": "string", "minLength": 1},
    "sourcePoolPlanDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "carrierEnvelopes": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"$ref": "work_request.schema.json#/$defs/envelopeRef"}
    },
    "activeCarrierCount": {"type": "integer", "minimum": 1, "maximum": 4},
    "artifactCount": {"type": "integer", "minimum": 3, "maximum": 6},
    "totalBytes": {"type": "integer", "minimum": 1},
    "durationMs": {"type": "integer", "minimum": 0},
    "compiledAt": {"type": "string", "format": "date-time"},
    "receiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
