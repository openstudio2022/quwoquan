{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Execution-owned source qualification outcome. Every target is confirmed or blocked from object-local source evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "executionId", "policyRevision", "verifiedAt", "passed", "targets", "issues"],
  "properties": {
    "contractVersion": {"const": "execution-source-qualification-v1"},
    "executionId": {"type": "string", "minLength": 1},
    "policyRevision": {"const": "encyclopedia-primary-v2"},
    "verifiedAt": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "sourceCatalogRef", "primarySource"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed", "blocked"]},
          "sourceCatalogRef": {"type": "string"},
          "primarySource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceKind": {"type": "string"},
              "canonicalUrl": {"type": "string"},
              "extractor": {"type": "string"},
              "snapshotHash": {"type": "string"},
              "evidenceRef": {"type": "string"}
            },
            "required": ["sourceKind", "canonicalUrl", "extractor", "snapshotHash", "evidenceRef"]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataIssue"}
    }
  },
  "$defs": {
    "dataIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "ref", "lane", "recovery", "message", "attrs"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "stage": {"const": "source_gate"},
        "ref": {"type": "string"},
        "lane": {"const": "homepage"},
        "recovery": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "attrs": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
