{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_copy_ready_receipt.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "rootExecutionId",
    "activeCarriers",
    "workloads",
    "campaignPlanDigest",
    "gitBranch",
    "gitCommitSha",
    "sourceDigest",
    "entityCatalogDigest",
    "minimums",
    "totalDiscardedCount",
    "lanes",
    "assessedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.content_copy_ready_receipt" },
    "status": { "const": "copy_ready" },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "activeCarriers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["homepage", "article", "image", "video"] }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "integer", "minimum": 1 },
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      }
    },
    "campaignPlanDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitBranch": { "type": "string", "minLength": 1 },
    "gitCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "entityCatalogDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assessmentRef": { "type": "string", "minLength": 1 },
    "minimums": {
      "type": "object",
      "required": ["qualifiedPerLane"],
      "additionalProperties": false,
      "properties": {
        "qualifiedPerLane": { "const": 1 }
      }
    },
    "totalDiscardedCount": { "type": "integer", "minimum": 0 },
    "lanes": {
      "description": "只覆盖 activeCarriers 声明的车道；键集合与 activeCarriers 的一致性由 writer fail-closed 断言。",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": { "$ref": "#/$defs/lane" },
        "article": { "$ref": "#/$defs/lane" },
        "image": { "$ref": "#/$defs/lane" },
        "video": { "$ref": "#/$defs/lane" }
      }
    },
    "assessedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "required": [
        "executionId",
        "requestedQuota",
        "requestedCount",
        "selectedCount",
        "qualifiedCount",
        "discardedCount",
        "finalizedCount",
        "shortfallCount",
        "quotaAttainmentRate",
        "reviewReceiptRef",
        "publishReceiptRef"
      ],
      "additionalProperties": false,
      "properties": {
        "executionId": { "type": "string", "minLength": 1 },
        "requestedQuota": { "type": "integer", "minimum": 1 },
        "requestedCount": { "type": "integer", "minimum": 1 },
        "selectedCount": { "type": "integer", "minimum": 0 },
        "qualifiedCount": { "type": "integer", "minimum": 0 },
        "discardedCount": { "type": "integer", "minimum": 0 },
        "finalizedCount": { "type": "integer", "minimum": 0 },
        "shortfallCount": { "type": "integer", "minimum": 0 },
        "quotaAttainmentRate": { "type": "number", "minimum": 0 },
        "reviewReceiptRef": { "type": "string", "minLength": 1 },
        "publishReceiptRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
