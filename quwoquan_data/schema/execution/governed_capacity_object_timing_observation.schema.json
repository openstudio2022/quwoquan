{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/governed_capacity_object_timing_observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceDigest", "executionId", "sampleCount",
    "p95Seconds", "maxSeconds", "samples", "snapshotDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.governed_capacity_object_timing_observation"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executionId": {"type": "string", "minLength": 1},
    "sampleCount": {"type": "integer", "minimum": 1},
    "p95Seconds": {"type": "number", "exclusiveMinimum": 0},
    "maxSeconds": {"type": "number", "exclusiveMinimum": 0},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "durationSeconds"],
        "properties": {
          "runId": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "snapshotDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
