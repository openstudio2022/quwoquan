{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/pool_delivery_drain_result.schema.json",
  "title": "Pool delivery-only recovery result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "executionId", "recoveryMode", "executionStatePreserved",
    "status", "attemptedCount", "completedCount", "qualifiedCount",
    "discardedCount", "total", "appendedCount", "replayedCount",
    "pendingCount", "excludedCount", "blockedCount", "poolDelta",
    "batchInputDigest", "recordSetDigest", "objectResults", "intentIds",
    "canonicalObjects", "issueCodes", "nextAction", "reentryRef"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.pool_delivery_drain_result"},
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "recoveryMode": {
      "enum": [
        "frozen_publish_jobs",
        "reviewed_delivery_only",
        "campaign_reviewed_publish"
      ]
    },
    "executionStatePreserved": {"const": true},
    "status": {"enum": ["waiting", "blocked", "completed"]},
    "attemptedCount": {"type": "integer", "minimum": 0},
    "completedCount": {"type": "integer", "minimum": 0},
    "qualifiedCount": {"type": "integer", "minimum": 0},
    "discardedCount": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "appendedCount": {"type": "integer", "minimum": 0},
    "replayedCount": {"type": "integer", "minimum": 0},
    "pendingCount": {"type": "integer", "minimum": 0},
    "excludedCount": {"type": "integer", "minimum": 0},
    "blockedCount": {"type": "integer", "minimum": 0},
    "poolDelta": {"type": "integer", "minimum": 0},
    "batchInputDigest": {"$ref": "#/$defs/digest"},
    "recordSetDigest": {"$ref": "#/$defs/digest"},
    "objectResults": {
      "type": "array",
      "items": {"$ref": "#/$defs/objectResult"}
    },
    "intentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "canonicalObjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/canonicalObject"}
    },
    "issueCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nextAction": {"$ref": "recovery_next_action.schema.json"},
    "reentryRef": {"$ref": "#/$defs/reentryRef"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "pendingCount": {"const": 0},
          "blockedCount": {"const": 0},
          "nextAction": {"const": "none"}
        }
      },
      "else": {
        "properties": {"nextAction": {"not": {"const": "none"}}}
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reentryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "batchInputDigest", "intentIds"],
      "properties": {
        "executionId": {"type": "string", "minLength": 1},
        "batchInputDigest": {"$ref": "#/$defs/digest"},
        "intentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "poolRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordRef", "recordSha256", "contentVersion", "recordSequence",
        "payloadDigest"
      ],
      "properties": {
        "recordRef": {"type": "string", "minLength": 1},
        "recordSha256": {"$ref": "#/$defs/digest"},
        "contentVersion": {"type": "integer", "minimum": 1},
        "recordSequence": {"type": "integer", "minimum": 1},
        "payloadDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "objectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectRef", "intentId", "transactionInputDigest", "result",
        "canonicalObject", "issueCodes", "nextAction", "reentryRef"
      ],
      "properties": {
        "objectRef": {"type": "string", "minLength": 1},
        "intentId": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "transactionInputDigest": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "result": {
          "enum": ["appended", "replayed", "pending", "excluded", "blocked"]
        },
        "canonicalObject": {
          "oneOf": [{"$ref": "#/$defs/canonicalObject"}, {"type": "null"}]
        },
        "issueCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "nextAction": {"$ref": "recovery_next_action.schema.json"},
        "reentryRef": {
          "oneOf": [{"$ref": "#/$defs/reentryRef"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"result": {"enum": ["appended", "replayed"]}},
            "required": ["result"]
          },
          "then": {
            "properties": {
              "canonicalObject": {"$ref": "#/$defs/canonicalObject"},
              "issueCodes": {"maxItems": 0},
              "nextAction": {"const": "none"},
              "reentryRef": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "canonicalObject": {"type": "null"},
              "nextAction": {"not": {"const": "none"}},
              "reentryRef": {"$ref": "#/$defs/reentryRef"}
            }
          }
        }
      ]
    },
    "canonicalObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId", "applyReportRef", "canonicalObjectRef",
        "canonicalObjectSha256", "objectClosureDigest", "admissionResult"
      ],
      "properties": {
        "transactionId": {"type": "string", "minLength": 1},
        "applyReportRef": {"type": "string", "minLength": 1},
        "canonicalObjectRef": {"type": "string", "pattern": "^(entities|posts)/"},
        "canonicalObjectSha256": {"$ref": "#/$defs/digest"},
        "objectClosureDigest": {"type": "string"},
        "admissionResult": {"enum": ["appended", "replayed"]},
        "poolRecord": {"$ref": "#/$defs/poolRecord"}
      }
    }
  }
}
