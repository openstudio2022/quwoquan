{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/target_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "carrier",
    "selectionPolicy",
    "entityCatalogDigest",
    "candidateBinding",
    "targetCount",
    "targetRefs",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.target_set"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "carrier": {
      "enum": [
        "homepage",
        "article",
        "image",
        "video"
      ]
    },
    "selectionPolicy": {
      "const": "frozen"
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest",
        "candidateCount"
      ],
      "properties": {
        "scope": {
          "const": "output"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "targetCount": {
      "type": "integer",
      "minimum": 1
    },
    "targetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:entities/[^/]+/[^/]+/[^/]+|posts/(?:article|image|video)/[^/]+/[^/]+/[1-9][0-9]*)$"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "name",
        "entityType"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "entityType": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "region": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "geoTagRef": {
          "type": "string"
        },
        "geoTagRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typeTagRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishAngle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "publishTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "publishSeq": {
          "type": "integer",
          "minimum": 1
        },
        "qualifiedHomepageSource": {
          "type": "object",
          "required": [
            "provider",
            "title",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "wikipedia",
                "baidu_baike",
                "toutiao_baike"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
