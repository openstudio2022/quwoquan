{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/target_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "carrier",
    "selectionPolicy",
    "entityCatalogDigest",
    "candidateBinding",
    "targetCount",
    "targetRefs",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.target_set"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "carrier": {
      "enum": [
        "homepage",
        "article",
        "image",
        "video"
      ]
    },
    "selectionPolicy": {
      "const": "frozen"
    },
    "entityCatalogDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest",
        "candidateCount"
      ],
      "properties": {
        "scope": {
          "const": "output"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "targetCount": {
      "type": "integer",
      "minimum": 1
    },
    "targetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:entities/[^/]+/[^/]+/[^/]+|posts/(?:article|image|video)/[^/]+/[^/]+/[1-9][0-9]*)$"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "entityRef": {
      "description": "调用方显式指定的稳定 opaque 实体引用；homepage 与 post 绑定同一实体时原样使用同值，不按名称、行政区或当前发布目录推导。",
      "type": "string",
      "pattern": "^/entity/(?!/)(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])\\S(?:.*[^/\\s])?$"
    },
    "entityId": {
      "description": "调用方显式指定的稳定实体业务 ID，init 原样冻结，不由 entityRef、execution 或物理目录重新生成。",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])\\S(?:.*\\S)?$"
    },
    "target": {
      "type": "object",
      "required": [
        "name",
        "entityType",
        "entityRef",
        "entityId"
      ],
      "additionalProperties": false,
      "properties": {
        "entityRef": {
          "$ref": "#/$defs/entityRef"
        },
        "entityId": {
          "$ref": "#/$defs/entityId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "entityType": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "region": {
          "type": "string"
        },
        "publishAngle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "publishTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "publishSeq": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "carrier": {
            "const": "homepage"
          }
        },
        "required": [
          "carrier"
        ]
      },
      "then": {
        "properties": {
          "targets": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "publishAngle"
                    ]
                  },
                  {
                    "required": [
                      "publishTitle"
                    ]
                  },
                  {
                    "required": [
                      "publishSeq"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "targets": {
            "items": {
              "required": [
                "publishAngle",
                "publishTitle",
                "publishSeq"
              ]
            }
          }
        }
      }
    }
  ]
}
