{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Immutable predecessor review feedback consumed by one retryOf execution. Qualified predecessor objects are never included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "retryOf",
    "failedObjectRefs",
    "items",
    "feedbackDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.retry_review_feedback"},
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "retryOf": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "failedObjectRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predecessorObjectRef",
          "entityRef",
          "targetName",
          "decision",
          "issues",
          "findings",
          "evidenceKind",
          "evidenceRef",
          "evidenceSha256",
          "responseDigest",
          "reviewer"
        ],
        "properties": {
          "predecessorObjectRef": {"type": "string", "minLength": 1},
          "entityRef": {"type": "string", "pattern": "^/entity/[^/]+/[^/]+/[^/]+$"},
          "targetName": {"type": "string", "minLength": 1},
          "decision": {"enum": ["revision_needed", "rejected"]},
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "findings": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidenceKind": {
            "enum": [
              "final_reviewer_result",
              "interrupted_review_reconciliation"
            ]
          },
          "evidenceRef": {"type": "string", "minLength": 1},
          "evidenceSha256": {"$ref": "#/$defs/sha256"},
          "responseDigest": {"$ref": "#/$defs/sha256"},
          "reviewer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "model", "modelFamily", "runId"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "modelFamily": {"type": "string", "minLength": 1},
              "runId": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "feedbackDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
