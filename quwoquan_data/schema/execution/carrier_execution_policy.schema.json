{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/carrier_execution_policy.schema.json",
  "type": "object",
  "required": ["schema", "carriers"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.carrier_execution_policy"},
    "carriers": {
      "type": "object",
      "required": ["homepage", "article", "image", "video"],
      "additionalProperties": false,
      "properties": {
        "homepage": {"$ref": "#/$defs/carrier"},
        "article": {"$ref": "#/$defs/carrier"},
        "image": {"$ref": "#/$defs/carrier"},
        "video": {"$ref": "#/$defs/carrier"}
      }
    }
  },
  "$defs": {
    "carrier": {
      "type": "object",
      "required": ["operation", "defaultSelector", "operatorPrompt"],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "homepage.generate",
            "article.generate",
            "image.generate",
            "video.generate"
          ]
        },
        "defaultSelector": {"enum": ["priority", "source-ready-priority"]},
        "operatorPrompt": {
          "type": "object",
          "required": ["ref", "text"],
          "additionalProperties": false,
          "properties": {
            "ref": {"type": "string", "pattern": "^campaign/carrier-execution/[a-z]+$"},
            "text": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
