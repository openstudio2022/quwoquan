{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "item"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan.data_content_worker_request"
    },
    "item": {
      "type": "object",
      "required": [
        "runtimeTaskId",
        "jobId",
        "executionId",
        "ref",
        "stage",
        "partitionKey",
        "entityRef",
        "carrier",
        "sourceRevision",
        "idempotencyKey",
        "jobSetEnvelopeDigest",
        "jobSetDigest",
        "actualTaskDigest",
        "maxAttempts"
      ],
      "additionalProperties": false,
      "properties": {
        "runtimeTaskId": {"type": "string", "minLength": 1},
        "jobId": {"type": "string", "minLength": 1},
        "executionId": {
          "type": "string",
          "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
        },
        "ref": {"type": "string", "minLength": 1},
        "stage": {"enum": ["download", "author", "publish"]},
        "partitionKey": {"type": "string", "minLength": 1},
        "entityRef": {"type": "string", "minLength": 1},
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "idempotencyKey": {"type": "string", "minLength": 5},
        "jobSetEnvelopeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "jobSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "actualTaskDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "maxAttempts": {"type": "integer", "minimum": 1},
        "workerHostSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workerHostGeneration": {"type": "integer", "minimum": 1},
        "workerFencingToken": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workerHostScopeId": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"anyOf": [
          {"required": ["workerHostSetDigest"]},
          {"required": ["workerHostGeneration"]},
          {"required": ["workerFencingToken"]},
          {"required": ["workerHostScopeId"]}
        ]},
        "then": {"required": [
          "workerHostSetDigest",
          "workerHostGeneration",
          "workerFencingToken",
          "workerHostScopeId"
        ]}
      }]
    }
  }
}
