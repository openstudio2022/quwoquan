{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/public_cli_live_import_zero_receipt.schema.json",
  "title": "Canonical public CLI live-import-zero receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceFingerprint",
    "command",
    "exitCode",
    "verdict",
    "capturedOutput",
    "probeDigest",
    "checkedCommands",
    "discoveredCommands",
    "forbiddenPrefixes",
    "importedModules",
    "loadedModules",
    "loadedModulesDigest",
    "receiptId",
    "forbiddenLoadedModules"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.public_cli_live_import_zero_receipt"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "entrypoint",
        "arguments"
      ],
      "properties": {
        "commandId": {
          "const": "data.public_cli.live_import_zero"
        },
        "entrypoint": {
          "const": "quwoquan_data/scripts/cli.py"
        },
        "arguments": {
          "const": [
            "governance",
            "public-cli-live-import-zero"
          ]
        }
      }
    },
    "exitCode": {
      "const": 0
    },
    "verdict": {
      "const": "pass"
    },
    "capturedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdoutDigest",
        "stderrDigest"
      ],
      "properties": {
        "stdoutDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stderrDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "probeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkedCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discoveredCommands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forbiddenPrefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "importedModules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "loadedModules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "loadedModulesDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "forbiddenLoadedModules": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
