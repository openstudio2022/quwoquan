{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "policy": {
      "type": "object",
      "properties": {
        "semanticAgent": {
          "type": "object",
          "properties": {
            "runtime": { "enum": ["local", "cloud"] },
            "fallbackPolicy": { "const": "forbidden" },
            "author": { "$ref": "#/$defs/semanticBinding" },
            "reviewer": { "$ref": "#/$defs/semanticBinding" },
            "calibration": {
              "type": "object",
              "properties": {
                "provider": { "enum": ["cursor_sdk", "codex_sdk"] },
                "model": { "type": "string", "minLength": 1 },
                "modelParameters": { "$ref": "#/$defs/modelParameters" },
                "sampleRate": { "const": 0.1 },
                "minimumSampleCount": { "const": 10 },
                "smallBatchPolicy": { "const": "all" }
              },
              "required": [
                "provider", "model", "modelParameters", "sampleRate",
                "minimumSampleCount", "smallBatchPolicy"
              ],
              "additionalProperties": false
            },
            "explicitSelections": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/explicitSemanticSelection" },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "selectionId": { "const": "cursor_grok" },
                      "provider": { "const": "cursor_sdk" },
                      "runtime": { "const": "local" },
                      "requiresNewRetryOf": { "const": false }
                    },
                    "required": [
                      "selectionId", "provider", "model", "modelParameters",
                      "runtime", "requiresNewRetryOf"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "selectionId": { "const": "cursor_auto" },
                      "provider": { "const": "cursor_sdk" },
                      "model": { "const": "auto" },
                      "modelParameters": { "const": [] },
                      "runtime": { "const": "local" },
                      "requiresNewRetryOf": { "const": true }
                    },
                    "required": [
                      "selectionId", "provider", "model", "modelParameters",
                      "runtime", "requiresNewRetryOf"
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "runtime", "fallbackPolicy", "author", "reviewer",
            "calibration", "explicitSelections"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "oversampleFactor": { "type": "number", "minimum": 1 },
            "quotaPursuit": {
              "type": "object",
              "properties": {
                "replenishFactor": { "type": "number", "minimum": 1 },
                "maxRounds": { "type": "integer", "minimum": 1 },
                "stallRounds": { "type": "integer", "minimum": 1 }
              },
              "required": ["replenishFactor", "maxRounds", "stallRounds"],
              "additionalProperties": false
            }
          },
          "required": ["oversampleFactor", "quotaPursuit"],
          "additionalProperties": false
        },
        "runtimeEvidence": {
          "type": "object",
          "properties": {
            "processInspectionTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "queueFaultEventTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "semanticPreflightReceiptTtlSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "processInspectionTimeoutSeconds",
            "queueFaultEventTimeoutSeconds",
            "semanticPreflightReceiptTtlSeconds"
          ],
          "additionalProperties": false
        },
        "budgets": {
          "type": "object",
          "properties": {
            "startupTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "campaignSubmissionTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "preflightNetworkTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "agentTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "authRetryLimit": { "type": "integer", "minimum": 1 },
            "authRetryDelaySeconds": { "type": "integer", "minimum": 1 },
            "noProgressRoundLimit": { "type": "integer", "minimum": 1 },
            "sourcePlanRecoveryPasses": { "type": "integer", "minimum": 0 },
            "managedFutureGraceSeconds": { "type": "integer", "minimum": 1 },
            "schedulerStaleSeconds": { "type": "integer", "minimum": 1 },
            "controllerLeaseStaleSeconds": { "type": "integer", "minimum": 1 },
            "assignmentDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "downloadFetchRetryLimit": { "type": "integer", "minimum": 0 },
            "bridgeLaunchCooldownSeconds": { "type": "number", "minimum": 0 },
            "bridgeReadyDelaySeconds": { "type": "number", "minimum": 0 },
            "reactRewindLimit": { "type": "integer", "minimum": 1 },
            "preflightStartupAttempts": { "type": "integer", "minimum": 1 },
            "preflightRetryDelaySeconds": { "type": "number", "exclusiveMinimum": 0 },
            "cursorWarmAttempts": { "type": "integer", "minimum": 1 },
            "cursorBridgeMaxRetries": { "type": "integer", "minimum": 1 },
            "managedCheckpointRefLimit": { "type": "integer", "minimum": 0 },
            "cursorBridgeHandshakeTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "pageImageFetchMaxAttempts": { "type": "integer", "minimum": 1 },
            "pageImageFetchRetryBackoffSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "pageImageDownloadTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "downloadTextTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "downloadBytesTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "stageNoProgressTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "networkBreakerThreshold": { "type": "integer", "minimum": 1 },
            "localProcessProbeTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "processTerminationTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "agentFuturePollTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "apiRequestTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "directFetchTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "sourceFetchTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "sourceVideoReadTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "sourceFetchMaxRetries": { "type": "integer", "minimum": 1 },
            "ocrTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "videoProbeTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "videoTranscodeTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "mediawikiFallbackRetries": { "type": "integer", "minimum": 1 },
            "mediawikiWikitextMaxRetries": { "type": "integer", "minimum": 1 },
            "mediawikiInterRequestDelaySeconds": { "type": "number", "minimum": 0 },
            "queueLeaseTtlSeconds": { "type": "integer", "minimum": 1 },
            "queueHeartbeatSeconds": { "type": "integer", "minimum": 1 },
            "queueMaxAttempts": { "type": "integer", "minimum": 1 },
            "queueMaxStartupFailures": { "type": "integer", "minimum": 1 },
            "queueMaxWallClockSeconds": { "type": "integer", "minimum": 1 },
            "queueBackoffBaseSeconds": { "type": "integer", "minimum": 1 },
            "queueBackoffCapSeconds": { "type": "integer", "minimum": 1 },
            "queueStuckThreshold": { "type": "integer", "minimum": 1 },
            "startupProbeSuiteAttempts": { "type": "integer", "minimum": 1 },
            "cursorStartupProbeCacheTtlSeconds": { "type": "integer", "minimum": 0 },
            "cursorTrue5xxRateLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "cursorStartupTimeoutRateLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "coverageWikiRetryLimit": { "type": "integer", "minimum": 1 },
            "coverageWikiRetryBackoffSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "coverageWikiInterRequestDelaySeconds": { "type": "number", "minimum": 0 },
            "coverageOverpassRetryLimit": { "type": "integer", "minimum": 1 },
            "coverageOverpassRetryBackoffSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "coverageOverpassInterRequestDelaySeconds": { "type": "number", "minimum": 0 },
            "coverageOverpassQueryTimeoutSeconds": { "type": "integer", "minimum": 1 }
          },
          "required": [
            "startupTimeoutSeconds", "campaignSubmissionTimeoutSeconds",
            "preflightNetworkTimeoutSeconds",
            "agentTimeoutSeconds", "authRetryLimit",
            "authRetryDelaySeconds", "noProgressRoundLimit",
            "sourcePlanRecoveryPasses",
            "managedFutureGraceSeconds", "schedulerStaleSeconds",
            "controllerLeaseStaleSeconds", "assignmentDeadlineSeconds",
            "downloadFetchRetryLimit", "bridgeLaunchCooldownSeconds",
            "bridgeReadyDelaySeconds", "reactRewindLimit",
            "preflightStartupAttempts",
            "preflightRetryDelaySeconds", "cursorWarmAttempts", "cursorBridgeMaxRetries",
            "managedCheckpointRefLimit", "cursorBridgeHandshakeTimeoutSeconds",
            "pageImageFetchMaxAttempts", "pageImageFetchRetryBackoffSeconds",
            "pageImageDownloadTimeoutSeconds", "downloadTextTimeoutSeconds",
            "downloadBytesTimeoutSeconds", "stageNoProgressTimeoutSeconds",
            "networkBreakerThreshold",
            "localProcessProbeTimeoutSeconds", "processTerminationTimeoutSeconds",
            "agentFuturePollTimeoutSeconds", "apiRequestTimeoutSeconds",
            "directFetchTimeoutSeconds",
            "sourceFetchTimeoutSeconds", "sourceVideoReadTimeoutSeconds",
            "sourceFetchMaxRetries", "ocrTimeoutSeconds",
            "videoProbeTimeoutSeconds", "videoTranscodeTimeoutSeconds",
            "mediawikiFallbackRetries", "mediawikiWikitextMaxRetries",
            "mediawikiInterRequestDelaySeconds", "queueLeaseTtlSeconds",
            "queueHeartbeatSeconds", "queueMaxAttempts", "queueMaxStartupFailures",
            "queueMaxWallClockSeconds", "queueBackoffBaseSeconds",
            "queueBackoffCapSeconds", "queueStuckThreshold",
            "startupProbeSuiteAttempts", "cursorStartupProbeCacheTtlSeconds", "cursorTrue5xxRateLimit",
            "cursorStartupTimeoutRateLimit", "coverageWikiRetryLimit",
            "coverageWikiRetryBackoffSeconds", "coverageWikiInterRequestDelaySeconds",
            "coverageOverpassRetryLimit", "coverageOverpassRetryBackoffSeconds",
            "coverageOverpassInterRequestDelaySeconds", "coverageOverpassQueryTimeoutSeconds"
          ],
          "additionalProperties": false
        },
        "coverageDiscovery": {
          "type": "object",
          "properties": {
            "saturationThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "saturationRounds": { "type": "integer", "minimum": 1 },
            "maxPagesPerCell": { "type": "integer", "minimum": 1 },
            "maxCandidatesPerCitySource": { "type": "integer", "minimum": 1 },
            "maxNewPerCell": { "type": "integer", "minimum": 1 },
            "requestBudget": { "type": "integer", "minimum": 1 },
            "maxTotalCandidates": { "type": "integer", "minimum": 0 },
            "requiredEmptyPages": { "type": "integer", "minimum": 1 },
            "requestTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "rateLimitPerSecond": { "type": "number", "exclusiveMinimum": 0 },
            "wikiCategoryDepth": { "type": "integer", "minimum": 0 },
            "retryBackoffMultiplier": { "type": "number", "exclusiveMinimum": 1 },
            "wikidataSparqlEndpoint": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "wikidataResultLimit": { "type": "integer", "minimum": 1 },
            "overpassResultLimit": { "type": "integer", "minimum": 1 },
            "overpassEndpoints": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          },
          "required": [
            "saturationThreshold", "saturationRounds", "maxPagesPerCell",
            "maxCandidatesPerCitySource", "maxNewPerCell", "requestBudget",
            "maxTotalCandidates", "requiredEmptyPages", "requestTimeoutSeconds",
            "rateLimitPerSecond", "wikiCategoryDepth", "retryBackoffMultiplier",
            "wikidataSparqlEndpoint", "wikidataResultLimit",
            "overpassResultLimit", "overpassEndpoints"
          ],
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "curlRetries": { "type": "integer", "minimum": 1 },
            "curlRetryDelaySeconds": { "type": "integer", "minimum": 1 },
            "providerTimeoutSeconds": {
              "type": "object",
              "properties": {
                "encyclopedia": { "type": "integer", "minimum": 1 },
                "mediawiki": { "type": "integer", "minimum": 1 },
                "qunar": { "type": "integer", "minimum": 1 },
                "openverse": { "type": "integer", "minimum": 1 },
                "overpass": { "type": "integer", "minimum": 1 }
              },
              "required": ["encyclopedia", "mediawiki", "qunar", "openverse", "overpass"],
              "additionalProperties": false
            }
          },
          "required": ["curlRetries", "curlRetryDelaySeconds", "providerTimeoutSeconds"],
          "additionalProperties": false
        }
      },
      "required": ["semanticAgent", "selection", "runtimeEvidence", "budgets", "coverageDiscovery", "network"],
      "additionalProperties": false
    }
  },
  "required": ["profileId", "policy"],
  "additionalProperties": false,
  "$defs": {
    "modelParameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticBinding": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["cursor_sdk", "codex_sdk"] },
        "model": { "type": "string", "minLength": 1 },
        "modelParameters": { "$ref": "#/$defs/modelParameters" }
      },
      "required": ["provider", "model", "modelParameters"],
      "additionalProperties": false
    },
    "explicitSemanticSelection": {
      "type": "object",
      "properties": {
        "selectionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "provider": { "enum": ["cursor_sdk", "codex_sdk"] },
        "model": { "type": "string", "minLength": 1 },
        "modelParameters": { "$ref": "#/$defs/modelParameters" },
        "runtime": { "enum": ["local", "cloud"] },
        "requiresNewRetryOf": { "type": "boolean" }
      },
      "required": [
        "selectionId", "provider", "model", "modelParameters",
        "runtime", "requiresNewRetryOf"
      ],
      "additionalProperties": false
    }
  }
}
