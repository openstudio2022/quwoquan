{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/semantic_task_journal_attempt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workUnitId",
    "requestDigest",
    "attempt",
    "recordedAt",
    "started",
    "status",
    "provider",
    "runId",
    "agentId",
    "requestId",
    "durationMs",
    "resultSha256",
    "failureKind",
    "messageSha256",
    "errorCode",
    "retryable",
    "retryAfterSeconds",
    "attempts",
    "warmAttempts",
    "attemptDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.semantic_task_journal_attempt"},
    "workUnitId": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "requestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "recordedAt": {"type": "string", "format": "date-time"},
    "started": {"type": "boolean"},
    "status": {"enum": ["finished", "error"]},
    "provider": {"enum": ["cursor_sdk", "codex_sdk"]},
    "runId": {"type": "string"},
    "agentId": {"type": "string"},
    "requestId": {"type": "string"},
    "durationMs": {"type": "integer", "minimum": 0},
    "resultSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "failureKind": {"type": "string"},
    "messageSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "errorCode": {"type": "string"},
    "retryable": {"type": "boolean"},
    "retryAfterSeconds": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "warmAttempts": {"type": "integer", "minimum": 0},
    "attemptDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
