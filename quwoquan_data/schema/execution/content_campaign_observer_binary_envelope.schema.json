{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Campaign Observer Binary Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rootExecutionId",
    "planDigest",
    "observerSourceDigest",
    "observerBinaryRef",
    "observerBinarySha256",
    "observerBuildAttestationDigest",
    "envelopeDigest"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.content_campaign_observer_binary_envelope"
    },
    "rootExecutionId": {
      "type": "string",
      "minLength": 1
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observerSourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observerBinaryRef": {
      "type": "string",
      "pattern": "^data/local/cache/reliabletask-observer-binaries/[0-9a-f]{64}/data-content-worker$"
    },
    "observerBinarySha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observerBuildAttestationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "envelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
