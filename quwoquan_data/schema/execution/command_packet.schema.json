{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/command_packet.schema.json",
  "title": "Command packet (标准命令 packet)",
  "description": "命令 packet 唯一字段定义（写入口 core/command_packet.write_packet）。每个 stage/命令的输入输出、停机条件与交接对象必须走本契约。",
  "type": "object",
  "required": [
    "schemaVersion",
    "executionId",
    "command",
    "objectKind",
    "objectRef",
    "stage",
    "readPolicy",
    "stopIf",
    "outputPolicy",
    "inputs",
    "outputs",
    "handoffTo",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "quwoquan.data.packet" },
    "executionId": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "objectKind": { "type": "string", "minLength": 1 },
    "objectRef": { "type": "string" },
    "stage": { "type": "string", "minLength": 1 },
    "readPolicy": { "type": "array", "items": { "type": "string" } },
    "stopIf": { "type": "array", "items": { "type": "string" } },
    "outputPolicy": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "object" },
    "outputs": { "type": "object" },
    "handoffTo": { "type": "string" },
    "evidence": { "type": "object" },
    "summary": { "type": "object" }
  }
}
