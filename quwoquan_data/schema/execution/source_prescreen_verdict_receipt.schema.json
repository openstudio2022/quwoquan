{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/source_prescreen_verdict_receipt.schema.json",
  "title": "Create-once source prescreen verdict receipt",
  "description": "一次预筛（含其全部补采轮次）的实体级终态，create-once 写入该 execution 的工作包，写入时点严格早于 execution spec 冻结。这是预筛失败的唯一呈现面：spec 不冻结时它仍在原路径可读，lane 终态为 published 或 partial 时同样可读，进程退出码与异常字符串不承载原因。lane 回执与 campaign report 只以 ref + digest 指向本回执并投影四类计数，不复制 verdict 行。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "executionId",
    "carrier",
    "calibrationReceiptDigest",
    "prescreenedAt",
    "verdicts",
    "primaryReasonCounts"
  ],
  "properties": {
    "schemaRef": {
      "type": "string",
      "const": "quwoquan_data/schema/execution/source_prescreen_verdict_receipt.schema.json"
    },
    "executionId": {
      "type": "string",
      "minLength": 1,
      "description": "与 execution spec 同一身份。spec 可以尚未存在，身份先于它成立。"
    },
    "carrier": {
      "type": "string",
      "enum": ["article", "homepage"],
      "description": "本次预筛所属载体。video 按 acquisition receipt 的 exact pair 查表且不探测网络，不产出本回执。"
    },
    "calibrationReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "本次预筛所用阈值与探测预算的来源回执摘要。阈值只能来自受治理标定，指不回一份 receipt 的 verdict 不成立。"
    },
    "prescreenedAt": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "description": "候选全集逐实体一行。出局实体也在其中——它们的首要原因正是要被量化的那部分，冻结集合里反而没有它们。",
      "items": {"$ref": "#/$defs/entityVerdict"}
    },
    "primaryReasonCounts": {"$ref": "#/$defs/primaryReasonCounts"}
  },
  "$defs": {
    "entityVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityName", "state", "recovery"],
      "description": "一个实体的终态。state 是一个字段的四个值而不是几个布尔的组合，subReason 按 state 条件必填，resumeRefs 与 settledEvidence 互斥。",
      "properties": {
        "entityName": {"type": "string", "minLength": 1},
        "state": {
          "type": "string",
          "enum": [
            "present_usable",
            "present_insufficient",
            "absent",
            "probe_failed"
          ]
        },
        "subReason": {
          "type": "string",
          "enum": [
            "length_below_threshold",
            "not_this_entity",
            "not_legally_retrievable",
            "no_candidate",
            "probe_interrupted",
            "unclassified_rejection"
          ]
        },
        "recovery": {
          "type": "string",
          "enum": [
            "resume_probe",
            "widen_source_closure",
            "adjust_length_threshold_or_swap_entity",
            "swap_entity",
            "none"
          ],
          "description": "运营者据此决定续跑、修来源闭集还是换实体。present_usable 取 none，其余三态必须给出一个可执行方向。"
        },
        "resumeRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "只有 probe_failed 携带。lane 已发布也不得删除——该实体的判定从未完成，refs 是它唯一的重入口。"
        },
        "settledEvidence": {
          "type": "string",
          "minLength": 1,
          "description": "只有 present_insufficient 与 absent 携带：它们不可续跑，取而代之给出判定所依据的事实。"
        },
        "detail": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "present_usable"}}},
          "then": {
            "not": {"required": ["subReason"]},
            "properties": {"recovery": {"const": "none"}}
          },
          "else": {"required": ["subReason"]}
        },
        {
          "if": {"properties": {"state": {"const": "probe_failed"}}},
          "then": {
            "required": ["resumeRefs"],
            "not": {"required": ["settledEvidence"]}
          },
          "else": {"not": {"required": ["resumeRefs"]}}
        },
        {
          "if": {
            "properties": {
              "state": {"enum": ["present_insufficient", "absent"]}
            },
            "required": ["state"]
          },
          "then": {"required": ["settledEvidence"]}
        }
      ]
    },
    "primaryReasonCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usable",
        "noRetrievableSource",
        "bodyBelowThreshold",
        "notThisEntity",
        "undetermined"
      ],
      "description": "实体级四类计量加可用数。undetermined 单独计量而不并入其余三类的分子分母——把未完成折进已判定的类，会让供给命中率读起来像测出来的，其实有一部分从未得出结论。五个计数之和等于 verdicts 长度。",
      "properties": {
        "usable": {"type": "integer", "minimum": 0},
        "noRetrievableSource": {"type": "integer", "minimum": 0},
        "bodyBelowThreshold": {"type": "integer", "minimum": 0},
        "notThisEntity": {"type": "integer", "minimum": 0},
        "undetermined": {"type": "integer", "minimum": 0}
      }
    }
  }
}
