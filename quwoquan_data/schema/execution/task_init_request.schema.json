{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/task_init_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "carrier",
    "familyRef",
    "quota",
    "candidateCount",
    "carrierDemand",
    "immutableCandidateBindings",
    "submittedInputs",
    "retryOf"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.task_init_request"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "carrier": {
      "enum": [
        "homepage",
        "article",
        "image",
        "video"
      ]
    },
    "familyRef": {
      "type": "string",
      "minLength": 1
    },
    "quota": {
      "type": "integer",
      "minimum": 1
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 1
    },
    "carrierDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "const": "output"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "immutableCandidateBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ref",
        "digest"
      ],
      "properties": {
        "scope": {
          "const": "output"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "retryOf": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executionId",
            "terminalReceipt"
          ],
          "properties": {
            "executionId": {
              "type": "string",
              "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
            },
            "terminalReceipt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "ref",
                "digest"
              ],
              "properties": {
                "scope": {
                  "const": "output"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      ]
    },
    "submittedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrierDemand",
        "immutableCandidateBindings"
      ],
      "properties": {
        "carrierDemand": {
          "$ref": "carrier_demand.schema.json"
        },
        "immutableCandidateBindings": {
          "$ref": "immutable_candidate_bindings.schema.json"
        }
      }
    }
  }
}
