{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "execution 工作包内的可恢复进度。",
  "type": "object",
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object"
    },
    "anglesByEntity": {
      "type": "object"
    },
    "openGaps": {
      "type": "array"
    },
    "counts": {
      "type": "object"
    },
    "lastRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": "quwoquan.content.execution_progress"
    }
  },
  "required": [
    "schema",
    "executionId",
    "updatedAt",
    "coverage",
    "anglesByEntity",
    "openGaps",
    "counts",
    "lastRunId"
  ],
  "additionalProperties": false
}
