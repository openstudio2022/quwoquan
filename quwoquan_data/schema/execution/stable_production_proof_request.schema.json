{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stable_production_proof_request.schema.json",
  "title": "Explicit three-unit stable production proof request",
  "description": "Caller-selected exact evidence for exactly three independent four-carrier M1 proof units on the current operational fingerprint. No latest discovery or proof production is permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fingerprint",
    "proofUnits"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stable_production_proof_request"
    },
    "artifactRoot": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "proofUnits": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/proofUnit"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "exactByteDigest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "exactByteDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "retryRecovery": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retryOf",
            "executionManifest",
            "executionState"
          ],
          "properties": {
            "retryOf": {
              "type": "string",
              "minLength": 1
            },
            "executionManifest": {
              "$ref": "#/$defs/exactRef"
            },
            "executionState": {
              "$ref": "#/$defs/exactRef"
            }
          }
        }
      ]
    },
    "carrierExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "carrierDemand",
        "candidateBindings",
        "taskInitRequest",
        "executionManifest",
        "targetSet",
        "stageReceipts",
        "executionState",
        "canonicalPublish",
        "poolDeliveryResult",
        "retryRecovery"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "carrierDemand": {
          "$ref": "#/$defs/exactRef"
        },
        "candidateBindings": {
          "$ref": "#/$defs/exactRef"
        },
        "taskInitRequest": {
          "$ref": "#/$defs/exactRef"
        },
        "executionManifest": {
          "$ref": "#/$defs/exactRef"
        },
        "targetSet": {
          "$ref": "#/$defs/exactRef"
        },
        "stageReceipts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/exactRef"
          }
        },
        "executionState": {
          "$ref": "#/$defs/exactRef"
        },
        "canonicalPublish": {
          "$ref": "#/$defs/exactRef"
        },
        "poolDeliveryResult": {
          "$ref": "#/$defs/exactRef"
        },
        "retryRecovery": {
          "$ref": "#/$defs/retryRecovery"
        }
      }
    },
    "carrierExecutions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "properties": {
        "homepage": {
          "$ref": "#/$defs/carrierExecution"
        },
        "article": {
          "$ref": "#/$defs/carrierExecution"
        },
        "image": {
          "$ref": "#/$defs/carrierExecution"
        },
        "video": {
          "$ref": "#/$defs/carrierExecution"
        }
      }
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "attestation",
        "desiredState",
        "samplePlan"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/exactRef"
        },
        "attestation": {
          "$ref": "#/$defs/exactRef"
        },
        "desiredState": {
          "$ref": "#/$defs/exactRef"
        },
        "samplePlan": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "proofUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "fingerprint",
        "carrierExecutions",
        "release",
        "environment",
        "environmentAcceptanceFact"
      ],
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "carrierExecutions": {
          "$ref": "#/$defs/carrierExecutions"
        },
        "release": {
          "$ref": "#/$defs/releaseEvidence"
        },
        "environment": {
          "enum": [
            "alpha",
            "beta",
            "gamma"
          ]
        },
        "environmentAcceptanceFact": {
          "$ref": "#/$defs/exactRef"
        }
      }
    }
  }
}
