{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/runtime_provider_fault_test_hook_attestation.schema.json",
  "title": "Explicit governed provider fault test-hook attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "rootExecutionId", "runId", "generation", "fencingToken",
    "providerBindings", "issuedAt", "expiresAt", "attestationDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.runtime_provider_fault_test_hook_attestation"},
    "rootExecutionId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "fencingToken": {"$ref": "#/$defs/digest"},
    "providerBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["faultType", "providerId", "configurationDigest"],
        "properties": {
          "faultType": {"enum": ["provider_timeout", "provider_rate_limit"]},
          "providerId": {"type": "string", "minLength": 1},
          "configurationDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "issuedAt": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string", "minLength": 1},
    "attestationDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
