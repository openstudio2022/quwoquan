{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/governed_worker_host_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hostSetId", "generation", "previousHostSetDigest", "fencingToken", "sourceRevision", "sourceDigest", "entityCatalogDigest", "transportBinding", "hosts", "availableSlots", "hostSetDigest"],
  "properties": {
    "schema": {"const": "quwoquan_data.governed_worker_host_set"},
    "hostSetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "generation": {"type": "integer", "minimum": 1},
    "previousHostSetDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "fencingToken": {"$ref": "#/$defs/digest"},
    "sourceRevision": {"$ref": "#/$defs/digest"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "entityCatalogDigest": {"$ref": "#/$defs/digest"},
    "transportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mongoTransportDigest", "redisTransportDigest"],
      "properties": {
        "mongoTransportDigest": {"$ref": "#/$defs/digest"},
        "redisTransportDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "hosts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/host"}
    },
    "availableSlots": {"type": "integer", "minimum": 1},
    "hostSetDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["receiptId", "selectionDigest", "provider", "model", "runtimeProfileDigest", "validUntil", "effectiveConcurrency"],
      "properties": {
        "receiptId": {"$ref": "#/$defs/digest"},
        "selectionDigest": {"$ref": "#/$defs/digest"},
        "provider": {"const": "cursor_sdk"},
        "model": {"type": "string", "minLength": 1},
        "runtimeProfileDigest": {"$ref": "#/$defs/digest"},
        "validUntil": {"type": "string", "format": "date-time"},
        "effectiveConcurrency": {"type": "integer", "minimum": 1}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["hostScopeId", "preflight", "executorBundleRef", "executorBundleDigest", "executorBundleFileSha256", "sourceCapsuleId", "sourceCapsuleDigest", "mongoTransportDigest", "redisTransportDigest"],
      "properties": {
        "hostScopeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "preflight": {"$ref": "#/$defs/preflight"},
        "executorBundleRef": {"type": "string", "minLength": 1},
        "executorBundleDigest": {"$ref": "#/$defs/digest"},
        "executorBundleFileSha256": {"$ref": "#/$defs/digest"},
        "sourceCapsuleId": {"type": "string", "minLength": 1},
        "sourceCapsuleDigest": {"$ref": "#/$defs/digest"},
        "mongoTransportDigest": {"$ref": "#/$defs/digest"},
        "redisTransportDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
