{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/pool_delivery_version_reservation.schema.json",
  "type": "object",
  "required": [
    "schema",
    "reservationId",
    "executionId",
    "carrier",
    "objectRef",
    "contentObjectDir",
    "canonicalRef",
    "contentId",
    "version",
    "sourceManifestSha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.pool_delivery_version_reservation"},
    "reservationId": {"$ref": "#/$defs/digest"},
    "executionId": {"type": "string", "minLength": 1},
    "carrier": {"enum": ["article", "image", "video"]},
    "objectRef": {"type": "string", "minLength": 1},
    "contentObjectDir": {"type": "string", "minLength": 1},
    "canonicalRef": {"type": "string", "minLength": 1},
    "contentId": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "sourceManifestSha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
