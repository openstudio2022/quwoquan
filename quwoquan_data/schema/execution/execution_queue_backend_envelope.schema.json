{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/execution_queue_backend_envelope.schema.json",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "campaignScale",
    "scaleClass",
    "approvedQuota",
    "queueBackend",
    "poolDeliveryBackend",
    "queuePolicyDigest",
    "executionManifestDigest",
    "sourceDigest",
    "targetSetDigest",
    "envelopeDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.execution_queue_backend_envelope"},
    "executionId": {"type": "string", "minLength": 1},
    "campaignScale": {"type": "string", "pattern": "^M[1-9][0-9]{0,5}$"},
    "scaleClass": {"enum": ["BELOW_M100", "M100_PLUS", "M10000_PLUS"]},
    "approvedQuota": {"type": "integer", "minimum": 1},
    "queueBackend": {"enum": ["local_file", "reliabletask"]},
    "poolDeliveryBackend": {"const": "reliabletask"},
    "queuePolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceDigest": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "targetSetDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
