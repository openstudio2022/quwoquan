{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/quota_pursuit_ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "plan",
    "rounds",
    "producedCount",
    "remainingDeficit"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.quota_pursuit_ledger"},
    "executionId": {"type": "string", "minLength": 1},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedQuota",
        "initialPool",
        "frozenTargetCeiling",
        "replenishFactor",
        "maxRounds",
        "stallRounds"
      ],
      "properties": {
        "approvedQuota": {"type": "integer", "minimum": 1},
        "initialPool": {"type": "integer", "minimum": 1},
        "frozenTargetCeiling": {"type": "integer", "minimum": 1},
        "replenishFactor": {"type": "number", "minimum": 1},
        "maxRounds": {"type": "integer", "minimum": 1},
        "stallRounds": {"type": "integer", "minimum": 1}
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "requestedPool",
          "drawnCount",
          "qualifiedCount",
          "producedCount"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "requestedPool": {"type": "integer", "minimum": 0},
          "drawnCount": {"type": "integer", "minimum": 0},
          "qualifiedCount": {"type": "integer", "minimum": 0},
          "producedCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "producedCount": {"type": "integer", "minimum": 0},
    "remainingDeficit": {"type": "integer", "minimum": 0}
  }
}
