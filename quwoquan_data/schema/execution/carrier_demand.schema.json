{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/carrier_demand.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "executionId",
    "carrier",
    "familyRef",
    "quota",
    "retryOf"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.carrier_demand"
    },
    "status": {
      "const": "confirmed"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "carrier": {
      "enum": [
        "homepage",
        "article",
        "image",
        "video"
      ]
    },
    "familyRef": {
      "type": "string",
      "minLength": 1
    },
    "quota": {
      "type": "integer",
      "minimum": 1
    },
    "retryOf": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
