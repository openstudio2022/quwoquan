{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "可复用内容运行配方。执行身份与范围由 CLI 注入，不进入 recipe；recipeId 必须等于 families/ 下去 `.recipe.yaml` 后缀的相对路径。",
  "type": "object",
  "properties": {
    "recipeId": {
      "type": "string",
      "description": "家族包内引用路径，如 content/travel/homepage/h100"
    },
    "title": {
      "type": "string"
    },
    "presetRef": {
      "type": "string",
      "description": "本配方必须绑定的内容 preset"
    },
    "runtimeProfile": {
      "type": "string",
      "description": "control_plane/_shared/<id>.runtime.yaml 运行环境 profile"
    },
    "selection": {
      "type": "object",
      "description": "可复用目标选择策略；省市、实体与 executionId 只由运行参数注入。",
      "properties": {
        "category": {
          "type": "string"
        },
        "entityArticlesPerTarget": {
          "type": "integer",
          "minimum": 0
        },
        "entityHomepagesPerTarget": {
          "type": "integer",
          "minimum": 0
        },
        "imageWorksPerTarget": {
          "type": "integer",
          "minimum": 0
        },
        "videoWorksPerTarget": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "description": "运行前契约门（不满足即 BLOCK，不静默降级）。executionBranch 已废止：分支由 quwoquan_ops/policies/branch_policy.yaml 治理，recipe 不得绑定 Git 分支。",
      "properties": {
        "requireActiveStatus": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelFamily": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "composer",
            "gemini",
            "gpt",
            "grok"
          ]
        },
        "modelParameters": {
          "$ref": "#/$defs/modelParameters"
        },
        "reviewModel": {
          "type": "string",
          "minLength": 1
        },
        "reviewModelFamily": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "composer",
            "gemini",
            "gpt",
            "grok"
          ]
        },
        "reviewModelParameters": {
          "$ref": "#/$defs/modelParameters"
        }
      },
      "required": [
        "model",
        "modelFamily",
        "modelParameters",
        "reviewModel",
        "reviewModelFamily",
        "reviewModelParameters"
      ],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "description": "运行后放量验收（execution audit + sdk monitoring + scale readiness）",
      "properties": {
        "minPassRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mode": {
          "type": "string"
        },
        "failOnNoGo": {
          "type": "boolean"
        },
        "requireReviewed": {
          "type": "boolean",
          "description": "要求 execution-readiness 只接受独立审阅闭包的对象"
        }
      },
      "additionalProperties": false
    },
    "env": false,
    "schema": {
      "const": "quwoquan.content.recipe"
    }
  },
  "required": [
    "schema",
    "recipeId",
    "title",
    "presetRef",
    "selection",
    "execution"
  ],
  "additionalProperties": false,
  "$defs": {
    "modelParameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
