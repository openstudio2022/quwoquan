{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/data_content_fleet_request.schema.json",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "scaleClass",
    "executionEnvelopeDigest",
    "requireCommercial",
    "recoverDeadTasks",
    "objectTimeoutMilliseconds",
    "requiredQuota",
    "jobs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan.data_content_fleet_request"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "scaleClass": {
      "enum": ["BELOW_M100", "M100_PLUS"]
    },
    "executionEnvelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requireCommercial": {
      "type": "boolean"
    },
    "recoverDeadTasks": {
      "type": "boolean"
    },
    "objectTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1
    },
    "requiredQuota": {
      "type": "integer",
      "minimum": 1
    },
    "campaignBinding": {
      "$ref": "#/$defs/campaignBinding"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entityRef",
          "carrier",
          "sourceRevision",
          "idempotencyKey",
          "jobId",
          "executionId",
          "ref",
          "stage",
          "partitionKey"
        ],
        "additionalProperties": false,
        "properties": {
          "entityRef": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "description": "Must equal the contentType parsed from this job's immutable executionId.",
            "enum": [
              "homepage",
              "article",
              "image",
              "video"
            ]
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "author",
              "publish"
            ]
          },
          "partitionKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "campaignBinding": {
      "type": "object",
      "required": [
        "rootExecutionId",
        "campaignRunId",
        "campaignGeneration",
        "campaignFencingToken",
        "campaignPlanDigest",
        "campaignSourceRevision",
        "campaignSourceDigest",
        "campaignEntityCatalogDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "rootExecutionId": {"type": "string", "minLength": 1},
        "campaignRunId": {"type": "string", "minLength": 1},
        "campaignGeneration": {"type": "integer", "minimum": 1},
        "campaignFencingToken": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignPlanDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignSourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignSourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignEntityCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
