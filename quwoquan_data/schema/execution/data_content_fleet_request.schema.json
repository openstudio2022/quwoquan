{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/data_content_fleet_request.schema.json",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "requireCommercial",
    "recoverDeadTasks",
    "jobs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan.data_content_fleet_request"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(canary|m1|m2|m3|h10k)-[0-9]{3,}$"
    },
    "requireCommercial": {
      "type": "boolean"
    },
    "recoverDeadTasks": {
      "type": "boolean"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entityRef",
          "carrier",
          "sourceRevision",
          "idempotencyKey",
          "jobId",
          "executionId",
          "ref",
          "stage",
          "partitionKey"
        ],
        "additionalProperties": false,
        "properties": {
          "entityRef": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "enum": [
              "homepage",
              "article",
              "image",
              "video"
            ]
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "author",
              "publish"
            ]
          },
          "partitionKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
