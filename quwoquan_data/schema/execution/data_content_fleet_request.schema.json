{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/data_content_fleet_request.schema.json",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "campaignScale",
    "scaleClass",
    "executionEnvelopeDigest",
    "jobSetEnvelopeDigest",
    "jobSetDigest",
    "actualTaskDigest",
    "requiredWorkers",
    "partitionCount",
    "partitionAlgorithm",
    "checkpointPolicy",
    "requireCommercial",
    "recoverDeadTasks",
    "objectTimeoutMilliseconds",
    "globalRequiredQuota",
    "requiredQuota",
    "jobs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quwoquan.data_content_fleet_request"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "campaignScale": {
      "type": "string",
      "pattern": "^M[1-9][0-9]{0,5}$"
    },
    "scaleClass": {
      "enum": ["BELOW_M100", "M100_PLUS", "M10000_PLUS"]
    },
    "executionEnvelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jobSetEnvelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jobSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actualTaskDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requiredWorkers": {
      "type": "integer",
      "minimum": 1
    },
    "partitionCount": {
      "enum": [16, 32, 64, 128, 256]
    },
    "partitionAlgorithm": {
      "const": "sha256_carrier_object_ref_mod_v1"
    },
    "checkpointPolicy": {
      "$ref": "#/$defs/checkpointPolicy"
    },
    "requireCommercial": {
      "type": "boolean"
    },
    "recoverDeadTasks": {
      "type": "boolean"
    },
    "objectTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1
    },
    "requiredQuota": {
      "type": "integer",
      "minimum": 1
    },
    "globalRequiredQuota": {
      "type": "integer",
      "minimum": 1
    },
    "campaignBinding": {
      "$ref": "#/$defs/campaignBinding"
    },
    "workerHostBinding": {
      "$ref": "#/$defs/workerHostBinding"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entityRef",
          "carrier",
          "sourceRevision",
          "idempotencyKey",
          "jobId",
          "executionId",
          "ref",
          "stage",
          "partitionKey",
          "maxAttempts"
        ],
        "additionalProperties": false,
        "properties": {
          "entityRef": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "description": "Must equal the contentType parsed from this job's immutable executionId.",
            "enum": [
              "homepage",
              "article",
              "image",
              "video"
            ]
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "author",
              "publish"
            ]
          },
          "partitionKey": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,2})$"
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "checkpointPolicy": {
      "type": "object",
      "required": ["mode", "scope", "cursor", "resume", "store", "fencing", "everyFinalizedObjects", "everySeconds", "triggerMode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "partition_watermark"},
        "scope": {"const": "execution_stage_partition"},
        "cursor": {"const": "last_succeeded_job_id"},
        "resume": {"const": "strictly_after_cursor"},
        "store": {"const": "MongoStore"},
        "fencing": {"const": "execution_job_set_digest"},
        "everyFinalizedObjects": {"const": 100},
        "everySeconds": {"const": 900},
        "triggerMode": {"const": "first_reached"}
      }
    },
    "campaignBinding": {
      "type": "object",
      "required": [
        "rootExecutionId",
        "campaignRunId",
        "campaignGeneration",
        "campaignFencingToken",
        "campaignPlanDigest",
        "campaignSourceRevision",
        "campaignSourceDigest",
        "campaignEntityCatalogDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "rootExecutionId": {"type": "string", "minLength": 1},
        "campaignRunId": {"type": "string", "minLength": 1},
        "campaignGeneration": {"type": "integer", "minimum": 1},
        "campaignFencingToken": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignPlanDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignSourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignSourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignEntityCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "workerHostBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["hostSetId", "generation", "fencingToken", "hostSetDigest", "transportBinding", "hostScopeId", "workerCount", "partitionKeys", "runtimeProfileDigest", "executorBundleRef", "executorBundleDigest", "executorBundleFileSha256", "sourceCapsuleId", "sourceCapsuleDigest"],
      "properties": {
        "hostSetId": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1},
        "fencingToken": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hostSetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "transportBinding": {
          "type": "object", "additionalProperties": false,
          "required": ["mongoTransportDigest", "redisTransportDigest"],
          "properties": {
            "mongoTransportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "redisTransportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "hostScopeId": {"type": "string", "minLength": 1},
        "workerCount": {"type": "integer", "minimum": 1},
        "partitionKeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$"}},
        "runtimeProfileDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "executorBundleRef": {"type": "string", "minLength": 1},
        "executorBundleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "executorBundleFileSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceCapsuleId": {"type": "string", "minLength": 1},
        "sourceCapsuleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
