{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/data_content_fleet_request.schema.json",
  "type": "object",
  "required": [
    "schema",
    "executionId",
    "campaignScale",
    "scaleClass",
    "executionEnvelopeDigest",
    "jobSetEnvelopeDigest",
    "jobSetDigest",
    "actualTaskDigest",
    "capacityPlanDigest",
    "calibrationReceiptDigest",
    "targetObjectCount",
    "fleetMaxConcurrentWorkers",
    "fleetWaveCount",
    "fleetBatchDeadlineEpochSeconds",
    "partitionCount",
    "partitionAlgorithm",
    "checkpointPolicy",
    "recoverDeadTasks",
    "objectTimeoutMilliseconds",
    "globalRequiredQuota",
    "requiredQuota",
    "jobs"
  ],
  "additionalProperties": false,
  "$comment": "The allOf bands below are the single declared source of truth for the ReliableTask partition topology. partitionCount is the smallest governed power of two covering the frozen work-unit count, floored at 16 and capped at 256. targetObjectCount is that frozen work-unit count, so it is the only admitted input; jobs carries the same set and its length must agree with it. Implementations: quwoquan_data/scripts/content/execution/queue/partition.py#partition_count and quwoquan_service/services/content-service/internal/content/post/application/importer/data_fleet.go#dataContentPartitionCount; both are pinned to these bands by local_contract tests.",
  "allOf": [
    {
      "if": {"required": ["targetObjectCount"], "properties": {"targetObjectCount": {"minimum": 1, "maximum": 16}}},
      "then": {"properties": {"partitionCount": {"const": 16}}}
    },
    {
      "if": {"required": ["targetObjectCount"], "properties": {"targetObjectCount": {"minimum": 17, "maximum": 32}}},
      "then": {"properties": {"partitionCount": {"const": 32}}}
    },
    {
      "if": {"required": ["targetObjectCount"], "properties": {"targetObjectCount": {"minimum": 33, "maximum": 64}}},
      "then": {"properties": {"partitionCount": {"const": 64}}}
    },
    {
      "if": {"required": ["targetObjectCount"], "properties": {"targetObjectCount": {"minimum": 65, "maximum": 128}}},
      "then": {"properties": {"partitionCount": {"const": 128}}}
    },
    {
      "if": {"required": ["targetObjectCount"], "properties": {"targetObjectCount": {"minimum": 129}}},
      "then": {"properties": {"partitionCount": {"const": 256}}}
    }
  ],
  "properties": {
    "schema": {
      "const": "quwoquan.data_content_fleet_request"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "campaignScale": {
      "type": "string",
      "pattern": "^M[1-9][0-9]{0,5}$"
    },
    "scaleClass": {
      "enum": ["BELOW_M100", "M100_PLUS", "M10000_PLUS"]
    },
    "executionEnvelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jobSetEnvelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jobSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actualTaskDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capacityPlanDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "冻结 job set 所依据的容量计划摘要，与 reliabletask_job_set_envelope 的同名字段一致。"
    },
    "calibrationReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "并行上限与批次截止的唯一合法来源，即 create-once capacity calibration receipt 的摘要。runtime profile、环境变量、命令行默认值与探针观测都不是合法来源。"
    },
    "targetObjectCount": {
      "type": "integer",
      "minimum": 1,
      "description": "本次冻结的工作单元数，也是派生 job 数与分区拓扑的唯一输入。它不承载对象下限（requiredQuota）也不承载并行上限（fleetMaxConcurrentWorkers）。"
    },
    "fleetMaxConcurrentWorkers": {
      "type": "integer",
      "minimum": 1,
      "description": "交付阶段任一时刻可同时运行的 worker 进程上限，只能由 immutable execution policy 冻结。规模增长只增加 wave 数，不增加该上限；它不得由工作单元数或 quota 派生。"
    },
    "fleetWaveCount": {
      "type": "integer",
      "minimum": 1,
      "description": "ceil(targetObjectCount / fleetMaxConcurrentWorkers)，与 quota 无关。冻结值与运行回执必须一致。"
    },
    "fleetBatchDeadlineEpochSeconds": {
      "type": "integer",
      "minimum": 1,
      "description": "批次时间预算的绝对纪元秒。进程重启、lease 续租与子进程重建只能注入 max(0, 本值 - 当前时间)，不得重新注入完整批次预算；需要更多时间只能由新的 retryOf 冻结新的绝对截止。"
    },
    "partitionCount": {
      "description": "Hash topology of the frozen job set, derived by the governed bands in this schema's allOf. Partitions isolate queue and checkpoint state; they are not worker capacity, so fleetMaxConcurrentWorkers and any per-worker resource ratio must never appear in this derivation.",
      "enum": [16, 32, 64, 128, 256]
    },
    "partitionAlgorithm": {
      "const": "sha256_carrier_object_ref_mod_v1"
    },
    "checkpointPolicy": {
      "$ref": "#/$defs/checkpointPolicy"
    },
    "recoverDeadTasks": {
      "type": "boolean"
    },
    "objectTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1
    },
    "requiredQuota": {
      "type": "integer",
      "minimum": 1
    },
    "globalRequiredQuota": {
      "type": "integer",
      "minimum": 1
    },
    "campaignBinding": {
      "$ref": "#/$defs/campaignBinding"
    },
    "workerHostBinding": {
      "$ref": "#/$defs/workerHostBinding"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entityRef",
          "carrier",
          "sourceRevision",
          "idempotencyKey",
          "jobId",
          "executionId",
          "ref",
          "stage",
          "partitionKey",
          "maxAttempts"
        ],
        "additionalProperties": false,
        "properties": {
          "entityRef": {
            "type": "string",
            "minLength": 1
          },
          "carrier": {
            "description": "Must equal the contentType parsed from this job's immutable executionId.",
            "enum": [
              "homepage",
              "article",
              "image",
              "video"
            ]
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "author",
              "publish"
            ]
          },
          "partitionKey": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,2})$"
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "checkpointPolicy": {
      "type": "object",
      "required": ["mode", "scope", "cursor", "resume", "store", "fencing", "everyFinalizedObjects", "everySeconds", "triggerMode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "partition_watermark"},
        "scope": {"const": "execution_stage_partition"},
        "cursor": {"const": "last_succeeded_job_id"},
        "resume": {"const": "strictly_after_cursor"},
        "store": {"const": "MongoStore"},
        "fencing": {"const": "execution_job_set_digest"},
        "everyFinalizedObjects": {"const": 100},
        "everySeconds": {"const": 900},
        "triggerMode": {"const": "first_reached"}
      }
    },
    "campaignBinding": {
      "type": "object",
      "required": [
        "rootExecutionId",
        "campaignRunId",
        "campaignGeneration",
        "campaignFencingToken",
        "campaignPlanDigest",
        "campaignSourceRevision",
        "campaignSourceDigest",
        "campaignEntityCatalogDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "rootExecutionId": {"type": "string", "minLength": 1},
        "campaignRunId": {"type": "string", "minLength": 1},
        "campaignGeneration": {"type": "integer", "minimum": 1},
        "campaignFencingToken": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignPlanDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignSourceRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignSourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "campaignEntityCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "workerHostBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["hostSetId", "generation", "fencingToken", "hostSetDigest", "transportBinding", "hostScopeId", "workerCount", "partitionKeys", "runtimeProfileDigest", "executorBundleRef", "executorBundleDigest", "executorBundleFileSha256", "sourceCapsuleId", "sourceCapsuleDigest"],
      "properties": {
        "hostSetId": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1},
        "fencingToken": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hostSetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "transportBinding": {
          "type": "object", "additionalProperties": false,
          "required": ["mongoTransportDigest", "redisTransportDigest"],
          "properties": {
            "mongoTransportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "redisTransportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "hostScopeId": {"type": "string", "minLength": 1},
        "workerCount": {"type": "integer", "minimum": 1},
        "partitionKeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$"}},
        "runtimeProfileDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "executorBundleRef": {"type": "string", "minLength": 1},
        "executorBundleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "executorBundleFileSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceCapsuleId": {"type": "string", "minLength": 1},
        "sourceCapsuleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
