{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/scale_source_pool_selection.schema.json",
  "type": "object",
  "required": ["carrier", "candidateIds", "candidateCount", "selectionDigest"],
  "additionalProperties": false,
  "properties": {
    "carrier": {"enum": ["homepage", "article", "image", "video"]},
    "candidateIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidateCount": {"type": "integer", "minimum": 1},
    "selectionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
