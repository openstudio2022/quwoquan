{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/stable_production_proof_set.schema.json",
  "title": "OPEN-006 one-unit pre-delete stable production proof projection",
  "description": "Pure read-only deterministic projection over caller-selected exact proof evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specRef",
    "openItemRef",
    "expectedFingerprint",
    "evidenceAuthority",
    "proofUnitCount",
    "unitIds",
    "releaseIds",
    "executionIds",
    "executionCount",
    "verifyAllReceipt",
    "publicCliLiveImportZeroReceipt",
    "carrierCountsPerUnit",
    "proofUnits",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.stable_production_proof_set"
    },
    "specRef": {
      "const": "specs/feature-tree/discovery-content/object-homepage-coverage-scaling/multi-carrier-release/spec.md#gwt-034"
    },
    "openItemRef": {
      "const": "specs/feature-tree/discovery-content/object-homepage-coverage-scaling/multi-carrier-release/spec.md#open-006"
    },
    "expectedFingerprint": {
      "$ref": "#/$defs/digest"
    },
    "proofUnitCount": {
      "const": 1
    },
    "unitIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "releaseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionCount": {
      "const": 4
    },
    "verifyAllReceipt": {
      "$ref": "#/$defs/exactRef"
    },
    "publicCliLiveImportZeroReceipt": {
      "$ref": "#/$defs/exactRef"
    },
    "carrierCountsPerUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "properties": {
        "homepage": {
          "const": 1
        },
        "article": {
          "const": 1
        },
        "image": {
          "const": 1
        },
        "video": {
          "const": 1
        }
      }
    },
    "proofUnits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/proofUnit"
      }
    },
    "verdict": {
      "const": "pass"
    },
    "evidenceAuthority": {
      "enum": [
        "canonical_runtime",
        "test_only"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "exactByteDigest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "exactByteDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "rawResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "exactByteDigest",
        "entrySurface",
        "carrier",
        "specRef"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "exactByteDigest": {
          "$ref": "#/$defs/digest"
        },
        "entrySurface": {
          "enum": [
            "feed",
            "search",
            "recommendation",
            "direct_or_object_route"
          ]
        },
        "carrier": {
          "enum": [
            "homepage",
            "article",
            "image",
            "video"
          ]
        },
        "specRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "carrierExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId",
        "carrier",
        "carrierDemand",
        "candidateBindings",
        "taskInitRequest",
        "executionManifest",
        "targetSet",
        "stageReceipts",
        "executionState",
        "canonicalPublish",
        "poolDeliveryResult",
        "objectTransactionPackage",
        "applyReport",
        "poolRecord"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "enum": [
            "homepage",
            "article",
            "image",
            "video"
          ]
        },
        "carrierDemand": {
          "$ref": "#/$defs/exactRef"
        },
        "candidateBindings": {
          "$ref": "#/$defs/exactRef"
        },
        "taskInitRequest": {
          "$ref": "#/$defs/exactRef"
        },
        "executionManifest": {
          "$ref": "#/$defs/exactRef"
        },
        "targetSet": {
          "$ref": "#/$defs/exactRef"
        },
        "executionState": {
          "$ref": "#/$defs/exactRef"
        },
        "canonicalPublish": {
          "$ref": "#/$defs/exactRef"
        },
        "poolDeliveryResult": {
          "$ref": "#/$defs/exactRef"
        },
        "stageReceipts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/exactRef"
          }
        },
        "objectTransactionPackage": {
          "$ref": "#/$defs/exactRef"
        },
        "applyReport": {
          "$ref": "#/$defs/exactRef"
        },
        "poolRecord": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "carrierExecutions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homepage",
        "article",
        "image",
        "video"
      ],
      "properties": {
        "homepage": {
          "$ref": "#/$defs/carrierExecution"
        },
        "article": {
          "$ref": "#/$defs/carrierExecution"
        },
        "image": {
          "$ref": "#/$defs/carrierExecution"
        },
        "video": {
          "$ref": "#/$defs/carrierExecution"
        }
      }
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "releaseDigest",
        "header",
        "attestation",
        "desiredState",
        "samplePlan"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1
        },
        "releaseDigest": {
          "$ref": "#/$defs/digest"
        },
        "header": {
          "$ref": "#/$defs/exactRef"
        },
        "attestation": {
          "$ref": "#/$defs/exactRef"
        },
        "desiredState": {
          "$ref": "#/$defs/exactRef"
        },
        "samplePlan": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "environmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation",
        "import",
        "readback",
        "lifecycle",
        "rollback",
        "apiConsumerRawResults"
      ],
      "properties": {
        "activation": {
          "$ref": "#/$defs/exactRef"
        },
        "import": {
          "$ref": "#/$defs/exactRef"
        },
        "readback": {
          "$ref": "#/$defs/exactRef"
        },
        "lifecycle": {
          "$ref": "#/$defs/exactRef"
        },
        "rollback": {
          "$ref": "#/$defs/exactRef"
        },
        "apiConsumerRawResults": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/rawResult"
          }
        }
      }
    },
    "proofUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "fingerprint",
        "evidenceAuthority",
        "carrierCounts",
        "carrierExecutions",
        "release",
        "environment",
        "environmentAcceptanceFact",
        "environmentEvidence"
      ],
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "carrierCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "homepage",
            "article",
            "image",
            "video"
          ],
          "properties": {
            "homepage": {
              "const": 1
            },
            "article": {
              "const": 1
            },
            "image": {
              "const": 1
            },
            "video": {
              "const": 1
            }
          }
        },
        "carrierExecutions": {
          "$ref": "#/$defs/carrierExecutions"
        },
        "release": {
          "$ref": "#/$defs/releaseEvidence"
        },
        "environment": {
          "enum": [
            "alpha",
            "beta",
            "gamma"
          ]
        },
        "environmentAcceptanceFact": {
          "$ref": "#/$defs/exactRef"
        },
        "environmentEvidence": {
          "$ref": "#/$defs/environmentEvidence"
        },
        "evidenceAuthority": {
          "enum": [
            "canonical_runtime",
            "test_only"
          ]
        }
      }
    }
  }
}
