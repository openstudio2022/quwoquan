{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/reliabletask_job_set_envelope.schema.json",
  "type": "object",
  "required": [
    "schema",
    "version",
    "executionId",
    "carrier",
    "stage",
    "attemptOrdinal",
    "previousJobSetEnvelopeDigest",
    "queueBackendEnvelopeDigest",
    "executionManifestDigest",
    "sourceDigest",
    "targetSetDigest",
    "requiredWorkers",
    "partitionCount",
    "partitionAlgorithm",
    "checkpointPolicy",
    "expectedTasks",
    "jobSetDigest",
    "envelopeDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.reliabletask_job_set_envelope"},
    "version": {"const": 3},
    "executionId": {"type": "string", "minLength": 1},
    "carrier": {"enum": ["homepage", "article", "image", "video"]},
    "stage": {"enum": ["author", "publish"]},
    "attemptOrdinal": {"type": "integer", "minimum": 1},
    "previousJobSetEnvelopeDigest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "queueBackendEnvelopeDigest": {"$ref": "#/$defs/digest"},
    "executionManifestDigest": {"$ref": "#/$defs/digest"},
    "sourceDigest": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/digest"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "targetSetDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requiredWorkers": {"type": "integer", "minimum": 1},
    "partitionCount": {"enum": [16, 32, 64, 128, 256]},
    "partitionAlgorithm": {"const": "sha256_carrier_object_ref_mod_v1"},
    "checkpointPolicy": {"$ref": "#/$defs/checkpointPolicy"},
    "campaignBinding": {"$ref": "#/$defs/campaignBinding"},
    "expectedTasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expectedTask"}
    },
    "jobSetDigest": {"$ref": "#/$defs/digest"},
    "envelopeDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpointPolicy": {
      "type": "object",
      "required": ["mode", "scope", "cursor", "resume", "store", "fencing", "everyFinalizedObjects", "everySeconds", "triggerMode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "partition_watermark"},
        "scope": {"const": "execution_stage_partition"},
        "cursor": {"const": "last_succeeded_job_id"},
        "resume": {"const": "strictly_after_cursor"},
        "store": {"const": "MongoStore"},
        "fencing": {"const": "execution_job_set_digest"},
        "everyFinalizedObjects": {"const": 100},
        "everySeconds": {"const": 900},
        "triggerMode": {"const": "first_reached"}
      }
    },
    "expectedTask": {
      "type": "object",
      "required": [
        "entityRef",
        "carrier",
        "sourceRevision",
        "idempotencyKey",
        "jobId",
        "executionId",
        "ref",
        "stage",
        "partitionKey"
      ],
      "additionalProperties": false,
      "properties": {
        "entityRef": {"type": "string", "minLength": 1},
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "sourceRevision": {"$ref": "#/$defs/digest"},
        "idempotencyKey": {"type": "string", "minLength": 1},
        "jobId": {"type": "string", "minLength": 1},
        "executionId": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "stage": {"enum": ["author", "publish"]},
        "partitionKey": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$"}
      }
    },
    "campaignBinding": {
      "type": "object",
      "required": [
        "rootExecutionId",
        "campaignRunId",
        "campaignGeneration",
        "campaignFencingToken",
        "campaignPlanDigest",
        "campaignSourceRevision",
        "campaignSourceDigest",
        "campaignEntityCatalogDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "rootExecutionId": {"type": "string", "minLength": 1},
        "campaignRunId": {"type": "string", "minLength": 1},
        "campaignGeneration": {"type": "integer", "minimum": 1},
        "campaignFencingToken": {"$ref": "#/$defs/digest"},
        "campaignPlanDigest": {"$ref": "#/$defs/digest"},
        "campaignSourceRevision": {"$ref": "#/$defs/digest"},
        "campaignSourceDigest": {"$ref": "#/$defs/digest"},
        "campaignEntityCatalogDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
