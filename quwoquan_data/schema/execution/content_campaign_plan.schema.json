{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/content_campaign_plan.schema.json",
  "type": "object",
  "required": [
    "schema",
    "rootExecutionId",
    "workloadMode",
    "activeCarriers",
    "workloads",
    "executionMode",
    "scale",
    "gitBranch",
    "gitCommitSha",
    "sourceRevision",
    "sourceDigest",
    "executionBundle",
    "entityCatalogDigest",
    "semanticSelectionId",
    "laneExternalInputs",
    "externalInputsDigest",
    "submissionDigests",
    "executionIds",
    "frozenAt",
    "planDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quwoquan_data.content_campaign_plan" },
    "workloadMode": { "enum": ["milestone_preset", "explicit"] },
    "activeCarriers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["homepage", "article", "image", "video"] }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "integer", "minimum": 1 },
        "article": { "type": "integer", "minimum": 1 },
        "image": { "type": "integer", "minimum": 1 },
        "video": { "type": "integer", "minimum": 1 }
      }
    },
    "executionAuthority": {
      "$ref": "execution_authority.schema.json"
    },
    "laneRetryUnfinishedRefs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "rootExecutionId": { "type": "string", "minLength": 1 },
    "executionMode": { "enum": ["central", "distributed"] },
    "scale": {"type": "string", "pattern": "^M[1-9][0-9]{0,5}$"},
    "gitBranch": { "type": "string", "minLength": 1 },
    "gitCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "sourceRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "executionBundle": {
      "type": "object",
      "required": ["algorithm", "digest", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "entityCatalogDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semanticSelectionId": {"enum": ["default", "cursor_grok", "cursor_auto", "not_applicable"]},
    "semanticPreflightReceipt": {
      "$ref": "semantic_provider_preflight_receipt_ref.schema.json"
    },
    "scaleSourcePool": {"$ref": "scale_source_pool_binding.schema.json"},
    "sourcePoolEvidenceRootRef": {"type": "string", "minLength": 1},
    "laneSourcePoolSelections": {
      "type": "object",
      "minProperties": 1,
      "$comment": "键集合必须与 activeCarriers 完全一致，由下方 allOf 的逐载体条件断言，不在此静态列举四条车道。",
      "additionalProperties": false,
      "properties": {
        "homepage": {"$ref": "scale_source_pool_selection.schema.json"},
        "article": {"$ref": "scale_source_pool_selection.schema.json"},
        "image": {"$ref": "scale_source_pool_selection.schema.json"},
        "video": {"$ref": "scale_source_pool_selection.schema.json"}
      }
    },
    "laneExternalInputs": {
      "type": "object",
      "minProperties": 1,
      "$comment": "键集合必须与 activeCarriers 完全一致，由下方 allOf 的逐载体条件断言，不在此静态列举四条车道。",
      "additionalProperties": false,
      "properties": {
        "homepage": { "$ref": "#/$defs/laneExternalInputs" },
        "article": { "$ref": "#/$defs/laneExternalInputs" },
        "image": { "$ref": "#/$defs/laneExternalInputs" },
        "video": { "$ref": "#/$defs/laneExternalInputs" }
      }
    },
    "externalInputsDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "submissionDigests": {
      "type": "object",
      "minProperties": 1,
      "$comment": "键集合必须与 activeCarriers 完全一致，由下方 allOf 的逐载体条件断言，不在此静态列举四条车道。",
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "article": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "image": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "video": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "executionIds": {
      "type": "object",
      "minProperties": 1,
      "$comment": "键集合必须与 activeCarriers 完全一致，由下方 allOf 的逐载体条件断言，不在此静态列举四条车道。",
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "string", "minLength": 1 },
        "article": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "video": { "type": "string", "minLength": 1 }
      }
    },
    "reviewedClosureAdoption": {
      "$ref": "reviewed_closure_adoption_campaign_binding.schema.json"
    },
    "distributedRun": {
      "type": "object",
      "required": [
        "campaignRunId",
        "campaignGeneration",
        "campaignFencingToken"
      ],
      "additionalProperties": false,
      "properties": {
        "campaignRunId": { "type": "string", "minLength": 1 },
        "campaignGeneration": { "type": "integer", "minimum": 1 },
        "campaignFencingToken": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "frozenAt": { "type": "string", "format": "date-time" },
    "planDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "$comment": "每条 lane 面必须恰好覆盖 activeCarriers：多一条会让计划声称一条未冻结的车道，少一条会让读取侧从缺失里推断该车道不活跃。",
      "allOf": [
        {
          "if": {
            "properties": {"activeCarriers": {"contains": {"const": "homepage"}}},
            "required": ["activeCarriers"]
          },
          "then": {
            "properties": {
              "workloads": {"required": ["homepage"]},
              "laneExternalInputs": {"required": ["homepage"]},
              "laneSourcePoolSelections": {"required": ["homepage"]},
              "submissionDigests": {"required": ["homepage"]},
              "executionIds": {"required": ["homepage"]}
            }
          },
          "else": {
            "properties": {
              "workloads": {"not": {"required": ["homepage"]}},
              "laneExternalInputs": {"not": {"required": ["homepage"]}},
              "laneSourcePoolSelections": {"not": {"required": ["homepage"]}},
              "submissionDigests": {"not": {"required": ["homepage"]}},
              "executionIds": {"not": {"required": ["homepage"]}}
            }
          }
        },
        {
          "if": {
            "properties": {"activeCarriers": {"contains": {"const": "article"}}},
            "required": ["activeCarriers"]
          },
          "then": {
            "properties": {
              "workloads": {"required": ["article"]},
              "laneExternalInputs": {"required": ["article"]},
              "laneSourcePoolSelections": {"required": ["article"]},
              "submissionDigests": {"required": ["article"]},
              "executionIds": {"required": ["article"]}
            }
          },
          "else": {
            "properties": {
              "workloads": {"not": {"required": ["article"]}},
              "laneExternalInputs": {"not": {"required": ["article"]}},
              "laneSourcePoolSelections": {"not": {"required": ["article"]}},
              "submissionDigests": {"not": {"required": ["article"]}},
              "executionIds": {"not": {"required": ["article"]}}
            }
          }
        },
        {
          "if": {
            "properties": {"activeCarriers": {"contains": {"const": "image"}}},
            "required": ["activeCarriers"]
          },
          "then": {
            "properties": {
              "workloads": {"required": ["image"]},
              "laneExternalInputs": {"required": ["image"]},
              "laneSourcePoolSelections": {"required": ["image"]},
              "submissionDigests": {"required": ["image"]},
              "executionIds": {"required": ["image"]}
            }
          },
          "else": {
            "properties": {
              "workloads": {"not": {"required": ["image"]}},
              "laneExternalInputs": {"not": {"required": ["image"]}},
              "laneSourcePoolSelections": {"not": {"required": ["image"]}},
              "submissionDigests": {"not": {"required": ["image"]}},
              "executionIds": {"not": {"required": ["image"]}}
            }
          }
        },
        {
          "if": {
            "properties": {"activeCarriers": {"contains": {"const": "video"}}},
            "required": ["activeCarriers"]
          },
          "then": {
            "properties": {
              "workloads": {"required": ["video"]},
              "laneExternalInputs": {"required": ["video"]},
              "laneSourcePoolSelections": {"required": ["video"]},
              "submissionDigests": {"required": ["video"]},
              "executionIds": {"required": ["video"]}
            }
          },
          "else": {
            "properties": {
              "workloads": {"not": {"required": ["video"]}},
              "laneExternalInputs": {"not": {"required": ["video"]}},
              "laneSourcePoolSelections": {"not": {"required": ["video"]}},
              "submissionDigests": {"not": {"required": ["video"]}},
              "executionIds": {"not": {"required": ["video"]}}
            }
          }
        }
      ]
    },
    {
      "$comment": "reviewed-closure adoption 只重发已审对象，不作者也不派发 fleet，因此没有执行授权事实可绑；其余 campaign 必须携带互斥 executionAuthority。",
      "if": {"required": ["reviewedClosureAdoption"]},
      "then": {"not": {"required": ["executionAuthority"]}},
      "else": {"required": ["executionAuthority"]}
    },
    {
      "if": {
        "properties": {
          "semanticSelectionId": {"enum": ["default", "cursor_grok", "cursor_auto"]}
        },
        "required": ["semanticSelectionId"]
      },
      "then": {"required": ["semanticPreflightReceipt"]}
    },
    {
      "if": {
        "properties": {
          "executionMode": {"const": "distributed"}
        },
        "required": ["executionMode"]
      },
      "then": {"required": ["distributedRun"]},
      "else": {"not": {"required": ["distributedRun"]}}
    },
    {
      "if": {"required": ["scaleSourcePool"]},
      "then": {
        "required": ["sourcePoolEvidenceRootRef", "laneSourcePoolSelections"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["sourcePoolEvidenceRootRef"]},
            {"required": ["laneSourcePoolSelections"]}
          ]
        }
      }
    },
    {
      "$comment": "来源池要求由冻结的 workload 政策决定：只有 milestone_preset 的 M10000 必须携带完整来源池，其余 workload 可以携带但不被强制。执行 id 的字面形状不是该政策的来源。",
      "if": {
        "properties": {
          "workloadMode": {"const": "milestone_preset"},
          "scale": {"const": "M10000"}
        },
        "required": ["workloadMode", "scale"]
      },
      "then": {
        "required": [
          "scaleSourcePool", "sourcePoolEvidenceRootRef", "laneSourcePoolSelections"
        ]
      }
    }
  ],
  "$defs": {
    "laneExternalInputs": {
      "type": "object",
      "required": ["executionId", "externalInputRefs", "externalInputsDigest"],
      "additionalProperties": false,
      "properties": {
        "executionId": { "type": "string", "minLength": 1 },
        "externalInputRefs": {
          "type": "array",
          "items": { "$ref": "campaign_external_input_ref.schema.json" }
        },
        "externalInputsDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
