{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/execution/semantic_task_journal_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workUnitId",
    "executionId",
    "carrier",
    "stage",
    "promptSha256",
    "sourceIdentity",
    "semanticPreflightReceipt",
    "workspaceRef",
    "provider",
    "model",
    "modelParameters",
    "runtimeProfileId",
    "runtimeProfileDigest",
    "semanticSelectionDigest",
    "maxAttempts",
    "requestDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.semantic_task_journal_request"},
    "workUnitId": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "executionId": {"type": "string", "minLength": 1},
    "carrier": {"enum": ["homepage", "article", "image", "video"]},
    "stage": {"enum": ["author", "reviewer"]},
    "promptSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest", "targetSetDigest"],
      "properties": {
        "sourceRevision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sourceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "entityCatalogDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "targetSetDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "semanticPreflightReceipt": {
      "oneOf": [
        {"$ref": "semantic_provider_preflight_receipt_ref.schema.json"},
        {"type": "null"}
      ]
    },
    "workspaceRef": {"type": "string", "pattern": "^data/tasks/[^/]+$"},
    "provider": {"enum": ["cursor_sdk", "codex_sdk"]},
    "model": {"type": "string", "minLength": 1},
    "modelParameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtimeProfileId": {"type": "string", "minLength": 1},
    "runtimeProfileDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semanticSelectionDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "maxAttempts": {"type": "integer", "minimum": 1},
    "requestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
