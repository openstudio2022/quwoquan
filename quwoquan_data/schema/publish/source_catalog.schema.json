{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical object source catalog",
  "type": "object",
  "required": [
    "schema",
    "policyRevision",
    "primaryEvidenceRef",
    "primarySource",
    "sources"
  ],
  "properties": {
    "policyRevision": {
      "const": "encyclopedia-primary"
    },
    "primaryEvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "primarySource": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "properties": {
            "sourceKind": {
              "enum": ["wikipedia", "baidu_baike", "toutiao_baike"]
            },
            "extractor": {
              "enum": ["wikipedia_api", "baidu_baike_html", "toutiao_baike_html"]
            },
            "policyRevision": { "const": "encyclopedia-primary" }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "schema": {
      "const": "quwoquan_data.object_source_catalog"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "sourceUnitId",
        "entityName",
        "sourceKind",
        "extractor",
        "canonicalUrl",
        "sourceUrl",
        "title",
        "fetchedAt",
        "snapshotHash",
        "policyRevision",
        "sourceUseMode",
        "evidenceRef"
      ],
      "properties": {
        "sourceUnitId": {
          "type": "string",
          "minLength": 1
        },
        "entityName": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "enum": [
            "wikipedia",
            "baidu_baike",
            "toutiao_baike",
            "image_collection"
          ]
        },
        "extractor": {
          "enum": [
            "wikipedia_api",
            "baidu_baike_html",
            "toutiao_baike_html",
            "image_collection_download",
            ""
          ]
        },
        "canonicalUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "fetchedAt": {
          "type": "string",
          "minLength": 1
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policyRevision": {
          "enum": [
            "encyclopedia-primary",
            "image-collection-attribution",
            ""
          ]
        },
        "sourceUseMode": {
          "enum": [
            "licensed_adaptation",
            "factual_reference_only"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
