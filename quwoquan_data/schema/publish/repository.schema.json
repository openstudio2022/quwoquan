{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "独立发布仓身份，不包含机器路径、环境、运行状态或隐式最新指针。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repositoryId", "layoutVersion"],
  "properties": {
    "schema": {"const": "quwoquan_data.publish_repository.v2"},
    "repositoryId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "layoutVersion": {"const": 2}
  }
}
