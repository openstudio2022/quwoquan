{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_video_acquisition_manifest.schema.json",
  "type": "object",
  "required": [
    "schema", "manifestId", "sourceRevision", "sourceDigest",
    "entityCatalogDigest", "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.professional_video_acquisition_manifest"},
    "manifestId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "executionBundle": {"$ref": "#/$defs/digestDocument"},
    "frozenPhysicalInput": {"$ref": "#/$defs/frozenPhysicalInput"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nullableCount": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "digestDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "inputs": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "frozenPhysicalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevision", "sourceDigest", "entityCatalogDigest",
        "sourceManifestDigest", "sourceReceiptRef", "sourceReceiptDigest",
        "sourceReceiptFileSha256"
      ],
      "properties": {
        "sourceRevision": {"type": "string", "minLength": 1},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
        "sourceManifestDigest": {"$ref": "#/$defs/sha256"},
        "sourceReceiptRef": {"$ref": "#/$defs/safeRef"},
        "sourceReceiptDigest": {"$ref": "#/$defs/sha256"},
        "sourceReceiptFileSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frozenAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetRef", "contentSha256", "bytes", "sourceReceiptRef",
        "sourceReceiptDigest", "sourceReceiptFileSha256"
      ],
      "properties": {
        "assetRef": {"$ref": "#/$defs/safeRef"},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "sourceReceiptRef": {"$ref": "#/$defs/safeRef"},
        "sourceReceiptDigest": {"$ref": "#/$defs/sha256"},
        "sourceReceiptFileSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "accessEvidence": {
      "type": "object",
      "required": [
        "anonymousAssetAccess", "loginRequired", "captchaRequired",
        "paywallRequired", "drmProtected", "accessControlBypass"
      ],
      "additionalProperties": false,
      "properties": {
        "anonymousAssetAccess": {"type": "boolean"},
        "loginRequired": {"type": "boolean"},
        "captchaRequired": {"type": "boolean"},
        "paywallRequired": {"type": "boolean"},
        "drmProtected": {"type": "boolean"},
        "accessControlBypass": {"type": "boolean"}
      }
    },
    "safetyReview": {
      "type": "object",
      "required": [
        "status", "entityMatch", "privacyRisk", "minorRisk",
        "maliciousMediaRisk", "watermarkStatus", "reviewedAt",
        "reviewer", "evidenceRef", "safetyEvidenceFileSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["passed", "blocked", "pending"]},
        "entityMatch": {"enum": ["matched", "mismatch", "unknown"]},
        "privacyRisk": {"enum": ["none", "present", "unknown"]},
        "minorRisk": {"enum": ["none", "present", "unknown"]},
        "maliciousMediaRisk": {"enum": ["none", "present", "unknown"]},
        "watermarkStatus": {"enum": ["absent", "present", "unknown"]},
        "reviewedAt": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "evidenceRef": {"type": "string", "minLength": 1},
        "safetyEvidenceFileSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "popularitySignals": {
      "type": "object",
      "required": [
        "playCount", "likeCount", "commentCount", "shareCount",
        "favoriteCount", "observedAt", "provider", "topic", "timeBucket"
      ],
      "additionalProperties": false,
      "properties": {
        "playCount": {"$ref": "#/$defs/nullableCount"},
        "likeCount": {"$ref": "#/$defs/nullableCount"},
        "commentCount": {"$ref": "#/$defs/nullableCount"},
        "shareCount": {"$ref": "#/$defs/nullableCount"},
        "favoriteCount": {"$ref": "#/$defs/nullableCount"},
        "observedAt": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "timeBucket": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "dependentRequired": {
        "popularCandidateId": [
          "popularCatalogRef", "popularCatalogDigest", "popularCatalogFileSha256"
        ],
        "popularCatalogRef": [
          "popularCandidateId", "popularCatalogDigest", "popularCatalogFileSha256"
        ],
        "popularCatalogDigest": [
          "popularCandidateId", "popularCatalogRef", "popularCatalogFileSha256"
        ],
        "popularCatalogFileSha256": [
          "popularCandidateId", "popularCatalogRef", "popularCatalogDigest"
        ]
      },
      "required": [
        "assetId", "entityId", "observedEntityId", "entityAliases",
        "provider", "platform", "displayName", "sourceKind",
        "acquisitionPath", "sourceUrl", "assetUrl", "manualFile",
        "apiEvidence", "accessEvidence", "title", "relevance", "creator",
        "capturedAt", "rightsStatus", "license", "termsUrl",
        "authorizationProof", "rightsIssues", "modelReleaseStatus",
        "propertyReleaseStatus", "safetyReview", "popularitySignals"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
        "entityId": {"type": "string", "minLength": 1},
        "observedEntityId": {"type": "string", "minLength": 1},
        "entityAliases": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provider": {"type": "string", "minLength": 1},
        "frozenAsset": {"$ref": "#/$defs/frozenAsset"},
        "popularCandidateId": {
          "type": "string",
          "pattern": "^popular-video:[a-z0-9_-]+:[0-9a-f]{16}$"
        },
        "popularCatalogRef": {"$ref": "#/$defs/safeRef"},
        "popularCatalogDigest": {"$ref": "#/$defs/sha256"},
        "popularCatalogFileSha256": {"$ref": "#/$defs/sha256"},
        "platform": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "sourceKind": {"type": "string", "minLength": 1},
        "acquisitionPath": {"enum": ["public_direct", "supported_api", "manual_file"]},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "assetUrl": {"type": "string"},
        "manualFile": {"type": "string"},
        "apiEvidence": {"type": "string"},
        "accessEvidence": {"$ref": "#/$defs/accessEvidence"},
        "title": {"type": "string", "minLength": 1},
        "relevance": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
        "license": {"type": "string", "minLength": 1},
        "termsUrl": {"type": "string"},
        "authorizationProof": {"type": "string"},
        "rightsIssues": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "modelReleaseStatus": {"enum": ["verified", "not_required", "unverified"]},
        "propertyReleaseStatus": {"enum": ["verified", "not_required", "unverified"]},
        "safetyReview": {"$ref": "#/$defs/safetyReview"},
        "popularitySignals": {"$ref": "#/$defs/popularitySignals"}
      }
    }
  }
}
