{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_image_supported_api_metadata_catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "catalogId", "catalogDigest", "sourceRevision", "sourceDigest",
    "entityCatalogDigest", "discoveryPlanId", "discoveryPlanDigest",
    "handoffId", "handoffRevision", "handoffDigest", "entityCatalogRef", "requestedProviders",
    "observedAt", "targetCandidateCount", "queryCount", "completedQueryCount",
    "excludedCount", "candidateCount", "candidates"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.professional_image_supported_api_metadata_catalog"},
    "catalogId": {"type": "string", "pattern": "^professional-image-supported-api-metadata-[0-9a-f]{16}$"},
    "catalogDigest": {"$ref": "#/$defs/sha256"},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "discoveryPlanId": {"type": "string", "pattern": "^professional-image-discovery-[0-9a-f]{16}$"},
    "discoveryPlanDigest": {"$ref": "#/$defs/sha256"},
    "handoffId": {"type": "string", "minLength": 1},
    "handoffRevision": {"type": "integer", "minimum": 1},
    "handoffDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogRef": {"type": "string", "minLength": 1},
    "requestedProviders": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["wikimedia_commons", "openverse"]}
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "targetCandidateCount": {"type": "integer", "minimum": 1},
    "queryCount": {"type": "integer", "minimum": 1},
    "completedQueryCount": {"type": "integer", "minimum": 1},
    "excludedCount": {"type": "integer", "minimum": 0},
    "candidateCount": {"type": "integer", "minimum": 1},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId", "queryId", "discoveryCandidateId", "provider", "entityId",
        "observedEntityId", "entityAliases", "providerAssetId",
        "upstreamProvider", "fileTitle", "pageId", "caption",
        "relevance", "sourcePageUrl", "originalAssetUrl", "creator", "license",
        "licenseVersion", "attributionText", "termsUrl", "width", "height",
        "apiRequestUrl", "apiResponseSha256"
      ],
      "properties": {
        "candidateId": {"type": "string", "pattern": "^(wikimedia_commons|openverse):[a-z0-9_-]+:[0-9a-f]{16}$"},
        "queryId": {"type": "string", "pattern": "^(commons|openverse)-query-[0-9a-f]{16}$"},
        "discoveryCandidateId": {"type": "string", "pattern": "^(wikimedia_commons|openverse):[0-9a-f]{16}$"},
        "provider": {"enum": ["wikimedia_commons", "openverse"]},
        "entityId": {"type": "string", "minLength": 1},
        "observedEntityId": {"type": "string", "minLength": 1},
        "entityAliases": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "providerAssetId": {"type": "string", "minLength": 1},
        "upstreamProvider": {"type": "string", "minLength": 1},
        "fileTitle": {"type": "string", "minLength": 1},
        "pageId": {"type": "integer", "minimum": 0},
        "caption": {"type": "string", "minLength": 1},
        "relevance": {"type": "string", "minLength": 1},
        "sourcePageUrl": {"type": "string", "pattern": "^https://"},
        "originalAssetUrl": {"type": "string", "pattern": "^https://"},
        "creator": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "licenseVersion": {"type": "string", "minLength": 1},
        "attributionText": {"type": "string", "minLength": 1},
        "termsUrl": {"type": "string", "pattern": "^https://"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "apiRequestUrl": {"type": "string", "pattern": "^https://(commons\\.wikimedia\\.org/w/api\\.php\\?|api\\.openverse\\.org/v1/images/)"},
        "apiResponseSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
