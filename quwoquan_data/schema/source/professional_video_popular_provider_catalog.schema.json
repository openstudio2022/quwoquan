{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_video_popular_provider_catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalogRevision", "providerOrder", "providers"],
  "properties": {
    "schema": {"const": "quwoquan_data.professional_video_popular_provider_catalog"},
    "catalogRevision": {"const": "popular-video-metadata-v1"},
    "providerOrder": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "providers": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/provider"}}
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "displayName", "priority", "sourceHosts",
        "metadataDiscoveryPaths", "mediaAcquisitionPaths", "manualFileRequired",
        "automaticStreamParsing", "automaticVideoDownload"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "sourceHosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "metadataDiscoveryPaths": {"const": ["supported_api"]},
        "mediaAcquisitionPaths": {"const": ["manual_file"]},
        "manualFileRequired": {"const": true},
        "automaticStreamParsing": {"const": false},
        "automaticVideoDownload": {"const": false}
      }
    }
  }
}
