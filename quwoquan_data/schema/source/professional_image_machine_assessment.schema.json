{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_image_machine_assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidateId", "contentSha256", "bytes", "dimensions", "perceptualHash", "verdict"],
  "properties": {
    "schema": {"const": "quwoquan_data.professional_image_machine_assessment"},
    "candidateId": {"type": "string", "minLength": 1},
    "contentSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 3000},
    "dimensions": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "perceptualHash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "verdict": {"type": "object", "minProperties": 6}
  }
}
