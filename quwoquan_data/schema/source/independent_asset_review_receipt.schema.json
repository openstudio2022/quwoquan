{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/independent_asset_review_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "reviewId", "assetKind", "objectRef", "sourceRevision",
    "sourceDigest", "entityCatalogDigest", "acquisitionReceiptRef",
    "acquisitionReceiptDigest", "acquisitionReceiptSha256",
    "executionManifestRef", "executionManifestSha256", "assetSnapshot",
    "acquisitionExecution", "authorExecution", "reviewerExecution",
    "judgment", "reviewDecision", "recordedAt", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.independent_asset_review_receipt"},
    "reviewId": {"type": "string", "pattern": "^asset-review-[0-9a-f]{64}$"},
    "assetKind": {"enum": ["image", "video"]},
    "objectRef": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "acquisitionReceiptRef": {"$ref": "#/$defs/safeRef"},
    "acquisitionReceiptDigest": {"$ref": "#/$defs/sha256"},
    "acquisitionReceiptSha256": {"$ref": "#/$defs/sha256"},
    "executionManifestRef": {"$ref": "#/$defs/safeRef"},
    "executionManifestSha256": {"$ref": "#/$defs/sha256"},
    "assetSnapshot": {"$ref": "#/$defs/assetSnapshot"},
    "acquisitionExecution": {"$ref": "#/$defs/executionIdentity"},
    "authorExecution": {"$ref": "#/$defs/executionIdentity"},
    "reviewerExecution": {"$ref": "#/$defs/reviewerIdentity"},
    "judgment": {"$ref": "#/$defs/judgment"},
    "reviewDecision": {"enum": ["accepted", "blocked"]},
    "recordedAt": {"type": "string", "minLength": 1},
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"assetKind": {"const": "video"}},
        "required": ["assetKind"]
      },
      "then": {
        "properties": {
          "assetSnapshot": {
            "required": ["mediaProbe", "popularitySignals", "poster"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nullableCount": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "nullableNumber": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId", "objectRef", "provider", "model", "runId",
        "evidenceRef", "evidenceSha256"
      ],
      "properties": {
        "executionId": {"type": "string", "minLength": 1},
        "objectRef": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "evidenceRef": {"$ref": "#/$defs/safeRef"},
        "evidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionId", "objectRef", "provider", "model", "modelFamily",
        "runId", "resultHash", "evidenceRef", "evidenceSha256"
      ],
      "properties": {
        "executionId": {"type": "string", "minLength": 1},
        "objectRef": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "modelFamily": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "resultHash": {"$ref": "#/$defs/sha256"},
        "evidenceRef": {"$ref": "#/$defs/safeRef"},
        "evidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "popularCandidateId": [
          "popularCatalogRef", "popularCatalogDigest", "popularCatalogFileSha256"
        ],
        "popularCatalogRef": [
          "popularCandidateId", "popularCatalogDigest", "popularCatalogFileSha256"
        ],
        "popularCatalogDigest": [
          "popularCandidateId", "popularCatalogRef", "popularCatalogFileSha256"
        ],
        "popularCatalogFileSha256": [
          "popularCandidateId", "popularCatalogRef", "popularCatalogDigest"
        ]
      },
      "required": [
        "assetId", "entityId", "observedEntityId", "contentSha256",
        "casRef", "sourceUrl", "platform", "creator", "capturedAt",
        "license", "termsUrl", "authorizationProof", "rightsIssues",
        "acquisitionStatus", "rightsStatus", "authorizationRequired",
        "distributionDecision"
      ],
      "properties": {
        "assetId": {"type": "string", "minLength": 1},
        "entityId": {"type": "string", "minLength": 1},
        "observedEntityId": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "casRef": {"$ref": "#/$defs/safeRef"},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "platform": {"type": "string", "minLength": 1},
        "popularCandidateId": {
          "type": "string",
          "pattern": "^popular-video:[a-z0-9_-]+:[0-9a-f]{16}$"
        },
        "popularCatalogRef": {"$ref": "#/$defs/safeRef"},
        "popularCatalogDigest": {"$ref": "#/$defs/sha256"},
        "popularCatalogFileSha256": {"$ref": "#/$defs/sha256"},
        "creator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "licenseSnapshot": {"type": "string", "minLength": 1},
        "usageScope": {"enum": ["internal_reference", "app_publish", "editorial"]},
        "modelReleaseStatus": {"enum": ["not_required", "obtained", "editorial_only", "verified", "unverified"]},
        "termsUrl": {"type": "string"},
        "authorizationProof": {"type": "string"},
        "rightsIssues": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "acquisitionStatus": {"const": "acquired"},
        "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
        "authorizationRequired": {"type": "boolean"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed", "blocked"]},
        "poster": {"$ref": "#/$defs/poster"},
        "mediaProbe": {"$ref": "#/$defs/mediaProbe"}
        ,"popularitySignals": {"$ref": "#/$defs/popularitySignals"}
      }
    },
    "poster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentSha256", "casRef", "bytes", "mimeType", "rights"],
      "properties": {
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "casRef": {"$ref": "#/$defs/safeRef"},
        "bytes": {"type": "integer", "minimum": 1},
        "mimeType": {"const": "image/png"},
        "rights": {"$ref": "#/$defs/posterRights"}
      }
    },
    "posterRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation", "sourceAssetId", "sourceUrl", "license", "termsUrl",
        "authorizationProof", "rightsStatus", "authorizationRequired",
        "distributionDecision", "rightsIssues"
      ],
      "properties": {
        "derivation": {"const": "frame_from_licensed_video"},
        "sourceAssetId": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "license": {"type": "string", "minLength": 1},
        "termsUrl": {"type": "string"},
        "authorizationProof": {"type": "string"},
        "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
        "authorizationRequired": {"type": "boolean"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed", "blocked"]},
        "rightsIssues": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "mediaProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width", "height", "frameCount", "framesPerSecond", "durationMs",
        "codec", "hasAudio", "sampleCount", "distinctFrameCount",
        "movingTransitionCount", "meanTransitionDelta", "playable",
        "motionVideo", "staticImageSequence", "premiumPlayableEligible"
      ],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frameCount": {"type": "integer", "minimum": 1},
        "framesPerSecond": {"type": "number", "exclusiveMinimum": 0},
        "durationMs": {"type": "integer", "minimum": 1},
        "codec": {"type": "string"},
        "hasAudio": {"type": "boolean"},
        "sampleCount": {"type": "integer", "minimum": 1},
        "distinctFrameCount": {"type": "integer", "minimum": 1},
        "movingTransitionCount": {"type": "integer", "minimum": 0},
        "meanTransitionDelta": {"type": "number", "minimum": 0, "maximum": 1},
        "playable": {"type": "boolean"},
        "motionVideo": {"type": "boolean"},
        "staticImageSequence": {"type": "boolean"},
        "premiumPlayableEligible": {"type": "boolean"}
      }
    },
    "popularitySignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playCount", "likeCount", "commentCount", "shareCount",
        "favoriteCount", "observedAt", "provider", "topic", "timeBucket",
        "popularityScore", "popularityPercentile", "rankingEligible",
        "ineligibleReason", "comparisonCandidateCount"
      ],
      "properties": {
        "playCount": {"$ref": "#/$defs/nullableCount"},
        "likeCount": {"$ref": "#/$defs/nullableCount"},
        "commentCount": {"$ref": "#/$defs/nullableCount"},
        "shareCount": {"$ref": "#/$defs/nullableCount"},
        "favoriteCount": {"$ref": "#/$defs/nullableCount"},
        "observedAt": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "timeBucket": {"type": "string", "minLength": 1},
        "popularityScore": {"$ref": "#/$defs/nullableNumber"},
        "popularityPercentile": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "rankingEligible": {"type": "boolean"},
        "ineligibleReason": {"type": "string"},
        "comparisonCandidateCount": {"type": "integer", "minimum": 0}
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rightsStatus", "authorizationRequired", "distributionDecision",
        "safetyStatus", "entityMatch", "qualityStatus", "privacyRisk",
        "minorRisk", "maliciousMediaRisk", "watermarkStatus", "findings"
      ],
      "properties": {
        "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
        "authorizationRequired": {"type": "boolean"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed", "blocked"]},
        "safetyStatus": {"enum": ["passed", "blocked"]},
        "entityMatch": {"enum": ["matched", "mismatch", "unknown"]},
        "qualityStatus": {"enum": ["passed", "blocked"]},
        "privacyRisk": {"enum": ["none", "present", "unknown"]},
        "minorRisk": {"enum": ["none", "present", "unknown"]},
        "maliciousMediaRisk": {"enum": ["none", "present", "unknown"]},
        "watermarkStatus": {"enum": ["absent", "present", "unknown"]},
        "findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
