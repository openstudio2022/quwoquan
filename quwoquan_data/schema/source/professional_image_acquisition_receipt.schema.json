{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_image_acquisition_receipt.schema.json",
  "type": "object",
  "required": [
    "schema", "manifestId", "manifestDigest", "sourceRevision", "sourceDigest",
    "entityCatalogDigest",
    "plannedAssetCount", "discoveredAssetCount", "downloadedAssetCount",
    "acceptedAssetCount", "rejectedAssetCount", "providerAssetCounts", "assets",
    "receiptDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quwoquan_data.professional_image_acquisition_receipt"},
    "status": {"enum": ["ready", "partial", "blocked"]},
    "manifestId": {"type": "string", "minLength": 1},
    "manifestDigest": {"$ref": "#/$defs/sha256"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "plannedAssetCount": {"type": "integer", "minimum": 1},
    "discoveredAssetCount": {"type": "integer", "minimum": 1},
    "downloadedAssetCount": {"type": "integer", "minimum": 0},
    "acceptedAssetCount": {"type": "integer", "minimum": 0},
    "rejectedAssetCount": {"type": "integer", "minimum": 0},
    "providerAssetCounts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/providerCounts"}
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "emptyOrSha256": {
      "anyOf": [
        {"const": ""},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "accessEvidence": {
      "type": "object",
      "required": [
        "anonymousAssetAccess", "loginRequired", "captchaRequired",
        "paywallRequired", "drmProtected", "accessControlBypass"
      ],
      "additionalProperties": false,
      "properties": {
        "anonymousAssetAccess": {"type": "boolean"},
        "loginRequired": {"type": "boolean"},
        "captchaRequired": {"type": "boolean"},
        "paywallRequired": {"type": "boolean"},
        "drmProtected": {"type": "boolean"},
        "accessControlBypass": {"type": "boolean"}
      }
    },
    "safetyReview": {
      "type": "object",
      "required": [
        "status", "entityMatch", "privacyRisk", "minorRisk",
        "maliciousMediaRisk", "watermarkStatus", "reviewedAt", "reviewer",
        "evidenceRef", "safetyEvidenceFileSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["passed", "blocked", "pending"]},
        "entityMatch": {"enum": ["matched", "mismatch", "unknown"]},
        "privacyRisk": {"enum": ["none", "present", "unknown"]},
        "minorRisk": {"enum": ["none", "present", "unknown"]},
        "maliciousMediaRisk": {"enum": ["none", "present", "unknown"]},
        "watermarkStatus": {"enum": ["absent", "present", "unknown"]},
        "reviewedAt": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "evidenceRef": {"type": "string", "minLength": 1},
        "safetyEvidenceFileSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "providerCounts": {
      "type": "object",
      "required": [
        "displayName", "provider", "plannedAssetCount", "discoveredAssetCount",
        "downloadedAssetCount", "acceptedAssetCount", "rejectedAssetCount",
        "verifiedAssetCount", "unverifiedAssetCount", "restrictedAssetCount",
        "unknownAssetCount"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "plannedAssetCount": {"type": "integer", "minimum": 1},
        "discoveredAssetCount": {"type": "integer", "minimum": 1},
        "downloadedAssetCount": {"type": "integer", "minimum": 0},
        "acceptedAssetCount": {"type": "integer", "minimum": 0},
        "rejectedAssetCount": {"type": "integer", "minimum": 0},
        "verifiedAssetCount": {"type": "integer", "minimum": 0},
        "unverifiedAssetCount": {"type": "integer", "minimum": 0},
        "restrictedAssetCount": {"type": "integer", "minimum": 0},
        "unknownAssetCount": {"type": "integer", "minimum": 0}
      }
    },
    "planImageSpec": {
      "type": "object",
      "required": [
        "url", "sourceUrl", "collectionPageUrl", "originalAssetUrl", "platform", "sourceId",
        "creator", "credit", "capturedAt",
        "contentSha256", "acquisitionStatus", "rightsStatus",
        "authorizationRequired", "distributionDecision", "rightsAuditStatus",
        "rightsIssues", "license", "licenseSnapshot", "usageScope",
        "modelReleaseStatus", "termsUrl", "authorizationProof", "caption",
        "relevance", "width", "height", "sourceAttribution"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^file://"},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "collectionPageUrl": {"type": "string", "pattern": "^https://"},
        "originalAssetUrl": {"type": "string", "pattern": "^https://"},
        "platform": {"type": "string", "minLength": 1},
        "sourceId": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "credit": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "acquisitionStatus": {"const": "acquired"},
        "rightsStatus": {"enum": ["verified", "unverified", "unknown"]},
        "authorizationRequired": {"type": "boolean"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed"]},
        "rightsAuditStatus": {"enum": ["verified", "unverified", "unknown"]},
        "rightsIssues": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "license": {"type": "string", "minLength": 1},
        "licenseSnapshot": {"type": "string", "minLength": 1},
        "usageScope": {"enum": ["internal_reference", "app_publish", "editorial"]},
        "modelReleaseStatus": {"enum": ["not_required", "obtained", "editorial_only"]},
        "termsUrl": {"type": "string"},
        "authorizationProof": {"type": "string"},
        "caption": {"type": "string", "minLength": 1},
        "relevance": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sourceAttribution": {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"}
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "assetId", "entityId", "observedEntityId", "entityAliases", "displayName",
        "provider", "platform",
        "acquisitionPath", "assetUrl", "manualFile", "apiEvidence", "accessEvidence",
        "acquisitionStatus", "rightsStatus", "authorizationRequired",
        "distributionDecision", "sourceUrl", "creator", "capturedAt", "contentSha256",
        "assetRef", "bytes", "mimeType", "width", "height", "license", "licenseSnapshot",
        "usageScope", "modelReleaseStatus", "termsUrl",
        "authorizationProof", "rightsIssues", "caption", "relevance", "safetyReview",
        "withdrawalRequired", "failureCode", "failure", "planImageSpec",
        "sourceAttribution"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": {"type": "string", "minLength": 1},
        "entityId": {"type": "string", "minLength": 1},
        "observedEntityId": {"type": "string", "minLength": 1},
        "entityAliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "displayName": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "acquisitionPath": {"enum": ["public_direct", "supported_api", "manual_file"]},
        "assetUrl": {"type": "string"},
        "manualFile": {"type": "string"},
        "apiEvidence": {"type": "string"},
        "accessEvidence": {"$ref": "#/$defs/accessEvidence"},
        "acquisitionStatus": {"enum": ["acquired", "failed", "blocked"]},
        "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
        "authorizationRequired": {"type": "boolean"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed", "blocked"]},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "creator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/emptyOrSha256"},
        "assetRef": {
          "anyOf": [
            {"const": ""},
            {"type": "string", "pattern": "^cas/sha256/[0-9a-f]{2}/[0-9a-f]{64}\\.(gif|jpg|png|webp)$"}
          ]
        },
        "bytes": {"type": "integer", "minimum": 0},
        "mimeType": {"enum": ["", "image/gif", "image/jpeg", "image/png", "image/webp"]},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "license": {"type": "string", "minLength": 1},
        "licenseSnapshot": {"type": "string", "minLength": 1},
        "usageScope": {"enum": ["internal_reference", "app_publish", "editorial"]},
        "modelReleaseStatus": {"enum": ["not_required", "obtained", "editorial_only"]},
        "termsUrl": {"type": "string"},
        "authorizationProof": {"type": "string"},
        "rightsIssues": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "caption": {"type": "string", "minLength": 1},
        "relevance": {"type": "string", "minLength": 1},
        "safetyReview": {"$ref": "#/$defs/safetyReview"},
        "sourceAttribution": {
          "anyOf": [
            {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"},
            {"type": "null"}
          ]
        },
        "withdrawalRequired": {"type": "boolean"},
        "failureCode": {"type": "string"},
        "failure": {"type": "string"},
        "planImageSpec": {
          "anyOf": [
            {"$ref": "#/$defs/planImageSpec"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "distributionDecision": {
                "enum": ["research_allowed", "commercial_allowed"]
              }
            },
            "required": ["distributionDecision"]
          },
          "then": {
            "properties": {
              "acquisitionStatus": {"const": "acquired"},
              "contentSha256": {"$ref": "#/$defs/sha256"},
              "assetRef": {
                "type": "string",
                "pattern": "^cas/sha256/[0-9a-f]{2}/[0-9a-f]{64}\\.(gif|jpg|png|webp)$"
              },
              "bytes": {"type": "integer", "minimum": 3000},
              "mimeType": {"type": "string", "pattern": "^image/(gif|jpeg|png|webp)$"},
              "width": {"type": "integer", "minimum": 640},
              "height": {"type": "integer", "minimum": 426},
              "failureCode": {"const": ""},
              "failure": {"const": ""},
              "planImageSpec": {"$ref": "#/$defs/planImageSpec"},
              "sourceAttribution": {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"},
              "safetyReview": {
                "type": "object",
                "properties": {
                  "status": {"const": "passed"},
                  "entityMatch": {"const": "matched"},
                  "privacyRisk": {"const": "none"},
                  "minorRisk": {"const": "none"},
                  "maliciousMediaRisk": {"const": "none"},
                  "watermarkStatus": {"const": "absent"}
                }
              }
            },
            "anyOf": [
              {
                "properties": {
                  "width": {"type": "integer", "minimum": 800}
                }
              },
              {
                "properties": {
                  "height": {"type": "integer", "minimum": 800}
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {"acquisitionStatus": {"const": "acquired"}},
            "required": ["acquisitionStatus"]
          },
          "then": {
            "properties": {
              "mimeType": {"type": "string", "pattern": "^image/(gif|jpeg|png|webp)$"}
            }
          }
        },
        {
          "if": {
            "properties": {"acquisitionStatus": {"enum": ["failed", "blocked"]}},
            "required": ["acquisitionStatus"]
          },
          "then": {
            "properties": {"mimeType": {"const": ""}}
          }
        },
        {
          "if": {
            "properties": {"distributionDecision": {"const": "blocked"}},
            "required": ["distributionDecision"]
          },
          "then": {
            "properties": {"planImageSpec": {"type": "null"}}
          }
        }
      ]
    }
  }
}
