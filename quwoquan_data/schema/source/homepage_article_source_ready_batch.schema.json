{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/homepage_article_source_ready_batch.schema.json",
  "title": "Create-once homepage and article source-ready set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceSetId", "targetScale", "sourceRevision", "sourceDigest",
    "entityCatalogDigest", "createdAt", "coverageProjection", "seedSelection", "candidateCapsules",
    "counts", "sourceSetDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.homepage_article_source_ready_batch"},
    "sourceSetId": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "targetScale": {"enum": ["WORKLOAD", "M100", "M1000", "M10000"]},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "minLength": 1},
    "coverageProjection": {"$ref": "#/$defs/documentBinding"},
    "seedSelection": {"$ref": "#/$defs/documentBinding"},
    "candidateCapsules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateBinding"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "article"],
      "properties": {
        "homepage": {"type": "integer", "minimum": 0},
        "article": {"type": "integer", "minimum": 0}
      }
    },
    "sourceSetDigest": {"$ref": "#/$defs/sha256"}
  },
  "anyOf": [
    {"properties": {"counts": {"properties": {"homepage": {"minimum": 1}}}}},
    {"properties": {"counts": {"properties": {"article": {"minimum": 1}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "fileSha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "fileSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier", "candidateId", "evidenceRootRef", "ref", "digest", "fileSha256"
      ],
      "properties": {
        "carrier": {"enum": ["homepage", "article"]},
        "candidateId": {"type": "string", "minLength": 1},
        "evidenceRootRef": {"$ref": "#/$defs/ref"},
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "fileSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
