{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/acquire_request.schema.json",
  "description": "task acquire 的 AI 输入：只点名来源 URL、类型与一句相关性理由；字节、摘要、license、作者、mime、探测与 poster 由脚本机械取得。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.acquire_request"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "relevance"
        ],
        "properties": {
          "kind": {
            "enum": [
              "page",
              "image",
              "video"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
