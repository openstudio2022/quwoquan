{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_image_manual_file_evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "evidenceId", "evidenceDigest", "sourceRevision", "sourceDigest",
    "executionBundle", "entityCatalogDigest", "handoffId", "handoffRevision",
    "handoffDigest", "provider", "acquisitionPath", "discoveryCandidateId",
    "sourcePageUrl", "assetUrl", "manualFile", "apiEvidence", "creator", "title",
    "observedAt", "contentSha256", "assetBytes", "dimensions",
    "originalAssetCandidate", "generated", "rightsStatus", "license",
    "licenseSnapshot", "usageScope", "modelReleaseStatus", "termsUrl",
    "authorizationProof", "rightsIssues", "sourceAttributionFile",
    "sourceAttributionFileSha256", "sourceAttribution"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.professional_image_manual_file_evidence"},
    "evidenceId": {"type": "string", "pattern": "^professional-image-manual-[0-9a-f]{16}$"},
    "evidenceDigest": {"$ref": "#/$defs/sha256"},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "executionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "inputs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "handoffId": {"type": "string", "minLength": 1},
    "handoffRevision": {"type": "integer", "minimum": 1},
    "handoffDigest": {"$ref": "#/$defs/sha256"},
    "provider": {"enum": ["pinterest", "tuchong", "wikimedia_commons", "openverse"]},
    "acquisitionPath": {"const": "manual_file"},
    "discoveryCandidateId": {
      "type": "string",
      "pattern": "^(pinterest|tuchong|wikimedia_commons|openverse):(?:[a-z0-9_-]+:)?[0-9a-f]{16}$"
    },
    "sourcePageUrl": {"type": "string", "pattern": "^https://"},
    "assetUrl": {"const": ""},
    "manualFile": {"$ref": "#/$defs/safeRef"},
    "apiEvidence": {"const": ""},
    "creator": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "format": "date-time"},
    "contentSha256": {"$ref": "#/$defs/sha256"},
    "assetBytes": {"type": "integer", "minimum": 3000, "maximum": 67108864},
    "dimensions": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "originalAssetCandidate": {"const": true},
    "generated": {"const": false},
    "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
    "license": {"type": "string", "minLength": 1},
    "licenseSnapshot": {"type": "string", "minLength": 1},
    "usageScope": {"enum": ["internal_reference", "app_publish", "editorial"]},
    "modelReleaseStatus": {"enum": ["not_required", "obtained", "editorial_only"]},
    "termsUrl": {"type": "string", "pattern": "^https://"},
    "authorizationProof": {"type": "string", "pattern": "^https://"},
    "rightsIssues": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourceAttributionFile": {"$ref": "#/$defs/safeRef"},
    "sourceAttributionFileSha256": {"$ref": "#/$defs/sha256"},
    "sourceAttribution": {
      "$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeRef": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
