{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/scale_source_pool.schema.json",
  "title": "Immutable carrier-selective source-ready workload pool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "poolId",
    "targetScale",
    "workloadMode",
    "activeCarriers",
    "workloadTargets",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "createdAt",
    "waveCandidateCounts",
    "candidates",
    "planDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.scale_source_pool"},
    "poolId": {"type": "string", "minLength": 1},
    "targetScale": {"enum": ["WORKLOAD", "M100", "M1000", "M10000"]},
    "workloadMode": {"enum": ["explicit", "milestone_preset"]},
    "activeCarriers": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["homepage", "article", "image", "video"]}
    },
    "workloadTargets": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "homepage": {"type": "integer", "minimum": 1},
        "article": {"type": "integer", "minimum": 1},
        "image": {"type": "integer", "minimum": 1},
        "video": {"type": "integer", "minimum": 1}
      }
    },
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "minLength": 1},
    "waveCandidateCounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/requiredCount"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "planDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requiredCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier", "minimumCandidateCount"],
      "properties": {
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "minimumCandidateCount": {"type": "integer", "minimum": 0}
      }
    },
    "homepageRequiredCount": {
      "allOf": [
        {"$ref": "#/$defs/requiredCount"},
        {"properties": {"carrier": {"const": "homepage"}}}
      ]
    },
    "articleRequiredCount": {
      "allOf": [
        {"$ref": "#/$defs/requiredCount"},
        {"properties": {"carrier": {"const": "article"}}}
      ]
    },
    "imageRequiredCount": {
      "allOf": [
        {"$ref": "#/$defs/requiredCount"},
        {"properties": {"carrier": {"const": "image"}}}
      ]
    },
    "videoRequiredCount": {
      "allOf": [
        {"$ref": "#/$defs/requiredCount"},
        {"properties": {"carrier": {"const": "video"}}}
      ]
    },
    "comparisonBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "topic", "timeBucket", "candidateCount"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "timeBucket": {"type": "string", "minLength": 1},
        "candidateCount": {"type": "integer", "minimum": 2}
      }
    },
    "videoReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playable", "motion", "premiumEligible"],
      "properties": {
        "playable": {"type": "boolean"},
        "motion": {"type": "boolean"},
        "premiumEligible": {"type": "boolean"},
        "playCount": {"type": ["integer", "null"], "minimum": 0},
        "likeCount": {"type": ["integer", "null"], "minimum": 0},
        "commentCount": {"type": ["integer", "null"], "minimum": 0},
        "shareCount": {"type": ["integer", "null"], "minimum": 0},
        "favoriteCount": {"type": ["integer", "null"], "minimum": 0},
        "observedAt": {"type": ["string", "null"], "minLength": 1},
        "popularityPercentile": {
          "anyOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0, "maximum": 1}
          ]
        },
        "comparisonBucket": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/comparisonBucket"}
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "carrier",
        "objectRef",
        "entityRef",
        "observedEntityRef",
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "provider",
        "contentSha256",
        "acquisitionStatus",
        "rightsStatus",
        "distributionDecision",
        "qualityStatus",
        "generated",
        "videoReadiness"
      ],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "carrier": {"enum": ["homepage", "article", "image", "video"]},
        "objectRef": {"type": "string", "minLength": 1},
        "entityRef": {"type": "string", "minLength": 1},
        "observedEntityRef": {"type": "string", "minLength": 1},
        "sourceRevision": {"$ref": "#/$defs/sha256"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
        "sourceAttribution": {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"},
        "publishMediaMode": {"enum": ["illustrated", "text_only"]},
        "sourceReadyEvidenceRootRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+)$"
        },
        "sourceAdmissionRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "sourceAdmissionDigest": {"$ref": "#/$defs/sha256"},
        "sourceUnitRef": {"type": "string", "minLength": 1},
        "sourceUnitDigest": {"$ref": "#/$defs/sha256"},
        "sourceUnitFileSha256": {"$ref": "#/$defs/sha256"},
        "provider": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "acquisitionStatus": {"const": "acquired"},
        "acquisitionRef": {"type": "string", "minLength": 1},
        "acquisitionDigest": {"$ref": "#/$defs/sha256"},
        "acquisitionFileSha256": {"$ref": "#/$defs/sha256"},
        "rightsStatus": {"enum": ["verified", "unverified", "unknown"]},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed"]},
        "rightsRef": {"type": "string", "minLength": 1},
        "rightsDigest": {"$ref": "#/$defs/sha256"},
        "rightsFileSha256": {"$ref": "#/$defs/sha256"},
        "qualityStatus": {"const": "passed"},
        "qualityRef": {"type": "string", "minLength": 1},
        "qualityDigest": {"$ref": "#/$defs/sha256"},
        "qualityFileSha256": {"$ref": "#/$defs/sha256"},
        "generated": {"type": "boolean"},
        "playabilityRef": {"type": ["string", "null"]},
        "playabilityDigest": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "playabilityFileSha256": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "videoReadiness": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/videoReadiness"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "carrier": {"enum": ["homepage", "article"]}
            },
            "required": ["carrier"]
          },
          "then": {
            "required": [
              "sourceReadyEvidenceRootRef",
              "sourceAttribution",
              "sourceUnitRef",
              "sourceUnitDigest",
              "sourceUnitFileSha256",
              "acquisitionRef",
              "acquisitionDigest",
              "acquisitionFileSha256",
              "rightsRef",
              "rightsDigest",
              "rightsFileSha256",
              "qualityRef",
              "qualityDigest",
              "qualityFileSha256",
              "playabilityRef",
              "playabilityDigest",
              "playabilityFileSha256"
            ],
            "not": {
              "anyOf": [
                {"required": ["sourceAdmissionRef"]},
                {"required": ["sourceAdmissionDigest"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"carrier": {"const": "homepage"}}, "required": ["carrier"]},
          "then": {"properties": {"objectRef": {"pattern": "^entities/"}}}
        },
        {
          "if": {"properties": {"carrier": {"const": "article"}}, "required": ["carrier"]},
          "then": {
            "required": ["publishMediaMode"],
            "properties": {"objectRef": {"pattern": "^posts/article/"}}
          }
        },
        {
          "if": {"properties": {"carrier": {"const": "image"}}, "required": ["carrier"]},
          "then": {
            "required": ["sourceAdmissionRef", "sourceAdmissionDigest"],
            "properties": {"objectRef": {"pattern": "^posts/image/"}},
            "not": {
              "anyOf": [
                {"required": ["sourceUnitRef"]},
                {"required": ["sourceUnitDigest"]},
                {"required": ["sourceUnitFileSha256"]},
                {"required": ["acquisitionRef"]},
                {"required": ["acquisitionDigest"]},
                {"required": ["acquisitionFileSha256"]},
                {"required": ["rightsRef"]},
                {"required": ["rightsDigest"]},
                {"required": ["rightsFileSha256"]},
                {"required": ["qualityRef"]},
                {"required": ["qualityDigest"]},
                {"required": ["qualityFileSha256"]},
                {"required": ["playabilityRef"]},
                {"required": ["playabilityDigest"]},
                {"required": ["playabilityFileSha256"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"carrier": {"const": "video"}}, "required": ["carrier"]},
          "then": {
            "required": ["sourceAdmissionRef", "sourceAdmissionDigest"],
            "properties": {
              "objectRef": {"pattern": "^posts/video/"},
              "videoReadiness": {"$ref": "#/$defs/videoReadiness"}
            },
            "not": {
              "anyOf": [
                {"required": ["sourceUnitRef"]},
                {"required": ["sourceUnitDigest"]},
                {"required": ["sourceUnitFileSha256"]},
                {"required": ["acquisitionRef"]},
                {"required": ["acquisitionDigest"]},
                {"required": ["acquisitionFileSha256"]},
                {"required": ["rightsRef"]},
                {"required": ["rightsDigest"]},
                {"required": ["rightsFileSha256"]},
                {"required": ["qualityRef"]},
                {"required": ["qualityDigest"]},
                {"required": ["qualityFileSha256"]},
                {"required": ["playabilityRef"]},
                {"required": ["playabilityDigest"]},
                {"required": ["playabilityFileSha256"]}
              ]
            }
          },
          "else": {
            "properties": {"videoReadiness": {"type": "null"}}
          }
        }
      ]
    }
  }
}
