{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/professional_image_supported_api_preparation_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "preparationId", "sourceRevision", "sourceDigest", "entityCatalogDigest",
    "discoveryPlanRef", "discoveryPlanDigest", "metadataCatalogRef", "metadataCatalogDigest",
    "acceptedTarget", "candidateCount", "acceptedCount", "pendingCount", "blockedCount",
    "shortfall", "status", "acquisitionManifestRef", "acquisitionManifestSha256",
    "items", "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.professional_image_supported_api_preparation_receipt"},
    "preparationId": {"type": "string", "pattern": "^professional-image-supported-api-[0-9a-f]{16}$"},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "executionBundle": {"$ref": "#/$defs/digestDocument"},
    "frozenPhysicalInput": {"$ref": "#/$defs/frozenPhysicalInput"},
    "reviewExecutionBindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewExecutionBinding"}
    },
    "discoveryPlanRef": {"type": "string", "minLength": 1},
    "discoveryPlanDigest": {"$ref": "#/$defs/sha256"},
    "metadataCatalogRef": {"type": "string", "minLength": 1},
    "metadataCatalogDigest": {"$ref": "#/$defs/sha256"},
    "acceptedTarget": {"type": "integer", "minimum": 1},
    "candidateCount": {"type": "integer", "minimum": 1},
    "acceptedCount": {"type": "integer", "minimum": 0},
    "pendingCount": {"type": "integer", "minimum": 0},
    "blockedCount": {"type": "integer", "minimum": 0},
    "shortfall": {"type": "integer", "minimum": 0},
    "status": {"enum": ["ready", "partial", "blocked"]},
    "acquisitionManifestRef": {"type": "string"},
    "acquisitionManifestSha256": {"type": "string"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidateId", "status", "evidenceRef", "evidenceSha256", "failureCode"],
        "properties": {
          "candidateId": {"type": "string", "minLength": 1},
          "status": {"enum": ["review_pending", "accepted", "blocked"]},
          "evidenceRef": {"$ref": "#/$defs/safeRef"},
          "evidenceSha256": {"$ref": "#/$defs/sha256"},
          "failureCode": {"type": "string"}
        }
      }
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "digest", "inputs"],
      "properties": {
        "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/sha256"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "frozenPhysicalInput": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRevision", "sourceDigest", "entityCatalogDigest", "metadataCatalogDigest", "externalInputsDigest"],
      "properties": {
        "sourceRevision": {"$ref": "#/$defs/sha256"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
        "metadataCatalogDigest": {"$ref": "#/$defs/sha256"},
        "externalInputsDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewExecutionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["executionId", "executionBundle", "executionManifestRef", "executionManifestSha256"],
      "properties": {
        "executionId": {"type": "string", "minLength": 1},
        "executionBundle": {"$ref": "#/$defs/digestDocument"},
        "executionManifestRef": {"$ref": "#/$defs/safeRef"},
        "executionManifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "safeRef": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
