{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/homepage_article_source_ready_acquisition_report.schema.json",
  "title": "Homepage and article source-ready acquisition report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceSetId", "targetScale", "sourceRevision", "sourceDigest",
    "entityCatalogDigest", "startedAt", "completedAt", "coverageProjection",
    "seedSelection", "seedIntersection", "seedExclusions", "status", "counts",
    "rejectionReasonCounts", "rejections", "batchRef", "sourceSetDigest",
    "reportDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.homepage_article_source_ready_acquisition_report"},
    "sourceSetId": {"type": "string", "minLength": 1},
    "targetScale": {"enum": ["M100", "M1000", "M10000"]},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "startedAt": {"type": "string", "minLength": 1},
    "completedAt": {"type": "string", "minLength": 1},
    "coverageProjection": {"$ref": "#/$defs/documentBinding"},
    "seedSelection": {"$ref": "#/$defs/documentBinding"},
    "seedIntersection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepageMatched", "articleMatched", "excluded"],
      "properties": {
        "homepageMatched": {"type": "integer", "minimum": 0},
        "articleMatched": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "seedExclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seedOrigin", "seedId", "coverageKey", "reason"],
        "properties": {
          "seedOrigin": {"enum": ["historical_capsule_hint", "current_coverage"]},
          "seedId": {"$ref": "#/$defs/sha256"},
          "coverageKey": {"$ref": "homepage_article_seed_selection.schema.json#/$defs/seed/properties/coverageKey"},
          "reason": {"const": "fresh coverage intersection missing or changed"}
        }
      }
    },
    "status": {"enum": ["copy_ready", "source_pool_shortfall"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned", "attempted", "homepageRequired", "articleRequired",
        "homepageAccepted", "articleAccepted", "homepageShortfall",
        "articleShortfall", "rejected"
      ],
      "properties": {
        "planned": {"type": "integer", "minimum": 0},
        "attempted": {"type": "integer", "minimum": 0},
        "homepageRequired": {"type": "integer", "minimum": 0},
        "articleRequired": {"type": "integer", "minimum": 0},
        "homepageAccepted": {"type": "integer", "minimum": 0},
        "articleAccepted": {"type": "integer", "minimum": 0},
        "homepageShortfall": {"type": "integer", "minimum": 0},
        "articleShortfall": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "rejectionReasonCounts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "carrier", "coverageEntityIdentity", "candidateName", "entityType",
          "sourceKind", "sourceUrl", "reason"
        ],
        "properties": {
          "carrier": {"enum": ["homepage", "article"]},
          "coverageEntityIdentity": {"type": "string", "minLength": 1},
          "candidateName": {"type": "string", "minLength": 1},
          "entityType": {"type": "string", "minLength": 1},
          "sourceKind": {"type": "string", "minLength": 1},
          "sourceUrl": {"type": "string", "pattern": "^https://"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "batchRef": {"$ref": "#/$defs/ref"},
    "sourceSetDigest": {"$ref": "#/$defs/sha256"},
    "reportDigest": {"$ref": "#/$defs/sha256"}
  },
  "anyOf": [
    {"properties": {"counts": {"properties": {"homepageRequired": {"minimum": 1}}}}},
    {"properties": {"counts": {"properties": {"articleRequired": {"minimum": 1}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "fileSha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "fileSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
