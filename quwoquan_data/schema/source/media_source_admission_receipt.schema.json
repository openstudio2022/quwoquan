{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/media_source_admission_receipt.schema.json",
  "title": "Create-once media source admission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admissionId",
    "assetKind",
    "objectRef",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "evidenceRootDigest",
    "evidenceBindings",
    "assetSnapshot",
    "sourceReview",
    "admissionDecision",
    "blockers",
    "recordedAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.media_source_admission_receipt"},
    "admissionId": {
      "type": "string",
      "pattern": "^media-source-admission-[0-9a-f]{64}$"
    },
    "assetKind": {"enum": ["image", "video"]},
    "objectRef": {"type": "string", "minLength": 1},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "evidenceRootDigest": {"$ref": "#/$defs/sha256"},
    "evidenceBindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceBinding"}
    },
    "assetSnapshot": {"$ref": "#/$defs/assetSnapshot"},
    "sourceReview": {"$ref": "#/$defs/sourceReview"},
    "admissionDecision": {"enum": ["accepted", "blocked"]},
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    },
    "recordedAt": {"type": "string", "minLength": 1},
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"assetKind": {"const": "image"}},
        "required": ["assetKind"]
      },
      "then": {
        "properties": {
          "objectRef": {"pattern": "^posts/image/"},
          "assetSnapshot": {
            "allOf": [
              {"$ref": "#/$defs/assetSnapshot"},
              {"required": ["width", "height", "sourceAttribution"]}
            ]
          }
        }
      },
      "else": {
        "properties": {
          "objectRef": {"pattern": "^posts/video/"},
          "assetSnapshot": {
            "allOf": [
              {"$ref": "#/$defs/assetSnapshot"},
              {"required": ["sourceKind", "mediaProbe", "popularitySignals"]}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"admissionDecision": {"const": "accepted"}},
        "required": ["admissionDecision"]
      },
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "sourceReview": {
            "type": "object",
            "properties": {
              "status": {"const": "passed"},
              "entityMatch": {"const": "matched"},
              "qualityStatus": {"const": "passed"},
              "privacyRisk": {"const": "none"},
              "minorRisk": {"const": "none"},
              "maliciousMediaRisk": {"const": "none"},
              "watermarkStatus": {"const": "absent"}
            }
          },
          "assetSnapshot": {
            "type": "object",
            "properties": {
              "acquisitionStatus": {"const": "acquired"},
              "rightsStatus": {"enum": ["verified", "unverified", "unknown"]},
              "distributionDecision": {
                "enum": ["research_allowed", "commercial_allowed"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {"blockers": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "documentDigest", "fileSha256"],
      "properties": {
        "role": {
          "enum": [
            "catalog",
            "acquisition",
            "media_probe",
            "rights_attribution",
            "source_semantic_review"
          ]
        },
        "ref": {"$ref": "#/$defs/safeRef"},
        "documentDigest": {"$ref": "#/$defs/sha256"},
        "fileSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "entityId",
        "observedEntityId",
        "contentSha256",
        "assetRef",
        "provider",
        "platform",
        "sourceUrl",
        "creator",
        "capturedAt",
        "acquisitionStatus",
        "rightsStatus",
        "authorizationRequired",
        "distributionDecision"
      ],
      "properties": {
        "assetId": {"type": "string", "minLength": 1},
        "entityId": {"type": "string", "minLength": 1},
        "observedEntityId": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "assetRef": {"$ref": "#/$defs/safeRef"},
        "provider": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "acquisitionStatus": {"enum": ["acquired", "failed", "blocked"]},
        "rightsStatus": {"enum": ["verified", "unverified", "restricted", "unknown"]},
        "authorizationRequired": {"type": "boolean"},
        "distributionDecision": {
          "enum": ["research_allowed", "commercial_allowed", "blocked"]
        },
        "sourceAttribution": {
          "$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"
        },
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sourceKind": {"type": "string", "minLength": 1},
        "mediaProbe": {
          "$ref": "professional_video_acquisition_receipt.schema.json#/$defs/mediaProbe"
        },
        "popularitySignals": {
          "$ref": "professional_video_acquisition_receipt.schema.json#/$defs/popularitySignals"
        }
      }
    },
    "sourceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entityMatch",
        "qualityStatus",
        "privacyRisk",
        "minorRisk",
        "maliciousMediaRisk",
        "watermarkStatus",
        "findings"
      ],
      "properties": {
        "status": {"enum": ["passed", "blocked", "pending"]},
        "entityMatch": {"enum": ["matched", "mismatch", "unknown"]},
        "qualityStatus": {"enum": ["passed", "blocked", "unknown"]},
        "privacyRisk": {"enum": ["none", "present", "unknown"]},
        "minorRisk": {"enum": ["none", "present", "unknown"]},
        "maliciousMediaRisk": {"enum": ["none", "present", "unknown"]},
        "watermarkStatus": {"enum": ["absent", "present", "unknown"]},
        "findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^DATA\\.[A-Z_]+\\.[A-Z_]+$"
        },
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
