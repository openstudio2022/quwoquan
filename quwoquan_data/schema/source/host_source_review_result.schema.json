{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/host_source_review_result.schema.json",
  "title": "Validated create-once host source semantic review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "requestRef", "requestDigest", "sourceIdentity",
    "assetBinding", "entityBinding", "evidenceBindings", "rubric", "actor",
    "reviewedAt", "verdict", "resultDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.host_source_review_result"},
    "requestRef": {"$ref": "host_source_review_result_input.schema.json#/$defs/safeRef"},
    "requestDigest": {"$ref": "host_source_review_result_input.schema.json#/$defs/sha256"},
    "sourceIdentity": {"$ref": "host_source_review_request.schema.json#/$defs/sourceIdentity"},
    "assetBinding": {"$ref": "host_source_review_request.schema.json#/$defs/assetBinding"},
    "entityBinding": {"$ref": "host_source_review_request.schema.json#/$defs/entityBinding"},
    "evidenceBindings": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "host_source_review_request.schema.json#/$defs/evidenceBinding"}
    },
    "rubric": {"$ref": "host_source_review_request.schema.json#/$defs/rubric"},
    "actor": {"$ref": "host_source_review_result_input.schema.json#/$defs/actor"},
    "reviewedAt": {"type": "string", "format": "date-time", "minLength": 1},
    "verdict": {"$ref": "host_source_review_result_input.schema.json#/$defs/verdict"},
    "resultDigest": {"$ref": "host_source_review_result_input.schema.json#/$defs/sha256"}
  }
}
