{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1.download source unit meta",
  "type": "object",
  "required": [
    "schemaVersion",
    "stage",
    "executionId",
    "executionBinding",
    "sourceUnitId",
    "entityName",
    "title",
    "sourceKind",
    "extractor",
    "canonicalUrl",
    "finalUrl",
    "fetchedAt",
    "rawSha256",
    "cleanSha256",
    "policyRevision",
    "rightsMode"
  ],
  "properties": {
    "schemaVersion": { "const": "quwoquan_data.source_unit" },
    "stage": { "const": "1.download" },
    "executionId": { "type": "string", "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(canary|m1|m2|m3)-[0-9]{3,}$" },
    "executionBinding": { "enum": ["frozen", "standalone"] },
    "sourceUnitId": { "type": "string", "minLength": 1 },
    "entityName": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sourceKind": {
      "enum": ["wikipedia", "baidu_baike", "sogou_baike", "toutiao_baike"]
    },
    "extractor": {
      "enum": ["wikipedia_api", "baidu_baike_html", "sogou_baike_html", "toutiao_baike_html"]
    },
    "canonicalUrl": { "type": "string", "pattern": "^https://" },
    "finalUrl": { "type": "string", "pattern": "^https://" },
    "requestedTitle": { "type": "string", "minLength": 1 },
    "resolvedTitle": { "type": "string", "minLength": 1 },
    "redirectChain": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "fetchedAt": { "type": "string", "minLength": 1 },
    "rawSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cleanSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policyRevision": { "const": "encyclopedia-primary-v2" },
    "rightsMode": {
      "enum": ["licensed_adaptation", "factual_reference_only", "blocked"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "sourceKind": { "const": "wikipedia" },
        "extractor": { "const": "wikipedia_api" },
        "canonicalUrl": { "pattern": "^https://(zh|en)\\.wikipedia\\.org/" }
      }
    },
    {
      "properties": {
        "sourceKind": { "const": "baidu_baike" },
        "extractor": { "const": "baidu_baike_html" },
        "canonicalUrl": { "pattern": "^https://baike\\.baidu\\.com/" }
      }
    },
    {
      "properties": {
        "sourceKind": { "const": "sogou_baike" },
        "extractor": { "const": "sogou_baike_html" },
        "canonicalUrl": { "pattern": "^https://baike\\.sogou\\.com/" }
      }
    },
    {
      "properties": {
        "sourceKind": { "const": "toutiao_baike" },
        "extractor": { "const": "toutiao_baike_html" },
        "canonicalUrl": { "pattern": "^https://www\\.baike\\.com/" }
      }
    }
  ]
}
