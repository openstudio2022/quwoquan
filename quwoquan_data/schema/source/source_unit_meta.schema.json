{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1.download source unit meta",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "executionId",
    "executionBinding",
    "sourceUnitId",
    "entityName",
    "title",
    "sourceKind",
    "extractor",
    "canonicalUrl",
    "finalUrl",
    "fetchedAt",
    "rawSha256",
    "cleanSha256",
    "policyRevision",
    "sourceUseMode",
    "rightsMode"
  ],
  "properties": {
    "stage": {
      "const": "1.download"
    },
    "executionId": {
      "type": "string",
      "pattern": "^20[0-9]{6}--[a-z][a-z0-9-]*-(homepage|article|image|video)-[a-z][a-z0-9-]*--[a-z0-9][a-z0-9-]*--(pilot|scale|full)-[0-9]{3,}$"
    },
    "executionBinding": {
      "enum": [
        "frozen",
        "standalone"
      ]
    },
    "sourceUnitId": {
      "type": "string",
      "minLength": 1
    },
    "entityName": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceKind": {
      "enum": [
        "wikipedia",
        "baidu_baike",
        "toutiao_baike",
        "douyin",
        "tiktok",
        "weibo",
        "toutiao",
        "tourism_video_site",
        "image_collection"
      ]
    },
    "extractor": {
      "enum": [
        "wikipedia_api",
        "baidu_baike_html",
        "toutiao_baike_html",
        "sourced_video_direct_download",
        "image_collection_download"
      ]
    },
    "canonicalUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "finalUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "requestedTitle": {
      "type": "string",
      "minLength": 1
    },
    "resolvedTitle": {
      "type": "string",
      "minLength": 1
    },
    "qualifiedAuthorityTitle": {
      "type": "string",
      "minLength": 1,
      "description": "Frozen homepage authority title admitted during target selection."
    },
    "redirectChain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fetchedAt": {
      "type": "string",
      "minLength": 1
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cleanSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyRevision": {
      "enum": [
        "encyclopedia-primary",
        "sourced-video-attribution",
        "image-collection-attribution"
      ]
    },
    "sourceUseMode": {
      "enum": [
        "licensed_adaptation",
        "factual_reference_only",
        "rights_audit_only",
        "blocked"
      ]
    },
    "rightsMode": {
      "enum": [
        "licensed_adaptation",
        "factual_reference_only",
        "attribution_no_watermark",
        "rights_audit_only",
        "blocked"
      ]
    },
    "schema": {
      "const": "quwoquan_data.source_unit"
    }
  },
  "oneOf": [
    {
      "properties": {
        "sourceKind": {
          "const": "wikipedia"
        },
        "extractor": {
          "const": "wikipedia_api"
        },
        "canonicalUrl": {
          "pattern": "^https://(zh|en)\\.wikipedia\\.org/"
        }
      }
    },
    {
      "properties": {
        "sourceKind": {
          "const": "baidu_baike"
        },
        "extractor": {
          "const": "baidu_baike_html"
        },
        "canonicalUrl": {
          "pattern": "^https://baike\\.baidu\\.com/item/"
        }
      }
    },
    {
      "properties": {
        "sourceKind": {
          "const": "toutiao_baike"
        },
        "extractor": {
          "const": "toutiao_baike_html"
        },
        "canonicalUrl": {
          "pattern": "^https://www\\.baike\\.com/"
        }
      }
    },
    {
      "required": [
        "researchLane",
        "hasVideo"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "douyin",
            "tiktok",
            "weibo",
            "toutiao",
            "tourism_video_site"
          ]
        },
        "extractor": {
          "const": "sourced_video_direct_download"
        },
        "policyRevision": {
          "const": "sourced-video-attribution"
        },
        "sourceUseMode": {
          "enum": ["licensed_adaptation", "rights_audit_only"]
        },
        "rightsMode": {
          "enum": ["attribution_no_watermark", "rights_audit_only"]
        },
        "researchLane": {
          "const": "video"
        },
        "hasVideo": {
          "const": true
        }
      }
    },
    {
      "required": [
        "researchLane",
        "hasVideo"
      ],
      "properties": {
        "sourceKind": {
          "const": "image_collection"
        },
        "extractor": {
          "const": "image_collection_download"
        },
        "policyRevision": {
          "const": "image-collection-attribution"
        },
        "sourceUseMode": {
          "const": "licensed_adaptation"
        },
        "rightsMode": {
          "const": "licensed_adaptation"
        },
        "researchLane": {
          "const": "video"
        },
        "hasVideo": {
          "const": false
        }
      }
    }
  ]
}
