{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/source_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "targetRef",
    "carrier",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "quwoquan_data.source_plan"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "targetRef": {
      "type": "string",
      "pattern": "^(?:entities/[^/]+/[^/]+/[^/]+|posts/(?:article|image|video)/[^/]+/[^/]+/[1-9][0-9]*)$"
    },
    "carrier": {
      "enum": [
        "homepage",
        "article",
        "image",
        "video"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "title",
          "purpose",
          "sourceClass",
          "sourceUseMode",
          "rightsClue"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "manualFile": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "sourceClass": {
            "type": "string",
            "minLength": 1
          },
          "sourceUseMode": {
            "enum": [
              "licensed_adaptation",
              "factual_reference_only",
              "rights_audit_only"
            ]
          },
          "rightsClue": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "manualFile",
              "contentSha256"
            ]
          }
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "url",
                "manualFile"
              ]
            }
          }
        ]
      }
    }
  }
}
