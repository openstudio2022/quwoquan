{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/object_source_refs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executionId", "objectRef", "sources"],
  "properties": {
    "schema": {"const": "quwoquan_data.object_source_refs"},
    "executionId": {"type": "string", "minLength": 1},
    "objectRef": {"type": "string", "pattern": "^(?:entities/[^/]+/[^/]+/[^/]+|posts/(?:article|image|video)/.+)$"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceUnitId", "sourceRef", "metaRef", "sourcePlanRef", "sourcePlanDigest", "chosenCandidateDigest", "sourceId", "sourceClass", "targetRefs"],
        "properties": {
          "sourceUnitId": {"type": "string", "minLength": 1},
          "sourceRef": {"type": "string", "pattern": "^sources/[^/]+/source\\.md$"},
          "metaRef": {"type": "string", "pattern": "^sources/[^/]+/meta\\.json$"},
          "sourcePlanRef": {"type": "string", "pattern": "^sources/plans/[0-9a-f]{64}\\.json$"},
          "sourcePlanDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "chosenCandidateDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sourceId": {"type": "string", "minLength": 1},
          "sourceClass": {"type": "string", "minLength": 1},
          "targetRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
