{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/article_source_unit_candidate_catalog.schema.json",
  "title": "Immutable illustrated article source-unit candidate catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogId",
    "catalogVersion",
    "policyRevision",
    "sourceRevision",
    "sourceDigest",
    "entityCatalogDigest",
    "createdAt",
    "minimumCandidateCount",
    "candidates",
    "catalogDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.article_source_unit_candidate_catalog"},
    "catalogId": {"type": "string", "minLength": 1},
    "catalogVersion": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"},
    "policyRevision": {"const": "article-source-registry-v1"},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "minLength": 1},
    "minimumCandidateCount": {"type": "integer", "minimum": 1},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "catalogDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "accessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymousPublicAccess",
        "loginRequired",
        "captchaRequired",
        "paywallRequired",
        "drmProtected",
        "accessControlBypass"
      ],
      "properties": {
        "anonymousPublicAccess": {"const": true},
        "loginRequired": {"const": false},
        "captchaRequired": {"const": false},
        "paywallRequired": {"const": false},
        "drmProtected": {"const": false},
        "accessControlBypass": {"const": false}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "role",
        "sourceUnitId",
        "sourceUnitRef",
        "assetRef",
        "originalAssetUrl",
        "sourcePageUrl",
        "platform",
        "provider",
        "creator",
        "capturedAt",
        "contentSha256",
        "license",
        "termsUrl",
        "authorizationProof",
        "authorizationRequired",
        "rightsStatus",
        "rightsIssues",
        "acquisitionStatus",
        "distributionDecision",
        "qualityStatus",
        "safetyStatus",
        "generated"
      ],
      "properties": {
        "assetId": {"type": "string", "minLength": 1},
        "role": {"enum": ["cover", "body"]},
        "sourceUnitId": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
        "sourceUnitRef": {"type": "string", "pattern": "^sources/[^/]+$"},
        "assetRef": {"type": "string", "pattern": "^sources/[^/]+/assets/.+$"},
        "originalAssetUrl": {"type": "string", "pattern": "^https://"},
        "sourcePageUrl": {"type": "string", "pattern": "^https://"},
        "platform": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": "string", "minLength": 1},
        "termsUrl": {"type": "string", "pattern": "^https://"},
        "authorizationProof": {"type": "string"},
        "authorizationRequired": {"type": "boolean"},
        "rightsStatus": {"enum": ["verified", "unverified", "unknown"]},
        "rightsIssues": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "acquisitionStatus": {"const": "acquired"},
        "distributionDecision": {"enum": ["research_allowed", "commercial_allowed"]},
        "qualityStatus": {"const": "passed"},
        "safetyStatus": {"const": "passed"},
        "generated": {"const": false}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "entityRef",
        "observedEntityRef",
        "sourceRevision",
        "sourceDigest",
        "entityCatalogDigest",
        "sourceAttribution",
        "publishMediaMode",
        "sourceUnitId",
        "sourceUnitRef",
        "sourceUnitDigest",
        "articleSiteId",
        "sourceDiscoveryProfileDigest",
        "sourceKind",
        "platform",
        "extractor",
        "policyRevision",
        "sourceUrl",
        "capturedAt",
        "bodyEvidenceRef",
        "bodyContentSha256",
        "accessEvidence",
        "assets"
      ],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "entityRef": {"type": "string", "minLength": 1},
        "observedEntityRef": {"type": "string", "minLength": 1},
        "sourceRevision": {"$ref": "#/$defs/sha256"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
        "sourceAttribution": {"$ref": "../content/post_manifest.schema.json#/$defs/sourceAttribution"},
        "publishMediaMode": {"enum": ["illustrated", "text_only"]},
        "sourceUnitId": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
        "sourceUnitRef": {"type": "string", "pattern": "^sources/[^/]+$"},
        "sourceUnitDigest": {"$ref": "#/$defs/sha256"},
        "articleSiteId": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "sourceDiscoveryProfileDigest": {"$ref": "#/$defs/sha256"},
        "sourceKind": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "extractor": {"type": "string", "minLength": 1},
        "policyRevision": {"const": "article-source-registry-v1"},
        "sourceUrl": {"type": "string", "pattern": "^https://"},
        "capturedAt": {"type": "string", "minLength": 1},
        "bodyEvidenceRef": {"type": "string", "pattern": "^sources/[^/]+/source\\.md$"},
        "bodyContentSha256": {"$ref": "#/$defs/sha256"},
        "accessEvidence": {"$ref": "#/$defs/accessEvidence"},
        "articleCategory": {"const": "photography"},
        "writingIntent": {"const": "planning_consultation"},
        "topicTagRefs": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"const": "Topic/旅行/玩法/摄影旅拍"}
        },
        "sourceClassification": {"$ref": "article_source_classification.schema.json"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      },
      "allOf": [
        {
          "if": {"properties": {"publishMediaMode": {"const": "illustrated"}}},
          "then": {"properties": {"assets": {"minItems": 2}}},
          "else": {"properties": {"assets": {"maxItems": 0}}}
        },
        {
          "if": {"required": ["articleCategory"]},
          "then": {"required": ["writingIntent", "topicTagRefs", "sourceClassification"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["writingIntent"]},
                {"required": ["topicTagRefs"]},
                {"required": ["sourceClassification"]}
              ]
            }
          }
        }
      ]
    }
  }
}
