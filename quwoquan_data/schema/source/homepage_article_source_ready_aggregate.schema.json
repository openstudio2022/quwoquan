{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data/schema/source/homepage_article_source_ready_aggregate.schema.json",
  "title": "Create-once aggregate projection over source-ready batches",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceSetId", "targetScale", "sourceRevision", "sourceDigest",
    "entityCatalogDigest", "createdAt", "memberBatches", "counts",
    "projectionDigest"
  ],
  "properties": {
    "schema": {"const": "quwoquan_data.homepage_article_source_ready_aggregate"},
    "sourceSetId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "targetScale": {"enum": ["WORKLOAD", "M100", "M1000", "M10000"]},
    "sourceRevision": {"$ref": "#/$defs/sha256"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "entityCatalogDigest": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "minLength": 1},
    "memberBatches": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/memberBatch"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "article"],
      "properties": {
        "homepage": {"type": "integer", "minimum": 1},
        "article": {"type": "integer", "minimum": 1}
      }
    },
    "projectionDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "memberBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSetId", "ref", "evidenceRootRef", "digest", "fileSha256", "counts"
      ],
      "properties": {
        "sourceSetId": {"type": "string", "minLength": 1},
        "ref": {"$ref": "#/$defs/ref"},
        "evidenceRootRef": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["homepage", "article"],
          "properties": {
            "homepage": {"type": "integer", "minimum": 0},
            "article": {"type": "integer", "minimum": 0}
          },
          "anyOf": [
            {"properties": {"homepage": {"minimum": 1}}},
            {"properties": {"article": {"minimum": 1}}}
          ]
        }
      }
    }
  }
}
