{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.creator_pool_plan",
  "type": "object",
  "required": ["schemaVersion", "vertical", "batchId", "targetCount", "creatorRefs", "diversityQuotas"],
  "properties": {
    "schemaVersion": { "const": "quwoquan_data.creator_pool_plan/1" },
    "vertical": { "type": "string" },
    "batchId": { "type": "string" },
    "targetCount": { "type": "integer", "minimum": 1 },
    "candidatePoolSize": { "type": "integer", "minimum": 1 },
    "creatorRefs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "diversityQuotas": {
      "type": "object",
      "properties": {
        "archetypeBuckets": { "type": "object", "additionalProperties": { "type": "integer" } },
        "regionBuckets": { "type": "object", "additionalProperties": { "type": "integer" } },
        "carrierBuckets": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "fixtureMode": { "type": "boolean" },
    "createdAt": { "type": "string" }
  }
}
