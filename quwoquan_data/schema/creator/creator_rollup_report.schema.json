{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.creator_rollup_report",
  "type": "object",
  "required": ["schemaVersion", "batchId", "vertical", "counts", "funnel"],
  "properties": {
    "schemaVersion": { "const": "quwoquan_data.creator_rollup_report/1" },
    "batchId": { "type": "string" },
    "vertical": { "type": "string" },
    "counts": {
      "type": "object",
      "properties": {
        "planned": { "type": "integer" },
        "acquired": { "type": "integer" },
        "scored": { "type": "integer" },
        "enriched": { "type": "integer" },
        "materialized": { "type": "integer" },
        "validated": { "type": "integer" }
      }
    },
    "funnel": {
      "type": "object",
      "properties": {
        "reviewGatePassRate": { "type": "number" },
        "provenanceCoverage": { "type": "number" },
        "tagResolveRate": { "type": "number" }
      }
    },
    "diversityReport": {
      "type": "object",
      "properties": {
        "entropy": { "type": "number" },
        "minBucketFillRate": { "type": "number" },
        "bucketFill": { "type": "object" }
      }
    },
    "generatedAt": { "type": "string" }
  }
}
