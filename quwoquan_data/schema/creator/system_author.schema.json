{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "平台虚拟创作者 / 系统作者档案。作者池是独立治理域，不作为标签或实体主树节点。",
  "type": "object",
  "required": [
    "creatorProfileId",
    "authorId",
    "subAccountId",
    "status",
    "verticalRefs",
    "scenarioRefs",
    "creatorArchetype",
    "voiceStyle",
    "claimPolicy",
    "disclosure",
    "publishCadence",
    "qualityScore",
    "fatigueScore",
    "riskTier",
    "profileVersion"
  ],
  "properties": {
    "creatorProfileId": { "type": "string", "minLength": 1 },
    "authorId": { "type": "string", "minLength": 1 },
    "subAccountId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ai_reviewed", "active", "throttled", "suspended", "retired"] },
    "verticalRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scenarioRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "creatorArchetype": { "type": "string", "minLength": 1 },
    "isSystemBuiltin": { "type": "boolean" },
    "isVirtualSystemCreator": { "const": true },
    "displayName": { "type": "string" },
    "userHandle": { "type": "string" },
    "voiceStyle": {
      "type": "object",
      "required": ["forbidFakeFirstPersonExperience"],
      "properties": {
        "pointOfView": { "type": "string" },
        "tone": { "type": "string" },
        "forbidFakeFirstPersonExperience": { "const": true }
      }
    },
    "claimPolicy": {
      "type": "object",
      "required": ["experienceClaimMode", "mayUseFirstPerson", "mustCiteEvidenceForClaims", "forbiddenClaims"],
      "properties": {
        "experienceClaimMode": {
          "enum": ["editorial_synthesis", "authorized_first_person", "public_data_analysis", "visual_discovery"]
        },
        "mayUseFirstPerson": { "type": "boolean" },
        "mustCiteEvidenceForClaims": { "const": true },
        "forbiddenClaims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disclosure": {
      "type": "object",
      "required": ["type", "displayText", "visible"],
      "properties": {
        "type": { "const": "platform_virtual_creator" },
        "displayText": { "type": "string", "minLength": 1 },
        "visible": { "const": true }
      }
    },
    "publishCadence": {
      "type": "object",
      "required": ["intervalDays", "randomizedRangeDays", "maxDailyPosts"],
      "properties": {
        "intervalDays": { "type": "integer", "minimum": 1, "maximum": 5 },
        "randomizedRangeDays": {
          "type": "array",
          "prefixItems": [{ "const": 1 }, { "const": 5 }],
          "items": false
        },
        "maxDailyPosts": { "type": "integer", "maximum": 1 }
      }
    },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "fatigueScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskTier": { "enum": ["low", "medium", "high"] },
    "profileVersion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
