{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.creator_bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "creatorProfileId",
    "subAccountId",
    "authorId",
    "creatorArchetype",
    "identity",
    "profile",
    "classification",
    "tags",
    "content",
    "contentAffinity",
    "relations",
    "operations",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "quwoquan_data.creator_bundle/1" },
    "creatorProfileId": { "type": "string", "minLength": 1 },
    "subAccountId": { "type": "string", "minLength": 1 },
    "authorId": { "type": "string", "minLength": 1 },
    "creatorArchetype": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "required": [
        "creatorProfileId",
        "subAccountId",
        "authorId",
        "userHandle",
        "personaVersion",
        "sourceClonePolicy"
      ],
      "properties": {
        "creatorProfileId": { "type": "string", "minLength": 1 },
        "subAccountId": { "type": "string", "minLength": 1 },
        "authorId": { "type": "string", "minLength": 1 },
        "userHandle": { "type": "string", "minLength": 1 },
        "personaVersion": { "const": "derivative_persona_v1" },
        "sourceClonePolicy": { "const": "no_real_name_no_avatar_no_bio_copy" }
      }
    },
    "sourceMetrics": {
      "type": "object",
      "properties": {
        "engagementScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "outputScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "platformStyle": { "type": "string" },
        "popularityTier": { "enum": ["head", "waist", "rising", "niche_expert"] },
        "outputTier": { "enum": ["prolific", "steady", "seasonal"] }
      }
    },
    "diversitySlots": {
      "type": "object",
      "required": ["regionBucket", "archetypeBucket", "carrierBucket"],
      "properties": {
        "regionBucket": { "type": "string" },
        "archetypeBucket": { "type": "string" },
        "carrierBucket": { "type": "string" },
        "platformBucket": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceKind",
        "derivationPolicy",
        "citedSourcePaths",
        "rightsPolicy",
        "modelReleaseStatus",
        "validationOnly",
        "crawlAllowed",
        "commercialReadiness"
      ],
      "properties": {
        "sourceKind": {
          "enum": ["open_web_profile", "open_rss", "wikimedia", "tourism_board", "site_supply_author", "fixture_synthetic"]
        },
        "sourceUrl": { "type": "string" },
        "sourceSiteId": { "type": ["string", "null"] },
        "sourceRegionClass": { "type": ["string", "null"] },
        "rightsPolicy": { "type": "string" },
        "modelReleaseStatus": { "type": "string" },
        "validationOnly": { "type": "boolean" },
        "crawlAllowed": { "type": "boolean" },
        "commercialReadiness": {
          "type": "object",
          "required": ["appPublishAllowed", "personaPolicy", "sourceClonePolicy"],
          "properties": {
            "appPublishAllowed": { "type": "boolean" },
            "personaPolicy": { "const": "derivative_persona_v1" },
            "sourceClonePolicy": { "const": "no_real_name_no_avatar_no_bio_copy" }
          }
        },
        "extractedSignals": { "type": "object" },
        "derivationPolicy": { "const": "derivative_persona_v1" },
        "citedSourcePaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "displayName",
        "userHandle",
        "bio",
        "headline",
        "slogan",
        "avatarObjectKey",
        "backgroundObjectKey",
        "ipLocation"
      ],
      "properties": {
        "displayName": { "type": "string" },
        "userHandle": { "type": "string" },
        "bio": { "type": "string" },
        "headline": { "type": "string" },
        "slogan": { "type": "string", "minLength": 1 },
        "avatarObjectKey": { "type": "string" },
        "backgroundObjectKey": { "type": "string" },
        "ipLocation": {
          "type": "object",
          "required": ["countryCode", "regionRef", "displayText", "source"],
          "properties": {
            "countryCode": { "type": "string", "minLength": 2 },
            "regionRef": { "type": "string", "minLength": 1 },
            "cityRef": { "type": "string" },
            "displayText": { "type": "string", "minLength": 1 },
            "source": { "const": "derived_from_region_bucket" }
          }
        },
        "identityTags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "required": ["verticalSegment", "creatorArchetype", "verticalRefs", "interestTagRefs", "publicProfileTagRefs", "creatorClassTagRefs"],
      "properties": {
        "verticalSegment": {
          "enum": ["travel_primary", "photography_primary", "travel_photography_cross"]
        },
        "creatorArchetype": { "type": "string", "minLength": 1 },
        "verticalRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "interestTagRefs": { "type": "array", "items": { "type": "string" } },
        "publicProfileTagRefs": { "type": "array", "items": { "type": "string" } },
        "creatorClassTagRefs": { "type": "array", "items": { "type": "string" } },
        "occupationTagRef": { "type": "string" }
      }
    },
    "tags": {
      "type": "object",
      "properties": {
        "occupationTagRef": { "type": "string" },
        "interestTagRefs": { "type": "array", "items": { "type": "string" } },
        "creatorClassTagRefs": { "type": "array", "items": { "type": "string" } },
        "publicProfileTagRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relations": {
      "type": "object",
      "required": ["joinedCircleIds", "followedHomepageCanonicalIds", "entityAffinityRefs", "circleAffinityRefs", "relationSeedPolicy"],
      "properties": {
        "joinedCircleIds": { "type": "array", "items": { "type": "string" } },
        "followedHomepageCanonicalIds": { "type": "array", "items": { "type": "string" } },
        "entityAffinityRefs": { "type": "array", "items": { "type": "string" } },
        "circleAffinityRefs": { "type": "array", "items": { "type": "string" } },
        "relationSeedPolicy": { "const": "deterministic_v1" }
      }
    },
    "content": {
      "type": "object",
      "required": ["verticalRefs", "carrierAffinity", "voiceStyle", "publishCadence", "disclosure", "claimPolicy"],
      "properties": {
        "verticalRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scenarioRefs": { "type": "array", "items": { "type": "string" } },
        "carrierAffinity": {
          "type": "object",
          "required": ["article", "image", "video"],
          "properties": {
            "article": { "type": "number", "minimum": 0, "maximum": 1 },
            "image": { "type": "number", "minimum": 0, "maximum": 1 },
            "video": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "coverageScope": { "type": "object" },
        "preferredBlueprintIds": { "type": "array", "items": { "type": "string" } },
        "voiceStyle": { "type": "object" },
        "publishCadence": { "type": "object" },
        "disclosure": { "type": "object" },
        "claimPolicy": { "type": "object" }
      }
    },
    "contentAffinity": {
      "type": "object",
      "required": ["carrierAffinity", "coverageScope", "preferredBlueprintIds", "voiceStyle", "publishCadence", "disclosure", "claimPolicy"],
      "properties": {
        "carrierAffinity": { "type": "object" },
        "coverageScope": { "type": "object" },
        "preferredBlueprintIds": { "type": "array", "items": { "type": "string" } },
        "voiceStyle": { "type": "object" },
        "publishCadence": { "type": "object" },
        "disclosure": { "type": "object" },
        "claimPolicy": { "type": "object" }
      }
    },
    "operations": {
      "type": "object",
      "required": ["cohortId", "batchId", "shardId", "envEligibility", "status", "riskTier", "importVersion"],
      "properties": {
        "cohortId": { "type": "string" },
        "batchId": { "type": "string" },
        "shardId": { "type": "string" },
        "envEligibility": {
          "type": "array",
          "items": { "enum": ["alpha", "beta", "gamma", "prod"] },
          "minItems": 1
        },
        "status": { "enum": ["draft", "active", "throttled", "retired"] },
        "maxDailyPosts": { "type": "integer", "maximum": 1 },
        "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "fatigueScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "riskTier": { "enum": ["low", "medium", "high"] },
        "importVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
