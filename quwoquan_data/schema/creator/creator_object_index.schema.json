{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quwoquan_data.creator_object_index",
  "type": "object",
  "required": ["schemaVersion", "batchId", "objects"],
  "properties": {
    "schemaVersion": { "const": "quwoquan_data.creator_object_index/1" },
    "batchId": { "type": "string" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["creatorRef", "stage"],
        "properties": {
          "creatorRef": { "type": "string" },
          "stage": {
            "enum": ["planned", "acquire", "score", "enrich", "materialize", "validate", "seeded"]
          },
          "archetype": { "type": "string" },
          "regionBucket": { "type": "string" }
        }
      }
    }
  }
}
