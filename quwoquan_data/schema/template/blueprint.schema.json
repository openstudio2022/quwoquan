{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "templateId",
    "version",
    "subject",
    "vertical",
    "intent",
    "carrier",
    "styleFamily",
    "styleProfile",
    "audiences",
    "editorialIntent",
    "render",
    "structure",
    "wordCount",
    "imagePlan",
    "crossRefs",
    "recommendation"
  ],
  "properties": {
    "templateId": { "type": "string" },
    "version": { "type": "integer" },
    "subject": { "type": "object" },
    "vertical": { "type": "string" },
    "category": { "type": "string" },
    "intent": { "type": "string" },
    "carrier": { "type": "string" },
    "styleFamily": { "type": "string" },
    "styleProfile": { "type": "object" },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "creatorPersona": { "type": "object" },
    "editorialIntent": { "type": "string" },
    "render": { "type": "object" },
    "structure": { "type": "object" },
    "hooks": { "type": "array", "items": { "type": "string" } },
    "mustIncludeFacts": { "type": "array", "items": { "type": "string" } },
    "forbiddenPhrases": { "type": "array", "items": { "type": "string" } },
    "wordCount": { "type": "object" },
    "imagePlan": { "type": "array" },
    "crossRefs": { "type": "object" },
    "recommendation": { "type": "object" },
    "conditionAxes": {
      "type": "object",
      "description": "声明地域/季节条件修饰维是否适用，以及注入正文的中性段名。内容来自 region_catalog/season_catalog。",
      "properties": {
        "region": {
          "type": "object",
          "properties": {
            "applicable": { "type": "boolean" },
            "slot": { "type": "string" }
          }
        },
        "season": {
          "type": "object",
          "properties": {
            "applicable": { "type": "boolean" },
            "slot": { "type": "string" }
          }
        }
      }
    },
    "sopExampleRef": { "type": "string" }
  }
}
