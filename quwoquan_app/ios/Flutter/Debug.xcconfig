#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// 明确设置 SDK 路径，避免 native_assets 构建错误
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
QWQ_APS_ENVIRONMENT = development

// Flutter tooling compatibility config. Flavored Runner targets use
// Base/Debug.xcconfig and select their exact dependency graph in the wrapper.
