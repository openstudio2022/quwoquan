{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "python3 quwoquan_ops/hooks/subagent_start_guard.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 quwoquan_ops/hooks/shell_cli_first_guard.py",
        "matcher": "python"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 quwoquan_ops/hooks/draft_quickcheck.py"
      }
    ]
  }
}
