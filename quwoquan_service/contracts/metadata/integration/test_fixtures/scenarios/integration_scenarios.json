{
  "schemaVersion": "integration.scenario-fixtures",
  "description": "集成域 alpha/beta/gamma 共享测试场景，首批覆盖发布位置选择。",
  "repositoryExpectations": {
    "alpha": "mock",
    "beta": "remote",
    "gamma": "remote"
  },
  "seedSets": {
    "location_poi_core": {
      "description": "附近地点与搜索地点。",
      "pois": [
        {
          "poiId": "fixture_poi_west_lake",
          "name": "杭州西湖",
          "address": "浙江省杭州市西湖区",
          "city": "杭州",
          "province": "浙江",
          "lat": 30.2431,
          "lng": 120.1505
        },
        {
          "poiId": "fixture_poi_coffee",
          "name": "契约咖啡馆",
          "address": "杭州市测试路 1 号",
          "city": "杭州",
          "province": "浙江",
          "lat": 30.25,
          "lng": 120.16
        }
      ]
    },
    "external_interaction_core": {
      "description": "外部可靠交互 mock provider 种子。",
      "requests": [
        {
          "requestId": "fixture_ext_sms_otp_001",
          "operation": "sms_otp.send",
          "idempotencyKey": "otp:+8618013813909:fixture",
          "callbackEvent": "SmsOtpDeliverySucceeded",
          "status": "accepted"
        },
        {
          "requestId": "fixture_ext_push_001",
          "operation": "push_delivery.send",
          "idempotencyKey": "push:notification-fixture:device-fixture",
          "callbackEvent": "PushDeliverySucceeded",
          "status": "accepted"
        }
      ],
      "providerPolicy": {
        "sms_otp.send": {
          "primaryProvider": "mock_sms",
          "backupProvider": "mock_sms",
          "maxAttempts": 3
        },
        "push_delivery.send": {
          "primaryProvider": "mock_push",
          "backupProvider": "mock_push",
          "maxAttempts": 3
        }
      },
      "passThroughDebt": {
        "enabled": true,
        "debtId": "TECHDEBT-SMS-OTP-PASSTHROUGH-001",
        "owner": "backend-team",
        "expiresAt": "2026-08-31",
        "prodAllowed": false
      }
    }
  },
  "scenarios": [
    {
      "id": "integration_location_poi_basic",
      "title": "发布位置选择契约种子",
      "type": "location_poi",
      "domainId": "integration",
      "seedRefs": ["location_poi_core"],
      "uiExpectations": {
        "poiIds": ["fixture_poi_west_lake", "fixture_poi_coffee"],
        "textFragments": ["杭州西湖", "契约咖啡馆"]
      },
      "remoteExpectations": {
        "poiIds": ["fixture_poi_west_lake", "fixture_poi_coffee"]
      },
      "environments": {
        "alpha": { "enabled": true, "repository": "mock" },
        "beta": { "enabled": true, "repository": "remote", "requiresSeedReset": true },
        "gamma": { "enabled": true, "repository": "remote", "requiresSeedReset": true }
      }
    },
    {
      "id": "integration_external_interaction_sms_otp_async",
      "title": "短信验证码可靠异步发送契约种子",
      "type": "external_interaction",
      "domainId": "integration",
      "seedRefs": ["external_interaction_core"],
      "remoteExpectations": {
        "requestIds": ["fixture_ext_sms_otp_001"],
        "operations": ["sms_otp.send"],
        "acceptedStatus": 202,
        "callbackEvents": ["SmsOtpDeliverySucceeded"]
      },
      "environments": {
        "alpha": { "enabled": true, "repository": "mock" },
        "beta": { "enabled": true, "repository": "remote", "requiresSeedReset": true },
        "gamma": { "enabled": true, "repository": "remote", "requiresSeedReset": true }
      }
    },
    {
      "id": "integration_push_delivery_async",
      "title": "手机推送可靠异步发送契约种子",
      "type": "push_delivery",
      "domainId": "integration",
      "seedRefs": ["external_interaction_core"],
      "remoteExpectations": {
        "requestIds": ["fixture_ext_push_001"],
        "operations": ["push_delivery.send"],
        "acceptedStatus": 202,
        "callbackEvents": ["PushDeliverySucceeded"]
      },
      "environments": {
        "alpha": { "enabled": true, "repository": "mock" },
        "beta": { "enabled": true, "repository": "remote", "requiresSeedReset": true },
        "gamma": { "enabled": true, "repository": "remote", "requiresSeedReset": true }
      }
    }
  ]
}
