        "port": 443
      },
      {
        "prefix": "/chat",
        "service": "chat-service",
        "port": 443
      },
      {
        "prefix": "/user",
        "service": "user-service",
        "port": 443
      },
      {
        "prefix": "/me",
        "service": "user-service",
        "port": 443
      },
      {
        "prefix": "/homepages",
        "service": "entity-service",
        "port": 443
      },
      {
        "prefix": "/integration",
        "service": "integration-service",
        "port": 443
      },
      {
        "prefix": "/search",
        "service": "search-service",
        "port": 443
      },
      {
        "prefix": "/app-messages",
        "service": "notification-service",
        "port": 443
      },
      {
        "prefix": "/rtc",
        "service": "rtc-service",
        "port": 443
      }
    ]
  },
  "mediaSeedRef": "quwoquan_ops/environments/media_delivery_manifest.json",
  "mediaCanary": {
    "profileRef": "quwoquan_data/reference/media_canary/video_playback.yaml",
    "readyAssetIds": [
      "media-canary-seek-125s",
      "media-canary-hour-boundary-3595s"
    ],
    "rejectionAssetIds": [
      "media-canary-over-limit-3605s"
