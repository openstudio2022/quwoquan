{
  "environment": "gamma",
  "acceptancePrincipal": {
    "ownerId": "fixture_user_current",
    "personaId": "fixture_user_current"
  },
  "description": "gamma 云侧精简清单：只装载声明的 curated 业务对象及其完整媒体闭包，alpha/beta 继续保持全量共享池。",
  "releaseInputs": [
    {
      "objectId": "content.filter_catalog_release",
      "manifestPath": "quwoquan_data/reference/filter_catalog/releases/filter-catalog-20260720-001/environments/gamma.seed.json"
    }
  ],
  "seedRefs": [
    {
      "domain": "assistant",
      "fixturePath": "assistant/test_fixtures/scenarios/assistant_scenarios.json",
      "refs": [
        "assistant_p0_core",
        "skill_management_core"
      ],
      "resetScope": "fixture_assistant_*",
      "targetStore": "mongodb:assistant.skill_subscriptions+redis:assistant-runtime",
      "verifiedEndpoints": [
        "/assistant/conversations",
        "/assistant/skill-subscriptions"
      ]
    },
    {
      "domain": "content",
      "fixturePath": "content/test_fixtures/scenarios/content_scenarios.gamma-curated.json",
      "refs": [
        "content_discovery_core",
        "comment_thread_core",
        "intersection_core",
        "home_showcase_core",
        "profile_share_interaction_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_content_*",
      "targetStore": "content-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/content/feed",
        "/content/posts/fixture_photo_001",
        "/content/posts/fixture_photo_001/comments",
        "/content/posts/fixture_photo_001/comments?sort=recommended",
        "/content/posts/fixture_photo_001/comments/fixture_comment_parent_001/replies",
        "/content/sub-accounts/{activePersonaId}/interactions/received?type=share",
        "/content/sub-accounts/{activePersonaId}/interactions/sent?type=share"
      ]
    },
    {
      "domain": "circle",
      "fixturePath": "social/circle/test_fixtures/scenarios/circle_scenarios.gamma-curated.json",
      "refs": [
        "circle_core",
        "circle_group_chat_link_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_circle_*",
      "targetStore": "circle-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/circles",
        "/circles/fixture_circle_photo"
      ]
    },
    {
      "domain": "chat",
      "fixturePath": "messages/chat/test_fixtures/scenarios/chat_scenarios.gamma-curated.json",
      "refs": [
        "chat_core",
        "chat_contacts_core",
        "chat_group_flow_core"
      ],
      "resetScope": "fixture_chat_*",
      "targetStore": "chat-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/chat/inbox",
        "/chat/conversations/fixture_conv_direct/messages"
      ]
    },
    {
      "domain": "user",
      "fixturePath": "user/test_fixtures/scenarios/user_scenarios.gamma-curated.json",
      "refs": [
        "user_profile_core",
        "persona_core",
        "profile_feed_core",
        "relationship_core",
        "greeting_core",
        "subject_follow_core",
        "contact_discovery_core",
        "following_subject_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_user_*",
      "targetStore": "user-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/user/profile/fixture_user_current",
        "/me",
        "/user/following-subjects",
        "/user/greeting-request/inbox",
        "/owner/contact-discovery/latest"
      ]
    },
    {
      "domain": "entity",
      "fixturePath": "entity/test_fixtures/scenarios/entity_scenarios.gamma-curated.json",
      "refs": [
        "entity_homepage_core",
        "entity_claim_core",
        "entity_picker_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "homepages authoritative collection in quwoquan_entity (ship/import sync+offline-stale 幂等重放)",
      "targetStore": "mongodb:quwoquan_entity.homepages",
      "seedChannel": "promote→qwq-data ship --import→entity-service homepage-import（与 beta 同通道、env 参数区分）",
      "verifiedEndpoints": [
        "/homepages/search",
        "/homepages/{homepageId}/object-page-bundle",
        "/homepages/{homepageId}/introduction"
      ]
    },
    {
      "domain": "integration",
      "fixturePath": "integration/test_fixtures/scenarios/integration_scenarios.json",
      "refs": [
        "location_poi_core"
      ],
      "resetScope": "fixture_integration_*",
      "targetStore": "integration-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/integration/locations/pois"
      ]
    },
    {
      "domain": "search",
      "fixturePath": "search/test_fixtures/scenarios/search_scenarios.json",
      "refs": [
        "search_remote_acceptance"
      ],
      "resetScope": "derived quwoquan_objects index + quwoquan_search acceptance facts",
      "targetStore": "elasticsearch:quwoquan_objects+mongodb:quwoquan_search",
      "verifiedEndpoints": [
        "/search",
        "/search/hot-queries",
        "/search/feedback"
      ],
      "deliveryChannels": [
        "content/entity/circle/user search-backfill",
        "search-service queryheat rebuild"
      ]
    },
    {
      "domain": "notification",
      "fixturePath": "notification/test_fixtures/scenarios/notification_scenarios.json",
      "refs": [
        "notification_core"
      ],
      "resetScope": "fixture_notification_*",
      "targetStore": "notification-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/app-messages"
      ]
    },
    {
      "domain": "rtc",
      "fixturePath": "rtc/test_fixtures/scenarios/rtc_scenarios.json",
      "refs": [
        "rtc_core"
      ],
      "resetScope": "fixture_rtc_*",
      "targetStore": "rtc-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/rtc/calls"
      ]
    },
    {
      "domain": "recommendation",
      "fixturePath": "_shared/test_fixtures/content_recommendation_object_cards.gamma_seed.json",
      "refs": [
        "object_cards_gamma_acceptance"
      ],
      "applyScript": "quwoquan_service/services/seed-box/scripts/apply_content_object_cards_seed.py",
      "resetScope": "gamma_object_cards_seed",
      "targetStore": "content-service:quwoquan_content",
      "verifiedEndpoints": [
        "/content/feed"
      ],
      "supplementaryFixtures": [
        "_shared/test_fixtures/content_recommendation_social_graph.gamma_seed.json",
        "_shared/test_fixtures/content_recommendation_moment_channel.gamma_seed.json"
      ]
    }
  ],
  "verificationScopes": {
    "object-homepage-gamma-real-data-closure": {
      "description": "只严格检查交集四主页/对象页商用闭环所需的 content + entity + circle + user 端点与 typed probes。",
      "domains": [
        "content",
        "entity",
        "circle",
        "user"
      ],
      "runtimeRefs": {
        "{viewerId}": "fixture_user_current",
        "{homepageId}": "homepage_sight_west_lake",
        "{circleId}": "fixture_circle_photo"
      },
      "strictEndpoints": [
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/object-page-bundle",
          "assertion": "entity_homepage_bundle"
        },
        {
          "domain": "entity",
          "path": "/homepages/{seededHomepageId}/introduction",
          "assertion": "homepage_introduction"
        },
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/review-summary",
          "assertion": "homepage_review_summary"
        },
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/related-groups",
          "assertion": "homepage_related_groups"
        },
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/impact",
          "assertion": "entity_impact_summary"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}",
          "assertion": "circle_detail"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}/impact",
          "assertion": "circle_impact_summary"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}/members",
          "assertion": "circle_members_page"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}/feed",
          "assertion": "circle_feed_page"
        },
        {
          "domain": "content",
          "path": "/content/intersections/object?objectType=homepage&objectId={homepageId}",
          "assertion": "object_intersections_homepage"
        },
        {
          "domain": "content",
          "path": "/content/intersections/object?objectType=circle&objectId={circleId}",
          "assertion": "object_intersections_circle"
        },
        {
          "domain": "content",
          "path": "/content/feed?sort=recommend&channelId=recommend&limit=24",
          "assertion": "home_feed_object_cards"
        }
      ]
    }
  },
  "appAssets": {
    "alphaOnlyFixtureAllowlist": []
  },
  "gateway": {
    "routes": [
      {
        "prefix": "/assistant",
        "service": "assistant-service",
        "port": 443
      },
      {
        "prefix": "/content",
        "service": "content-service",
        "port": 443
      },
      {
        "prefix": "/circles",
