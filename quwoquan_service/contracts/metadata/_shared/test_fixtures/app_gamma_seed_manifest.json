{
  "schemaVersion": "app-seed-manifest",
  "environment": "gamma",
  "acceptancePrincipal": {
    "ownerId": "fixture_user_current",
    "personaId": "fixture_user_current"
  },
  "description": "gamma 云侧精简清单：当前 gamma 只装载约 100 图内的 curated 业务子集，alpha/beta 继续保持全量共享池。",
  "seedRefs": [
    {
      "domain": "assistant",
      "fixturePath": "assistant/test_fixtures/scenarios/assistant_scenarios.json",
      "refs": [
        "assistant_p0_core",
        "skill_management_core"
      ],
      "resetScope": "fixture_assistant_*",
      "targetStore": "mongodb:assistant.skill_subscriptions+redis:assistant-runtime",
      "verifiedEndpoints": [
        "/v1/assistant/conversations",
        "/v1/assistant/skill-subscriptions"
      ]
    },
    {
      "domain": "content",
      "fixturePath": "content/test_fixtures/scenarios/content_scenarios.gamma-curated.json",
      "refs": [
        "content_discovery_core",
        "intersection_core",
        "home_showcase_core",
        "profile_share_interaction_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_content_*",
      "targetStore": "content-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/content/feed",
        "/v1/content/posts/fixture_photo_001",
        "/v1/content/posts/fixture_photo_001/comments",
        "/v1/content/posts/fixture_photo_001/comments?sort=recommended",
        "/v1/content/posts/fixture_photo_001/comments/fixture_comment_parent_001/replies",
        "/v1/content/sub-accounts/{activePersonaId}/interactions/received?type=share",
        "/v1/content/sub-accounts/{activePersonaId}/interactions/sent?type=share"
      ]
    },
    {
      "domain": "circle",
      "fixturePath": "social/circle/test_fixtures/scenarios/circle_scenarios.gamma-curated.json",
      "refs": [
        "circle_core",
        "circle_group_chat_link_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_circle_*",
      "targetStore": "circle-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/circles",
        "/v1/circles/fixture_circle_photo"
      ]
    },
    {
      "domain": "chat",
      "fixturePath": "messages/chat/test_fixtures/scenarios/chat_scenarios.gamma-curated.json",
      "refs": [
        "chat_core",
        "chat_contacts_core",
        "chat_group_flow_core"
      ],
      "resetScope": "fixture_chat_*",
      "targetStore": "chat-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/chat/inbox",
        "/v1/chat/conversations/fixture_conv_direct/messages"
      ]
    },
    {
      "domain": "user",
      "fixturePath": "user/test_fixtures/scenarios/user_scenarios.gamma-curated.json",
      "refs": [
        "user_profile_core",
        "persona_core",
        "profile_feed_core",
        "relationship_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_user_*",
      "targetStore": "user-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/user/profile/fixture_user_current",
        "/v1/me"
      ]
    },
    {
      "domain": "creator_pool",
      "fixturePath": "_shared/test_fixtures/creator_pool/creator_pool_scenarios.json",
      "refs": [
        "creator_travel_photo_1k_v1",
        "creator_travel_photo_1k_v1_core"
      ],
      "resetScope": "fixture_creator_pool_*",
      "targetStore": "user-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/user/{subAccountId}",
        "/v1/user/sub-accounts/{subAccountId}/homepage-bundle"
      ]
    },
    {
      "domain": "entity",
      "fixturePath": "entity/test_fixtures/scenarios/entity_scenarios.gamma-curated.json",
      "refs": [
        "entity_homepage_core",
        "entity_claim_core",
        "entity_picker_core"
      ],
      "verificationScopes": [
        "object-homepage-gamma-real-data-closure"
      ],
      "resetScope": "fixture_entity_*",
      "targetStore": "entity-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/homepages/search",
        "/v1/homepages/{homepageId}/object-page-bundle",
        "/v1/homepages/{homepageId}/introduction"
      ]
    },
    {
      "domain": "integration",
      "fixturePath": "integration/test_fixtures/scenarios/integration_scenarios.json",
      "refs": [
        "location_poi_core"
      ],
      "resetScope": "fixture_integration_*",
      "targetStore": "integration-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/integration/locations/pois"
      ]
    },
    {
      "domain": "notification",
      "fixturePath": "notification/test_fixtures/scenarios/notification_scenarios.json",
      "refs": [
        "notification_core"
      ],
      "resetScope": "fixture_notification_*",
      "targetStore": "notification-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/app-messages"
      ]
    },
    {
      "domain": "rtc",
      "fixturePath": "rtc/test_fixtures/scenarios/rtc_scenarios.json",
      "refs": [
        "rtc_core"
      ],
      "resetScope": "fixture_rtc_*",
      "targetStore": "rtc-service:gamma_test_namespace",
      "verifiedEndpoints": [
        "/v1/rtc/calls"
      ]
    }
  ],
  "verificationScopes": {
    "object-homepage-gamma-real-data-closure": {
      "description": "只严格检查交集四主页/对象页商用闭环所需的 content + entity + circle + user 端点与 typed probes。",
      "domains": [
        "content",
        "entity",
        "circle",
        "user"
      ],
      "runtimeRefs": {
        "{viewerId}": "fixture_user_current",
        "{homepageId}": "homepage_sight_west_lake",
        "{circleId}": "fixture_circle_photo"
      },
      "strictEndpoints": [
        {
          "domain": "entity",
          "path": "/v1/homepages/{homepageId}/object-page-bundle",
          "assertion": "entity_homepage_bundle"
        },
        {
          "domain": "entity",
          "path": "/v1/homepages/{seededHomepageId}/introduction",
          "assertion": "homepage_introduction"
        },
        {
          "domain": "entity",
          "path": "/v1/homepages/{homepageId}/review-summary",
          "assertion": "homepage_review_summary"
        },
        {
          "domain": "entity",
          "path": "/v1/homepages/{homepageId}/related-groups",
          "assertion": "homepage_related_groups"
        },
        {
          "domain": "entity",
          "path": "/v1/homepages/{homepageId}/impact",
          "assertion": "entity_impact_summary"
        },
        {
          "domain": "circle",
          "path": "/v1/circles/{circleId}",
          "assertion": "circle_detail"
        },
        {
          "domain": "circle",
          "path": "/v1/circles/{circleId}/impact",
          "assertion": "circle_impact_summary"
        },
        {
          "domain": "circle",
          "path": "/v1/circles/{circleId}/members",
          "assertion": "circle_members_page"
        },
        {
          "domain": "circle",
          "path": "/v1/circles/{circleId}/feed",
          "assertion": "circle_feed_page"
        },
        {
          "domain": "content",
          "path": "/v1/content/intersections/object?objectType=homepage&objectId={homepageId}",
          "assertion": "object_intersections_homepage"
        },
        {
          "domain": "content",
          "path": "/v1/content/intersections/object?objectType=circle&objectId={circleId}",
          "assertion": "object_intersections_circle"
        }
      ]
    }
  },
  "appAssets": {
    "alphaOnlyFixtureAllowlist": []
  },
  "gateway": {
    "routes": [
      {
        "prefix": "/v1/assistant",
        "service": "assistant-service",
        "port": 443
      },
      {
        "prefix": "/v1/content",
        "service": "content-service",
        "port": 443
      },
      {
        "prefix": "/v1/circles",
        "service": "circle-service",
        "port": 443
      },
      {
        "prefix": "/v1/chat",
        "service": "chat-service",
        "port": 443
      },
      {
        "prefix": "/v1/user",
        "service": "user-service",
        "port": 443
      },
      {
        "prefix": "/v1/me",
        "service": "user-service",
        "port": 443
      },
      {
        "prefix": "/v1/homepages",
        "service": "entity-service",
        "port": 443
      },
      {
        "prefix": "/v1/integration",
        "service": "integration-service",
        "port": 443
      },
      {
        "prefix": "/v1/app-messages",
        "service": "notification-service",
        "port": 443
      },
      {
        "prefix": "/v1/rtc",
        "service": "rtc-service",
        "port": 443
      }
    ]
  }
}
