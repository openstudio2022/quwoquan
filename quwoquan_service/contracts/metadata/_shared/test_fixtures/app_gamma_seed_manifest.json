  "verificationScopes": {
    "object-homepage-gamma-real-data-closure": {
      "description": "只严格检查交集四主页/对象页商用闭环所需的 content + entity + circle + user 端点与 typed probes。",
      "domains": [
        "content",
        "entity",
        "circle",
        "user"
      ],
      "runtimeRefs": {
        "{viewerId}": "fixture_user_current",
        "{homepageId}": "homepage_sight_west_lake",
        "{circleId}": "fixture_circle_photo"
      },
      "strictEndpoints": [
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/object-page-bundle",
          "assertion": "entity_homepage_bundle"
        },
        {
          "domain": "entity",
          "path": "/homepages/{seededHomepageId}/introduction",
          "assertion": "homepage_introduction"
        },
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/review-summary",
          "assertion": "homepage_review_summary"
        },
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/related-groups",
          "assertion": "homepage_related_groups"
        },
        {
          "domain": "entity",
          "path": "/homepages/{homepageId}/impact",
          "assertion": "entity_impact_summary"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}",
          "assertion": "circle_detail"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}/impact",
          "assertion": "circle_impact_summary"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}/members",
          "assertion": "circle_members_page"
        },
        {
          "domain": "circle",
          "path": "/circles/{circleId}/feed",
          "assertion": "circle_feed_page"
        },
        {
          "domain": "content",
          "path": "/content/intersections/object?objectType=homepage&objectId={homepageId}",
          "assertion": "object_intersections_homepage"
        },
        {
          "domain": "content",
          "path": "/content/intersections/object?objectType=circle&objectId={circleId}",
          "assertion": "object_intersections_circle"
        },
        {
          "domain": "content",
          "path": "/content/feed?sort=recommend&channelId=recommend&limit=24",
          "assertion": "home_feed_object_cards"
        }
      ]
    },
    "app-core-readback": {
      "description": "以 production Remote composition 验证首页、视频书、消息契约与我的主页核心读链；Chat 由同次 T3 的 generated API contract 创建并回读会话。",
      "domains": [
        "content",
        "chat",
        "user"
      ],
      "verificationPrincipal": {
        "mode": "ephemeral",
        "subjectPrefix": "app-core-readback"
      },
      "probeMode": "strictEndpointsOnly",
      "runtimeRefs": {
        "{viewerId}": "fixture_user_current"
      },
      "strictEndpoints": [
        {
          "domain": "content",
          "path": "/content/feed?sort=recommend&channelId=recommend&limit=24",
          "assertion": "home_feed_page",
          "requireObjectCards": true
        },
        {
          "domain": "content",
          "path": "/content/feed?identity=work&type=video&sort=recommend&limit=20",
          "assertion": "video_feed_page"
        },
        {
          "domain": "chat",
          "path": "/chat/inbox",
          "assertion": "chat_inbox_page",
          "expectedConversationId": "{coreConversationId}",
          "expectedMessageText": "{coreMessageText}"
        },
        {
          "domain": "user",
          "path": "/me",
          "assertion": "my_profile",
          "expectedOwnerUserId": "{activeOwnerId}",
          "expectedPersonaId": "{activePersonaId}"
        }
      ]
    }
  },
