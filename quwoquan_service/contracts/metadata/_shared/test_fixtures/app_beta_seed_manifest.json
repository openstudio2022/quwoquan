{
  "environment": "beta",
  "description": "本地端云 beta 联调 seed manifest，供自动化与人工 beta 共用。",
  "seedRefs": [
    {
      "domain": "assistant",
      "fixturePath": "assistant/test_fixtures/scenarios/assistant_scenarios.json",
      "refs": [
        "assistant_p0_core",
        "skill_management_core"
      ],
      "resetScope": "fixture_assistant_*",
      "targetStore": "mongodb:assistant.skill_subscriptions+redis:assistant-runtime",
      "verifiedEndpoints": [
        "/assistant/conversations",
        "/assistant/skill-subscriptions"
      ]
    },
    {
      "domain": "content",
      "fixturePath": "content/test_fixtures/scenarios/content_scenarios.json",
      "refs": [
        "content_discovery_core",
        "home_feed_core",
        "content_detail_core",
        "comment_thread_core",
        "search_core",
        "publish_core",
        "intersection_core",
        "footprint_core",
        "home_showcase_core",
        "profile_share_interaction_core"
      ],
      "resetScope": "fixture_content_*",
      "targetStore": "mongodb:content_test.posts",
      "verifiedEndpoints": [
        "/content/feed",
        "/content/posts/fixture_photo_001",
        "/content/posts/fixture_photo_001/comments",
        "/content/posts/fixture_photo_001/comments?sort=recommended",
        "/content/posts/fixture_photo_001/comments/fixture_comment_parent_001/replies",
        "/content/comments/fixture_comment_parent_001/reaction",
        "/content/comments/fixture_comment_parent_001/media:bind",
        "/content/sub-accounts/fixture_user_current/interactions/received?type=share",
        "/content/sub-accounts/fixture_user_current/interactions/sent?type=share"
      ]
    },
    {
      "domain": "circle",
      "fixturePath": "social/circle/test_fixtures/scenarios/circle_scenarios.json",
      "refs": [
        "circle_core",
        "circle_home_feed_core",
        "circle_profile_core",
        "circle_group_chat_link_core"
      ],
      "resetScope": "fixture_circle_*",
      "targetStore": "mongodb:circle_test",
      "verifiedEndpoints": [
        "/circles",
        "/circles/fixture_circle_photo"
      ]
    },
    {
      "domain": "chat",
      "fixturePath": "messages/chat/test_fixtures/scenarios/chat_scenarios.json",
      "refs": [
        "chat_core",
        "chat_settings_core",
        "chat_contacts_core",
        "chat_group_flow_core",
        "chat_realtime_fixture_core"
      ],
      "resetScope": "fixture_chat_*",
      "targetStore": "mongodb:chat_test",
      "verifiedEndpoints": [
        "/chat/inbox",
        "/chat/conversations/fixture_conv_direct/messages"
      ]
    },
    {
      "domain": "user",
      "fixturePath": "user/test_fixtures/scenarios/user_scenarios.json",
      "refs": [
        "user_profile_core",
        "persona_core",
        "profile_feed_core",
        "relationship_core",
        "following_subject_core",
        "settings_core"
      ],
      "resetScope": "fixture_user_*",
      "targetStore": "postgres+mongodb:user_test",
      "verifiedEndpoints": [
        "/user/profile",
        "/user/following-subjects"
      ]
    },
    {
      "domain": "entity",
      "fixturePath": "entity/test_fixtures/scenarios/entity_scenarios.json",
      "refs": [
        "entity_homepage_core",
        "entity_claim_core",
        "entity_picker_core"
      ],
      "resetScope": "homepage_state snapshot in quwoquan_entity (ship/import sync+tombstone 幂等重放)",
      "targetStore": "mongodb:quwoquan_entity.homepage_state",
      "seedChannel": "promote→qwq-data ship --import（content import + entity-service homepage-import，与 gamma 同通道、env 参数区分）",
      "verifiedEndpoints": [
        "/homepages/search",
        "/homepages/{homepageId}/object-page-bundle",
        "/homepages/{homepageId}/introduction"
      ]
    },
    {
      "domain": "integration",
      "fixturePath": "integration/test_fixtures/scenarios/integration_scenarios.json",
      "refs": [
        "location_poi_core"
      ],
      "resetScope": "fixture_integration_*",
      "targetStore": "integration-service:memory",
      "verifiedEndpoints": [
        "/integration/locations/pois"
      ]
    },
    {
      "domain": "notification",
      "fixturePath": "notification/test_fixtures/scenarios/notification_scenarios.json",
      "refs": [
        "notification_core"
      ],
      "resetScope": "fixture_notification_*",
      "targetStore": "notification-service:memory",
      "verifiedEndpoints": [
        "/app-messages"
      ]
    },
    {
      "domain": "rtc",
      "fixturePath": "rtc/test_fixtures/scenarios/rtc_scenarios.json",
      "refs": [
        "rtc_core"
      ],
      "resetScope": "fixture_rtc_*",
      "targetStore": "mongodb:rtc_test",
      "verifiedEndpoints": [
        "/rtc/calls"
      ]
    }
  ],
  "appAssets": {
    "alphaOnlyFixtureAllowlist": []
  },
  "gateway": {
    "routes": [
      {
        "prefix": "/assistant",
        "service": "assistant-service",
        "port": 18087
      },
      {
        "prefix": "/content",
        "service": "content-service",
        "port": 18101
      },
      {
        "prefix": "/circles",
        "service": "circle-service",
        "port": 18102
      },
      {
        "prefix": "/chat",
        "service": "chat-service",
        "port": 18103
      },
      {
        "prefix": "/user",
        "service": "user-service",
        "port": 18104
      },
      {
        "prefix": "/entity",
        "service": "entity-service",
        "port": 18105
      },
      {
        "prefix": "/integration",
        "service": "integration-service",
        "port": 18106
      },
      {
        "prefix": "/app-messages",
        "service": "notification-service",
        "port": 18107
      },
      {
        "prefix": "/rtc",
        "service": "rtc-service",
        "port": 18108
      }
    ]
  },
  "schema": "app-seed-manifest"
}
