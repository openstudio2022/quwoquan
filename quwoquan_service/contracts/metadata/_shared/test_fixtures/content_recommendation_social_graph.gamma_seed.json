{
  "schemaVersion": "content-recommendation-social-graph-seed.v1",
  "environment": "gamma",
  "description": "gamma-local 内容推荐社交图读模型种子（env-seed-first 单一真相源）。content-service 的对象交集 / feed 交集计算读取 quwoquan_content 库中的 follow_edges、rm_recommend_feature、rm_entity_tags、rm_behavior_events 与 circle_members；真实部署里这些读模型分别由 user/circle/content 的事件投影维护，gamma-local 未完整接线，因此需要用同一 fixture 为 canonical viewer + homepage + circle 补最小事实闭环。应用器：quwoquan_service/services/seed-box/scripts/apply_content_social_graph_seed.py（幂等可重跑）。",
  "targetStore": "content-service:quwoquan_content",
  "collections": [
    "follow_edges",
    "rm_recommend_feature",
    "rm_entity_tags",
    "rm_behavior_events",
    "circle_members",
    "rm_viewer_object_intersection(invalidate)"
  ],
