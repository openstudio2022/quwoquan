{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/object.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "description",
    "identity",
    "access",
    "relationships",
    "search_policy",
    "assistant_access",
    "business_rules",
    "lifecycle"
  ],
  "properties": {
    "model_version": {
      "description": "对象内部 major.minor 变更声明；仅参与 ContractGraph 发布差异门禁，不进入 wire、路由或 App UI。缺省为初始基线 1.0，门禁只报告 required version，不自动改写本字段。",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "kind": {
      "enum": [
        "aggregate_root",
        "append_only_fact",
        "process_manager",
        "projection",
        "external_reference",
        "runtime_session"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 16
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fields", "version_source"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "version_source": { "type": "string", "minLength": 1 }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commands", "queries", "cross_context"]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "members": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/member"
      }
    },
    "local_identity_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposed"],
      "properties": {
        "exposed": {
          "enum": [
            "none",
            "filter_only",
            "local_only",
            "remote_index",
            "remote_provider",
            "hybrid"
          ]
        },
        "object_type_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "eligibility_ref": { "type": "string", "minLength": 1 },
        "index_projector_ref": { "type": "string", "minLength": 1 },
        "provider_egress_ref": { "type": "string", "minLength": 1 },
        "privacy_filter_ref": { "type": "string", "minLength": 1 },
        "delegated_enforcement": { "type": "string", "minLength": 16 },
        "not_exposed_reason": { "type": "string", "minLength": 16 }
      },
      "allOf": [
        {
          "if": {
            "required": ["exposed"],
            "properties": { "exposed": { "const": "none" } }
          },
          "then": {
            "required": ["not_exposed_reason"],
            "not": {
              "anyOf": [
                { "required": ["object_type_refs"] },
                { "required": ["eligibility_ref"] },
                { "required": ["index_projector_ref"] },
                { "required": ["provider_egress_ref"] },
                { "required": ["privacy_filter_ref"] },
                { "required": ["delegated_enforcement"] }
              ]
            }
          },
          "else": { "not": { "required": ["not_exposed_reason"] } }
        },
        {
          "if": {
            "required": ["exposed"],
            "properties": { "exposed": { "enum": ["remote_index", "hybrid"] } }
          },
          "then": {
            "required": [
              "eligibility_ref",
              "index_projector_ref",
              "privacy_filter_ref"
            ],
            "not": {
              "anyOf": [
                { "required": ["delegated_enforcement"] },
                { "required": ["provider_egress_ref"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["exposed"],
            "properties": { "exposed": { "const": "remote_provider" } }
          },
          "then": {
            "required": ["provider_egress_ref", "privacy_filter_ref"],
            "not": {
              "anyOf": [
                { "required": ["delegated_enforcement"] },
                { "required": ["eligibility_ref"] },
                { "required": ["index_projector_ref"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["exposed"],
            "properties": {
              "exposed": { "enum": ["local_only", "filter_only"] }
            }
          },
          "then": {
            "required": ["delegated_enforcement"],
            "not": {
              "anyOf": [
                { "required": ["eligibility_ref"] },
                { "required": ["index_projector_ref"] },
                { "required": ["provider_egress_ref"] },
                { "required": ["privacy_filter_ref"] }
              ]
            }
          }
        }
      ]
    },
    "assistant_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "cite", "write"],
      "properties": {
        "read": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scopes"],
          "properties": {
            "mode": {
              "enum": ["none", "metadata_only", "owner_scoped", "public"]
            },
            "scopes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^assistant\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.read$"
              }
            }
          }
        },
        "cite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scopes"],
          "properties": {
            "mode": {
              "enum": ["none", "internal_reference", "public_citation"]
            },
            "scopes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^assistant\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.cite$"
              }
            }
          }
        },
        "write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scopes"],
          "properties": {
            "mode": {
              "enum": ["none", "proposal_only", "consented_command"]
            },
            "scopes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^assistant\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.write$"
              }
            },
            "requires_user_consent": { "type": "boolean" },
            "consent_scope_ref": { "type": "string", "minLength": 1 }
          }
        },
        "denied_reason": { "type": "string", "minLength": 16 }
      }
    },
    "relation_signal": {
      "type": "boolean"
    },
    "counter_strategy": {
      "type": "object"
    },
    "join_paths": {
      "type": "array"
    },
    "livekit_integration": {
      "type": "object"
    },
    "seq_strategy": {
      "type": "object"
    },
    "dedup_strategy": {
      "type": "object"
    },
    "business_rules": {
      "oneOf": [
        { "type": "array", "minItems": 1 },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "lifecycle": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "not": { "required": ["transitions"] },
      "dependentRequired": {
        "source_events": ["event_consumers"],
        "event_consumers": ["source_events"]
      },
      "properties": {
        "state_field": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "immutable": { "type": "boolean" },
        "source_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]*$"
          }
        },
        "checkpoint": { "type": "string", "minLength": 1 },
        "rebuild": { "type": "string", "minLength": 1 },
        "tombstone": { "type": "string", "minLength": 1 },
        "idempotency": { "type": "string", "minLength": 1 },
        "event_consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "facet", "method", "idempotency"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]+$"
              },
              "kind": {
                "enum": ["projector", "event_handler", "subscription"]
              },
              "facet": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*(Facade|Projector|Projection|Appender|Consumer|Coordinator|Recorder|Orchestrator|Handler)$"
              },
              "method": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "idempotency": {
                "enum": ["event_id", "aggregate_version", "identity_payload_digest", "transaction_identity"]
              }
            }
          }
        }
      }
    },
    "external_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "identity_contract"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "identity_contract": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "append_only_fact" } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["immutable"],
            "properties": { "immutable": { "const": true } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "projection" } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["checkpoint", "rebuild", "tombstone"],
            "properties": {
              "source_events": { "type": "array", "minItems": 1, "uniqueItems": true },
              "checkpoint": { "type": "string", "minLength": 1 },
              "rebuild": { "type": "string", "minLength": 1 },
              "tombstone": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "process_manager" } } },
      "then": {
        "properties": {
          "identity": {
            "properties": { "version_source": { "const": "checkpoint" } }
          },
          "lifecycle": {
            "required": ["state_field", "states"],
            "properties": {
              "state_field": { "type": "string", "minLength": 1 },
              "states": { "type": "array", "minItems": 2, "uniqueItems": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "runtime_session" } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["ttl_seconds", "expiry_semantics"],
            "properties": {
              "ttl_seconds": { "type": "integer", "minimum": 1 },
              "expiry_semantics": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "external_reference" } } },
      "then": { "required": ["external_authority"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "aggregate_root" } },
        "required": ["kind"]
      },
      "else": {
        "not": { "required": ["members"] }
      }
    }
  ],
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cardinality", "max_cardinality", "ownership", "description"],
      "properties": {
        "kind": { "enum": ["owned_entity", "value_object"] },
        "identity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "cardinality": { "enum": ["one", "zero_or_one", "many"] },
        "max_cardinality": { "type": "integer", "minimum": 1 },
        "ownership": { "const": "aggregate" },
        "write_access": { "const": "aggregate_facade_only" },
        "append_only": { "const": true },
        "description": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "cardinality": { "enum": ["one", "zero_or_one"] } },
            "required": ["cardinality"]
          },
          "then": { "properties": { "max_cardinality": { "const": 1 } } }
        },
        {
          "if": {
            "properties": { "cardinality": { "const": "many" } },
            "required": ["cardinality"]
          },
          "then": { "properties": { "max_cardinality": { "minimum": 2 } } }
        },
        {
          "if": {
            "properties": { "kind": { "const": "owned_entity" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["identity", "write_access"],
            "not": { "required": ["append_only"] }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["identity"] },
                { "required": ["write_access"] }
              ]
            }
          }
        }
      ]
    }
  }
}
