{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/object.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "description",
    "identity",
    "access",
    "relationships",
    "business_rules",
    "lifecycle"
  ],
  "properties": {
    "kind": {
      "enum": [
        "aggregate_root",
        "append_only_fact",
        "projection",
        "external_reference",
        "runtime_session"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 16
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fields", "version_source"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "version_source": { "type": "string", "minLength": 1 }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commands", "queries", "cross_context"]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "members": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "local_identity_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "taggable": {
      "type": "boolean"
    },
    "vector_enabled": {
      "type": "boolean"
    },
    "relation_signal": {
      "type": "boolean"
    },
    "counter_strategy": {
      "type": "object"
    },
    "join_paths": {
      "type": "array"
    },
    "livekit_integration": {
      "type": "object"
    },
    "seq_strategy": {
      "type": "object"
    },
    "dedup_strategy": {
      "type": "object"
    },
    "business_rules": {
      "oneOf": [
        { "type": "array", "minItems": 1 },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "lifecycle": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "state_field": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "immutable": { "type": "boolean" }
      }
    },
    "external_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "identity_contract"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "identity_contract": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "append_only_fact" } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["immutable"],
            "properties": { "immutable": { "const": true } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "projection" } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["source_events", "checkpoint", "rebuild", "tombstone"],
            "properties": {
              "source_events": { "type": "array", "minItems": 1, "uniqueItems": true },
              "checkpoint": { "type": "string", "minLength": 1 },
              "rebuild": { "type": "string", "minLength": 1 },
              "tombstone": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "runtime_session" } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["ttl_seconds", "expiry_semantics"],
            "properties": {
              "ttl_seconds": { "type": "integer", "minimum": 1 },
              "expiry_semantics": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "external_reference" } } },
      "then": { "required": ["external_authority"] }
    }
  ]
}
