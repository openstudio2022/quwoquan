{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/domain_model_compatibility_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "baseline",
    "current",
    "evidence",
    "objects",
    "issues",
    "invariants"
  ],
  "properties": {
    "schema": { "const": "domain-model-compatibility-report" },
    "status": { "enum": ["passed", "blocked"] },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "stage",
        "receiptId",
        "committedGeneration",
        "contractGraphDigest"
      ],
      "properties": {
        "authority": { "const": "prod-hosted-service-plane" },
        "stage": { "enum": ["full", "100"] },
        "receiptId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "committedGeneration": { "type": "integer", "minimum": 1 },
        "contractGraphDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractGraphDigest"],
      "properties": {
        "contractGraphDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibilityWindowDigest",
        "storageMigrationPlanDigest"
      ],
      "properties": {
        "compatibilityWindowDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "storageMigrationPlanDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/objectReport" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wireModelVersion",
        "automaticSourceRewrite",
        "breakingStorageMigration",
        "dualRead",
        "dualWrite"
      ],
      "properties": {
        "wireModelVersion": { "const": "forbidden" },
        "automaticSourceRewrite": { "const": false },
        "breakingStorageMigration": { "const": "quiesced_atomic" },
        "dualRead": { "const": "forbidden" },
        "dualWrite": { "const": "forbidden" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "modelVersion": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        { "type": "null" }
      ]
    },
    "impact": {
      "enum": ["none", "compatible", "incompatible"]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "code", "detail"],
      "properties": {
        "level": { "$ref": "#/$defs/impact" },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "window": {
      "type": "object",
      "required": ["operationId", "status"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["closed", "blocked"] },
        "reason": { "type": "string", "minLength": 1 },
        "windowClosed": { "type": "boolean" },
        "usageCount": { "type": ["integer", "null"], "minimum": 0 },
        "affectedAppBuilds": { "type": ["object", "null"] }
      }
    },
    "objectReport": {
      "type": "object",
      "required": [
        "objectId",
        "baselineModelVersion",
        "currentModelVersion",
        "requiredModelVersion",
        "changeImpact",
        "migrationMode",
        "changes",
        "compatibilityWindow",
        "versionDeclarationValid"
      ],
      "properties": {
        "objectId": { "type": "string", "minLength": 1 },
        "baselineModelVersion": { "$ref": "#/$defs/modelVersion" },
        "currentModelVersion": { "$ref": "#/$defs/modelVersion" },
        "requiredModelVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "changeImpact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "command", "storage"],
          "properties": {
            "query": { "$ref": "#/$defs/impact" },
            "command": { "$ref": "#/$defs/impact" },
            "storage": { "$ref": "#/$defs/impact" }
          }
        },
        "migrationMode": { "enum": ["none", "additive", "quiesced_atomic"] },
        "migrationEvidence": { "type": "string", "minLength": 1 },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/change" }
        },
        "compatibilityWindow": {
          "type": "array",
          "items": { "$ref": "#/$defs/window" }
        },
        "versionDeclarationValid": { "type": "boolean" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
