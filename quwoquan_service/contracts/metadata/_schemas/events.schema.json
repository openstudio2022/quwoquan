{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/events.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "payload_entity": { "type": "string", "minLength": 1 },
          "consumers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "no_consumer_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
