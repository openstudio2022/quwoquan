{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "privacy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["aggregate", "description"],
  "properties": {
    "aggregate": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "app_log_policy": {
      "type": "array",
      "items": {"$ref": "#/$defs/appLogPolicy"}
    },
    "data_lifecycle": {"$ref": "#/$defs/dataLifecycle"},
    "field_visibility": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldVisibility"}
    }
  },
  "$defs": {
    "fieldName": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "appLogPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "classification", "app_log"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "classification": {"enum": ["PUBLIC", "PII", "SENSITIVE", "SECRET", "INTERNAL"]},
        "app_log": {"enum": ["allow", "mask", "drop", "truncate", "count_only", "drop_if_gt_100chars"]},
        "mask_strategy": {"type": "string", "minLength": 1},
        "truncate_chars": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "deletionCascade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "strategy"],
      "properties": {
        "entity": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "strategy": {"type": "string", "minLength": 1},
        "soft_delete_first": {"type": "boolean"},
        "cdn_purge_delay_hours": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "anonymization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "strategy"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "strategy": {"type": "string", "minLength": 1},
        "placeholder": {"type": "string"}
      }
    },
    "dataLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention_days": {"type": "integer", "minimum": 0},
        "user_deletion_hook": {"type": "boolean"},
        "deletion_on_user_request": {"type": "boolean"},
        "deletion_cascade": {
          "type": "array",
          "items": {"$ref": "#/$defs/deletionCascade"}
        },
        "anonymization_on_delete": {
          "type": "array",
          "items": {"$ref": "#/$defs/anonymization"}
        }
      }
    },
    "fieldVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "visibility": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["visibility"]},
        {"required": ["description"]}
      ]
    }
  }
}
