{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/operations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_routes"
  ],
  "properties": {
    "externalDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "port", "operations"],
        "properties": {
          "role": {
            "enum": [
              "owner",
              "use"
            ]
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "port": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*Port$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            }
          },
          "conformance": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "use"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "required": [
                "scenes"
              ],
              "not": {
                "required": [
                  "conformance"
                ]
              }
            },
            "else": {
              "required": [
                "conformance"
              ]
            }
          }
        ]
      }
    },
    "response_list_key": {
      "type": "string",
      "minLength": 1
    },
    "api_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "method",
          "path",
          "operation",
          "actor",
          "application"
        ],
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "allOf": [
              {
                "anyOf": [
                  {
                    "enum": [
                      "/health",
                      "/healthz",
                      "/metrics"
                    ]
                  },
                  {
                    "pattern": "^/(internal|callbacks)/[A-Za-z][A-Za-z0-9._:{}\\-/]*$"
                  },
                  {
                    "pattern": "^/[A-Za-z][A-Za-z0-9._:{}\\-/]*$"
                  }
                ]
              },
              {
                "not": {
                  "pattern": "(^|/)v[0-9]+(/|$)"
                }
              }
            ]
          },
          "operation": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$"
          },
          "actor": {
            "enum": [
              "none",
              "account",
              "persona",
              "device",
              "persona_or_device"
            ]
          },
          "auth": false,
          "auth_required": false,
          "security": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auth_mode"
            ],
            "properties": {
              "auth_mode": {
                "enum": [
                  "public",
                  "optional",
                  "required"
                ]
              },
              "principal": {
                "type": "string",
                "minLength": 1
              },
              "permissions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "token_transport": {
                "type": "string",
                "minLength": 1
              },
              "anonymous_policy": {
                "type": "string",
                "minLength": 1
              },
              "visibility": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "application": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "facet",
              "method"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "query",
                  "session"
                ]
              },
              "facet": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "aggregate_owner": {
                "type": "string",
                "minLength": 1
              },
              "append_sink": {
                "type": "string",
                "minLength": 1
              },
              "mutation_target": {
                "type": "string",
                "minLength": 1
              },
              "invariant_target": {
                "type": "string",
                "minLength": 1
              },
              "session_owner": {
                "type": "string",
                "minLength": 1
              },
              "reader": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*Reader$"
              },
              "slice": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "command"
                    }
                  }
                },
                "then": {
                  "required": [
                    "mutation_target",
                    "invariant_target"
                  ],
                  "oneOf": [
                    {
                      "required": [
                        "aggregate_owner"
                      ]
                    },
                    {
                      "required": [
                        "append_sink"
                      ]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "query"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reader",
                    "slice"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "session"
                    }
                  }
                },
                "then": {
                  "required": [
                    "session_owner"
                  ]
                }
              }
            ]
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal",
              "ownership_policy"
            ],
            "properties": {
              "principal": {
                "enum": [
                  "public",
                  "account",
                  "persona",
                  "device",
                  "service",
                  "admin",
                  "operator"
                ]
              },
              "scopes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "permissions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ownership_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "commercial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ready",
                  "blocked"
                ]
              },
              "block_reason": {
                "type": "string",
                "minLength": 1
              },
              "gap_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              },
              "target_story": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  }
                },
                "then": {
                  "required": [
                    "block_reason",
                    "gap_id",
                    "target_story"
                  ]
                }
              }
            ]
          },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout_ms",
              "cancellation",
              "retry_mode",
              "max_attempts",
              "idempotency"
            ],
            "properties": {
              "timeout_ms": {
                "type": "integer",
                "minimum": 1
              },
              "cancellation": {
                "enum": [
                  "supported",
                  "none"
                ]
              },
              "retry_mode": {
                "enum": [
                  "none",
                  "idempotent"
                ]
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "idempotency": {
                "enum": [
                  "none",
                  "optional",
                  "required",
                  "payload_digest_server_side"
                ]
              }
            }
          },
          "concurrency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version_precondition"
            ],
            "properties": {
              "version_precondition": {
                "const": "if_match"
              }
            }
          },
          "error_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_classification",
              "response_classification",
              "log_policy"
            ],
            "properties": {
              "request_classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "PII",
                  "SENSITIVE",
                  "SECRET"
                ]
              },
              "response_classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "PII",
                  "SENSITIVE",
                  "SECRET"
                ]
              },
              "log_policy": {
                "enum": [
                  "none",
                  "metadata_only",
                  "redacted"
                ]
              }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "trace"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "trace": {
                "const": true
              },
              "attributes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latency_p95_ms",
              "availability_percent"
            ],
            "properties": {
              "latency_p95_ms": {
                "type": "integer",
                "minimum": 1
              },
              "availability_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          },
          "client_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dart_import",
              "request_type",
              "response_type",
              "request_encoder",
              "response_decoder"
            ],
            "properties": {
              "dart_import": {
                "type": "string",
                "pattern": "^\\.\\./(?:[a-z0-9_]+/)+[a-z0-9_]+\\.dart$"
              },
              "request_type": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              },
              "response_type": {
                "type": "string",
                "pattern": "^(void|[A-Z][A-Za-z0-9]*)$"
              },
              "request_encoder": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "response_decoder": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "path_bindings": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "query_bindings": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "consumers": {
      "type": "array"
    },
    "contract_test": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "commercial_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "block_reason",
        "gap_id",
        "target_story"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "block_reason": {
          "type": "string",
          "minLength": 1
        },
        "gap_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "target_story": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "upstreams": {
      "type": "object"
    },
    "delivery_slo": {
      "type": "object"
    },
    "privacy_contract": {
      "type": "object"
    },
    "incoming_call_slo": {
      "type": "object"
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "port",
          "operations",
          "conformance"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conformance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
