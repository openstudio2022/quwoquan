{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/operations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_routes"
  ],
  "properties": {
    "externalDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "port", "operations"],
        "properties": {
          "role": {
            "enum": [
              "owner",
              "use"
            ]
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "port": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*Port$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            }
          },
          "conformance": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "adapterContracts": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^(ext|infra|data)\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpointEnvs",
                "secretRefs",
                "defaultTimeoutMs"
              ],
              "properties": {
                "endpointEnvs": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                },
                "secretRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                },
                "defaultTimeoutMs": {
                  "type": "integer",
                  "minimum": 1
                },
                "allowEnvironmentOverrides": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "endpointEnvs",
                      "secretRefs",
                      "timeoutMs"
                    ]
                  }
                }
              }
            }
          },
          "observability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metrics"
            ],
            "properties": {
              "metrics": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "use"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "required": [
                "scenes"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "conformance"
                    ]
                  },
                  {
                    "required": [
                      "adapterContracts"
                    ]
                  },
                  {
                    "required": [
                      "observability"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "conformance",
                "adapterContracts"
              ]
            }
          }
        ]
      }
    },
    "readiness_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/readinessCase"
      }
    },
    "response_list_key": {
      "type": "string",
      "minLength": 1
    },
    "api_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "method",
          "path",
          "operation",
          "actor",
          "application"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "\\{[^{}]+\\}"
                }
              }
            },
            "then": {
              "required": [
                "request_bindings"
              ],
              "properties": {
                "request_bindings": {
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "allOf": [
              {
                "anyOf": [
                  {
                    "enum": [
                      "/health",
                      "/healthz",
                      "/metrics"
                    ]
                  },
                  {
                    "pattern": "^/(internal|callbacks)/[A-Za-z][A-Za-z0-9._:{}\\-/]*$"
                  },
                  {
                    "pattern": "^/[A-Za-z][A-Za-z0-9._:{}\\-/]*$"
                  }
                ]
              },
              {
                "not": {
                  "pattern": "(^|/)v[0-9]+(/|$)"
                }
              }
            ]
          },
          "operation": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$"
          },
          "actor": {
            "enum": [
              "none",
              "account",
              "persona",
              "device",
              "persona_or_device"
            ]
          },
          "request_entity": {
            "type": "string",
            "minLength": 1
          },
          "request_body_kind": {
            "enum": ["object", "none"]
          },
          "success_status": {
            "enum": [200, 201, 202, 204]
          },
          "transport": {
            "enum": ["json", "sse"]
          },
          "streaming": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resume_request_field",
              "resume_response_field",
              "terminal_field",
              "terminal_values"
            ],
            "properties": {
              "resume_request_field": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "resume_response_field": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "terminal_field": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "terminal_values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "request_bindings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              },
              "query": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              },
              "header": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              },
              "injected": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              }
            }
          },
          "request_constants": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body"
            ],
            "properties": {
              "body": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "auth": false,
          "auth_required": false,
          "security": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auth_mode"
            ],
            "properties": {
              "auth_mode": {
                "enum": [
                  "public",
                  "optional",
                  "required"
                ]
              },
              "principal": {
                "type": "string",
                "minLength": 1
              },
              "token_transport": {
                "type": "string",
                "minLength": 1
              },
              "anonymous_policy": {
                "type": "string",
                "minLength": 1
              },
              "visibility": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "application": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "facet",
              "method"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "query",
                  "session"
                ]
              },
              "facet": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "aggregate_owner": {
                "type": "string",
                "minLength": 1
              },
              "append_sink": {
                "type": "string",
                "minLength": 1
              },
              "lifecycle_owner": {
                "type": "string",
                "minLength": 1
              },
              "mutation_target": {
                "type": "string",
                "minLength": 1
              },
              "invariant_target": {
                "type": "string",
                "minLength": 1
              },
              "session_owner": {
                "type": "string",
                "minLength": 1
              },
              "reader": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*Reader$"
              },
              "slice": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "command"
                    }
                  }
                },
                "then": {
                  "required": [
                    "mutation_target",
                    "invariant_target"
                  ],
                  "oneOf": [
                    {
                      "required": [
                        "aggregate_owner"
                      ]
                    },
                    {
                      "required": [
                        "append_sink"
                      ]
                    },
                    {
                      "required": [
                        "lifecycle_owner"
                      ]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "query"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reader",
                    "slice"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "session"
                    }
                  }
                },
                "then": {
                  "required": [
                    "session_owner"
                  ]
                }
              }
            ]
          },
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal",
              "ownership_policy"
            ],
            "properties": {
              "principal": {
                "enum": [
                  "public",
                  "account",
                  "persona",
                  "device",
                  "service",
                  "admin",
                  "operator"
                ]
              },
              "scopes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "permissions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ownership_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "commercial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ready",
                  "blocked"
                ]
              },
              "block_reason": {
                "type": "string",
                "minLength": 1
              },
              "gap_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              },
              "target_story": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  }
                },
                "then": {
                  "required": [
                    "block_reason",
                    "gap_id",
                    "target_story"
                  ]
                }
              }
            ]
          },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cancellation",
              "retry_mode",
              "max_attempts",
              "idempotency"
            ],
            "oneOf": [
              {
                "required": [
                  "timeout_ms"
                ],
                "not": {
                  "required": [
                    "stream_budget"
                  ]
                }
              },
              {
                "required": [
                  "stream_budget"
                ],
                "not": {
                  "required": [
                    "timeout_ms"
                  ]
                }
              }
            ],
            "properties": {
              "timeout_ms": {
                "type": "integer",
                "minimum": 1
              },
              "stream_budget": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "handshake_ms",
                  "idle_ms",
                  "max_duration_ms"
                ],
                "properties": {
                  "handshake_ms": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "idle_ms": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_duration_ms": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "cancellation": {
                "enum": [
                  "supported",
                  "none"
                ]
              },
              "retry_mode": {
                "enum": [
                  "none",
                  "idempotent"
                ]
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "idempotency": {
                "enum": [
                  "none",
                  "optional",
                  "required",
                  "payload_digest_server_side"
                ]
              }
            }
          },
          "pagination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default_items",
              "maximum_items"
            ],
            "properties": {
              "default_items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "maximum_items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              }
            }
          },
          "response_admission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maximum_body_bytes"
            ],
            "properties": {
              "maximum_body_bytes": {
                "type": "integer",
                "minimum": 1024
              }
            }
          },
          "concurrency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version_precondition"
            ],
            "properties": {
              "version_precondition": {
                "const": "if_match"
              }
            }
          },
          "error_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_classification",
              "response_classification",
              "log_policy"
            ],
            "properties": {
              "request_classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "PII",
                  "SENSITIVE",
                  "SECRET"
                ]
              },
              "response_classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "PII",
                  "SENSITIVE",
                  "SECRET"
                ]
              },
              "log_policy": {
                "enum": [
                  "none",
                  "metadata_only",
                  "redacted"
                ]
              }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "trace"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "trace": {
                "const": true
              },
              "attributes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latency_p95_ms",
              "availability_percent"
            ],
            "properties": {
              "latency_p95_ms": {
                "type": "integer",
                "minimum": 1
              },
              "availability_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          },
          "client_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dart_import",
              "response_type",
              "response_decoder"
            ],
            "properties": {
              "dart_import": {
                "type": "string",
                "pattern": "^\\.\\./(?:[a-z0-9_]+/)+[a-z0-9_]+\\.dart$"
              },
              "response_type": {
                "type": "string",
                "pattern": "^(void|[A-Z][A-Za-z0-9]*)$"
              },
              "response_decoder": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              }
            }
          }
        }
      }
    },
    "runtime_entrypoints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "phase",
          "application",
          "telemetry",
          "slo"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$"
          },
          "kind": {
            "enum": [
              "middleware",
              "projector",
              "event_handler",
              "subscription",
              "internal_port",
              "external_port"
            ]
          },
          "phase": {
            "enum": [
              "post_authorization_pre_owner_proxy",
              "event_projection",
              "event_command",
              "event_ingest",
              "transactional_append",
              "outbound_invocation"
            ]
          },
          "source_objects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]+$"
            }
          },
          "idempotency": {
            "enum": [
              "event_id",
              "aggregate_version",
              "identity_payload_digest",
              "transaction_identity"
            ]
          },
          "application": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "facet",
              "method",
              "object_owner"
            ],
            "properties": {
              "kind": {
                "enum": ["command", "query", "session"]
              },
              "facet": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*(Facade|Projector|Projection|Appender|Consumer|Port|Coordinator|Recorder|Orchestrator|Handler)$"
              },
              "method": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "object_owner": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "trace"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "trace": {
                "const": true
              },
              "attributes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "latency_p95_ms": {
                "type": "integer",
                "minimum": 1
              },
              "failure_ratio_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "freshness_p95_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "backlog_max_events": {
                "type": "integer",
                "minimum": 1
              },
              "dead_letter_ratio_percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "middleware" } } },
            "then": {
              "properties": {
                "phase": { "const": "post_authorization_pre_owner_proxy" },
                "application": {
                  "properties": { "kind": { "const": "session" } }
                },
                "slo": { "$ref": "#/$defs/runtimeEntrypointSynchronousSlo" }
              },
              "not": {
                "anyOf": [
                  { "required": ["source_objects"] },
                  { "required": ["idempotency"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "projector" } } },
            "then": {
              "properties": {
                "phase": { "const": "event_projection" },
                "application": {
                  "properties": { "kind": { "const": "command" } }
                },
                "slo": { "$ref": "#/$defs/runtimeEntrypointEventStreamSlo" }
              },
              "not": {
                "anyOf": [
                  { "required": ["source_objects"] },
                  { "required": ["idempotency"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "event_handler" } } },
            "then": {
              "properties": {
                "phase": { "const": "event_command" },
                "application": {
                  "properties": { "kind": { "const": "command" } }
                },
                "slo": { "$ref": "#/$defs/runtimeEntrypointEventStreamSlo" }
              },
              "not": {
                "anyOf": [
                  { "required": ["source_objects"] },
                  { "required": ["idempotency"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "subscription" } } },
            "then": {
              "properties": {
                "phase": { "const": "event_ingest" },
                "application": {
                  "properties": { "kind": { "const": "command" } }
                },
                "slo": { "$ref": "#/$defs/runtimeEntrypointEventStreamSlo" }
              },
              "not": {
                "anyOf": [
                  { "required": ["source_objects"] },
                  { "required": ["idempotency"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "internal_port" } } },
            "then": {
              "required": ["source_objects", "idempotency"],
              "properties": {
                "phase": { "const": "transactional_append" },
                "application": {
                  "properties": { "kind": { "const": "command" } }
                },
                "slo": { "$ref": "#/$defs/runtimeEntrypointSynchronousSlo" }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "external_port" } } },
            "then": {
              "required": ["source_objects", "idempotency"],
              "properties": {
                "phase": { "const": "outbound_invocation" },
                "slo": { "$ref": "#/$defs/runtimeEntrypointOutboundSlo" }
              }
            }
          }
        ]
      }
    },
    "consumers": {
      "type": "array"
    },
    "contract_test": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "commercial_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "block_reason",
        "gap_id",
        "target_story"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "block_reason": {
          "type": "string",
          "minLength": 1
        },
        "gap_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "target_story": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "upstreams": {
      "type": "object"
    },
    "delivery_slo": {
      "type": "object"
    },
    "privacy_contract": {
      "type": "object"
    },
    "incoming_call_slo": {
      "type": "object"
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "port",
          "operations",
          "conformance"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conformance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "runtimeEntrypointSynchronousSlo": {
      "description": "同步在途 seam（middleware / internal_port）：调用方在栈上等待结果，可判定的维度只有单次调用耗时与失败比率。没有 HTTP 状态码，因此不使用 availability_percent。",
      "required": ["latency_p95_ms", "failure_ratio_percent"],
      "not": {
        "anyOf": [
          { "required": ["freshness_p95_seconds"] },
          { "required": ["backlog_max_events"] },
          { "required": ["dead_letter_ratio_percent"] }
        ]
      }
    },
    "runtimeEntrypointEventStreamSlo": {
      "description": "事件消费 seam（projector / event_handler / subscription）：调用方已经离场，用户可见的失效是滞后与积压，而不是单次调用延迟。因此口径是端到端新鲜度、未处理积压与重试后仍失败的比率。",
      "required": [
        "freshness_p95_seconds",
        "backlog_max_events",
        "failure_ratio_percent"
      ],
      "not": {
        "anyOf": [
          { "required": ["latency_p95_ms"] },
          { "required": ["dead_letter_ratio_percent"] }
        ]
      }
    },
    "runtimeEntrypointOutboundSlo": {
      "description": "外部调用 seam（external_port）：既有同步调用耗时与失败比率，又有重试耗尽后进入死信的比率；死信率是该 seam 独有的可判定失效维度。",
      "required": [
        "latency_p95_ms",
        "failure_ratio_percent",
        "dead_letter_ratio_percent"
      ],
      "not": {
        "anyOf": [
          { "required": ["freshness_p95_seconds"] },
          { "required": ["backlog_max_events"] }
        ]
      }
    },
    "readinessTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["operation", "page", "object"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "readinessExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env", "platform", "device", "provider", "digest_binding"],
      "properties": {
        "env": {
          "enum": ["alpha", "beta", "gamma", "prod"]
        },
        "platform": {
          "$ref": "#/$defs/readinessIdentity"
        },
        "device": {
          "$ref": "#/$defs/readinessIdentity"
        },
        "provider": {
          "$ref": "#/$defs/readinessIdentity"
        },
        "digest_binding": {
          "enum": ["candidate", "release", "candidate_or_release"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "env": { "const": "prod" }
            },
            "required": ["env"]
          },
          "then": {
            "properties": {
              "digest_binding": { "const": "release" }
            }
          }
        }
      ]
    },
    "readinessIdentity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "readinessCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "spec_ref", "producer", "layer", "target", "runner_source_path", "executions"],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "spec_ref": {
          "type": "string",
          "pattern": "^specs/feature-tree/(?:[A-Za-z0-9_.-]+/)*spec\\.md#(?:uat|dom|sit|gwt)-[0-9]{3,}$"
        },
        "producer": {
          "enum": ["service", "app", "ops"]
        },
        "layer": {
          "enum": [
            "local_contract",
            "api_integration",
            "user_acceptance",
            "environment_acceptance",
            "rollback",
            "replay"
          ]
        },
        "target": {
          "$ref": "#/$defs/readinessTarget"
        },
        "runner_source_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
        },
        "executions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/readinessExecution"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "producer": { "const": "service" },
            "layer": { "enum": ["local_contract", "api_integration"] },
            "target": {
              "properties": { "kind": { "enum": ["operation", "object"] } }
            }
          }
        },
        {
          "properties": {
            "producer": { "const": "app" },
            "layer": { "enum": ["local_contract", "api_integration"] },
            "target": {
              "properties": { "kind": { "const": "operation" } }
            }
          }
        },
        {
          "properties": {
            "producer": { "const": "app" },
            "layer": { "const": "user_acceptance" },
            "target": {
              "properties": { "kind": { "const": "page" } }
            }
          }
        },
        {
          "properties": {
            "producer": { "const": "ops" },
            "layer": { "enum": ["environment_acceptance", "rollback", "replay"] },
            "target": {
              "properties": { "kind": { "const": "object" } }
            }
          }
        }
      ]
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "field"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    }
  }
}
