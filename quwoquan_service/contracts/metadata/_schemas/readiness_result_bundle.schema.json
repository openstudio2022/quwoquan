{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/readiness_result_bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "results"
  ],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "nonSecretIdentity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "operation",
            "page",
            "object"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "specRef",
        "caseId",
        "producer",
        "layer",
        "status",
        "target",
        "commitSha",
        "contractGraphSourceHash",
        "deploymentTarget",
        "baselineId",
        "packageDigest",
        "configurationDigest",
        "candidateManifestSha256",
        "environment",
        "provider",
        "startedAt",
        "completedAt",
        "runnerIdentity",
        "artifactSha256"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "objectRef": {
          "type": "string",
          "minLength": 1
        },
        "objectDigest": {
          "$ref": "#/$defs/digest"
        },
        "specRef": {
          "type": "string",
          "minLength": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "enum": [
            "service",
            "app",
            "ops"
          ]
        },
        "layer": {
          "enum": [
            "local_contract",
            "api_integration",
            "user_acceptance",
            "environment_acceptance",
            "rollback",
            "replay"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "skipped"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "commitSha": {
          "$ref": "#/$defs/gitCommit"
        },
        "contractGraphSourceHash": {
          "$ref": "#/$defs/sha256"
        },
        "deploymentTarget": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "baselineId": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "packageDigest": {
          "$ref": "#/$defs/digest"
        },
        "configurationDigest": {
          "$ref": "#/$defs/digest"
        },
        "candidateManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidateDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseId": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "importRunId": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "verifyRunId": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "targetUatBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "entrySurface": {
          "enum": [
            "feed",
            "search",
            "recommendation",
            "direct_or_object_route"
          ]
        },
        "carrier": {
          "enum": [
            "homepage",
            "article",
            "image",
            "video"
          ]
        },
        "environment": {
          "enum": [
            "alpha",
            "beta",
            "gamma",
            "prod"
          ]
        },
        "platform": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "deviceClass": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "deviceRegistered": {
          "type": "boolean"
        },
        "provider": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runnerIdentity": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactPath": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "receiptRef": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "deviceIdentity": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "uatProfile": {
          "enum": [
            "rehearsal",
            "promotable",
            "production"
          ]
        },
        "nonPromotable": {
          "type": "boolean"
        },
        "artifactClass": {
          "enum": [
            "production_behavior",
            "production"
          ]
        },
        "physicalDevice": {
          "type": "boolean"
        },
        "reasonCode": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "observedOutcome": {
          "enum": [
            "content",
            "empty",
            "deleted",
            "offline",
            "no_active_release",
            "rollback_restored",
            "replay_restored"
          ]
        },
        "observedReleaseId": {
          "$ref": "#/$defs/nonSecretIdentity"
        },
        "previousReleaseId": {
          "$ref": "#/$defs/nonSecretIdentity"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "releaseDigest"
            ],
            "properties": {
              "producer": {
                "const": "app"
              },
              "layer": {
                "const": "user_acceptance"
              }
            }
          },
          "then": {
            "required": [
              "releaseId",
              "targetUatBindingDigest",
              "entrySurface",
              "carrier",
              "deviceIdentity",
              "deviceRegistered",
              "uatProfile",
              "nonPromotable",
              "artifactClass",
              "physicalDevice"
            ]
          }
        },
        {
          "if": {
            "required": ["producer", "layer"],
            "properties": {
              "producer": {"const": "app"},
              "layer": {"const": "user_acceptance"}
            }
          },
          "then": {
            "required": ["platform", "deviceClass"]
          }
        },
        {
          "if": {
            "required": ["producer", "layer"],
            "properties": {
              "producer": {"const": "service"},
              "layer": {"const": "api_integration"}
            }
          },
          "then": {
            "required": [
              "releaseId", "releaseDigest", "importRunId", "verifyRunId",
              "objectRef", "objectDigest"
            ],
            "not": {
              "anyOf": [
                {"required": ["platform"]},
                {"required": ["deviceClass"]},
                {"required": ["deviceRegistered"]},
                {"required": ["deviceIdentity"]},
                {"required": ["targetUatBindingDigest"]},
                {"required": ["uatProfile"]},
                {"required": ["nonPromotable"]},
                {"required": ["artifactClass"]},
                {"required": ["physicalDevice"]}
              ]
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "producer": {
                  "const": "service"
                },
                "layer": {
                  "enum": [
                    "local_contract",
                    "api_integration"
                  ]
                }
              }
            },
            {
              "properties": {
                "producer": {
                  "const": "app"
                },
                "layer": {
                  "enum": [
                    "local_contract",
                    "api_integration",
                    "user_acceptance"
                  ]
                }
              }
            },
            {
              "properties": {
                "producer": {
                  "const": "ops"
                },
                "layer": {
                  "enum": [
                    "environment_acceptance",
                    "rollback",
                    "replay"
                  ]
                }
              }
            }
          ]
        },
        {
          "if": {
            "required": [
              "uatProfile"
            ],
            "properties": {
              "uatProfile": {
                "const": "rehearsal"
              }
            }
          },
          "then": {
            "required": [
              "nonPromotable",
              "artifactClass"
            ],
            "properties": {
              "nonPromotable": {
                "const": true
              },
              "artifactClass": {
                "const": "production_behavior"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "uatProfile"
            ],
            "properties": {
              "uatProfile": {
                "const": "promotable"
              }
            }
          },
          "then": {
            "required": [
              "physicalDevice",
              "deviceRegistered",
              "nonPromotable"
            ],
            "properties": {
              "physicalDevice": {
                "const": true
              },
              "deviceRegistered": {
                "const": true
              },
              "nonPromotable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "uatProfile"
            ],
            "properties": {
              "uatProfile": {
                "const": "production"
              }
            }
          },
          "then": {
            "required": [
              "environment",
              "artifactClass",
              "physicalDevice",
              "deviceRegistered",
              "nonPromotable"
            ],
            "properties": {
              "environment": {
                "const": "prod"
              },
              "artifactClass": {
                "const": "production"
              },
              "physicalDevice": {
                "const": true
              },
              "deviceRegistered": {
                "const": true
              },
              "nonPromotable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "blocked",
                  "skipped"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reasonCode"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reasonCode"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "observedOutcome"
            ],
            "properties": {
              "observedOutcome": {
                "const": "no_active_release"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "observedReleaseId"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "observedOutcome"
            ],
            "properties": {
              "observedOutcome": {
                "enum": [
                  "rollback_restored",
                  "replay_restored"
                ]
              }
            }
          },
          "then": {
            "required": [
              "observedReleaseId",
              "previousReleaseId"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "artifactPath"
          ],
          "not": {
            "required": [
              "receiptRef"
            ]
          }
        },
        {
          "required": [
            "receiptRef"
          ],
          "not": {
            "required": [
              "artifactPath"
            ]
          }
        }
      ]
    }
  }
}
