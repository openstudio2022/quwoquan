{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quwoquan.local/contracts/metadata/contract_graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objects",
    "operations",
    "runtimeEntrypoints",
    "projections",
    "businessObjectMaps",
    "readinessCases",
    "readinessEvidence",
    "objectReadiness",
    "sources",
    "documents"
  ],
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "name", "kind", "kindExplicit", "sourcePath"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["aggregate_root", "owned_entity", "value_object", "process_manager", "projection", "external_reference", "append_only_fact", "runtime_session"]
          },
          "kindExplicit": { "type": "boolean" },
          "aggregateOwner": { "type": "string", "minLength": 1 },
          "storageBackend": { "type": "string", "minLength": 1 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "members": {
            "type": "array",
            "items": { "type": "object" }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "states": { "$ref": "#/$defs/stringList" },
              "stateField": { "type": "string", "minLength": 1 },
              "immutable": { "type": "boolean" },
              "sourceEvents": { "$ref": "#/$defs/stringList" },
              "checkpoint": { "type": "string", "minLength": 1 },
              "rebuild": { "type": "string", "minLength": 1 },
              "tombstone": { "type": "string", "minLength": 1 },
              "idempotency": { "type": "string", "minLength": 1 },
              "eventConsumers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "kind", "facet", "method", "idempotency"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "kind": { "enum": ["projector", "event_handler", "subscription"] },
                    "facet": { "type": "string", "minLength": 1 },
                    "method": { "type": "string", "minLength": 1 },
                    "idempotency": { "type": "string", "minLength": 1 },
                    "implementation": { "$ref": "#/$defs/evidenceArtifact" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "localId",
          "domain",
          "objectId",
          "method",
          "pathTemplate",
          "transport",
          "kind",
          "kindExplicit",
          "authMode",
          "commercial",
          "reliability",
          "privacy",
          "telemetry",
          "slo",
          "sourcePath"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "localId": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "objectId": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "pathTemplate": { "type": "string", "minLength": 1 },
          "transport": { "enum": ["json", "sse"] },
          "streaming": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resumeRequestField",
              "resumeResponseField",
              "terminalField",
              "terminalValues"
            ],
            "properties": {
              "resumeRequestField": { "type": "string", "minLength": 1 },
              "resumeResponseField": { "type": "string", "minLength": 1 },
              "terminalField": { "type": "string", "minLength": 1 },
              "terminalValues": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "kind": { "enum": ["command", "query", "session"] },
          "kindExplicit": { "type": "boolean" },
          "facet": { "type": "string", "minLength": 1 },
          "facadeMethod": { "type": "string", "minLength": 1 },
          "aggregateOwner": { "type": "string", "minLength": 1 },
          "appendSink": { "type": "string", "minLength": 1 },
          "lifecycleOwner": { "type": "string", "minLength": 1 },
          "mutationTarget": { "type": "string", "minLength": 1 },
          "invariantTarget": { "type": "string", "minLength": 1 },
          "sessionOwner": { "type": "string", "minLength": 1 },
          "reader": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*Reader$"
          },
          "slice": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "actorRequirement": {
            "enum": ["none", "account", "persona", "device", "persona_or_device"]
          },
          "requestEntity": { "type": "string", "minLength": 1 },
          "requestBodyKind": { "enum": ["object", "none"] },
          "requestBindings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              },
              "query": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              },
              "header": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              },
              "injected": {
                "type": "array",
                "items": { "$ref": "#/$defs/requestBinding" }
              }
            }
          },
          "requestConstants": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "body": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "value": {
                      "type": ["string", "number", "integer", "boolean", "null"]
                    }
                  }
                }
              }
            }
          },
          "responseEntity": { "type": "string", "minLength": 1 },
          "responseEntityRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]*$"
          },
          "responseBody": { "type": "string", "minLength": 1 },
          "responseBodyKind": { "type": "string", "minLength": 1 },
          "successStatus": { "enum": [200, 201, 202, 204] },
          "sourcePath": { "type": "string", "minLength": 1 },
          "security": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "authMode": { "enum": ["deny", "public", "optional", "required"] },
          "principal": {
            "enum": ["public", "account", "persona", "device", "service", "admin", "operator"]
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "ownershipPolicy": { "type": "string", "minLength": 1 },
          "commercial": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "explicit"],
            "properties": {
              "status": { "enum": ["ready", "blocked"] },
              "explicit": { "type": "boolean" },
              "blockReason": { "type": "string", "minLength": 1 },
              "gapId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_-]*$"
              },
              "targetStory": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "blocked" } },
                  "required": ["status"]
                },
                "then": {
                  "required": ["blockReason"]
                }
              }
            ]
          },
          "reliability": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timeoutMilliseconds": { "type": "integer", "minimum": 1 },
              "streamBudget": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "handshakeMilliseconds",
                  "idleMilliseconds",
                  "maxDurationMilliseconds"
                ],
                "properties": {
                  "handshakeMilliseconds": { "type": "integer", "minimum": 1 },
                  "idleMilliseconds": { "type": "integer", "minimum": 1 },
                  "maxDurationMilliseconds": { "type": "integer", "minimum": 1 }
                }
              },
              "cancellation": { "enum": ["supported", "none"] },
              "retryMode": { "enum": ["none", "idempotent"] },
              "maxAttempts": { "type": "integer", "minimum": 1 },
              "idempotency": {
                "enum": [
                  "none",
                  "optional",
                  "required",
                  "payload_digest_server_side"
                ]
              }
            }
          },
          "pagination": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultItems", "maximumItems"],
            "properties": {
              "defaultItems": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "maximumItems": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              }
            }
          },
          "responseAdmission": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximumBodyBytes"],
            "properties": {
              "maximumBodyBytes": {
                "type": "integer",
                "minimum": 1024
              }
            }
          },
          "concurrency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "versionPrecondition": { "enum": ["if_match"] }
            }
          },
          "errorCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestClassification": {
                "enum": ["PUBLIC", "INTERNAL", "PII", "SENSITIVE", "SECRET"]
              },
              "responseClassification": {
                "enum": ["PUBLIC", "INTERNAL", "PII", "SENSITIVE", "SECRET"]
              },
              "logPolicy": { "enum": ["none", "metadata_only", "redacted"] }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trace"],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "trace": { "type": "boolean" },
              "attributes": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "latencyP95Milliseconds": { "type": "integer", "minimum": 1 },
              "availabilityPercent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          },
          "clientContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dartImport",
              "responseType",
              "responseDecoder"
            ],
            "properties": {
              "dartImport": { "type": "string", "minLength": 1 },
              "responseType": { "type": "string", "minLength": 1 },
              "responseDecoder": { "type": "string", "minLength": 1 }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "command" } },
              "required": ["kind"]
            },
            "then": {
              "oneOf": [
                { "required": ["aggregateOwner"] },
                { "required": ["appendSink"] },
                { "required": ["lifecycleOwner"] }
              ]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "query" } },
              "required": ["kind"]
            },
            "then": { "required": ["reader", "slice"] }
          },
          {
            "if": {
              "properties": { "kind": { "const": "session" } },
              "required": ["kind"]
            },
            "then": { "required": ["sessionOwner"] }
          },
          {
            "if": {
              "properties": {
                "commercial": {
                  "properties": { "status": { "const": "ready" } },
                  "required": ["status"]
                }
              },
              "required": ["commercial"]
            },
            "then": {
              "required": [
                "actorRequirement",
                "principal",
                "ownershipPolicy",
                "errorCodes"
              ],
              "properties": {
                "authMode": { "enum": ["public", "optional", "required"] },
                "reliability": {
                  "required": [
                    "timeoutMilliseconds",
                    "cancellation",
                    "retryMode",
                    "maxAttempts",
                    "idempotency"
                  ]
                },
                "privacy": {
                  "required": [
                    "requestClassification",
                    "responseClassification",
                    "logPolicy"
                  ]
                },
                "telemetry": {
                  "required": ["metric", "trace"],
                  "properties": { "trace": { "const": true } }
                },
                "slo": {
                  "required": [
                    "latencyP95Milliseconds",
                    "availabilityPercent"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "runtimeEntrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "localId",
          "domain",
          "objectId",
          "runtimeKind",
          "phase",
          "applicationKind",
          "facet",
          "facadeMethod",
          "objectOwner",
          "telemetry",
          "slo",
          "sourcePath"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "localId": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+$"
          },
          "domain": { "type": "string", "minLength": 1 },
          "objectId": { "type": "string", "minLength": 1 },
          "runtimeKind": {
            "enum": ["middleware", "projector", "event_handler", "subscription", "internal_port", "external_port"]
          },
          "phase": {
            "enum": ["post_authorization_pre_owner_proxy", "event_projection", "event_command", "event_ingest", "transactional_append", "outbound_invocation"]
          },
          "applicationKind": { "enum": ["command", "query", "session"] },
          "facet": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*(Facade|Projector|Projection|Appender|Consumer|Port|Coordinator|Recorder|Orchestrator|Handler)$"
          },
          "facadeMethod": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "objectOwner": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "sourceObjects": { "$ref": "#/$defs/stringList" },
          "idempotency": {
            "enum": ["event_id", "aggregate_version", "identity_payload_digest", "transaction_identity"]
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "trace"],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "trace": { "const": true },
              "attributes": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "latencyP95Milliseconds": {
                "type": "integer",
                "minimum": 1
              },
              "failureRatioPercent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "freshnessP95Seconds": {
                "type": "integer",
                "minimum": 1
              },
              "backlogMaxEvents": {
                "type": "integer",
                "minimum": 1
              },
              "deadLetterRatioPercent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          },
          "sourcePath": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "runtimeKind": {
                  "enum": ["middleware", "internal_port"]
                }
              },
              "required": ["runtimeKind"]
            },
            "then": {
              "properties": {
                "slo": {
                  "required": [
                    "latencyP95Milliseconds",
                    "failureRatioPercent"
                  ],
                  "not": {
                    "anyOf": [
                      { "required": ["freshnessP95Seconds"] },
                      { "required": ["backlogMaxEvents"] },
                      { "required": ["deadLetterRatioPercent"] }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "runtimeKind": {
                  "enum": ["projector", "event_handler", "subscription"]
                }
              },
              "required": ["runtimeKind"]
            },
            "then": {
              "properties": {
                "slo": {
                  "required": [
                    "freshnessP95Seconds",
                    "backlogMaxEvents",
                    "failureRatioPercent"
                  ],
                  "not": {
                    "anyOf": [
                      { "required": ["latencyP95Milliseconds"] },
                      { "required": ["deadLetterRatioPercent"] }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "runtimeKind": { "const": "external_port" }
              },
              "required": ["runtimeKind"]
            },
            "then": {
              "properties": {
                "slo": {
                  "required": [
                    "latencyP95Milliseconds",
                    "failureRatioPercent",
                    "deadLetterRatioPercent"
                  ],
                  "not": {
                    "anyOf": [
                      { "required": ["freshnessP95Seconds"] },
                      { "required": ["backlogMaxEvents"] }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "objectId", "readModel", "readModelExplicit", "sourcePath"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "objectId": { "type": "string", "minLength": 1 },
          "readModel": { "type": "string", "minLength": 1 },
          "readModelExplicit": { "type": "boolean" },
          "dartClass": { "type": "string", "minLength": 1 },
          "outputPath": { "type": "string", "minLength": 1 },
          "fieldNames": { "$ref": "#/$defs/fieldNames" },
          "sourceEntities": { "$ref": "#/$defs/stringList" },
          "sourceEvents": { "$ref": "#/$defs/stringList" },
          "sourcePath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "businessObjectMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "boundedContexts", "sourcePath", "objects"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "boundedContexts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/boundedContext" }
          },
          "sourcePath": { "type": "string", "minLength": 1 },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonicalObject",
                "boundedContext",
                "objectKind",
                "identity",
                "invariantRefs",
                "memberBounds",
                "storageRole",
                "mutationEntrypoints",
                "eventConsumers",
                "lifecycleRefs",
                "access",
                "relationships",
                "fieldRoles"
              ],
              "properties": {
                "canonicalObject": { "type": "string", "minLength": 1 },
                "boundedContext": { "type": "string", "minLength": 1 },
                "objectKind": {
                  "enum": [
                    "aggregate_root",
                    "owned_entity",
                    "value_object",
                    "append_only_fact",
                    "process_manager",
                    "projection",
                    "external_reference",
                    "runtime_session"
                  ]
                },
                "aggregateOwner": { "type": "string", "minLength": 1 },
                "identity": { "$ref": "#/$defs/objectIdentity" },
                "invariantRefs": { "$ref": "#/$defs/stringList" },
                "memberBounds": {
                  "type": "object",
                  "additionalProperties": { "type": "integer", "minimum": 1 }
                },
                "storageRole": {
                  "enum": ["authoritative", "owned", "append_only", "projection", "external", "runtime"]
                },
                "storageBackend": { "type": "string", "minLength": 1 },
                "mutationEntrypoints": { "$ref": "#/$defs/stringList" },
                "eventConsumers": { "$ref": "#/$defs/stringList" },
                "lifecycleRefs": { "$ref": "#/$defs/stringList" },
                "sourceDocument": { "type": "string", "minLength": 1 },
                "sourceEntity": { "type": "string", "minLength": 1 },
                "access": { "$ref": "#/$defs/objectAccess" },
                "relationships": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/relationship" }
                },
                "counterSources": {
                  "type": "object",
                  "propertyNames": { "type": "string", "minLength": 1 },
                  "additionalProperties": { "type": "string", "minLength": 1 }
                },
                "localIdentityReasons": {
                  "type": "object",
                  "propertyNames": { "type": "string", "minLength": 1 },
                  "additionalProperties": { "type": "string", "minLength": 1 }
                },
                "fieldRoles": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "authoritative_state",
                    "owned_value",
                    "reference",
                    "append_only_fact",
                    "projection",
                    "transport_only"
                  ],
                  "properties": {
                    "authoritative_state": { "$ref": "#/$defs/fieldNames" },
                    "owned_value": { "$ref": "#/$defs/fieldNames" },
                    "reference": { "$ref": "#/$defs/fieldNames" },
                    "append_only_fact": { "$ref": "#/$defs/fieldNames" },
                    "projection": { "$ref": "#/$defs/fieldNames" },
                    "transport_only": { "$ref": "#/$defs/fieldNames" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "readinessCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId", "specRef", "caseId", "producer", "layer", "target", "runnerSourcePath", "executions", "sourcePath"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "specRef": {
            "type": "string",
            "pattern": "^specs/feature-tree/.+/spec\\.md#(?:uat|dom|sit|gwt)-[0-9]{3,}$"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "producer": {
            "enum": ["service", "app", "ops"]
          },
          "layer": {
            "enum": [
              "local_contract", "api_integration", "user_acceptance",
              "environment_acceptance", "rollback", "replay"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["operation", "page", "object"] },
              "id": { "type": "string", "minLength": 1 }
            }
          },
          "runnerSourcePath": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
          },
          "executions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environment", "platform", "deviceClass", "provider", "digestBinding"
              ],
              "properties": {
                "environment": { "enum": ["alpha", "beta", "gamma", "prod"] },
                "platform": { "type": "string", "minLength": 1 },
                "deviceClass": { "type": "string", "minLength": 1 },
                "provider": { "type": "string", "minLength": 1 },
                "digestBinding": {
                  "enum": ["candidate", "release", "candidate_or_release"]
                }
              }
            }
          },
          "sourcePath": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          {
            "required": ["producer", "layer"],
            "properties": {
              "producer": { "const": "service" },
              "layer": { "enum": ["local_contract", "api_integration"] },
              "target": {
                "properties": { "kind": { "enum": ["operation", "object"] } }
              }
            }
          },
          {
            "required": ["producer", "layer"],
            "properties": {
              "producer": { "const": "app" },
              "layer": { "enum": ["local_contract", "api_integration"] },
              "target": {
                "properties": { "kind": { "const": "operation" } }
              }
            }
          },
          {
            "required": ["producer", "layer"],
            "properties": {
              "producer": { "const": "app" },
              "layer": { "const": "user_acceptance" },
              "target": {
                "properties": { "kind": { "const": "page" } }
              }
            }
          },
          {
            "required": ["producer", "layer"],
            "properties": {
              "producer": { "const": "ops" },
              "layer": { "enum": ["environment_acceptance", "rollback", "replay"] },
              "target": {
                "properties": { "kind": { "const": "object" } }
              }
            }
          }
        ]
      }
    },
    "readinessEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId", "operationIds", "service", "app", "ops", "sourcePath"
        ],
        "properties": {
          "objectId": { "type": "string", "minLength": 1 },
          "operationIds": { "$ref": "#/$defs/stringList" },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain", "store", "outbox", "reader", "transport",
              "localContract", "apiIntegration"
            ],
            "properties": {
              "domain": { "$ref": "#/$defs/evidenceArtifacts" },
              "store": { "$ref": "#/$defs/evidenceArtifacts" },
              "outbox": { "$ref": "#/$defs/storageEvidenceList" },
              "reader": { "$ref": "#/$defs/evidenceArtifacts" },
              "transport": { "$ref": "#/$defs/evidenceArtifacts" },
              "localContract": { "$ref": "#/$defs/evidenceArtifacts" },
              "apiIntegration": { "$ref": "#/$defs/evidenceArtifacts" }
            }
          },
          "app": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain", "application", "adapters", "presentation",
              "localContract", "apiIntegration", "userAcceptance",
              "pageParticipant", "pageOwned"
            ],
            "properties": {
              "domain": { "$ref": "#/$defs/evidenceArtifacts" },
              "application": { "$ref": "#/$defs/evidenceArtifacts" },
              "adapters": { "$ref": "#/$defs/evidenceArtifacts" },
              "presentation": { "$ref": "#/$defs/evidenceArtifacts" },
              "localContract": { "$ref": "#/$defs/evidenceArtifacts" },
              "apiIntegration": { "$ref": "#/$defs/evidenceArtifacts" },
              "userAcceptance": { "$ref": "#/$defs/evidenceArtifacts" },
              "pageParticipant": { "type": "boolean" },
              "pageOwned": { "type": "boolean" }
            }
          },
          "ops": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environmentAcceptance", "rollbackRunner", "replayRunner"],
            "properties": {
              "environmentAcceptance": { "$ref": "#/$defs/evidenceArtifacts" },
              "rollbackRunner": { "$ref": "#/$defs/evidenceArtifacts" },
              "replayRunner": { "$ref": "#/$defs/evidenceArtifacts" }
            }
          },
          "publicationStores": { "$ref": "#/$defs/stringList" },
          "deliveryStores": { "$ref": "#/$defs/stringList" },
          "publicationDelivery": { "$ref": "#/$defs/storageEvidenceList" },
          "unannotatedStores": { "$ref": "#/$defs/stringList" },
          "unresolvedPublicationWrites": { "$ref": "#/$defs/stringList" },
          "unresolvedPublicationDelivery": { "$ref": "#/$defs/stringList" },
          "undeclaredStorageWrites": { "$ref": "#/$defs/stringList" },
          "pythonImplementation": { "type": "boolean" },
          "sourcePath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "objectReadiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId", "stage", "modeled", "contractReady", "implemented",
          "commercialReady", "missing"
        ],
        "properties": {
          "objectId": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["unmodeled", "modeled", "contract-ready", "implemented"] },
          "modeled": { "type": "boolean" },
          "contractReady": { "type": "boolean" },
          "implemented": { "type": "boolean" },
          "commercialReady": { "type": "boolean" },
          "missing": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mediaType", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mediaType": { "enum": ["application/yaml", "application/json"] },
          "content": {}
        }
      }
    }
  },
  "$defs": {
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "field"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "boundedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextId", "name", "role", "accessPolicy"],
      "properties": {
        "contextId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["core", "supporting", "generic"] },
        "accessPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "queries", "childObjects", "crossContext"],
          "properties": {
            "commands": { "const": "aggregate_facade_only" },
            "queries": { "const": "named_reader_slice_only" },
            "childObjects": { "const": "aggregate_root_only" },
            "crossContext": { "const": "public_contract_only" }
          }
        }
      }
    },
    "objectAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "queries", "crossContext"],
      "properties": {
        "commands": { "enum": ["aggregate_facade", "cli_facade", "via_aggregate_root", "append_only_sink", "process_facade", "session_facade", "none"] },
        "queries": { "enum": ["named_reader", "via_aggregate_projection", "external_port", "none"] },
        "crossContext": { "enum": ["public_contract_only", "event_only", "forbidden"] }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "referenceFields", "kind", "cardinality", "consistency", "access", "onDelete"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "targetObject": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]*$" },
        "targetObjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9]*$" }
        },
        "referenceFields": { "$ref": "#/$defs/fieldNames" },
        "kind": { "enum": ["owned", "reference", "event_source", "projection_source", "external"] },
        "cardinality": { "enum": ["1:1", "1:N", "N:1", "N:N"] },
        "consistency": { "enum": ["strong", "eventual", "runtime"] },
        "access": { "enum": ["aggregate_root", "command_facade", "named_reader", "event", "external_port", "none"] },
        "onDelete": { "enum": ["cascade", "restrict", "tombstone", "retain", "detach"] }
      },
      "oneOf": [
        { "required": ["targetObject"] },
        { "required": ["targetObjects"] }
      ]
    },
    "fieldNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidenceArtifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceArtifact" }
    },
    "storageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "artifact"],
      "properties": {
        "storage": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/evidenceArtifact" }
      }
    },
    "storageEvidenceList": {
      "type": "array",
      "items": { "$ref": "#/$defs/storageEvidence" }
    },
    "objectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "versionSource"],
      "properties": {
        "fields": { "$ref": "#/$defs/fieldNames" },
        "versionSource": {
          "enum": ["field", "store_commit", "owner", "immutable", "checkpoint", "external", "session"]
        },
        "versionField": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "versionSource": { "const": "field" } }, "required": ["versionSource"] },
          "then": { "required": ["versionField"] }
        }
      ]
    }
  }
}
